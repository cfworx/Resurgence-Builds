---
import SocialBar from './SocialBar.astro';
import RelatedHub from './RelatedHub.astro';
import { AMAZON_TAG, AMAZON_DISCLOSURE } from '../data/site-config';
import { allTranslations, activeLangs } from '../utils/translations';
export interface Props {
  title?: string;
}

const { title } = Astro.props;
const year = new Date().getFullYear();
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
// Languages with at least one translated guide get a link to their hub (TRANSLATIONS.md).
const langs = activeLangs(await allTranslations());
---

<RelatedHub current={Astro.url.pathname} />
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left meta-line-wrap"><div class="meta-line">
      <span><a href="/" class="footer-logo">Resurgence<span>Builds</span></a></span>
      <span class="footer-copy">&copy; {year}</span>
      <span class="footer-copy">CC BY-SA 4.0</span>
    </div></div>
    <nav class="footer-nav" aria-label="Footer navigation">
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/partners/">Partners</a>
      <a href="/editorial-policy/">Editorial Policy</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="/dmca/">DMCA</a>
      <a href="/sitemap/">Sitemap</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>

  {langs.length > 0 && (
    <nav class="footer-langs" aria-label="Guides in other languages">
      <span>Guides in:</span>
      <a href="/guides/" hreflang="en" lang="en">English</a>
      {langs.map((l) => <a href={`/${l.code}/`} hreflang={l.tag} lang={l.tag}>{l.name}</a>)}
    </nav>
  )}

  <SocialBar pathname={Astro.url.pathname} />

  <div class="footer-notes">
    <div class="footer-notes__inner">
      <p class="footer-about">
        Builds, guides, a game database, an interactive map and patch notes for The Division Resurgence, <a href="https://www.ubisoft.com/en-us/game/the-division/resurgence" target="_blank" rel="noopener noreferrer">Ubisoft's</a> free-to-play shooter on PC, iOS and Android.
      </p>
      <p class="footer-legal">
        Resurgence Builds is an independent fan site. We are not affiliated with, endorsed by, or sponsored by Ubisoft Entertainment SA. Tom Clancy's The Division, The Division Resurgence, and all related characters, logos, and game assets are trademarks and copyrights of Ubisoft Entertainment SA. Game screenshots and footage are used under fair use for commentary, criticism, and news reporting.
      </p>
      {AMAZON_TAG && <p class="footer-legal">{AMAZON_DISCLOSURE} Links to Amazon on this site are affiliate links.</p>}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface);
    border-top: 1px solid var(--border);
    margin-top: var(--sp-16);
    padding: var(--sp-4) 0 var(--sp-6);
  }
  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--sp-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  @media (min-width: 45em) {
    .footer-inner { padding: 0 var(--sp-8); }
  }

  .footer-left .meta-line { align-items: center; }
  .footer-logo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--ink);
    letter-spacing: -0.02em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .footer-logo:hover { color: var(--ink); }
  .footer-logo span { color: var(--accent); }
  .footer-copy {
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .footer-nav {
    display: flex;
    gap: 0 var(--sp-2);
    flex-wrap: wrap;
    margin-inline: calc(-1 * var(--sp-2));
  }
  .footer-nav a {
    font-size: var(--step--1);
    color: var(--ink-muted);
    transition: color var(--transition-fast);
    padding: var(--sp-2);
    min-height: 44px;
    min-width: 44px;
    justify-content: center;
    display: inline-flex;
    align-items: center;
  }
  .footer-nav a:hover { color: var(--accent); }

  /* "Guides in: English, Deutsch, ..." under the footer links, only when translations exist */
  .footer-langs {
    max-width: var(--max-width); margin: var(--sp-2) auto 0; padding: 0 var(--sp-4);
    display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--sp-2);
    font-size: var(--step--1); color: var(--ink-muted);
  }
  .footer-langs a { color: var(--ink-muted); padding: var(--sp-2); min-height: 44px; display: inline-flex; align-items: center; text-decoration: underline; text-underline-offset: 3px; }
  .footer-langs a:hover { color: var(--accent); }
  @media (min-width: 45em) { .footer-langs { padding: 0 var(--sp-8); } }

  /* About text and legal line under one divider. Phones: full width.
     Tablets: a centred reading-width column under the centred social bar.
     Wide screens: two columns that run from the logo's edge to the nav's edge. */
  .footer-notes {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--sp-5) var(--sp-4) 0;
    border-top: 1px solid var(--border);
  }
  .footer-notes__inner {
    display: grid;
    gap: var(--sp-3);
    max-width: 34rem; /* about 75 characters of the 15px about text */
    margin-inline: auto;
  }
  .footer-about,
  .footer-legal {
    max-width: none; /* the column sets the line length */
    margin: 0;
    color: var(--ink-muted);
    text-align: left; /* long text stays left-aligned; the column itself is what's centred */
    line-height: var(--lh-small);
  }
  .footer-about { font-size: var(--step--1); }
  /* underlined: a link inside a sentence can't be told apart by colour alone */
  .footer-about a { color: var(--accent); text-decoration: underline; text-underline-offset: 0.15em; }
  .footer-legal { font-size: var(--step--2); }
  @media (min-width: 45em) {
    .footer-notes { padding-inline: var(--sp-8); }
  }
  @media (min-width: 60em) {
    .footer-notes__inner {
      max-width: none;
      grid-template-columns: minmax(0, 34rem) minmax(0, 30rem);
      justify-content: space-between;
      align-items: start;
      gap: var(--sp-10);
    }
  }
</style>
