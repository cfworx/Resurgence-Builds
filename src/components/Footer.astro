---
import SocialBar from './SocialBar.astro';
import RelatedHub from './RelatedHub.astro';
export interface Props {
  title?: string;
}

const { title } = Astro.props;
const year = new Date().getFullYear();
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
---

<RelatedHub current={Astro.url.pathname} />
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left meta-line-wrap"><div class="meta-line">
      <span><a href="/" class="footer-logo">Resurgence<span>Builds</span></a></span>
      <span class="footer-copy">&copy; {year}</span>
      <span class="footer-copy">CC BY-SA 4.0</span>
    </div></div>
    <nav class="footer-nav" aria-label="Footer navigation">
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="/dmca/">DMCA</a>
      <a href="/sitemap/">Sitemap</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>

  <SocialBar pathname={Astro.url.pathname} />

  <div class="footer-notes">
    <p class="footer-disclaimer footer-disclaimer--about">
      Resurgence Builds covers The Division Resurgence, <a href="https://www.ubisoft.com/en-us/game/the-division/resurgence" target="_blank" rel="noopener noreferrer">Ubisoft's</a> free-to-play RPG shooter on PC, iOS, and Android. We write build guides, gear set breakdowns, weapon tier lists, class guides, and patch notes for people who actually want to understand why their build works (or doesn't). PvE, Dark Zone PvP, Conflict, Legendary missions, exotic weapons, gear sets, SHD agents, OS Protocols, the Cleaners, the Rikers, the Freemen, solo builds, team builds, meme builds that shouldn't work but somehow do. If it's in the game, we've probably argued about it and then written it up here. Updated every patch because the meta waits for nobody.
    </p>
    <p class="footer-disclaimer footer-disclaimer--legal">
      Resurgence Builds is an independent fan site. We are not affiliated with, endorsed by, or sponsored by Ubisoft Entertainment SA. Tom Clancy's The Division, The Division Resurgence, and all related characters, logos, and game assets are trademarks and copyrights of Ubisoft Entertainment SA. Game screenshots and footage are used under fair use for commentary, criticism, and news reporting.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface);
    border-top: 1px solid var(--border);
    margin-top: var(--sp-16);
    padding: var(--sp-4) 0 var(--sp-3);
  }
  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--sp-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  @media (min-width: 45em) {
    .footer-inner { padding: 0 var(--sp-8); }
  }

  .footer-left .meta-line { align-items: center; }
  .footer-logo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--ink);
    letter-spacing: -0.02em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .footer-logo:hover { color: var(--ink); }
  .footer-logo span { color: var(--accent); }
  .footer-copy {
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .footer-nav {
    display: flex;
    gap: 0 var(--sp-2);
    flex-wrap: wrap;
    margin-inline: calc(-1 * var(--sp-2));
  }
  .footer-nav a {
    font-size: var(--step--1);
    color: var(--ink-muted);
    transition: color var(--transition-fast);
    padding: var(--sp-2);
    min-height: 44px;
    min-width: 44px;
    justify-content: center;
    display: inline-flex;
    align-items: center;
  }
  .footer-nav a:hover { color: var(--accent); }

  /* Left-aligned on the container's edge: long text is hard to read centered */
  .footer-notes {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--sp-3) var(--sp-4) 0;
    border-top: 1px solid var(--border);
  }
  @media (min-width: 45em) {
    .footer-notes { padding-inline: var(--sp-8); }
  }
  .footer-disclaimer {
    color: var(--ink-muted);
    text-align: left;
    line-height: var(--lh-small);
  }
  .footer-disclaimer--about { font-size: var(--step--1); margin-bottom: var(--sp-2); }
  .footer-disclaimer--about a { color: var(--accent); text-decoration: none; }
  .footer-disclaimer--legal { font-size: var(--step--2); margin-bottom: 0; }
</style>
