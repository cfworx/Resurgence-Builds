---
// The build at a glance, at the top of every build page: specialization, headline numbers, the must-haves, both
// weapons with their talents, the OS Protocol and skill mods, and the six gear pieces in the game's own loadout order
// (mask, body armor, backpack / gloves, holster, knee pads), each colored by its gear set.
import { resolveLoadout, inlineMd, type LoadoutData } from '../utils/loadout';
import type { DbImage } from '../utils/db-images';

interface Props {
  loadout: LoadoutData;
  specialization: string;
  subclass?: string;
  playstyle: string;
  pve: boolean;
  pvp: boolean;
  plannerHash?: string;
}
const { loadout, specialization, subclass, playstyle, pve, pvp, plannerHash } = Astro.props;
const L = resolveLoadout(loadout);
const specSlug = specialization.toLowerCase().replace(/\s+/g, '-');
const srcset = (img?: DbImage) => img ? img.srcset.map(([w, u]) => `${w ? `${u} ${w}w` : u}`).join(', ') : undefined;
const small = (img?: DbImage) => img ? img.srcset[0][1] : undefined;
---

<section class="lo" id="loadout" aria-labelledby="loadout-title" data-loadout>
  <header class="lo__head">
    <div class="lo__id">
      <img class="lo__spec" src={`/images/ui/specializations/${specSlug}.webp`} width="56" height="56" alt="" decoding="async" />
      <div class="lo__idtext">
        <h2 id="loadout-title" class="lo__title"><span class="lo__kicker">The loadout</span> {specialization}{subclass && <span class="lo__sub"> · {subclass}</span>}</h2>
        <p class="lo__tags">
          <span>{playstyle}</span>
          {pve && <span>PvE</span>}
          {pvp && <span>PvP</span>}
        </p>
      </div>
    </div>
    {L.stats.length > 0 && (
      <div class="lo__statwrap">
        <dl class="lo__stats">
          {L.stats.map((s) => (
            <div class="lo__stat"><dt>{s.label}</dt><dd>{s.value}</dd></div>
          ))}
        </dl>
        {L.statsFrom && <p class="lo__from">{L.statsFrom}</p>}
      </div>
    )}
    {plannerHash && (
      <a class="lo__planner" href={`/builder/#${plannerHash}`}>
        Open in Build Planner
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    )}
  </header>

  {L.must.length > 0 && (
    <div class="lo__must">
      <p class="lo__mustlabel">Don't skip</p>
      <ul>
        {L.must.map((m) => <li>{m}</li>)}
      </ul>
    </div>
  )}

  <div class="lo__grid">
    <div class="lo__block lo__weapons">
      <h3 class="lo__label">Weapons</h3>
      {L.weapons.map((w) => (
        <div class="lo__weapon">
          <a href={w.href} class="lo__wimg" tabindex="-1" aria-hidden="true">
            {w.image && <img src={small(w.image)} srcset={srcset(w.image)} sizes="132px" width={w.image.width} height={w.image.height} alt="" decoding="async" />}
          </a>
          <div class="lo__winfo">
            <p class="lo__role">{w.role}</p>
            <p class="lo__name"><a href={w.href}>{w.name}</a></p>
            <p class="lo__meta">{w.meta}</p>
            {w.talents.length > 0 && (
              <ul class="lo__chips" aria-label={`${w.name} talents`}>
                {w.talents.map((t) => (
                  <li><a class="lo__chip" href={t.href}>{t.icon && <img src={small(t.icon)} srcset={srcset(t.icon)} sizes="28px" width="28" height="28" alt="" decoding="async" />}{t.name}</a></li>
                ))}
              </ul>
            )}
            {w.attrs.length > 0 && <p class="lo__attrs">{w.attrs.join(' · ')}</p>}
          </div>
        </div>
      ))}
    </div>

    {(L.os || L.mods.length > 0) && (
      <div class="lo__block lo__skills">
        {L.os && (
          <div class="lo__part">
            <h3 class="lo__label">OS Protocol</h3>
            <div class="lo__skill lo__skill--os">
              {L.os.icon && <img src={small(L.os.icon)} srcset={srcset(L.os.icon)} sizes="52px" width="52" height="52" alt="" decoding="async" />}
              <div>
                <p class="lo__name"><a href={L.os.href}>{L.os.name}</a></p>
                <p class="lo__meta">{L.os.meta}</p>
              </div>
            </div>
          </div>
        )}
        {L.mods.length > 0 && (
          <div class="lo__part">
            <h3 class="lo__label">Skill Mods</h3>
            <ul class="lo__skilllist">
              {L.mods.map((m) => (
                <li class="lo__skill">
                  {m.icon && <img src={small(m.icon)} srcset={srcset(m.icon)} sizes="44px" width="44" height="44" alt="" decoding="async" />}
                  <div>
                    <p class="lo__role">{m.skill}</p>
                    <p class="lo__name"><a href={m.href}>{m.name}</a></p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </div>

  <div class="lo__block lo__gearblock">
    <div class="lo__gearhead">
      <h3 class="lo__label">Gear</h3>
      <ul class="lo__sets" aria-label="Gear sets">
        {L.sets.map((s) => (
          <li style={`--set:${s.color}`}>
            {s.icon && <img src={small(s.icon)} srcset={srcset(s.icon)} sizes="28px" width="28" height="28" alt="" loading="lazy" decoding="async" />}
            <span class="lo__setname"><a href={s.href}>{s.count}pc {s.name}</a>{s.bonuses.length > 0 && <span class="lo__bonus">{s.bonuses.join(' · ')}</span>}</span>
          </li>
        ))}
      </ul>
    </div>
    <ol class="lo__gear">
      {L.gear.map((g) => (
        <li class="lo__piece" style={`--set:${g.set.color}`}>
          <div class="lo__ptop">
            <span class="lo__slot">{g.slot}</span>
            <span class="lo__tier">{g.any ? 'Any tier' : g.piece?.tier}</span>
          </div>
          <div class="lo__prow">
            {g.any || !g.piece ? (
              <div class="lo__any" aria-hidden="true">{g.set.icon && <img src={small(g.set.icon)} srcset={srcset(g.set.icon)} sizes="36px" width="36" height="36" alt="" loading="lazy" decoding="async" />}</div>
            ) : (
              <a href={g.piece.href} class="lo__pimg" tabindex="-1" aria-hidden="true">{g.piece.image && <img src={small(g.piece.image)} srcset={srcset(g.piece.image)} sizes="104px" width={g.piece.image.width} height={g.piece.image.height} alt="" loading="lazy" decoding="async" />}</a>
            )}
            <div class="lo__pinfo">
              <p class="lo__pname">{g.any || !g.piece ? `Any ${g.set.name} ${g.slot.toLowerCase()}` : <a href={g.piece.href}>{g.piece.name}</a>}</p>
              {g.alts.length > 0 && <p class="lo__alts">or {g.alts.join(' or ')}</p>}
              <p class="lo__pset"><span class="lo__dot" aria-hidden="true"></span>{g.set.name}</p>
              {g.talent && <a class="lo__talent" href={g.talent.href}>{g.talent.icon && <img src={small(g.talent.icon)} srcset={srcset(g.talent.icon)} sizes="24px" width="24" height="24" alt="" loading="lazy" decoding="async" />}{g.talent.name}</a>}
              {g.attrs.length > 0 && <p class="lo__attrs" title={g.fullAttrs.join(', ')}>{g.attrs.join(' · ')}</p>}
              {g.note && <p class="lo__note">{g.note}</p>}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>

  {L.notes.length > 0 && (
    <div class="lo__notes">
      {L.notes.map((n) => <p><strong>{n.label}:</strong> <span set:html={inlineMd(n.text)} /></p>)}
    </div>
  )}
</section>

<style>
  .lo {
    --lo-pad: var(--pad-card);
    background: linear-gradient(180deg, #1b1b1f 0%, #141417 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: clip;
    margin: 0 0 var(--sp-8);
  }
  .lo p { margin: 0; max-width: none; }

  /* Head: who, the numbers, the planner */
  .lo__head {
    display: grid;
    gap: var(--sp-4);
    padding: var(--lo-pad);
    border-bottom: 1px solid var(--border);
    background: radial-gradient(120% 160% at 0% 0%, rgba(242, 104, 34, 0.16), transparent 55%);
  }
  .lo__id { display: flex; gap: var(--sp-3); align-items: center; min-width: 0; }
  .lo__spec {
    flex: none; width: 56px; height: 56px; padding: 6px; border-radius: var(--radius);
    background: #0f0f12; border: 1px solid var(--border); object-fit: contain;
  }
  .lo__idtext { min-width: 0; }
  .lo__kicker, .lo__label, .lo__mustlabel {
    font-family: var(--font-mono); font-size: var(--step--2); font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent);
  }
  .lo__title {
    font-family: var(--font-heading); font-size: var(--step-1); line-height: var(--lh-tight);
    color: var(--ink-heading); margin: 0 0 6px; padding: 0; border: 0; background: none;
  }
  .lo__title .lo__kicker { display: block; margin-bottom: 4px; line-height: 1.2; }
  .lo__title::before, .lo__title::after { display: none; }
  .lo__sub { color: var(--ink-muted); font-weight: 600; }
  .lo__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .lo__tags span {
    font-family: var(--font-mono); font-size: var(--step--2); line-height: 1.4; padding: 2px 8px;
    border: 1px solid var(--border); border-radius: var(--radius-xs); color: var(--ink); background: rgba(255, 255, 255, 0.03);
  }
  @media (min-width: 35em) { .lo__title { font-size: var(--step-2); } }
  .lo__statwrap { min-width: 0; }
  .lo__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-2); margin: 0; }
  .lo__stat {
    display: flex; flex-direction: column-reverse; justify-content: flex-end; min-width: 0;
    padding: var(--sp-2) 10px; border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.28); border: 1px solid var(--border);
  }
  .lo__stat dd {
    margin: 0; font-family: var(--font-heading); font-weight: 800; font-size: var(--step-0);
    line-height: 1.15; color: var(--ink-heading);
  }
  @media (min-width: 35em) { .lo__stat { padding: var(--sp-2) var(--sp-3); } .lo__stat dd { font-size: var(--step-1); } }
  .lo__stat dt { font-size: var(--step--2); line-height: var(--lh-small); color: var(--ink-muted); margin-top: 2px; }
  .lo__from { margin-top: 6px !important; font-size: var(--step--2); color: var(--ink-muted); }
  .lo__planner {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 0 var(--sp-5);
    border-radius: var(--radius-sm); background: var(--accent); color: #111; font-family: var(--font-heading);
    font-weight: 800; font-size: var(--step--1); text-decoration: none; white-space: nowrap;
    box-shadow: 0 6px 18px rgba(242, 104, 34, 0.28); transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .lo__planner:hover { transform: translateY(-1px); box-shadow: 0 8px 22px rgba(242, 104, 34, 0.38); color: #000; }
  @media (min-width: 60em) {
    .lo__head { grid-template-columns: minmax(0, 1fr) minmax(0, 26rem) auto; align-items: center; }
    .lo__stat dd { font-size: var(--step-2); }
  }

  /* Must-haves */
  .lo__must {
    padding: var(--sp-3) var(--lo-pad); border-bottom: 1px solid var(--border);
    background: linear-gradient(90deg, rgba(242, 104, 34, 0.12), rgba(242, 104, 34, 0.03));
  }
  .lo__must ul { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 6px; }
  .lo__must li {
    display: flex; gap: var(--sp-2); align-items: flex-start; margin: 0; max-width: none;
    color: var(--ink-heading); font-weight: 600; font-size: var(--step--1); line-height: var(--lh-small);
  }
  .lo__must li::before {
    content: '!'; flex: none; width: 22px; height: 22px; margin-top: 1px; border-radius: 50%;
    display: grid; place-items: center; background: var(--accent); color: #111; font-weight: 800; font-size: 13px;
  }

  /* Weapons and skills */
  .lo__grid { display: grid; }
  .lo__block { padding: var(--lo-pad); border-bottom: 1px solid var(--border); min-width: 0; }
  .lo__label { margin: 0 0 var(--sp-3); padding: 0; border: 0; background: none; }
  .lo__label::before, .lo__label::after { display: none; }
  @media (min-width: 60em) {
    .lo__grid { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); }
    .lo__skills { border-left: 1px solid var(--border); }
  }
  .lo__weapon { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: var(--sp-3); align-items: start; }
  .lo__weapon + .lo__weapon { margin-top: var(--sp-4); padding-top: var(--sp-4); border-top: 1px dashed var(--border); }
  .lo__wimg img { display: block; width: 112px; height: auto; border-radius: 6px; }
  @media (min-width: 35em) {
    .lo__weapon { grid-template-columns: 140px minmax(0, 1fr); }
    .lo__wimg img { width: 140px; }
  }
  .lo__role { font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
  .lo__name { font-family: var(--font-heading); font-weight: 800; font-size: var(--step-0); line-height: var(--lh-snug); color: var(--ink-heading); }
  .lo__name a, .lo__pname a { color: inherit; text-decoration: none; }
  .lo__name a:hover, .lo__pname a:hover { color: var(--accent); }
  .lo__meta { font-size: var(--step--2); line-height: var(--lh-small); color: var(--ink-muted); margin-top: 2px !important; }
  .lo__chips { list-style: none; padding: 0; margin: var(--sp-2) 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .lo__chips li { margin: 0; max-width: 100%; }
  .lo__chip {
    display: inline-flex; align-items: center; gap: 8px; min-height: 36px; padding: 3px 12px 3px 3px; max-width: 100%;
    border-radius: 999px; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border);
    color: var(--ink-heading); font-weight: 700; font-size: var(--step--1); line-height: 1.2; text-decoration: none;
  }
  .lo__chip:hover { border-color: var(--accent); color: #fff; }
  .lo__chip img { flex: none; width: 28px; height: 28px; border-radius: 50%; background: #2a2a2e; }
  .lo__attrs { margin-top: 6px !important; font-size: var(--step--2); line-height: var(--lh-small); color: var(--ink-muted); }

  /* OS Protocol and Skill Mods: two sections with their own headings, split by a rule (Cory, October 31) */
  .lo__part + .lo__part { margin-top: var(--sp-5); padding-top: var(--sp-5); border-top: 1px solid var(--border); }
  .lo__skilllist { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-3); }
  .lo__skill { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: var(--sp-3); align-items: center; margin: 0; }
  .lo__skill img { width: 44px; height: 44px; border-radius: 10px; background: #2a2a2e; border: 1px solid rgba(255, 255, 255, 0.08); }
  .lo__skill .lo__name { font-size: var(--step--1); }
  .lo__skill--os { grid-template-columns: 52px minmax(0, 1fr); }
  .lo__skill--os img { width: 52px; height: 52px; }
  .lo__skill--os .lo__name { font-size: var(--step-0); }
  @media (min-width: 35em) and (max-width: 59.99em) {
    .lo__skilllist { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Gear */
  /* "Gear" on the left, the set chips centered over the six pieces (Cory, October 31) */
  .lo__gearhead { display: grid; grid-template-columns: minmax(0, 1fr); align-items: center; gap: var(--sp-2) var(--sp-4); margin-bottom: var(--sp-3); }
  .lo__gearhead .lo__label { margin: 0; }
  .lo__sets { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--sp-2); }
  @media (min-width: 60em) {
    .lo__gearhead { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); }
    .lo__gearhead .lo__sets { grid-column: 2; }
  }
  .lo__sets li {
    display: inline-flex; align-items: center; gap: 8px; margin: 0; padding: 4px 14px 4px 4px; border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--set) 45%, transparent); background: color-mix(in srgb, var(--set) 9%, transparent);
  }
  .lo__sets img { flex: none; width: 30px; height: 30px; border-radius: 50%; background: #202024; }
  .lo__setname { display: flex; flex-direction: column; line-height: 1.25; }
  .lo__setname a { color: var(--set); font-weight: 800; font-size: var(--step--1); text-decoration: none; }
  .lo__setname a:hover { text-decoration: underline; }
  .lo__bonus { font-size: var(--step--2); color: var(--ink); }
  .lo__gear { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-3); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 35em) { .lo__gear { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 60em) { .lo__gear { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .lo__piece {
    margin: 0; min-width: 0; padding: var(--sp-3); border-radius: 10px;
    background: #111114; border: 1px solid var(--border); border-top: 3px solid var(--set);
  }
  .lo__ptop { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-2); margin-bottom: var(--sp-2); }
  .lo__slot { font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-muted); }
  .lo__tier { font-family: var(--font-mono); font-size: var(--step--2); padding: 1px 7px; border-radius: var(--radius-xs); background: rgba(255, 255, 255, 0.07); color: var(--ink-heading); white-space: nowrap; }
  .lo__prow { display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: var(--sp-3); align-items: start; }
  .lo__pimg img { display: block; width: 104px; height: auto; border-radius: 6px; }
  .lo__any {
    width: 104px; aspect-ratio: 330 / 156; border-radius: 6px; display: grid; place-items: center;
    border: 1px dashed color-mix(in srgb, var(--set) 55%, transparent);
    background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.035) 0 6px, transparent 6px 12px), #18181c;
  }
  .lo__any img { width: 36px; height: 36px; border-radius: 50%; }
  .lo__pinfo { min-width: 0; }
  .lo__pname { font-family: var(--font-heading); font-weight: 800; font-size: var(--step--1); line-height: var(--lh-snug); color: var(--ink-heading); overflow-wrap: anywhere; }
  .lo__alts { margin-top: 2px !important; font-size: var(--step--2); line-height: var(--lh-small); color: var(--ink-muted); }
  .lo__pset { display: flex; align-items: center; gap: 6px; margin-top: 4px !important; font-size: var(--step--2); font-weight: 700; color: var(--set); }
  .lo__dot { flex: none; width: 9px; height: 9px; border-radius: 50%; background: var(--set); box-shadow: 0 0 0 3px color-mix(in srgb, var(--set) 22%, transparent); }
  .lo__talent {
    display: inline-flex; align-items: center; gap: 6px; margin-top: 6px; padding: 2px 10px 2px 2px; border-radius: 999px;
    background: rgba(242, 104, 34, 0.12); border: 1px solid rgba(242, 104, 34, 0.5);
    color: #ffd9c4; font-weight: 700; font-size: var(--step--2); line-height: 1.3; text-decoration: none;
  }
  .lo__talent:hover { background: rgba(242, 104, 34, 0.22); color: #fff; }
  .lo__talent img { flex: none; width: 26px; height: 26px; border-radius: 50%; background: #2a2a2e; }
  .lo__note { margin-top: 4px !important; font-size: var(--step--2); font-style: italic; color: var(--ink-muted); }

  .lo__notes { padding: var(--lo-pad); font-size: var(--step--1); line-height: var(--lh-small); color: var(--ink); display: grid; gap: var(--sp-2); }
  .lo__notes strong { color: var(--ink-heading); }
  .lo > :last-child { border-bottom: 0; }

  /* Touch: links keep their look but get a 44px tap area */
  @media (pointer: coarse) {
    .lo__chip, .lo__talent, .lo__name a, .lo__pname a, .lo__setname a { position: relative; }
    .lo__chip::after, .lo__talent::after, .lo__name a::after, .lo__pname a::after, .lo__setname a::after {
      content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 44px; transform: translateY(-50%);
    }
  }
</style>
