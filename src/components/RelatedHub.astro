---
/**
 * RelatedHub: contextual internal links shown above the footer.
 * Renders 3 hub links (excluding the current page) to boost interlinking
 * between high-value pages: codes, safe codes, tier list, build planner, error codes.
 */
export interface Props {
  current?: string;
}

const { current = '' } = Astro.props;

const hubs = [
  { href: '/guides/division-resurgence-codes/', label: 'Redeem Codes', icon: 'gift', desc: 'All active codes' },
  { href: '/guides/division-resurgence-safe-codes/', label: 'Safe Codes', icon: 'lock', desc: 'Every safe location' },
  { href: '/tier-list/', label: 'Build Tier List', icon: 'trophy', desc: 'Meta rankings' },
  { href: '/builder/', label: 'Build Planner', icon: 'wrench', desc: 'Plan your loadout' },
  { href: '/guides/division-resurgence-error-codes/', label: 'Error Codes', icon: 'alert', desc: 'Fixes & workarounds' },
];

// Filter out the current page and pick 3
const links = hubs
  .filter(h => !current.includes(h.href.replace(/\/$/, '')))
  .slice(0, 3);
const ICONS: Record<string, string> = {
  gift: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5"/>',
  lock: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  trophy: '<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4z"/><path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"/>',
  wrench: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4 2.5-2.5z"/>',
  alert: '<path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/>',
};
---

{links.length > 0 && (
  <nav class="related-hubs" aria-label="Related resources">
    <span class="related-hubs__label">Quick Links</span>
    <div class="related-hubs__links">
      {links.map(link => (
        <a href={link.href} class="related-hubs__link">
          <span class="related-hubs__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[link.icon] || ICONS.wrench}></svg></span>
          <span class="related-hubs__text">
            <strong>{link.label}</strong>
            <small>{link.desc}</small>
          </span>
        </a>
      ))}
    </div>
  </nav>
)}

<style>
  .related-hubs {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-4) var(--sp-4);
  }
  @media (min-width: 45em) {
    .related-hubs { padding: var(--sp-6) var(--sp-8) var(--sp-4); }
  }
  .related-hubs__label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    margin-bottom: var(--sp-3);
  }
  .related-hubs__links {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }
  .related-hubs__link {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-3);
    background: var(--surface-alt, rgba(255,255,255,0.03));
    border: 1px solid var(--border);
    border-radius: var(--radius, 8px);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
    flex: 1 1 auto;
    min-width: 180px;
    max-width: 280px;
  }
  .related-hubs__link:hover {
    border-color: var(--accent);
    background: rgba(242, 104, 34, 0.05);
  }
  .related-hubs__icon {
    display: inline-flex;
    color: var(--accent);
    flex-shrink: 0;
  }
  .related-hubs__text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .related-hubs__text strong {
    font-size: var(--text-sm);
    color: var(--ink);
  }
  .related-hubs__text small {
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }
</style>
