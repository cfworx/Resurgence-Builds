---
import { NEWSLETTER_FORM } from '../data/site-config';

export interface Props {
  /** Where the box sits; keeps the input ids unique. */
  source: string;
}

const { source } = Astro.props;
const id = `nl-email-${source}`;
const { action, emailField, hidden = {} } = NEWSLETTER_FORM;
---

{action && (
  <aside class="newsletter" aria-labelledby={`${id}-heading`}>
    <h2 id={`${id}-heading`} class="newsletter__heading">Get new builds the day they drop</h2>
    <p class="newsletter__text">One email when new builds land or the tier lists shake up. No spam, no "you won't believe this loadout." Unsubscribe in one click.</p>
    <form
      class="newsletter__form"
      action={action}
      method="post"
      target="_blank"
    >
      <label for={id} class="newsletter__label">Email address</label>
      <input type="email" name={emailField} id={id} class="newsletter__input" placeholder="agent@example.com" autocomplete="email" required />
      {Object.entries(hidden).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
      <button type="submit" class="newsletter__button">Notify me</button>
    </form>
  </aside>
)}

<style>
  .newsletter {
    margin: var(--sp-8) 0;
    padding: var(--sp-5);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--border-radius);
    background: var(--surface);
  }
  .newsletter__heading {
    font-family: var(--font-heading);
    font-size: var(--text-xl, 1.25rem);
    margin: 0 0 var(--sp-2);
  }
  .newsletter__text {
    color: var(--ink-muted);
    margin: 0 0 var(--sp-4);
  }
  .newsletter__form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    align-items: center;
  }
  .newsletter__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .newsletter__input {
    flex: 1 1 14rem;
    min-width: 0;
    padding: var(--sp-2) var(--sp-3);
    border: 1px solid var(--border);
    border-radius: var(--border-radius);
    background: var(--inset, transparent);
    color: var(--ink);
    font: inherit;
  }
  .newsletter__button {
    flex: 0 0 auto;
    padding: var(--sp-2) var(--sp-4);
    border: 0;
    border-radius: var(--border-radius);
    background: var(--accent);
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: opacity var(--transition-fast, 150ms);
  }
  .newsletter__button:hover { opacity: 0.9; }
</style>
