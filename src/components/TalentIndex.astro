---
/**
 * Consolidated, sortable talent index with per-item anchors.
 * Replaces the former per-talent item pages for backpack-talents and
 * body-armor-talents (those URLs 301 to anchors on the index).
 */
export interface Props {
  talents: { id?: string; name: string; description: string; note?: string }[];
  /** e.g. "/database/backpack-talents/" */
  basePath: string;
}

// Never name a prop `slot` here: Astro reads slot="..." on a component as a named-slot target
// and silently drops the component when the parent has no slot by that name.
import GameImage from './GameImage.astro';
import { dbImage, CARDS_RECORDED } from '../utils/db-images';
import DbIcon from './DbIcon.astro';
import { piecesFor, pieceSets, GEAR_SOURCES_RECORDED } from '../utils/rolls';
const { talents, basePath } = Astro.props;
// "/database/backpack-talents/" -> "backpack-talents": the folder of the in-game card images.
const section = basePath.split('/').filter(Boolean).pop() || '';
const kind = section === 'backpack-talents' ? { talent: 'backpack talent', gear: 'backpacks' } : { talent: 'body armor talent', gear: 'body armor pieces' };

const toSlug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

// Role derivation: same keyword logic the old item pages used.
const roleOf = (description: string): string[] => {
  const roles: string[] = [];
  if (/weapon damage|critical hit chance|critical hit damage|rate of fire|magazine size|optimal range|damage(?! reduction)/i.test(description)) roles.push('DPS');
  if (/skill|engineering/i.test(description)) roles.push('Skill');
  if (/armor|health|damage reduction|healing|medical kit|extra health/i.test(description)) roles.push('Tank/Sustain');
  if (/ally|allies/i.test(description)) roles.push('Team');
  if (roles.length === 0) roles.push('Utility');
  return roles;
};

const roleColors: Record<string, string> = {
  'DPS': '#f87171',
  'Skill': '#facc15',
  'Tank/Sustain': '#60a5fa',
  'Team': '#22c55e',
  'Utility': '#b8b8c0',
};

const sourceKind = section === 'backpack-talents' ? 'backpackTalents' : 'bodyArmorTalents';
const entries = talents.map(t => ({
  ...t,
  slug: toSlug(t.name),
  roles: roleOf(t.description),
  // The pieces in the talent's Source list (recorded in game), with the gear sets each one carries.
  rollsOn: piecesFor(sourceKind, toSlug(t.name)).map((p) => ({ ...p, sets: pieceSets(p.slug).map((x) => x.name) })),
}));
const tierOrder: Record<string, number> = { T2: 0, T1: 1, T0: 2 };

const allRoles = ['DPS', 'Skill', 'Tank/Sustain', 'Team', 'Utility'].filter(r => entries.some(e => e.roles.includes(r)));
---

<!-- Jump nav -->
<nav class="ti-jumpnav" aria-label="Jump to talent">
  {entries.map(e => (
    <a href={`#${e.slug}`} class="ti-jumpnav__link">{e.name}</a>
  ))}
</nav>

<!-- Controls -->
<div class="ti-controls">
  <div class="ti-sort" role="group" aria-label="Sort talents">
    <span class="ti-controls__label">Sort:</span>
    <button type="button" class="ti-sort__btn is-active" data-sort="az">A to Z</button>
    <button type="button" class="ti-sort__btn" data-sort="role">By role</button>
  </div>
  <div class="ti-filter" role="group" aria-label="Filter by role">
    <span class="ti-controls__label">Role:</span>
    <button type="button" class="ti-filter__btn is-active" data-role="all">All</button>
    {allRoles.map(r => (
      <button type="button" class="ti-filter__btn" data-role={r} style={`--role-color:${roleColors[r]}`}>{r}</button>
    ))}
  </div>
</div>

<div class="ti-list" id="ti-list">
  {entries.map(e => (
    <article class="ti-entry" id={e.slug} data-name={e.name} data-roles={e.roles.join('|')}>
      <h2 class="ti-entry__title">
        <a href={`#${e.slug}`} class="ti-entry__anchor" aria-label={`Link to ${e.name}`}>#</a>
        <DbIcon id={`${section}/${e.slug}`} size={44} alt={`${e.name} ${kind.talent} icon`} />
        {e.name}
        {e.roles.map(r => (
          <span class="ti-entry__badge" style={`--role-color:${roleColors[r]}`}>{r}</span>
        ))}
      </h2>
      <p class="ti-entry__desc">{e.description}</p>
      {e.note && <p class="item-note">{e.note}</p>}
      {e.rollsOn.length > 0 && (
        <div class="ti-rolls">
          <p class="ti-rolls__lead">Rolls on {e.rollsOn.length} of the 12 {kind.gear}, at High-End and Superior (the talent's Source list in game, recorded {GEAR_SOURCES_RECORDED}), with the gear sets each one carries:</p>
          <ul class="ti-rolls__list">
            {[...e.rollsOn].sort((a, b) => tierOrder[a.tier] - tierOrder[b.tier] || a.name.localeCompare(b.name)).map((p) => {
              const icon = dbImage(`gear-icons/${p.slug}`);
              return (
                <li>
                  <a class="ti-piece" href={`/database/gear/#${p.slug}`}>
                    {icon && <img src={icon.srcset[0][1]} srcset={icon.srcset.map(([iw, u]) => `${u} ${iw}w`).join(', ')} sizes="88px" width={icon.width} height={icon.height} alt="" loading="lazy" decoding="async" />}
                    <span class="ti-piece__text">
                      <span class="ti-piece__name">{p.name} <span class="ti-piece__tier">{p.tier}</span></span>
                      <span class="ti-piece__sets">{p.sets.join(', ')}</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      )}
      {dbImage(`${section}/${e.slug}`) && (
        <details class="game-card-toggle ti-card">
          <summary>In-game card</summary>
          <figure class="game-figure game-figure--wide">
            <GameImage
              image={dbImage(`${section}/${e.slug}`)!}
              alt={`${e.name} ${kind.talent} card in The Division Resurgence, with the ${kind.gear} that can roll it`}
              sizes="(max-width: 760px) calc(100vw - 64px), 688px"
            />
            <figcaption>{e.name} in the game's Build-Making Database, recorded {CARDS_RECORDED}. The Source list shows the {kind.gear} that can roll it.</figcaption>
          </figure>
        </details>
      )}
    </article>
  ))}
</div>

<style>
  .ti-jumpnav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--sp-5);
    padding: var(--sp-4);
    background: rgba(0,0,0,0.25);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
  }
  .ti-jumpnav__link {
    font-size: var(--text-xs);
    color: #b8b8c0;
    text-decoration: none;
    padding: 3px 8px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    transition: all 0.15s;
  }
  .ti-jumpnav__link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .ti-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    align-items: center;
    margin-bottom: var(--sp-6);
  }
  .ti-sort, .ti-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
  }
  .ti-controls__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #8888a0;
  }
  .ti-sort__btn, .ti-filter__btn {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: #b8b8c0;
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    padding: 5px 12px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .ti-sort__btn.is-active, .ti-filter__btn.is-active {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(242,104,34,0.08);
  }
  .ti-filter__btn[data-role]:not([data-role="all"]).is-active {
    color: var(--role-color);
    border-color: var(--role-color);
    background: transparent;
  }
  .ti-entry {
    max-width: calc(var(--measure) + 2 * var(--sp-5));
    margin-bottom: var(--sp-5);
    padding: var(--sp-5);
    background: rgba(0,0,0,0.2);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px;
  }
  .ti-entry:target {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px rgba(242,104,34,0.3);
  }
  .ti-entry__title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-2);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 800;
    color: #fff;
    margin: 0 0 var(--sp-3) 0;
  }
  .ti-entry__anchor {
    color: rgba(255,255,255,0.25);
    text-decoration: none;
  }
  .ti-entry__anchor:hover { color: var(--accent); }
  .ti-entry__badge {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border: 1px solid var(--role-color);
    color: var(--role-color);
    border-radius: 999px;
  }
  .ti-entry__desc {
    color: #c8c8d0;
    line-height: 1.7;
    font-size: var(--text-base);
    margin: 0;
  }

  .ti-rolls { margin-top: var(--sp-3); }
  .ti-rolls__lead { margin: 0 0 var(--sp-2); font-size: var(--text-sm); color: var(--ink-muted); }
  .ti-rolls__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--sp-2);
  }
  .ti-rolls__list li { margin: 0; max-width: none; }
  .ti-piece {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px;
    height: 100%;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.07);
    background: rgba(0,0,0,0.22);
    color: #e8e8f0;
    text-decoration: none;
  }
  .ti-piece:hover { border-color: rgba(242,104,34,0.45); }
  .ti-piece img { width: 88px; height: auto; border-radius: 4px; flex: none; }
  .ti-piece__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .ti-piece__name { font-size: var(--text-sm); font-weight: 600; line-height: 1.3; }
  .ti-piece__tier {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-muted);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 4px;
    padding: 0 4px;
    margin-left: 4px;
  }
  .ti-piece__sets { font-size: var(--text-xs); color: var(--ink-muted); line-height: 1.4; }
</style>

<script>
  const list = document.getElementById('ti-list');
  if (list) {
    const entries = Array.from(list.querySelectorAll<HTMLElement>('.ti-entry'));
    const sortBtns = document.querySelectorAll<HTMLButtonElement>('.ti-sort__btn');
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.ti-filter__btn');
    const ROLE_ORDER = ['DPS', 'Skill', 'Tank/Sustain', 'Team', 'Utility'];

    sortBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        sortBtns.forEach(b => b.classList.toggle('is-active', b === btn));
        const mode = btn.dataset.sort;
        const sorted = [...entries].sort((a, b) => {
          if (mode === 'role') {
            const ra = ROLE_ORDER.indexOf((a.dataset.roles || '').split('|')[0]);
            const rb = ROLE_ORDER.indexOf((b.dataset.roles || '').split('|')[0]);
            if (ra !== rb) return ra - rb;
          }
          return (a.dataset.name || '').localeCompare(b.dataset.name || '');
        });
        sorted.forEach(e => list.appendChild(e));
      });
    });

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.toggle('is-active', b === btn));
        const role = btn.dataset.role;
        entries.forEach(e => {
          const roles = (e.dataset.roles || '').split('|');
          e.style.display = (role === 'all' || roles.includes(role!)) ? '' : 'none';
        });
      });
    });
  }
</script>
