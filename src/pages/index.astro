---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTag from '../components/SectionTag.astro';
import PostCard from '../components/PostCard.astro';
import AdSenseUnit from '../components/AdSenseUnit.astro';
import { getCollection } from 'astro:content';
import seasonStatus from '../data/season-status.json';

// Fetch all content collections
const allNews = await getCollection('news');
const allPatchNotes = await getCollection('patchNotes');
const allGuides = await getCollection('guides');
const allBuilds = await getCollection('builds');

// Normalize into a unified post format
interface UnifiedPost {
  title: string;
  href: string;
  date: Date;
  author: string;
  description: string;
  type: 'news' | 'patch-notes' | 'guide' | 'build' | 'alert';
  tags: string[];
  featuredImage?: string;
  imageAlt?: string;
}

const posts: UnifiedPost[] = [
  ...allNews.map((post) => ({
    title: post.data.title,
    href: `/news/${post.id}/`,
    date: post.data.publishDate,
    author: post.data.author,
    description: post.data.description,
    type: (post.data.tags.includes('Alert') ? 'alert' : 'news') as 'alert' | 'news',
    tags: post.data.tags,
    featuredImage: post.data.featuredImage,
    imageAlt: post.data.imageAlt,
  })),
  ...allPatchNotes.map((pn) => ({
    title: pn.data.title,
    href: `/patch-notes/${pn.id}/`,
    date: pn.data.patchDate,
    author: pn.data.author,
    description: pn.data.summary,
    type: 'patch-notes' as const,
    tags: pn.data.tags || [],
    featuredImage: pn.data.featuredImage,
    imageAlt: pn.data.imageAlt,
  })),
  ...allGuides.map((guide) => ({
    title: guide.data.title,
    href: `/guides/${guide.id}/`,
    // first-published date keeps refreshed evergreen guides from burying new posts
    date: guide.data.publishDate ?? guide.data.lastUpdated,
    author: guide.data.author || 'Resurgence Builds',
    description: guide.data.description,
    type: 'guide' as const,
    tags: guide.data.tags,
    featuredImage: guide.data.featuredImage,
    imageAlt: guide.data.imageAlt,
  })),
  ...allBuilds.map((build) => ({
    title: build.data.title,
    href: `/builds/${build.id}/`,
    date: build.data.lastUpdated,
    author: build.data.author,
    description: build.data.description,
    type: 'build' as const,
    tags: build.data.tags,
    featuredImage: build.data.featuredImage,
    imageAlt: build.data.imageAlt,
  })),
];

// Sort by date (newest first)
posts.sort((a, b) => b.date.getTime() - a.date.getTime());

// Fixed tag list
const filterTags = [
  { label: 'News', value: 'news' },
  { label: 'Alerts', value: 'alert' },
  { label: 'Builds', value: 'build' },
  { label: 'Guides', value: 'guide' },
  { label: 'Patch Notes', value: 'patch-notes' },
];

const faqs = [
  {
    question: "What is Resurgence Builds?",
    answer: "Resurgence Builds is a fan site for The Division Resurgence. We publish community builds, tier lists, a game database, an interactive map, patch note breakdowns and guides, and we check our claims against Ubisoft's official patch notes."
  },
  {
    question: "What is The Division Resurgence?",
    answer: "The Division Resurgence is Ubisoft's free-to-play open-world RPG shooter, set in post-crisis New York with its own storyline, separate from The Division and The Division 2. It launched on iOS and Android on March 31, 2026 and on PC through Steam and Ubisoft Connect on August 5, 2026. Expect five specializations, the Dark Zone, and a loot grind that will eat your free time like a black hole."
  },
  {
    question: "How often are builds and guides updated?",
    answer: "Patch notes get covered as soon as Ubisoft publishes them. Builds and guides get re-checked when a patch touches them, and every page shows its Last Updated date and the patch it was checked against, so you can tell at a glance whether it is current or ancient history."
  },
  {
    question: "Is Division Resurgence free to play?",
    answer: "Yes, on mobile and PC. There are optional purchases, like the premium track of the Classified Ops pass and store cosmetics, but nothing on this site is paywalled either. All our builds and guides are free."
  },
  {
    question: "What platforms is Division Resurgence on?",
    answer: "iOS, Android and PC. The PC version left early access and launched on Steam and Ubisoft Connect on August 5, 2026. Mobile and PC players can play together on the same regional server, and since Season 2 Phase 1 there is a crossplay matchmaking selector, plus mobile-only groups can stay in mobile Dark Zone instances."
  },
];

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Latest Division Resurgence Builds, Guides & News',
  itemListElement: posts.slice(0, 12).map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://resurgencebuilds.com${p.href}`,
    name: p.title,
  })),
};
---

<BaseLayout
  title="Division Resurgence Builds, Tier Lists & Guides"
  description="Independent Division Resurgence site for mobile and PC: builds, tier lists, patch notes, an interactive map and a game database."
  keywords={[
    "the division resurgence",
    "division resurgence mobile",
    "division resurgence pc",
    "division resurgence patch notes",
    "division resurgence guide",
    "division resurgence tier list",
    "division resurgence builds",
    "division resurgence best build",
    "division resurgence weapon tier list",
    "division resurgence gear sets"
  ]}
  faqs={faqs}
  jsonLd={itemListLd}
>
  <!-- Hero -->
  <section class="hero-banner">
    <img src="/images/hero-banner.webp" alt="The Division Resurgence Hero Banner" class="hero-banner__img" width="1920" height="596" style="aspect-ratio:1920/596;" fetchpriority="high" loading="eager" />
    <div class="hero-banner__overlay"></div>
    <div class="hero-banner__content container" style="display:flex; justify-content:center;">
      <div class="hero-box">
        <h1 class="hero__title" style="margin-bottom: var(--sp-4);">
          Division Resurgence Builds, Guides <span style="color:var(--accent);">&amp;</span> Patch Notes
          <span class="hero__subtitle">The #1 Independent Source for The Division Resurgence</span>
        </h1>
        <p class="hero__lede">
          We love The Division Resurgence and do our best to put out the best builds, guides, and news on the internet. We actually play the game and do our best to make sure all of our content is accurate and useful. Bookmark our page, we are always improving and we want to be your source of all things The Division Resurgence.
        </p>
        <div class="hero__actions">
          <a href="/builds/" class="btn btn--primary">Browse Division Resurgence Builds</a>
          <a href="/division-resurgence-interactive-map/" class="btn btn--outline">Open the Interactive Map</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Live season strip (data: src/data/season-status.json) -->
  <section class="now-live" aria-label="What is live in The Division Resurgence right now">
    <div class="now-live__inner container">
      <span class="now-live__badge"><span class="now-live__dot" aria-hidden="true"></span>Live now</span>
      <strong class="now-live__season">{seasonStatus.season}</strong>
      <span class="now-live__headline">{seasonStatus.headline}</span>
      <span class="now-live__links">
        {seasonStatus.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </span>
    </div>
  </section>

  <hr class="divider" style="max-width:var(--max-width);margin:0 auto;" />

  <!-- Latest Posts Feed -->
  <section class="section" id="latest-posts-section" aria-labelledby="latest-posts">
    <div class="container">
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: var(--sp-6); margin-bottom: var(--sp-6);">
        <div>
          <SectionTag label="Latest" />
          <h2 class="heading-accent" id="latest-posts">Latest Posts</h2>

          <!-- Tag Filter Bar -->
          <div class="filter-bar filter-bar--grid" id="tag-filters" style="margin-bottom: 0;" role="group" aria-label="Filter posts">
            <button class="filter-btn is-active" data-tag="all" aria-pressed="true">All</button>
            {filterTags.map((tag) => (
              <button class="filter-btn" data-tag={tag.value} aria-pressed="false">{tag.label}</button>
            ))}
          </div>
        </div>
      </div>

      <!-- Posts Grid -->
      <div class="grid grid--3" id="posts-grid">
        {posts.map((post, i) => (
          <PostCard
            eager={i < 3}
            title={post.title}
            href={post.href}
            date={post.date}
            author={post.author}
            description={post.description}
            type={post.type}
            tags={post.tags}
            featuredImage={post.featuredImage}
            imageAlt={post.imageAlt}
          />
        ))}
      </div>

      <AdSenseUnit className="ad-slot--in-feed" format="fluid" label="Advertisement (homepage 1)" />

      <!-- Pagination Controls -->
      <div id="pagination-controls" style="justify-content:center; align-items:center; gap:var(--sp-4); margin-top:var(--sp-8); display:none;">
        <button class="btn btn--outline" id="prev-page" disabled>Previous</button>
        <span id="page-info" style="color:var(--ink); font-family:var(--font-mono);">Page 1 of 1</span>
        <button class="btn btn--outline" id="next-page" disabled>Next</button>
      </div>

      <!-- Empty state (hidden by default) -->
      <div id="no-results" style="display:none;text-align:center;padding:var(--sp-12) 0;">
        <p style="color:var(--ink-muted);font-size:var(--text-lg);">No posts match that filter.</p>
        <button class="btn btn--outline" id="clear-filter" style="margin-top:var(--sp-4);">Show All Posts</button>
      </div>
    </div>
  </section>

  <hr class="divider" style="max-width:var(--max-width);margin:0 auto;" />

</BaseLayout>


<script>
  const filterBar = document.getElementById('tag-filters');
  const grid = document.getElementById('posts-grid');
  const noResults = document.getElementById('no-results');
  const clearBtn = document.getElementById('clear-filter');
  
  const paginationControls = document.getElementById('pagination-controls');
  const prevBtn = document.getElementById('prev-page');
  const nextBtn = document.getElementById('next-page');
  const pageInfo = document.getElementById('page-info');

  const ITEMS_PER_PAGE = 9;
  let currentPage = 1;
  let currentTag = 'all';

  function filterPosts() {
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.post-card'));
    let matchedCards: HTMLElement[] = [];

    // Filter cards
    cards.forEach((card) => {
      const cardType = card.dataset.type || '';
      if (currentTag === 'all' || cardType === currentTag) {
        matchedCards.push(card);
      } else {
        card.style.display = 'none';
      }
    });

    const totalPages = Math.ceil(matchedCards.length / ITEMS_PER_PAGE);
    
    // Ensure currentPage is valid
    if (currentPage > totalPages) currentPage = totalPages || 1;

    // Show/hide based on pagination
    const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
    const endIndex = startIndex + ITEMS_PER_PAGE;

    matchedCards.forEach((card, index) => {
      if (index >= startIndex && index < endIndex) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });

    // Update empty state
    if (noResults) {
      noResults.style.display = matchedCards.length === 0 ? '' : 'none';
    }

    // Update pagination UI
    if (paginationControls && prevBtn && nextBtn && pageInfo) {
      if (totalPages > 1) {
        paginationControls.style.display = 'flex';
        pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
        
        if (currentPage === 1) {
          prevBtn.setAttribute('disabled', 'true');
        } else {
          prevBtn.removeAttribute('disabled');
        }

        if (currentPage === totalPages) {
          nextBtn.setAttribute('disabled', 'true');
        } else {
          nextBtn.removeAttribute('disabled');
        }
      } else {
        paginationControls.style.display = 'none';
      }
    }
  }

  function setActiveButton(activeBtn: Element) {
    filterBar?.querySelectorAll('.filter-btn').forEach((b) => { b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false'); });
    activeBtn.classList.add('is-active');
    activeBtn.setAttribute('aria-pressed', 'true');
  }

  if (filterBar) {
    filterBar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.filter-btn');
      if (!btn) return;
      setActiveButton(btn);
      currentTag = btn.getAttribute('data-tag') || 'all';
      currentPage = 1; // Reset to page 1 on filter change
      filterPosts();
    });
  }

  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      const allBtn = filterBar?.querySelector('[data-tag="all"]');
      if (allBtn) setActiveButton(allBtn);
      currentTag = 'all';
      currentPage = 1;
      filterPosts();
    });
  }

  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        filterPosts();
        document.getElementById('latest-posts-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      currentPage++;
      filterPosts();
      document.getElementById('latest-posts-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  // Initial render
  filterPosts();
</script>
