---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionTag from '../../components/SectionTag.astro';
import { verifiedPatch } from '../../data/site-config';
const lastVerified = verifiedPatch('Patch 1.1.2.2'); // Bump: drop the arg ONLY after re-verifying this page's content in-game (CURRENT_PATCH is a ceiling, not an auto-bump)

const title = "Best OS Protocol Per Class: Build Guide";
const description = "The best OS Protocol for every class in Division Resurgence for Season 2 Phase 2, with primary and backup picks from creator builds and results.";

const breadcrumbs = [
  { name: 'Guides', url: '/guides/' },
  { name: 'Best OS Protocol', url: '/guides/best-os-protocol/' }
];

const classes = [
  {
    name: 'Vanguard',
    tagClass: 'tag--vanguard',
    primary: {
      name: 'Cover Shooter',
      spec: 'Firepower',
      slug: 'cover-shooter',
      explanation: 'Cover Shooter is the Season 2 creator pick for Commando damage. TikTokAndy switched his Double Barrel build to it in early October, soloed Precious Cargo on Legendary with it on October 6, and calls it second to none for PvE with that gun. It adds +15% Weapon Damage, and Critical Hits from behind cover have an 80% chance of granting +16% Weapon Critical Hit Damage, stacking 3 times. His October 27 Lightweight M4 build tries Explosive Round instead and took it to six stars on Lone Wolf floor 20, so aimers have a second option.'
    },
    backup: {
      name: 'Strategic Assistance',
      spec: 'Engineering',
      slug: 'strategic-assistance',
      explanation: 'For a support Vanguard, Strategic Assistance is our earlier pick: assists grant Signature Ability Charge Efficiency and reduce Skill Cooldown, which feeds Tactical Link and Scanning Pulse uptime. AgentHuntzman\'s Recon support build does the same cooldown job with Pressing Matter.'
    }
  },
  {
    name: 'Field Medic',
    tagClass: 'tag--medic',
    primary: {
      name: 'Brains Over Brawn',
      spec: 'Engineering',
      slug: 'brains-over-brawn',
      explanation: 'Brains Over Brawn is the pick on GGReborn\'s Season 2 Tactical Pharma build: Skill Critical Chance as the main stat, and hits deal extra damage equal to 24% of your Engineering. It\'s only a Specialized (blue) protocol, which is good news for your Phoenix Credits. In his October 23 Lone Wolf test, Chain Reaction, Collateral Damage and Tactical Persistence all finished within five seconds of it (Brains Over Brawn actually had the least time left of the four), so if you already own one of those, keep it.'
    },
    backup: {
      name: 'Medical Excellence',
      spec: 'Toughness',
      slug: 'medical-excellence',
      explanation: 'For a Combat Medicine healer, Medical Excellence: healing an ally above half Health gives the team extra healing equal to 5% Max Health, and healing one below half gives the target 12.5% Max Health. Nadie\'s tank-medic build runs Pummeling Shield instead, because a medic who can\'t die heals for longer.'
    }
  },
  {
    name: 'Bulwark',
    tagClass: 'tag--bulwark',
    primary: {
      name: 'Pummeling Shield',
      spec: 'Toughness',
      slug: 'pummeling-shield',
      explanation: 'Pummeling Shield is still the Bulwark protocol, and Nadie runs it on both of his creator builds here. While you have Extra Health, every 10 hits apply a stun, and at Max Health getting hit grants Extra Health equal to 2400% of your Firepower. Since the June 26, 2026 hotfix the stun lasts 1.5 seconds (down from 2) on a 10-second cooldown, so it interrupts instead of stun-locking, which is why it dropped from S to A on our tier list.'
    },
    backup: {
      name: 'Heavy Armor',
      spec: 'Toughness',
      slug: 'heavy-armor',
      explanation: 'Heavy Armor grants +14.4% Damage while you have Extra Health, and assists grant Extra Health worth 16% of Max Health, a solid option while you farm for Pummeling Shield. For DPS Breacher builds, Death From Afar converts Headshot Damage into Firepower (see Saiynergy\'s 334k DPS Breacher build).'
    }
  },
  {
    name: 'Demolitionist',
    tagClass: 'tag--demo',
    primary: {
      name: 'Surgical Engineering',
      spec: 'Engineering',
      slug: 'surgical-engineering',
      explanation: 'Surgical Engineering is our earlier pick: Skill Critical Hits have a 60% chance of granting +16% Skill Critical Damage for 10 seconds, stacking, so it pays off on a build that already stacks Skill Crit Chance. We haven\'t found a Season 2 creator result for Demolitionist yet, and PVE Enjoyer\'s pre-Season 2 Glass Cannon build runs Pressing Matter for cooldowns instead.'
    },
    backup: {
      name: 'Collateral Damage',
      spec: 'Engineering',
      slug: 'collateral-damage',
      explanation: 'Collateral Damage adds damage equal to 3000% Engineering to enemies within 5 meters of whatever your skills hit, on a 10-second cooldown. Pick this if you want AoE coverage rather than crit damage. It tied for second in GGReborn\'s October 23 test on a Tactical Pharma build, so the explosion math holds up.'
    }
  },
  {
    name: 'Tech Operator',
    tagClass: 'tag--tech',
    primary: {
      name: 'Recursive Treatment',
      spec: 'Engineering',
      slug: 'recursive-treatment',
      explanation: 'For an Aegis healer, Recursive Treatment is TikTokAndy\'s pick on his October 10 Aegis Team Healer build, his favorite PvE build right now. Healing or granting Extra Health grants +20% Skill Intensity, on top of an Engineering main stat, and an Aegis kit is built around healing.'
    },
    backup: {
      name: 'Brains Over Brawn',
      spec: 'Engineering',
      slug: 'brains-over-brawn',
      explanation: 'For skill-crit damage, Brains Over Brawn is the pick on LtFoe\'s and Tampishach\'s damage-focused Aegis builds (both from before Season 2). Offensive Operations drone builds have their own options: our Jackpot Striker Drone build runs Rampart, and Tactical Layering (+15% Engineering per skill deployment, up to 3 stacks) suits Striker Drone rotations.'
    }
  }
];

const faqs = [
  { question: "What is the best OS Protocol in Division Resurgence?", answer: "Going by Season 2 Phase 2 creator results, Brains Over Brawn and Cover Shooter, the two S picks on our OS Protocol tier list. Brains Over Brawn is on GGReborn's Season 2 Tactical Pharma build, and Cover Shooter is what TikTokAndy ran when he soloed Precious Cargo on Legendary with his Double Barrel Commando. The best one for you still depends on your class, which is what the picks above are for." },
  { question: "How do OS Protocols work in Division Resurgence?", answer: "OS Protocols are unique gear-talent items that slot into your Operating System loadout. Each provides a main stat, three sub-stats, and a unique Talent that triggers under specific combat conditions. Died Again Gaming points out that any agent level can equip any rarity; higher rarities just roll bigger stats and better talents." },
  { question: "How do you upgrade OS Protocols?", answer: "Two separate ways. Leveling raises the stats: you feed a protocol Algorithm Data from bounties and open-world activities, or spare protocols, and creator readings show level 50 doubling the percentage main stat, with on-screen readings in between that fit +10% of the base every five levels. Talent Upgrade raises the talent: you donate duplicates of the same protocol, and Ubisoft's published ladders climb in five steps of 20% of the base value, ending at double. Purple duplicates are far easier to find than gold ones, so a purple you can actually max is often the better bet." },
  { question: "What is the best OS Protocol for Vanguard?", answer: "For a Commando damage build, Cover Shooter (Firepower, High-End), TikTokAndy's Double Barrel pick since early October; his October 27 Lightweight M4 build runs Explosive Round instead. For team support, Strategic Assistance from our earlier ranking: its assists feed Signature Ability Charge Efficiency and Skill Cooldown reduction." },
  { question: "What is the best OS Protocol for Field Medic?", answer: "For Tactical Pharma, Brains Over Brawn (Engineering, Specialized), which GGReborn runs on his Season 2 build; Chain Reaction, Collateral Damage and Tactical Persistence finished within five seconds of it in his October 23 Lone Wolf test, all slightly ahead. For a Combat Medicine healer, Medical Excellence, while Nadie's tank medic runs Pummeling Shield." },
  { question: "What is the best OS Protocol for Bulwark?", answer: "Pummeling Shield (Toughness, High-End). The stun every 10 hits while you have Extra Health still defines the class. Since the June 26, 2026 hotfix the stun lasts 1.5 seconds and has a 10-second cooldown, so it's an interrupt, not a stun-lock." },
  { question: "What is the best OS Protocol for Demolitionist?", answer: "Surgical Engineering (Engineering, High-End), from our earlier ranking: a 60% chance of +16% Skill Critical Damage on Skill Crits. We haven't found a Season 2 creator result for Demolitionist yet." },
  { question: "What is the best OS Protocol for Tech Operator?", answer: "For an Aegis healer, Recursive Treatment, TikTokAndy's pick on his October Aegis Team Healer build. For skill-crit damage, Brains Over Brawn, the pick on two damage-focused Aegis builds from before Season 2. Offensive Operations drone builds run Rampart (our Jackpot Striker Drone) or Tactical Layering." },
];
---

<BaseLayout {title} {description} breadcrumbs={breadcrumbs} faqs={faqs}>
  <div class="container section">
    <Breadcrumbs items={breadcrumbs} />
    <SectionTag label="Guide" />
    <h1 class="heading-accent">Best OS Protocol Per Class</h1>
    <p style="color:var(--ink-muted);margin-bottom:var(--sp-3);">
      The right OS Protocol turns a good build into a great one. Here's a primary and backup protocol for every class in Division Resurgence, matched to our <a href="/tier-list/os-protocols/" style="color: var(--accent);">OS Protocol tier list</a> and the Season 2 creator builds behind it.
    </p>
    <p style="color:var(--ink-muted);margin-bottom:var(--sp-3);">
      <strong>Update (October 28, 2026):</strong> these picks now follow our <a href="/tier-list/os-protocols/" style="color: var(--accent);">OS Protocol tier list</a>, which ranks protocols from Season 2 Phase 2 creator results; our own last in-game check was {lastVerified}. Several protocols changed on paper since then (Applied Demolition, Pummeling Shield, Dominating Presence, Concerted Strike and Relentless Assault); of the picks on this page, only Pummeling Shield did, when the June 26 hotfix gave its stun a 10-second cooldown and cut it from 2s to 1.5s. Full values are on each protocol's <a href="/database/os-protocols/" style="color: var(--accent);">database page</a>.</p>

    <div style="display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: var(--text-xs); color: #6DAA45; background: rgba(109, 170, 69, 0.1); border: 1px solid rgba(109, 170, 69, 0.25); padding: 6px 14px; border-radius: 999px; margin-bottom: var(--sp-8); letter-spacing: 0.02em;">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      <span>Last verified for <strong>{lastVerified}</strong></span>
    </div>

    <!-- Class Sections -->
    <div class="class-sections">
      {classes.map((cls) => (
        <div class="class-section">
          <div class="class-section__header">
            <h2 class="class-section__name">{cls.name}</h2>
            <span class={`tag ${cls.tagClass}`}>{cls.name}</span>
          </div>

          <!-- Primary Pick -->
          <div class="protocol-pick protocol-pick--primary">
            <div class="protocol-pick__badge">Primary</div>
            <div class="protocol-pick__content">
              <h3 class="protocol-pick__name">
                <a href={`/database/os-protocols/#${cls.primary.slug}`}>{cls.primary.name}</a>
                <span class="protocol-pick__spec">{cls.primary.spec}</span>
              </h3>
              <p class="protocol-pick__explanation">{cls.primary.explanation}</p>
            </div>
          </div>

          <!-- Backup Pick -->
          <div class="protocol-pick protocol-pick--backup">
            <div class="protocol-pick__badge protocol-pick__badge--backup">Backup</div>
            <div class="protocol-pick__content">
              <h3 class="protocol-pick__name">
                <a href={`/database/os-protocols/#${cls.backup.slug}`}>{cls.backup.name}</a>
                <span class="protocol-pick__spec">{cls.backup.spec}</span>
              </h3>
              <p class="protocol-pick__explanation">{cls.backup.explanation}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- FAQ Section -->
    <div class="faq-section" style="margin-top: var(--sp-8);">
      <h2 style="font-family: var(--font-heading); font-size: var(--text-2xl); font-weight: 800; margin-bottom: var(--sp-4);">Frequently Asked Questions</h2>
      <div class="faq-list" style="display: flex; flex-direction: column; gap: var(--sp-2);">
        {faqs.map(faq => (
          <details class="faq-item">
            <summary class="faq-question">{faq.question}</summary>
            <p class="faq-answer">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>

    <!-- Related Links -->
    <div style="margin-top: var(--sp-8); padding-top: var(--sp-6); border-top: 1px solid rgba(255,255,255,0.08);">
      <h2 style="font-family: var(--font-heading); font-size: var(--text-xl); font-weight: 800; margin-bottom: var(--sp-4);">Related Resources</h2>
      <div class="related-links">
        <a href="/tier-list/os-protocols/" class="related-link">
          <span class="related-link__label">Tier List</span>
          <span class="related-link__title">OS Protocol Tier List</span>
          <span class="related-link__desc">Every protocol ranked S to C</span>
        </a>
        <a href="/database/os-protocols/" class="related-link">
          <span class="related-link__label">Database</span>
          <span class="related-link__title">OS Protocols Database</span>
          <span class="related-link__desc">Full stats, talents, and details</span>
        </a>
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .class-sections {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .class-section {
    background: linear-gradient(145deg, rgba(30,30,36,0.9) 0%, rgba(20,20,24,0.95) 100%);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }
  @media (max-width: 44.99em) {
    .class-section { padding: var(--sp-4); }
  }

  .class-section__header {
    display: flex;
    flex-wrap: wrap; /* the class tag drops under the name on narrow phones instead of sticking out */
    align-items: center;
    gap: var(--sp-2) var(--sp-3);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

  .class-section__name {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 800;
    margin: 0;
    color: #fff;
  }

  /* Protocol Picks */
  .protocol-pick {
    display: flex;
    gap: var(--sp-4);
    padding: var(--sp-5);
    border-radius: 10px;
    border: 1px solid rgba(242, 104, 34, 0.2);
    background: rgba(242, 104, 34, 0.04);
  }

  .protocol-pick--backup {
    border-color: rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.02);
  }

  .protocol-pick__badge {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    background: rgba(242, 104, 34, 0.12);
    border: 1px solid rgba(242, 104, 34, 0.25);
    padding: 4px 10px;
    border-radius: 999px;
    flex-shrink: 0;
    height: fit-content;
    white-space: nowrap;
  }

  .protocol-pick__badge--backup {
    color: var(--ink-muted);
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.12);
  }

  .protocol-pick__content {
    flex: 1;
    min-width: 0;
  }

  .protocol-pick__name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    margin: 0 0 var(--sp-2) 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
  }

  .protocol-pick__name a {
    color: #fff;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .protocol-pick__name a:hover {
    color: var(--accent);
  }

  .protocol-pick__spec {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #F5CC45;
    background: rgba(245, 204, 69, 0.1);
    border: 1px solid rgba(245, 204, 69, 0.25);
    padding: 2px 8px;
    border-radius: 999px;
  }

  /* the reasoning is the content people came for: body size */
  .protocol-pick__explanation {
    font-size: var(--step-0);
    line-height: var(--lh-body);
    color: #b8b8c0;
    margin: 0;
  }

  /* Related Links */
  .related-links {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-3);
  }

  @media (min-width: 45em) {
    .related-links {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .related-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--sp-5);
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    text-decoration: none;
    transition: all 200ms ease;
  }

  .related-link:hover {
    border-color: rgba(242, 104, 34, 0.4);
    background: rgba(242, 104, 34, 0.04);
    transform: translateY(-2px);
  }

  .related-link__label {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .related-link__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    color: #fff;
  }

  .related-link__desc {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  @media (max-width: 44.99em) {
    .protocol-pick {
      flex-direction: column;
      gap: var(--sp-3);
    }
  }
</style>
