---
import GuideLayout from '../../layouts/GuideLayout.astro';
import { getCollection, render } from 'astro:content';
import { allTranslations, versionsOf, alternatesOf } from '../../utils/translations';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  const translations = await allTranslations();
  return guides.map((guide) => ({
    params: { slug: guide.id },
    // English first, then every translation of this guide (TRANSLATIONS.md)
    props: { guide, versions: versionsOf(guide.id, translations) },
  }));
}

const { guide, versions } = Astro.props;
const { Content, headings } = await render(guide);
const wordCount = guide.body ? guide.body.replace(/<[^>]+>/g, ' ').trim().split(/\s+/).filter(Boolean).length : 0;
---

<GuideLayout
  title={guide.data.title}
  description={guide.data.description}
  category={guide.data.category}
  lastUpdated={guide.data.lastUpdated}
  publishDate={guide.data.publishDate}
  tags={guide.data.tags}
  author={guide.data.author}
  featuredImage={guide.data.featuredImage}
  imageAlt={guide.data.imageAlt}
  shareTitle={guide.data.shareTitle}
  shareText={guide.data.shareText}
  headings={headings}
  faqs={guide.data.faqs || []}
  sources={guide.data.sources || []}
  howTo={guide.data.howTo}
  videoId={guide.data.videoId}
  videoTitle={guide.data.videoTitle}
  videoChannel={guide.data.videoChannel}
  videoChannelUrl={guide.data.videoChannelUrl}
  videoUploadDate={guide.data.videoUploadDate}
  videoDuration={guide.data.videoDuration}
  wordCount={wordCount}
  versions={versions}
  alternates={versions.length > 1 ? alternatesOf(versions) : undefined}
>
  <Content />
</GuideLayout>
