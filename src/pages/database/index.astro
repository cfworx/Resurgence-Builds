---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionTag from '../../components/SectionTag.astro';
import AdSenseUnit from '../../components/AdSenseUnit.astro';

import osProtocols from '../../data/os-protocols.json';
import skillModCombos from '../../data/skill-mod-combos.json';
import weaponTalents from '../../data/weapon-talents.json';
import standardWeapons from '../../data/standard-weapons.json';
import backpackTalents from '../../data/backpack-talents.json';
import bodyArmorTalents from '../../data/body-armor-talents.json';
import bonusAttributes from '../../data/bonus-attributes.json';
import gearSetEffects from '../../data/gear-set-effects.json';
import exoticWeapons from '../../data/exotic-weapons.json';
import dropRates from '../../data/drop-rates.json';
import { verifiedPatch } from '../../data/site-config';
const lastVerified = verifiedPatch('Patch 1.1.2.2'); // Bump: drop the arg ONLY after re-verifying this page's content in-game (CURRENT_PATCH is a ceiling, not an auto-bump)

const title = "The Division Resurgence Database";
const description = `Division Resurgence database: OS Protocols, weapons, gear sets, talents, skill mods and bonus attributes, updated for the Season 2 Phase 2 patch notes.`;

const breadcrumbs = [
  { name: 'Database', url: '/database/' }
];

const sections = [
  {
    title: 'OS Protocols',
    href: '/database/os-protocols/',
    count: osProtocols.length,
    description: 'Every OS Protocol in the game with stats, talents, and build recommendations. Your sixth gear slot.',
    icon: 'chip',
    color: '#F5CC45',
  },
  {
    title: 'Skill Mod Combos',
    href: '/database/skill-mod-combos/',
    count: skillModCombos.length,
    description: 'Firmware set bonuses for every skill. Stack the right mods and your skills hit twice as hard.',
    icon: 'layers',
    color: '#3b82f6',
  },
  {
    title: 'Weapon Talents',
    href: '/database/weapon-talents/',
    count: weaponTalents.length,
    description: 'Every weapon talent with proc conditions, damage values, and which builds they fit.',
    icon: 'bolt',
    color: '#ef4444',
  },
  {
    title: 'Weapons',
    href: '/database/weapons/',
    count: standardWeapons.length,
    description: 'Standard weapon stats: RPM, magazine and talents. ARs, SMGs, LMGs, MMRs, rifles and shotguns.',
    icon: 'crosshair',
    color: '#F26822',
  },
  {
    title: 'Backpack Talents',
    href: '/database/backpack-talents/',
    count: backpackTalents.length,
    description: 'Backpack talent breakdowns with tier comparisons and recommended gear set pairings.',
    icon: 'backpack',
    color: '#6DAA45',
  },
  {
    title: 'Body Armor Talents',
    href: '/database/body-armor-talents/',
    count: bodyArmorTalents.length,
    description: 'Body Armor piece talents ranked by archetype. Toymaker, Glass Cannon, Deep Focus, and more.',
    icon: 'shield',
    color: '#a855f7',
  },
  {
    title: 'Bonus Attributes',
    href: '/database/bonus-attributes/',
    count: bonusAttributes.length,
    description: 'Every bonus attribute that can roll on gear. Know what to chase and what to trash.',
    icon: 'sliders',
    color: '#14b8a6',
  },
  {
    title: 'Gear Set Effects',
    href: '/database/gear-set-effects/',
    count: gearSetEffects.length,
    description: 'Full breakdown of every gear set: 2pc through 4pc bonuses and best-in-slot combinations.',
    icon: 'grid',
    color: '#f59e0b',
  },
  {
    title: 'Exotic Weapons',
    href: '/database/exotic-weapons/',
    count: exoticWeapons.length,
    description: 'Every exotic weapon with unique talents, stat ranges, and how to farm each one.',
    icon: 'star',
    color: '#F26822',
  },
  {
    title: 'Official Drop Rates',
    href: '/database/drop-rates/',
    count: dropRates.caches.length,
    description: "Ubisoft's own sealed cache odds: every cache, every item, every pity timer. Including the mystery exotic.",
    icon: 'dice',
    color: '#22d3ee',
  },
];

const ICON_SVG: Record<string, string> = {
  chip: '<rect x="7" y="7" width="10" height="10" rx="1"/><path d="M9 3v4M15 3v4M9 17v4M15 17v4M3 9h4M3 15h4M17 9h4M17 15h4"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/>',
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
  crosshair: '<circle cx="12" cy="12" r="8"/><path d="M12 2v5M12 17v5M2 12h5M17 12h5"/>',
  backpack: '<path d="M6 8a6 6 0 0 1 12 0v12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2M9 14h6"/>',
  shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>',
  sliders: '<path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/>',
  grid: '<rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/>',
  star: '<path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.9l-5.4 2.6 1.2-6-4.5-4.2 6.1-.7z"/>',
  dice: '<rect x="4" y="4" width="16" height="16" rx="3"/><circle cx="9" cy="9" r="1.2"/><circle cx="15" cy="15" r="1.2"/><circle cx="15" cy="9" r="1.2"/><circle cx="9" cy="15" r="1.2"/>',
};

const totalItems = sections.reduce((sum, s) => sum + s.count, 0);

const faqs = [
  {
    question: "How is the Resurgence Builds database different from a wiki?",
    answer: "We actually open the tooltips. Every entry was checked in-game for the patch on its 'Last verified' stamp, and when Ubisoft's official patch notes change a number after that (Season 1 Phase 3 through Season 2 Phase 2 so far), we update it from the notes and flag the change on the entry instead of pretending we re-tested it. We don't copy-paste data mines or rely on beta information that's been wrong for six months."
  },
  {
    question: "How often is the database updated?",
    answer: "Less often than our old FAQ bragged. The site went quiet after July 4, 2026, and the October 2026 refresh applied the official changes from Season 1 Phase 3 through Season 2 Phase 2 that touch our entries, straight from Ubisoft's patch notes. Every page keeps its 'Last verified for Patch X.X.X' stamp so you know when we last checked it in-game, and entries a later patch changed carry a note saying so."
  },
  {
    question: "Can I use this database with the Build Planner?",
    answer: "Absolutely. The database and the Build Planner are designed to work together. Look up your gear set bonuses here, plan your attribute priorities, then hop into the Build Planner at /builder/ to see the full loadout come together."
  },
];

const siteUrl = 'https://resurgencebuilds.com';
const articleLd = {
  '@type': 'Article',
  headline: title,
  description: description,
  url: `${siteUrl}/database/`,
  author: { '@type': 'Person', '@id': `${siteUrl}/author/rapidf5/#person`, name: 'RapidF5' },
  publisher: { '@type': 'Organization', '@id': `${siteUrl}/#organization`, name: 'Resurgence Builds' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${siteUrl}/database/` },
  datePublished: '2026-05-30',
  dateModified: '2026-10-24',
};
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} jsonLd={articleLd} faqs={faqs}>
  <div class="container section">
    <Breadcrumbs items={breadcrumbs} />
    <SectionTag label="Database" />
    <h1 class="heading-accent" style="font-size: var(--text-4xl); margin-bottom: var(--sp-3);">The Division Resurgence Database</h1>

    <div style="display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: var(--text-xs); color: #6DAA45; background: rgba(109, 170, 69, 0.1); border: 1px solid rgba(109, 170, 69, 0.25); padding: 6px 14px; border-radius: 999px; margin-bottom: var(--sp-6); letter-spacing: 0.02em;">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      <span>Last verified for <strong>{lastVerified}</strong> · {totalItems} entries</span>
    </div>

    <p style="color: var(--ink-muted); margin-bottom: var(--sp-8); font-size: var(--text-base); max-width: var(--measure); line-height: 1.7;">
      Every stat, talent, and gear set bonus in Division Resurgence, checked in-game for the patch on each page's stamp. This isn't a data mine dump from six months ago. When Ubisoft's official patch notes changed a value later (Season 1 Phase 3 through Season 2 Phase 2), we updated it from those notes and flagged it on the entry. Use it to plan your loadouts, check talent interactions, and stop guessing whether that Reddit post from March is still accurate. Spoiler: it's not.
    </p>

    <div class="db-index-grid">
      {sections.map(section => (
        <a href={section.href} class="db-index-card">
          <div class="db-index-card__icon" style={`color: ${section.color}; border-color: ${section.color};`}>
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON_SVG[section.icon] || ICON_SVG.grid}></svg>
          </div>
          <div class="db-index-card__body">
            <div style="display: flex; align-items: baseline; gap: var(--sp-2); margin-bottom: var(--sp-1);">
              <h2 class="db-index-card__title">{section.title}</h2>
              <span class="db-index-card__count" style={`color: ${section.color};`}>{section.count}</span>
            </div>
            <p class="db-index-card__desc">{section.description}</p>
          </div>
          <span class="db-index-card__arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>

    <AdSenseUnit label="Advertisement (database)" />

    {faqs && faqs.length > 0 && (
      <div class="faq-section" style="margin-top: var(--sp-8);">
        <h2 style="font-family: var(--font-heading); font-size: var(--text-2xl); font-weight: 800; margin-bottom: var(--sp-4);">Frequently Asked Questions</h2>
        <div class="faq-list" style="display: flex; flex-direction: column; gap: var(--sp-2);">
          {faqs.map(faq => (
            <details class="faq-item">
              <summary class="faq-question">{faq.question}</summary>
              <p class="faq-answer">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .db-index-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
    margin-bottom: var(--sp-8);
  }

  @media (min-width: 45em) {
    .db-index-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 60em) {
    .db-index-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .db-index-card {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-5);
    background: linear-gradient(145deg, rgba(30,30,36,0.9) 0%, rgba(20,20,24,0.95) 100%);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .db-index-card::before {
    content: '';
    position: absolute;
    top: 0; left: 10%; right: 10%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: 0 0 4px 4px;
  }

  .db-index-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.5), 0 0 25px rgba(242, 104, 34, 0.1);
    border-color: rgba(242, 104, 34, 0.3);
  }

  .db-index-card:hover::before { opacity: 1; }

  .db-index-card__icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    border-radius: 12px;
    background: rgba(0,0,0,0.3);
    border: 1px solid;
    flex-shrink: 0;
  }

  .db-index-card__body {
    flex: 1;
    min-width: 0;
  }

  .db-index-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 800;
    color: #fff;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .db-index-card__count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .db-index-card__desc {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .db-index-card__arrow {
    font-size: var(--text-xl);
    color: var(--ink-muted);
    transition: color 0.2s, transform 0.2s;
    flex-shrink: 0;
  }

  .db-index-card:hover .db-index-card__arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  /* FAQ styles live in global.css */
</style>
