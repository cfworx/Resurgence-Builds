---
import DatabaseLayout from '../../../layouts/DatabaseLayout.astro';
import WeaponAttributes from '../../../components/WeaponAttributes.astro';
import allStandardWeapons from '../../../data/standard-weapons.json';
// Every standard weapon is listed with its class, Armory tier and damage type (from the in-game Armory,
// October 28, 2026), and each one has its own page with the talents it can roll (October 29, 2026).
const TIER_ORDER: Record<string, number> = { T0: 0, T1: 1, T2: 2 };
const standardWeapons = [...allStandardWeapons].sort((a: any, b: any) =>
  (TIER_ORDER[a.armoryTier] ?? 9) - (TIER_ORDER[b.armoryTier] ?? 9) || a.name.localeCompare(b.name));
const hasPage = (_w: any) => true;
const tierLabel = (t: string) => (t ? `Tier ${t.slice(1)}` : '');
const typeCount = (t: string) => allStandardWeapons.filter((w: any) => w.type === t).length;
import allExoticWeapons from '../../../data/exotic-weapons.json';
// Exotics with unverified stat lines (statsVerified: false) are in the planner only, not the database.
const exoticWeapons = allExoticWeapons.filter((w: any) => w.statsVerified !== false);
import AdSenseUnit from '../../../components/AdSenseUnit.astro';
import GameImage from '../../../components/GameImage.astro';
import { dbImage } from '../../../utils/db-images';
import { publicImageSize } from '../../../utils/image-dims.mjs';
const exoticHero = (w: any) => dbImage(`exotic-weapons/${w.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`, 'hero');
// Each standard weapon's own in-game icon (its High-End tile in the talent Source lists).
const weaponIcon = (w: any) => dbImage(`weapon-icons/${w.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`);
const imgSize = (src: string) => publicImageSize(src) ?? { width: 1200, height: 571 };

const breadcrumbs = [
  { name: 'Database', url: '/database/' },
  { name: 'Weapons', url: '/database/weapons/' }
];

const title = "All Weapons: Division Resurgence Database";
const description = `All ${allStandardWeapons.length} standard Division Resurgence weapons by class, Armory tier and damage type, checked in the in-game Armory, plus the six exotics.`;

// Group by type
const TYPE_ORDER = ['Assault Rifle', 'SMG', 'LMG', 'Marksman Rifle', 'Rifle', 'Shotgun'];
const types = [...TYPE_ORDER.filter((t) => standardWeapons.some((w: any) => w.type === t)), ...[...new Set(standardWeapons.map((w: any) => w.type))].filter((t: any) => !TYPE_ORDER.includes(t))];

const faqs = [
  { question: "How many weapons are in Division Resurgence?", answer: `The in-game Armory lists ${allStandardWeapons.length} standard weapons in six classes: ${typeCount('Assault Rifle')} assault rifles, ${typeCount('SMG')} SMGs, ${typeCount('LMG')} LMGs, ${typeCount('Marksman Rifle')} marksman rifles, ${typeCount('Rifle')} rifles and ${typeCount('Shotgun')} shotguns, spread over three pages (Season 1, Tiers 0, 1 and 2). On top of those come the six exotics. We checked the whole Armory on October 28, 2026.` },
  { question: "What damage type does each weapon deal in Division Resurgence?", answer: "Every gun deals one of three damage types, Blast, Piercing or Shredding, and the Armory shows it as an icon next to the weapon's name. Each card on this page carries the type from that icon. Match it to the colored bar above an elite's health: our damage types guide explains which color wants which type." },
  { question: "What is the best weapon type in Division Resurgence?", answer: "Assault Rifles are the most versatile: good range, solid DPS, forgiving magazine sizes. SMGs dominate at close range, especially in Dark Zone PvP. LMGs are the sustained DPS kings for PvE. Marksman Rifles reward headshot accuracy with massive burst damage. There's no single best type, it depends on your range, your build, and honestly, what feels good in your hands." },
  { question: "How do weapon stats work in Division Resurgence?", answer: "Every weapon has base stats for Damage, RPM (rate of fire), Magazine size, Accuracy, Stability, Reload Speed, Optimal Range, and Movement Speed. These stats are fixed per weapon model but can be modified by weapon mods and attachments. The damage number scales with your Firepower core attribute and any weapon damage bonuses from gear." },
];
---

<DatabaseLayout
  {title}
  {description}
  {breadcrumbs}
  heading="All Weapons"
  subheading={`All ${allStandardWeapons.length} standard weapons and the six exotics, with the class, tier and damage type the in-game Armory shows for each (checked October 28, 2026). Stats where we have them.`}
  {faqs}
>
  <div class="db-filters">
    <div class="filter-group">
      <span class="filter-label">Category:</span>
      <div class="filter-bar" id="weapon-filters">
        <button class="filter-btn is-active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="exotic">Exotic</button>
        {types.map((type: string) => (
          <button class="filter-btn" data-filter={type.toLowerCase()}>{type}</button>
        ))}
      </div>
    </div>
  </div>

  {exoticWeapons && exoticWeapons.length > 0 && (
    <div class="weapon-category" data-category="exotic" style="margin-bottom: var(--sp-10);">
      <h2 style="font-family: var(--font-heading); font-size: var(--text-2xl); font-weight: 800; color: #ff5100; margin-bottom: var(--sp-4);">Exotics</h2>
      <div class="db-grid">
        {exoticWeapons.map((w: any, i: number) => (
            <article class="db-card exotic-card">
              <a href={`/database/exotic-weapons/${w.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}/`} class="db-card-full-link" aria-label={`View ${w.name} exotic weapon details`}></a>
              {exoticHero(w) && (
                <div class="db-card__image-banner exotic-thumb">
                  <GameImage
                    image={exoticHero(w)!}
                    alt={`${w.name}, exotic ${w.type} in The Division Resurgence, on its in-game card`}
                    sizes="(max-width: 640px) calc(100vw - 64px), 360px"
                    eager={i < 3}
                  />
                </div>
              )}
              <div class="db-card__header">
                <div>
                  <h2 class="db-card__title" style="color: #ff5100;">{w.name}</h2>
                  <div style="display:flex;gap:var(--sp-2);flex-wrap:wrap;margin-top:var(--sp-2);">
                    <span class="weapon-type tag" style="background: rgba(255,81,0,0.1); border: 1px solid rgba(255,81,0,0.3); color: #ff5100; padding: 2px 8px; border-radius: 4px; font-size: var(--step--2); font-weight: 800; text-transform: uppercase;">{w.type}</span>
                  </div>
                </div>
              </div>
              
              <div class="db-card__body">
                <div class="db-card__talent" style="border-left-color: #ff5100;">
                  <strong style="color: #ff5100;">{w.talentName}:</strong> {w.talentDescription}
                </div>
                
                <WeaponAttributes 
                  accuracy={w.accuracy} 
                  reloadSpeed={w.reloadSpeed} 
                  optimalRange={w.optimalRange} 
                  movementSpeed={w.movementSpeed} 
                  stability={w.stability} 
                  isCard={true}
                />
                
                <ul class="attr-list" style="margin-top: auto;">
                  <li><span>Damage</span><span>{w.damage}</span></li>
                  <li><span>RPM</span><span>{w.rpm}</span></li>
                  <li><span>MAG</span><span>{w.mag}</span></li>
                </ul>
              </div>
            </article>
        ))}
      </div>
    </div>
  )}

  {types.map((type: string) => (
    <div class="weapon-category" data-category={type.toLowerCase()} style="margin-bottom: var(--sp-10);">
      <h2 style="font-family: var(--font-heading); font-size: var(--text-xl); font-weight: 800; color: var(--accent); margin-bottom: var(--sp-4);">{type}s</h2>
      <div class="db-grid">
        {standardWeapons.filter((w: any) => w.type === type).map((w: any) => {
          const slug = w.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
          const hasStats = [w.rpm, w.mag, w.accuracy, w.reloadSpeed, w.stability].some(Boolean);
          const hasTalents = false;
          return (
            <article class={`db-card weapon-card${!hasStats && !hasTalents ? ' weapon-card--compact' : ''}${hasPage(w) ? '' : ' weapon-card--nolink'}`}>
              {hasPage(w) && <a href={`/database/weapons/${slug}/`} class="db-card-full-link" aria-label={`View ${w.name} weapon details`}></a>}
              {weaponIcon(w) ? (
                <div class="db-card__image-banner">
                  <GameImage image={weaponIcon(w)!} alt={`${w.name} ${w.type} icon in The Division Resurgence`} sizes="(max-width: 640px) calc(100vw - 64px), 330px" />
                </div>
              ) : w.image && (
                <div class="db-card__image-banner">
                  <img src={w.image} alt={`${w.name} ${w.type} in Division Resurgence`} width={imgSize(w.image).width} height={imgSize(w.image).height} loading="lazy" decoding="async" />
                </div>
              )}
              <div class="db-card__header">
                <div>
                  <h2 class="db-card__title" style="color: #fff;">{w.name}</h2>
                  <div class="weapon-tags">
                    <span class="weapon-type tag">{w.type}</span>
                    {w.armoryTier && <span class="weapon-tier tag">{tierLabel(w.armoryTier)}</span>}
                    {w.dmgType && <span class={`weapon-dmg tag weapon-dmg--${w.dmgType.toLowerCase()}`}>{w.dmgType}</span>}
                  </div>
                </div>
              </div>
              {(hasStats || hasTalents) && (
                <div class="db-card__body" style="justify-content: flex-end;">
                  {hasStats && (
                    <WeaponAttributes
                      rpm={w.rpm}
                      mag={w.mag}
                      accuracy={w.accuracy}
                      reloadSpeed={w.reloadSpeed}
                      stability={w.stability}
                      isCard={true}
                    />
                  )}
                </div>
              )}
            </article>
          );
        })}
      </div>
    </div>
  ))}

  <div class="load-more-wrap" id="load-more-wrap">
    <button class="load-more-btn" id="load-more-weapons" type="button">
      Load More Weapons
    </button>
    <p class="load-more-count" id="load-more-count"></p>
  </div>

  <AdSenseUnit label="Advertisement (database category)" />
</DatabaseLayout>

<script>
  const filterBar = document.getElementById('weapon-filters');
  const categories = document.querySelectorAll('.weapon-category');
  const allCards = document.querySelectorAll('.db-card');
  const loadMoreBtn = document.getElementById('load-more-weapons');
  const loadMoreWrap = document.getElementById('load-more-wrap');
  const loadMoreCount = document.getElementById('load-more-count');
  const BATCH = 20;
  let shown = BATCH;
  let activeFilter = 'all';

  function updateLoadMore() {
    if (activeFilter !== 'all') {
      // When filtering by category, show all cards in that category
      if (loadMoreWrap) (loadMoreWrap as HTMLElement).style.display = 'none';
      return;
    }
    const total = allCards.length;
    // Hide cards beyond the shown count
    allCards.forEach((card, i) => {
      (card as HTMLElement).style.display = i < shown ? '' : 'none';
    });
    // Also hide empty category headers
    categories.forEach(cat => {
      const visibleCards = cat.querySelectorAll('.db-card:not([style*="display: none"])');
      (cat as HTMLElement).style.display = visibleCards.length > 0 ? '' : 'none';
    });
    if (loadMoreWrap) {
      (loadMoreWrap as HTMLElement).style.display = shown >= total ? 'none' : '';
    }
    if (loadMoreCount) {
      loadMoreCount.textContent = `Showing ${Math.min(shown, total)} of ${total} weapons`;
    }
  }

  // Initial hide
  updateLoadMore();

  loadMoreBtn?.addEventListener('click', () => {
    shown = Math.min(shown + BATCH, allCards.length);
    updateLoadMore();
  });

  if (filterBar) {
    filterBar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.filter-btn');
      if (!btn) return;

      const filterId = btn.getAttribute('data-filter') || 'all';
      activeFilter = filterId;

      filterBar.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      if (filterId === 'all') {
        // Re-apply load more pagination
        shown = BATCH;
        categories.forEach(el => (el as HTMLElement).style.display = '');
        allCards.forEach(card => (card as HTMLElement).style.display = '');
        updateLoadMore();
      } else {
        // Show all cards in the filtered category, hide others
        allCards.forEach(card => (card as HTMLElement).style.display = '');
        categories.forEach(el => {
          const cat = (el as HTMLElement).getAttribute('data-category');
          (el as HTMLElement).style.display = (cat === filterId) ? '' : 'none';
        });
        if (loadMoreWrap) (loadMoreWrap as HTMLElement).style.display = 'none';
      }
    });
  }
</script>

<style is:global>
  .db-card__image-banner {
    width: 100%;
    overflow: hidden;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.06);
    background: rgba(0,0,0,0.3);
    margin-bottom: var(--sp-4);
  }
  .db-card__image-banner img {
    display: block;
    width: 100%;
    height: auto;
  }
  .db-card-full-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Standard weapon tags: class, Armory tier and damage type */
  .weapon-tags { display: flex; gap: var(--sp-2); flex-wrap: wrap; margin-top: var(--sp-2); }
  .weapon-tags .tag {
    padding: 2px 8px;
    border-radius: 4px;
    font-size: var(--step--2);
    font-weight: 800;
    text-transform: uppercase;
    color: #fff;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
  }
  .weapon-tags .weapon-tier { color: #c8c8d0; background: transparent; }
  .weapon-tags .weapon-dmg--blast { color: #f6896a; border-color: rgba(246,137,106,0.45); background: rgba(246,137,106,0.1); }
  .weapon-tags .weapon-dmg--piercing { color: #9fb0ff; border-color: rgba(159,176,255,0.45); background: rgba(159,176,255,0.1); }
  .weapon-tags .weapon-dmg--shredding { color: #8fd79f; border-color: rgba(143,215,159,0.45); background: rgba(143,215,159,0.1); }
  .weapon-card { align-self: start; }
  .weapon-card--compact .db-card__header { padding-bottom: 0; border-bottom: 0; }
  .weapon-card--nolink:hover { transform: none; box-shadow: none; border-color: rgba(255,255,255,0.08); }
  .weapon-card--nolink:hover::before { opacity: 0; }

  /* Load More button */
  .load-more-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-8) 0;
  }
  .load-more-btn {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0 32px;
    min-height: var(--control-lg); /* 48px, like the site's other main buttons */
    display: inline-flex;
    align-items: center;
    background: rgba(242, 104, 34, 0.12);
    border: 1px solid rgba(242, 104, 34, 0.4);
    border-radius: 8px;
    color: var(--accent);
    cursor: pointer;
    transition: all 200ms ease;
  }
  .load-more-btn:hover {
    background: rgba(242, 104, 34, 0.22);
    border-color: var(--accent);
    box-shadow: 0 0 16px rgba(242, 104, 34, 0.2);
  }
  .load-more-count {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    margin: 0;
  }
</style>
