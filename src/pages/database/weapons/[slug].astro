---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionTag from '../../../components/SectionTag.astro';
import WeaponAttributes from '../../../components/WeaponAttributes.astro';
import RandomizedAttributes from '../../../components/RandomizedAttributes.astro';
import WeaponTalentsGrid from '../../../components/WeaponTalentsGrid.astro';
import AdSenseUnit from '../../../components/AdSenseUnit.astro';
import { truncateDesc, metaDescription } from '../../../utils/seo';
import standardWeapons from '../../../data/standard-weapons.json';
import DbItemExtras from '../../../components/DbItemExtras.astro';
import DbFaq from '../../../components/DbFaq.astro';
import { verifiedPatch, DATABASE_UPDATED } from '../../../data/site-config';
import GameImage from '../../../components/GameImage.astro';
import { dbImage, dbImageNames, armoryScreenId, imageObject, CARDS_RECORDED } from '../../../utils/db-images';
import { publicImageSize } from '../../../utils/image-dims.mjs';
const lastVerified = verifiedPatch('Patch 1.1.2.2'); // Bump: drop the arg ONLY after re-verifying this page's content in-game (CURRENT_PATCH is a ceiling, not an auto-bump)

export function getStaticPaths() {
  // Weapons with statsVerified: false are in the build planner only.
  return standardWeapons.filter((w: any) => w.statsVerified !== false).map((weapon: any) => ({
    params: {
      slug: weapon.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
    },
    props: { weapon }
  }));
}

const { weapon } = Astro.props;
// "an SMG", "an LMG", "an Assault Rifle", "a Shotgun"
const typeArticle = /^(SMG|LMG|[AEIOU])/.test(weapon.type) ? 'an' : 'a';

const slug = weapon.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
// The Armory screen this weapon sits on (its class and tier), from the Oct 28 recordings.
const armoryId = armoryScreenId(weapon.type, weapon.armoryTier);
const armoryImage = armoryId ? dbImage(armoryId) : undefined;
const armoryNames = armoryId ? dbImageNames(armoryId) : [];
const weaponImageSize = weapon.image ? publicImageSize(weapon.image) : null;
const siteUrl = 'https://resurgencebuilds.com';

const title = `${weapon.name}: Division Resurgence ${weapon.type}`;
const description = metaDescription(weapon.summary, `${weapon.name} in The Division Resurgence: ${weapon.type} stats, best talents and builds, and how to farm it.`);

const breadcrumbs = [
  { name: 'Weapons', url: '/database/weapons/' },
  { name: weapon.name, url: '#' }
];

const typeGuide: Record<string, string> = {
  'Assault Rifle': 'ARs are the jack-of-all-trades in Division Resurgence: good damage, good RPM, good range. If you just want one gun that works everywhere without thinking too hard, this is it. Most meta builds run an AR primary for a reason.',
  'SMG': 'SMGs are for players who like getting in people\'s faces. You give up range for high RPM, which makes them strong in Dark Zone PvP and aggressive PvE runs, and they are the most common secondary in our creator builds. If you\'re not pushing forward, you\'re wasting the gun.',
  'LMG': 'LMGs let you hold the trigger and just keep shooting. Big magazines mean on-hit talents keep stacking without a reload break. Great for solo and group PvE: you become the team\'s damage printer.',
  'Marksman Rifle': 'Marksman Rifles trade fire rate for heavy single shots, so they reward players who land headshots. They pair with sniper-minded OS Protocols like Death From Afar.',
  'Shotgun': 'Shotguns delete people up close. TikTokAndy\'s Double Barrel build runs one as the star of a Vanguard Commando loadout: walk up, blast, repeat. Not subtle, but extremely effective.',

};

const typeDesc = typeGuide[weapon.type] || `${weapon.type}s are a weapon category in Division Resurgence offering unique playstyle options depending on your build and specialization.`;

// Weapon Attributes box only renders with 4+ populated stats (avoids near-empty stat boxes).
const attributeStats = [weapon.rpm, weapon.mag, weapon.accuracy, weapon.reloadSpeed, weapon.stability];
const populatedStatCount = attributeStats.filter((v: any) => v !== undefined && v !== null && v !== '').length;

// dmgType and armoryTier come from the in-game Armory (our screen recording, October 28, 2026): the damage type
// is the icon next to the weapon's name, the tier is the Armory page it sits on (Season 1, Tier 0, 1 or 2).
const knownDmgType: string | null = weapon.dmgType && weapon.dmgType !== 'Physical' ? weapon.dmgType : null;
const armoryTier: string | null = /^T[012]$/.test(weapon.armoryTier || '') ? weapon.armoryTier : null;

// Recommended bonus attributes, deduplicated by name (SMGs otherwise listed Crit Damage twice).
type RecAttr = { name: string; note: string; accent?: boolean };
const recommendedAttrsRaw: RecAttr[] = [
  { name: 'All Weapon Damage', note: "Season 2 Phase 1 removed the Blast, Shredding and Piercing damage bonuses from weapon rolls in favor of All Weapon Damage, so this is the flat damage stat to chase now.", accent: true },
  weapon.type === 'Marksman Rifle'
    ? { name: 'Headshot Damage', note: 'MMRs live on headshots, so this is the stat that pays off on every precise shot.' }
    : { name: 'Crit Chance', note: 'Usually the first damage stat creators build. TikTokAndy\'s sheet with his Lightweight M4 equipped shows 51%, and it climbs to 90% with Pulse and Tactical Link active, so count your buffs before you over-invest.' },
  { name: 'Crit Damage', note: 'After Crit Chance is healthy, stack Crit Damage for bigger crits.' },
  { name: 'Damage to Elites', note: 'For PvE, this stat is a flat multiplier on every named and elite enemy.' },
];
const seenAttrs = new Set<string>();
const recommendedAttrs = recommendedAttrsRaw.filter(a => !seenAttrs.has(a.name) && !!seenAttrs.add(a.name));

const faqs = [
  {
    question: `Is the ${weapon.name} good in Division Resurgence?`,
    answer: `The ${weapon.name} is ${typeArticle} ${weapon.type}${weapon.rpm && weapon.mag ? ` with ${weapon.rpm} RPM and a ${weapon.mag}-round mag` : ''}${knownDmgType ? `, dealing ${knownDmgType} damage` : ''}. ${typeDesc.split('.')[0]}. How good it actually is depends on what weapon talents you roll and how well it fits your gear set combo.`
  },
  {
    question: `What type of damage does the ${weapon.name} do?`,
    answer: knownDmgType
      ? `${knownDmgType} damage. Enemies with a matching color bar take more of it, which still matters even though Season 2 Phase 1 removed damage-type bonus rolls from weapons.`
      : `Check the weapon's details in the Armory: Resurgence weapons deal Blast, Shredding or Piercing damage, and we have not confirmed which one this weapon uses yet. Matching it to the enemy's color bar still matters, even though Season 2 Phase 1 removed damage-type bonus rolls from weapons.`
  },
  {
    question: `What builds use ${weapon.type}s in Division Resurgence?`,
    answer: typeDesc
  }
];

const weaponLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: `${siteUrl}/database/weapons/${slug}/`,
  author: { '@type': 'Person', '@id': `${siteUrl}/author/rapidf5/#person`, name: 'RapidF5' },
  publisher: { '@type': 'Organization', '@id': `${siteUrl}/#organization`, name: 'Resurgence Builds' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${siteUrl}/database/weapons/${slug}/` },
  datePublished: '2026-05-30',
  dateModified: DATABASE_UPDATED,
  image: weapon.image
    ? { '@type': 'ImageObject', url: `${siteUrl}${weapon.image}`, ...(weaponImageSize ?? {}) }
    : armoryImage
      ? imageObject(armoryImage)
      : { '@type': 'ImageObject', url: `${siteUrl}/images/resurgence-builds-official-logo.png`, width: 1024, height: 1024 },
  inLanguage: 'en-US',
  lastReviewed: '2026-05-30',
  wordCount: 500,
  about: { '@id': `${siteUrl}/#division-resurgence` },
};

const itemLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': `${siteUrl}/database/weapons/${slug}/#item`,
  name: `${weapon.name}: ${weapon.type} in Division Resurgence`,
  description: `${weapon.name} ${weapon.type} in Division Resurgence.${weapon.rpm && weapon.mag ? ` ${weapon.rpm} RPM, ${weapon.mag} magazine${knownDmgType ? `, ${knownDmgType} damage` : ''}.` : ''}`,
  genre: 'Video Game Item Database',
  isPartOf: {
    '@type': 'VideoGame',
    name: 'Tom Clancy\'s The Division Resurgence',
    gamePlatform: ['iOS', 'Android', 'PC'],
    applicationCategory: 'Game',
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Weapon Class', value: weapon.type },
    ...(weapon.rpm ? [{ '@type': 'PropertyValue', name: 'RPM', value: String(weapon.rpm) }] : []),
    ...(weapon.mag ? [{ '@type': 'PropertyValue', name: 'Magazine', value: String(weapon.mag) }] : []),
    ...(knownDmgType ? [{ '@type': 'PropertyValue', name: 'Damage Type', value: knownDmgType }] : []),
    ...(armoryTier ? [{ '@type': 'PropertyValue', name: 'Armory Tier', value: `Tier ${armoryTier.slice(1)}` }] : []),
  ]
};

// The talent tips are written with **bold** markers; turn them into <strong> (they showed up as literal asterisks)
const boldStars = (t: string) => t
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
  .replace(/\*\*(.+?)\*\*/g, '<strong style="color: #fff;">$1</strong>');
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} jsonLd={[weaponLd, itemLd]} faqs={faqs} ogImage={weapon.image || armoryImage?.src}>
  <div class="container section">
    <Breadcrumbs items={breadcrumbs} />
    <SectionTag label="Weapon Database" />

    <div style="max-width: 700px;">
      <!-- Header -->
      <div style="margin-bottom: var(--sp-8); padding-bottom: var(--sp-6); border-bottom: 1px solid rgba(255,255,255,0.08);">
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-4);">
          <h1 style="font-family: var(--font-heading); font-size: var(--text-4xl); font-weight: 900; letter-spacing: -0.03em; margin: 0; background: linear-gradient(135deg, #fff 60%, var(--accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">{weapon.name}</h1>
          <span style="display: inline-flex; align-items: center; font-family: var(--font-mono); font-size: var(--step--2); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); background: rgba(242,104,34,0.12); border: 1px solid rgba(242,104,34,0.25); padding: 5px 14px; border-radius: 999px;">{weapon.type}</span>
          {armoryTier && <span class="weapon-pill">Tier {armoryTier.slice(1)}</span>}
          {knownDmgType && <span class={`weapon-pill weapon-pill--${knownDmgType.toLowerCase()}`}>{knownDmgType}</span>}
        </div>
        <div style="display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: var(--text-xs); color: #6DAA45; background: rgba(109, 170, 69, 0.1); border: 1px solid rgba(109, 170, 69, 0.25); padding: 6px 14px; border-radius: 999px; margin-top: var(--sp-4); letter-spacing: 0.02em;">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          <span>Last verified for <strong>{lastVerified}</strong></span>
        </div>
      </div>

      {weapon.image && (
        <div style="margin-bottom: var(--sp-8); border-radius: 8px; overflow: hidden; border: 1px solid var(--border); background: rgba(0,0,0,0.3);">
          <img src={weapon.image} alt={`${weapon.name} ${weapon.type} in Division Resurgence`} width={weaponImageSize?.width} height={weaponImageSize?.height} fetchpriority="high" style="width: 100%; height: auto; display: block;" />
        </div>
      )}

      <!-- Overview -->
      <div style="margin-bottom: var(--sp-8);">
        <h2 style="font-family: var(--font-heading); font-size: var(--text-lg); font-weight: 800; color: #fff; margin: 0 0 var(--sp-4) 0; padding-bottom: var(--sp-2); border-bottom: 1px solid rgba(255,255,255,0.08);">Overview</h2>
        <p style="color: #c8c8d0; line-height: 1.75; font-size: var(--text-base);">
          The <strong>{weapon.name}</strong> is {typeArticle} <strong>{weapon.type}</strong> in The Division Resurgence{weapon.rpm && weapon.mag && <> that fires at <strong>{weapon.rpm} RPM</strong> with a <strong>{weapon.mag}-round</strong> magazine</>}{knownDmgType && <> and deals <strong>{knownDmgType}</strong> damage</>}.{armoryTier && <> The in-game Armory lists it under Season 1, Tier {armoryTier.slice(1)}{knownDmgType ? ', with the damage type shown next to its name' : ''} (checked October 28, 2026).</>}
        </p>
      </div>

      {armoryImage && (
        <figure class="game-figure game-figure--wide">
          <GameImage
            image={armoryImage}
            alt={`The Division Resurgence Armory, ${weapon.type} Tier ${weapon.armoryTier.slice(1)} screen: ${armoryNames.join(', ')}`}
            sizes="(max-width: 760px) calc(100vw - 32px), 720px"
          />
          <figcaption>The {weapon.name} on the Armory's {weapon.type} Tier {weapon.armoryTier.slice(1)} screen, next to the other {weapon.type === 'SMG' || weapon.type === 'LMG' ? weapon.type + 's' : weapon.type.toLowerCase() + 's'} of that tier. Weapons the recording account hadn't unlocked yet show as locked outlines. Recorded {CARDS_RECORDED}.</figcaption>
        </figure>
      )}

      {populatedStatCount >= 4 && (
        <WeaponAttributes
          rpm={weapon.rpm}
          mag={weapon.mag}
          accuracy={weapon.accuracy}
          reloadSpeed={weapon.reloadSpeed}
          stability={weapon.stability}
        />
      )}

      {weapon.randomizedAttributes && (
        <RandomizedAttributes attributes={weapon.randomizedAttributes} />
      )}

      {(weapon.talent1 || weapon.talent2) && (
        <div style="margin-bottom: var(--sp-8); background: #1a1a1a; padding: var(--sp-4); border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--sp-4);">
            <h2 style="font-family: var(--font-heading); font-size: var(--text-xl); font-weight: 800; color: var(--accent); margin: 0; display: flex; align-items: center; gap: 8px;">
              <span style="letter-spacing: -2px;">:::</span> Weapon Talents
            </h2>
            <svg style="color: #a0a0a0;" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
          </div>
          {weapon.talent1 && <WeaponTalentsGrid talentNames={weapon.talent1} gridTitle="Talent 1" />}
          {weapon.talent2 && <WeaponTalentsGrid talentNames={weapon.talent2} gridTitle="Talent 2" />}
        </div>
      )}

      <!-- Weapon Talents to Pair -->
      <div style="margin-bottom: var(--sp-8);">
        <h2 style="font-family: var(--font-heading); font-size: var(--text-lg); font-weight: 800; color: #fff; margin: 0 0 var(--sp-4) 0; padding-bottom: var(--sp-2); border-bottom: 1px solid rgba(255,255,255,0.08);">Best Weapon Talents for {weapon.name}</h2>
        <div style="color: #c8c8d0; line-height: 1.75; font-size: var(--text-base);">
          <p set:html={boldStars(weapon.type === 'Assault Rifle' ? `Talents from our AR builds: **Unhinged** (+18% Weapon Damage for -10% Stability and Accuracy; on his Lightweight M4, TikTokAndy says you won't even notice the penalty), **Killer** and **Breadbasket** (the pair we recommend for the Lightweight M4 on Saiynergy's Bulwark Breacher build, over his own Steady Hands and Medical Accuracy: Critical Hit Kills grant +36% Crit Damage, and body shots stack Headshot Damage), and **In Sync** on skill-heavy builds (weapon hits buff Skill Damage, skill hits buff Weapon Damage, and the bonus doubles while both are up). Engineering builds put **Torrential Downpour** on ARs too (AgentHuntzman's Police M4, the Jackpot Striker's Mk16).` : weapon.type === 'SMG' ? `Talents our SMG builds actually run: **Precise Crit** and **Performer** (TikTokAndy's "god rolled" P90: 10 hits give allies within 40 meters +15% Weapon and Skill Crit Damage, and Performer adds +18% Weapon Damage inside 20 meters), or **Torrential Downpour** with **Last Stand** on skill builds (his Vector pair, which feeds Engineering and Skill Duration). **Strained** suits SMGs that fire in long bursts: half a second of firing grants +10% Crit Damage, stacking 3 times.` : weapon.type === 'LMG' ? `Talents worth chasing on an LMG: **In Sync** (the roll on our Milkshake Machine build), **Unhinged** for a flat +18% Weapon Damage, and **Damage Trade**, which grants +6% Weapon Damage for each 20% of the magazine you empty, up to 4 stacks, until you reload. Support builds use LMGs too: Nadie's Muscular Nurse runs **Sadistic Shield** and **Conceited** on an M60. Talents that need kills to get going do less on a gun built for sustained fire.` : weapon.type === 'Marksman Rifle' ? `Our one marksman rifle build, the Jackpot Striker Drone, pairs a Hunting M44 with its skill kit, rolling **Enhancement Trade** (Skill Intensity as you empty the magazine) and **Ammo Supply**. For a shooting build, the tooltips that reward precision are **No Exit** (headshot kills grant +21% Weapon Damage), **Surgical** (headshots stack +7% Weapon Crit Damage, up to 5 stacks) and **Breadbasket** (body shots stack Headshot Damage for the follow-up).` : weapon.type === 'Shotgun' ? `TikTokAndy's Double Barrel build runs **Misdirection Insurance** (a missed shot has a 30% chance of returning the bullet) and **Still Alive** (kills restore 30% of missing Health on a 10 second cooldown), which he calls necessary for solo content. **Performer** (+18% Weapon Damage inside 20 meters) is the natural damage roll for a gun that lives at close range.` : `Check the weapon talent database for the full list. The right talent depends entirely on your build's archetype and playstyle.`)} />
        </div>
      </div>

      <!-- Recommended Bonus Attributes -->
      <div style="margin-bottom: var(--sp-8);">
        <h2 style="font-family: var(--font-heading); font-size: var(--text-lg); font-weight: 800; color: #fff; margin: 0 0 var(--sp-4) 0; padding-bottom: var(--sp-2); border-bottom: 1px solid rgba(255,255,255,0.08);">Recommended Bonus Attributes for {weapon.name}</h2>
        <div style="color: #c8c8d0; line-height: 1.75; font-size: var(--text-base);">
          <p>When rolling bonus attributes for {typeArticle} {weapon.type} build using the {weapon.name}, prioritize in this order (All Weapon Damage is a weapon roll; the rest can roll on gear too):</p>
          <ol style="padding-left: var(--inset); margin-top: var(--sp-2);">
            {recommendedAttrs.map(attr => (
              <li><strong style={attr.accent ? 'color: var(--accent);' : 'color: #fff;'}>{attr.name}</strong>: {attr.note}</li>
            ))}
          </ol>
          <p style="margin-top: var(--sp-3);">Check the <a href="/database/bonus-attributes/" style="color: var(--accent);">bonus attributes database</a> for exact values and which gear slots can roll each stat.</p>
        </div>
      </div>

      <!-- How to Farm -->
      <div style="margin-bottom: var(--sp-8);">
        <h2 style="font-family: var(--font-heading); font-size: var(--text-lg); font-weight: 800; color: #fff; margin: 0 0 var(--sp-4) 0; padding-bottom: var(--sp-2); border-bottom: 1px solid rgba(255,255,255,0.08);">How to Get {weapon.name}</h2>
        <div style="color: #c8c8d0; line-height: 1.75; font-size: var(--text-base);">
          <p>Standard weapons like the {weapon.name} drop from the general loot pool: any activity can drop it. For T2 copies at level 40, Ubisoft's Season 2 Phase 2 notes give <strong style="color: #fff;">Weapon Kill daily quests</strong> a chance of T2 weapons of the quest's type, and creators point at <strong style="color: #fff;">Elite missions</strong> and the weekly Elite Mission Challenge chest. You can also raise a T0 or T1 copy in the Armory's <strong style="color: #fff;">Power Tier Enhancement</strong> screen with an Enhancement Kit (our <a href="/guides/division-resurgence-gear-farming-guide/" style="color: var(--accent);">gear farming guide</a> has the full list and the proficiency gate). When farming, you're looking for two things: the right weapon AND the right talents. If you find a {weapon.name} with a bad talent but great base stats, recalibration rerolls that talent line at random, so expect a few tries.</p>
          <p>Keep in mind: since Season 2 Phase 1, weapons no longer roll Blast, Piercing or Shredding damage bonuses (Ubisoft replaced them with <strong style="color: var(--accent);">All Weapon Damage</strong>), and newly dropped weapon mods don't roll them either. Check the <a href="/database/bonus-attributes/" style="color: var(--accent);">bonus attributes database</a> for the full list of damage-type stats and where they still apply.</p>
        </div>
      </div>

      <DbFaq faqs={faqs} />

      <DbItemExtras kind="weapon" name={weapon.name} drops={false} />

      <!-- Related links -->
      <div style="display: flex; flex-wrap: wrap; gap: var(--sp-3); padding-top: var(--sp-6); border-top: 1px solid rgba(255,255,255,0.08);">
        <a href="/database/weapons/" style="font-family: var(--font-mono); font-size: var(--text-sm); color: var(--accent); text-decoration: none; padding: var(--sp-2) var(--sp-4); background: rgba(242,104,34,0.08); border: 1px solid rgba(242,104,34,0.2); border-radius: 6px; transition: all 0.2s;">&larr; All Weapons</a>
        <a href="/database/weapon-talents/" style="font-family: var(--font-mono); font-size: var(--text-sm); color: var(--accent); text-decoration: none; padding: var(--sp-2) var(--sp-4); background: rgba(242,104,34,0.08); border: 1px solid rgba(242,104,34,0.2); border-radius: 6px; transition: all 0.2s;">Weapon Talents</a>
        <a href="/database/exotic-weapons/" style="font-family: var(--font-mono); font-size: var(--text-sm); color: var(--accent); text-decoration: none; padding: var(--sp-2) var(--sp-4); background: rgba(242,104,34,0.08); border: 1px solid rgba(242,104,34,0.2); border-radius: 6px; transition: all 0.2s;">Exotic Weapons</a>
        <a href="/database/gear-set-effects/" style="font-family: var(--font-mono); font-size: var(--text-sm); color: var(--accent); text-decoration: none; padding: var(--sp-2) var(--sp-4); background: rgba(242,104,34,0.08); border: 1px solid rgba(242,104,34,0.2); border-radius: 6px; transition: all 0.2s;">Gear Sets</a>
        <a href="/tier-list/" style="font-family: var(--font-mono); font-size: var(--text-sm); color: var(--accent); text-decoration: none; padding: var(--sp-2) var(--sp-4); background: rgba(242,104,34,0.08); border: 1px solid rgba(242,104,34,0.2); border-radius: 6px; transition: all 0.2s;">Tier List</a>
      </div>
    </div>

    <AdSenseUnit label="Advertisement (database item)" />
  </div>
</BaseLayout>

<style>
  .weapon-pill {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #c8c8d0;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.18);
    padding: 5px 14px;
    border-radius: 999px;
  }
  .weapon-pill--blast { color: #f6896a; border-color: rgba(246, 137, 106, 0.45); background: rgba(246, 137, 106, 0.1); }
  .weapon-pill--piercing { color: #9fb0ff; border-color: rgba(159, 176, 255, 0.45); background: rgba(159, 176, 255, 0.1); }
  .weapon-pill--shredding { color: #8fd79f; border-color: rgba(143, 215, 159, 0.45); background: rgba(143, 215, 159, 0.1); }
</style>
