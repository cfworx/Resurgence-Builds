---
import DatabaseLayout from '../../../layouts/DatabaseLayout.astro';
import osProtocols from '../../../data/os-protocols.json';
import AdSenseUnit from '../../../components/AdSenseUnit.astro';
import { verifiedPatch } from '../../../data/site-config';
// All 66 protocols were re-checked in the in-game Build-Making Database on 2026-10-28 (Season 2 Phase 2).
const lastVerified = verifiedPatch();

const slugify = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
// Same normalization as the search script below: lowercase words and numbers (% and . kept).
const norm = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[^a-z0-9%.]+/g, ' ').trim();

const title = "OS Protocols Database: Stats & Talents";
const description = "Search all 66 Division Resurgence OS Protocols by name, talent or stat: rarity, main stat, attributes and cooldowns, checked in game.";
const breadcrumbs = [
  { name: 'OS Protocols', url: '/database/os-protocols/' }
];

const TYPES = ['Engineering', 'Firepower', 'Toughness'];
const RARITIES = ['High-End', 'Superior', 'Specialized', 'Standard'];
const total = osProtocols.length;

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'The Division Resurgence OS Protocols',
  description: description,
  numberOfItems: osProtocols.length,
  itemListElement: osProtocols.map((item: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${Astro.url.origin}/database/os-protocols/${slugify(item.name)}/`,
    item: {
      '@type': 'Thing',
      '@id': `${Astro.url.href}#item-${i}`,
      name: item.name,
      description: item.talentDescription,
      url: `${Astro.url.origin}/database/os-protocols/${slugify(item.name)}/`,
      subjectOf: { '@id': 'https://resurgencebuilds.com/#division-resurgence' }
    }
  })),
};

const faqs = [
  { question: "What is the best OS Protocol in Division Resurgence?", answer: "It depends on your class and build. Going by Season 2 Phase 2 creator results, Brains Over Brawn (on GGReborn's Season 2 Tactical Pharma build) and Cover Shooter (on TikTokAndy's Double Barrel Commando) are the two S picks on our OS Protocol tier list, and TikTokAndy's newest Lightweight M4 Commando runs Explosive Round. The tier list gives the reason and the sources for every rank." },
  { question: "How do OS Protocols work in Division Resurgence?", answer: "OS Protocols are unique gear-talent items that slot into your Operating System loadout. Each protocol provides a main stat, three sub-stats (a specialization rating, a damage modifier, and a Health value), and a unique Talent that triggers under specific combat conditions; some talents have a cooldown. Died Again Gaming points out that any agent level can equip any rarity; higher rarities roll bigger stats and better talents." },
  { question: "How do you upgrade OS Protocols?", answer: "Two separate ways. Leveling raises the stats: you feed a protocol Algorithm Data from bounties and open-world activities, or spare protocols, and creator readings show level 50 doubling the percentage main stat (Pressing Matter's 12% reads 24%), and on-screen readings in between fit +10% of the base every five levels (a level 42 Recursive Treatment reads 1.8 times its base, a level 45 Explosive Round 1.9 times). Talent Upgrade raises the talent: you donate duplicates of the same protocol, and Ubisoft's published ladders climb in five steps of 20% of the base value, ending at double. Gold duplicates are rare, so a purple you can max is often the better bet." },
  { question: "What is the best OS Protocol for Vanguard?", answer: "For a Commando damage build, Cover Shooter (Firepower, High-End): TikTokAndy switched his Double Barrel build to it in early October and soloed Precious Cargo on Legendary with it. His October 27 Lightweight M4 build uses Explosive Round instead. For team support, Strategic Assistance is our earlier pick, since its assist-based Signature Ability Charge Efficiency and Skill Cooldown reduction feed Tactical Link and Scanning Pulse uptime." },
  { question: "What is the best OS Protocol for Field Medic?", answer: "For Tactical Pharma, Brains Over Brawn (Engineering, Specialized), which GGReborn runs on his Season 2 build; Chain Reaction, Collateral Damage and Tactical Persistence finished within five seconds of it in his October 23 Lone Wolf test, all slightly ahead. For Combat Medicine, Nadie's tank medic runs Pummeling Shield, and Medical Excellence (Toughness, Superior) is the pure-healer option: healing an ally above half Health grants the team extra healing equal to 5% Max Health, and healing one below half grants the target 12.5% Max Health." },
  { question: "What is the best OS Protocol for Bulwark?", answer: "Pummeling Shield (Toughness, High-End) is the defining protocol for Bulwark. While you have Extra Health, every 10 hits apply a stun, and at Max Health getting hit grants Extra Health equal to 2400% of your Firepower. Since the June 26, 2026 hotfix the stun lasts 1.5 seconds (down from 2) and has a 10-second cooldown, so it's a periodic interrupt now, not a stun-lock." },
  { question: "What is the best OS Protocol for Demolitionist?", answer: "Surgical Engineering (Engineering, High-End), from our earlier ranking: Skill Critical Hits have a 60% chance of granting +16% Skill Critical Damage. We haven't found a Season 2 creator result for Demolitionist yet; PVE Enjoyer's pre-Season 2 Glass Cannon build runs Pressing Matter." },
  { question: "What is the best OS Protocol for Tech Operator?", answer: "For an Aegis healer, Recursive Treatment, which TikTokAndy runs on his October Aegis Team Healer build. For skill-crit damage, Brains Over Brawn is the pick on LtFoe's and Tampishach's damage-focused Aegis builds (both from before Season 2). Offensive Operations drone builds run Rampart (our Jackpot Striker Drone build) or Tactical Layering (+15% Engineering per skill deployment, up to 3 stacks)." },
];
---

<DatabaseLayout
  {title}
  {description}
  {breadcrumbs}
  heading="OS Protocols"
  subheading="All 66 protocols from the in-game Build-Making Database. Search by name, talent or stat."
  jsonLd={itemListLd}
  lastVerified={lastVerified}
  modified="2026-10-28"
  {faqs}
>
  <div class="osdb-tools" role="search" aria-label="Search OS Protocols">
    <label for="osdb-q" class="sr-only">Search OS Protocols by name, talent or stat</label>
    <input id="osdb-q" class="osdb-search" type="search" placeholder={'Name, talent or stat (try "headshot")'} autocomplete="off" spellcheck="false" enterkeyhint="search" />
    <div class="osdb-selects">
      <label class="osdb-select">
        <span class="sr-only">Type</span>
        <select id="osdb-type">
          <option value="all">All types</option>
          {TYPES.map((t) => <option value={t}>{t}</option>)}
        </select>
      </label>
      <label class="osdb-select">
        <span class="sr-only">Rarity</span>
        <select id="osdb-rarity">
          <option value="all">All rarities</option>
          {RARITIES.map((r) => <option value={r}>{r}</option>)}
        </select>
      </label>
    </div>
  </div>
  <p class="osdb-count"><span id="osdb-count" aria-live="polite">{total} protocols</span> · stats at level 1, no talent upgrades</p>

  <ul class="osdb-list" id="osdb-list">
    {osProtocols.map((p: any) => (
      <li
        id={slugify(p.name)}
        data-type={p.specialization}
        data-rarity={p.rarity}
        data-s={norm([p.name, p.specialization, p.rarity, p.mainStat, p.talentDescription, p.attr1, p.attr2, p.attr3, p.cooldown ? 'cooldown' : ''].join(' '))}
      >
        <a class={`osdb-card osdb-card--${slugify(p.rarity)}`} href={`/database/os-protocols/${slugify(p.name)}/`}>
          <div class="osdb-card__top">
            <h2 class="osdb-card__name">{p.name}</h2>
            <span class="osdb-card__rarity">{p.rarity}</span>
          </div>
          <span class="osdb-card__main"><span class="osdb-card__type">{p.specialization}</span> Main stat <span class="osdb-card__stat">{p.mainStat} <strong>{p.mainValue}</strong></span></span>
          <p class="osdb-card__talent">{p.talentDescription}</p>
          <span class="osdb-card__foot">{p.val1} {p.attr1} · {p.val2} {p.attr2} · {p.val3} {p.attr3}{p.cooldown && ` · ${p.cooldown.replace(' seconds', 's').replace(' second', 's')} cooldown`}</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="osdb-empty" id="osdb-empty" hidden>No protocol matches that. Try a single word, like "cover" or "headshot".</p>

  <section class="osdb-more" aria-labelledby="osdb-base">
    <h2 id="osdb-base">Base stats by rarity</h2>
    <p>Within a rarity, every protocol carries the same three attributes: its own rating (Engineering, Firepower or Toughness), a damage stat (Skill Damage on Engineering protocols, All Weapon Damage on the others) and Health. Levelling adds 10% of the main stat's base every five levels (double at level 50), and each of the five talent upgrades adds 20% of the talent's base value.</p>
    <table class="t-cards">
      <thead>
        <tr><th scope="col">Rarity</th><th scope="col">Rating</th><th scope="col">Damage stat</th><th scope="col">Health</th><th scope="col">Main stat at level 1</th></tr>
      </thead>
      <tbody>
        <tr><td data-label="Rarity">High-End</td><td data-label="Rating">+97</td><td data-label="Damage stat">+77</td><td data-label="Health">+2,554</td><td data-label="Main stat at level 1">Engineering, Firepower or Toughness 22.50%, Skill or Weapon Critical Damage 30%, Skill or Weapon Critical Chance 18%, Skill Intensity or Weapon Damage 15%, Max Health 30%</td></tr>
        <tr><td data-label="Rarity">Superior</td><td data-label="Rating">+77</td><td data-label="Damage stat">+62</td><td data-label="Health">+2,043</td><td data-label="Main stat at level 1">Engineering, Firepower or Toughness 18%, Critical Damage 24%, Critical Chance 14.40%, Skill Intensity or Weapon Damage 12%, Armor 28%, Healing Intensity 20%</td></tr>
        <tr><td data-label="Rarity">Specialized</td><td data-label="Rating">+58</td><td data-label="Damage stat">+46</td><td data-label="Health">+1,532</td><td data-label="Main stat at level 1">Engineering, Firepower or Toughness 13.50%, Critical Damage 18%, Critical Chance 10.80%, Skill Intensity or Weapon Damage 9%</td></tr>
        <tr><td data-label="Rarity">Standard</td><td data-label="Rating">+38</td><td data-label="Damage stat">+30</td><td data-label="Health">+1,021</td><td data-label="Main stat at level 1">Firepower or Toughness 9%, Skill Intensity or Weapon Damage 6%, Armor 14%</td></tr>
      </tbody>
    </table>
    <p>Which ones to chase: the <a href="/tier-list/os-protocols/">OS Protocol tier list</a> and the <a href="/guides/best-os-protocol/">best protocol per class</a>.</p>
  </section>

  <div class="os-related">
    <h2 class="db-heading" style="font-size: var(--text-2xl);">Related Guides</h2>
    <ul>
      <li><a href="/database/">Division Resurgence Build Database</a></li>
      <li><a href="/tier-list/os-protocols/">OS Protocol Tier List (Season 2 Phase 2)</a></li>
      <li><a href="/guides/best-os-protocol/">Best OS Protocol Per Class</a></li>
      <li><a href="/patch-notes/season-2-phase-2/">Season 2 Phase 2 Patch Notes (Dominating Presence, Concerted Strike, Relentless Assault)</a></li>
      <li><a href="/patch-notes/season-2-phase-1-the-call/">Season 2 Phase 1 Patch Notes (Dominating Presence fix)</a></li>
      <li><a href="/news/server-hotfix-june-26-2026/">June 26, 2026 Hotfix (Pummeling Shield)</a></li>
      <li><a href="/patch-notes/season-1-phase-3-a-new-fire/">Season 1 Phase 3 Patch Notes (Applied Demolition)</a></li>
      <li><a href="/builder/">Division Resurgence Build Planner</a></li>
    </ul>
  </div>

<AdSenseUnit label="Advertisement (database category)" />
</DatabaseLayout>

<style is:global>
  /* Search row: the search box, then the two filters (side by side even on phones) */
  .osdb-tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-bottom: var(--sp-2);
  }
  .osdb-search {
    flex: 1 1 18rem;
    min-width: 0;
    min-height: 44px;
    padding: 10px 14px;
    font-size: max(16px, 1rem); /* 16px keeps iOS from zooming in */
    color: var(--ink-heading);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
  }
  .osdb-search::placeholder { color: var(--ink-muted); opacity: 1; }
  .osdb-search:focus { border-color: var(--accent); outline: none; }
  .osdb-selects {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-2);
    flex: 1 1 18rem;
  }
  .osdb-select select {
    width: 100%;
    min-height: 44px;
    padding: 8px 12px;
    font-size: max(16px, 1rem);
    color: var(--ink-heading);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
  }
  .osdb-select select:focus { border-color: var(--accent); outline: none; }
  .osdb-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    margin: 0 0 var(--sp-4);
  }

  /* Protocol list: one compact card per protocol */
  .osdb-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-3);
  }
  @media (min-width: 45em) { .osdb-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 68.75em) { .osdb-list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .osdb-list > li[hidden] { display: none; }
  .osdb-card {
    --rarity: #888;
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 12px 14px 12px calc(var(--inset, 16px) - 3px);
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--rarity);
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
    transition: border-color 150ms ease, background 150ms ease;
  }
  .osdb-card:hover, .osdb-card:focus-visible { background: var(--surface-2); border-color: var(--rarity); }
  .osdb-card--high-end { --rarity: #F5CC45; }
  .osdb-card--superior { --rarity: #C285DB; }
  .osdb-card--specialized { --rarity: #5B9AEF; }
  .osdb-card--standard { --rarity: #6DAA45; }
  .osdb-card__top { display: flex; align-items: baseline; justify-content: space-between; gap: var(--sp-2); }
  .osdb-card__name {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 800;
    line-height: 1.25;
    color: #fff;
  }
  .osdb-card__rarity {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rarity);
  }
  .osdb-card__main { font-size: var(--text-sm); color: var(--ink-muted); }
  .osdb-card__type {
    display: inline-block;
    margin-right: 4px;
    padding: 0 6px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    border: 1px solid var(--border);
    border-radius: 4px;
  }
  .osdb-card__stat { color: var(--ink-heading); }
  .osdb-card__stat strong { color: var(--accent); font-weight: 700; }
  .osdb-card__talent { margin: 0; font-size: var(--text-sm); line-height: 1.55; color: #c8c8d0; }
  .osdb-card__foot { margin-top: auto; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--ink-muted); }
  .osdb-empty { margin: var(--sp-4) 0; color: var(--ink-muted); }

  /* Below the list */
  .osdb-more { max-width: 80ch; margin-top: var(--sp-10); }
  .osdb-more h2 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 800;
    color: #fff;
    margin: 0 0 var(--sp-3);
  }
  .osdb-more p { color: #b8b8c0; line-height: 1.7; margin-bottom: var(--sp-4); }
  .osdb-more a { color: var(--accent); }
  .os-related { margin-top: var(--sp-10); }
  .os-related ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--sp-2); }
</style>

<script>
  const q = document.getElementById('osdb-q') as HTMLInputElement | null;
  const type = document.getElementById('osdb-type') as HTMLSelectElement | null;
  const rarity = document.getElementById('osdb-rarity') as HTMLSelectElement | null;
  const list = document.getElementById('osdb-list');
  const count = document.getElementById('osdb-count');
  const empty = document.getElementById('osdb-empty');

  if (q && type && rarity && list && count && empty) {
    const items = Array.from(list.children) as HTMLElement[];
    const norm = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[^a-z0-9%.]+/g, ' ').trim();

    // Restore a shared search (?find=headshot&type=Firepower&rarity=Superior). Not ?q=, which opens the site search.
    const params = new URLSearchParams(location.search);
    q.value = params.get('find') || '';
    const pick = (sel: HTMLSelectElement, v: string | null) => {
      if (v && Array.from(sel.options).some((o) => o.value === v)) sel.value = v;
    };
    pick(type, params.get('type'));
    pick(rarity, params.get('rarity'));

    const apply = () => {
      const words = norm(q.value).split(' ').filter(Boolean);
      let shown = 0;
      for (const li of items) {
        const ok = (type.value === 'all' || li.dataset.type === type.value)
          && (rarity.value === 'all' || li.dataset.rarity === rarity.value)
          && words.every((w) => ` ${li.dataset.s || ''}`.includes(` ${w}`)); // each word matches the start of a word
        li.hidden = !ok;
        if (ok) shown++;
      }
      count.textContent = shown === items.length ? `${items.length} protocols` : `${shown} of ${items.length} protocols`;
      empty.hidden = shown > 0;

      const next = new URLSearchParams();
      if (q.value.trim()) next.set('find', q.value.trim());
      if (type.value !== 'all') next.set('type', type.value);
      if (rarity.value !== 'all') next.set('rarity', rarity.value);
      const qs = next.toString();
      history.replaceState(null, '', `${location.pathname}${qs ? `?${qs}` : ''}${location.hash}`);
    };

    let t: number | undefined;
    q.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(apply, 80); });
    type.addEventListener('change', apply);
    rarity.addEventListener('change', apply);
    if (q.value || type.value !== 'all' || rarity.value !== 'all') apply();
  }
</script>
