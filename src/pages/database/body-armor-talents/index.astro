---
import DatabaseLayout from '../../../layouts/DatabaseLayout.astro';
import armorTalents from '../../../data/body-armor-talents.json';
import TalentIndex from '../../../components/TalentIndex.astro';
import AdSenseUnit from '../../../components/AdSenseUnit.astro';
import { verifiedPatch } from '../../../data/site-config';
const lastVerified = verifiedPatch('Patch 1.1.2.2'); // Bump: drop the arg ONLY after re-verifying this page's content in-game (CURRENT_PATCH is a ceiling, not an auto-bump)

const title = "Division Resurgence Body Armor Talents & Best Builds";
const description = "Every Body Armor (Body Armor) Talent in Division Resurgence. Pick the right one and you're unkillable. Pick the wrong one and you're a loot donation.";
const breadcrumbs = [
  { name: 'Body Armor Talents', url: '/database/body-armor-talents/' }
];

const faqs = [
  { question: "What are body armor talents in Division Resurgence?", answer: "Body armor talents are passive abilities on Tier 2 Body Armor pieces. Your Body Armor talent is arguably the most impactful gear talent in the game because it directly affects survivability or damage output in every firefight. One talent per Body Armor piece, always active once equipped." },
  { question: "What is the best body armor talent for DPS in Division Resurgence?", answer: "For pure DPS, you want a Body Armor talent that amplifies weapon damage or gives you a damage bonus when certain conditions are met (like hitting crits or staying in cover). The strongest DPS Body Armor talents typically give a flat damage increase that multiplies with everything else in your build. Check the descriptions below: if it says 'amplified' damage, that's the good stuff." },
  { question: "What is the difference between backpack and body armor talents?", answer: "Backpack talents and body armor talents occupy separate gear slots and stack with each other. They’re different talent pools, so you won’t find the same talent on both. Your Body Armor talent usually has a bigger impact on your build's identity, while backpack talents tend to provide sustain or utility bonuses. You want both working together." },
];

const toSlug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const siteUrl = 'https://resurgencebuilds.com';

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'The Division Resurgence Body Armor Talents',
  description: description,
  numberOfItems: armorTalents.length,
  itemListElement: armorTalents.map((item: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${siteUrl}/database/body-armor-talents/#${toSlug(item.name)}`,
    item: {
      '@type': 'Thing',
      '@id': `${siteUrl}/database/body-armor-talents/#${toSlug(item.name)}`,
      name: item.name,
      description: item.description,
      url: `${siteUrl}/database/body-armor-talents/#${toSlug(item.name)}`,
      subjectOf: { '@id': 'https://resurgencebuilds.com/#division-resurgence' }
    }
  })),
};
---

<DatabaseLayout
  {title}
  {description}
  {breadcrumbs}
  heading="Body Armor Talents"
  subheading="Every Body Armor talent on one page: full effects, roles, and direct anchors. The talent on your Body Armor piece is the most important decision you'll make in this game."
  jsonLd={itemListLd}
  lastVerified={lastVerified}
  {faqs}
>
  <div style="color: #c8c8d0; line-height: 1.75; font-size: var(--text-base); margin-bottom: var(--sp-6); max-width: 72ch;">
    <p>Body Armor is one of only two gear slots that carries a talent (the backpack is the other), and it's the one that defines your build's identity. These talents are always active once equipped and stack with your backpack talent, weapon talents, and gear set bonuses. A bad roll isn't the end: the Recalibration Station lets you swap the talent slot on a piece with otherwise great stats (one recalibration per piece).</p>
  </div>

  <TalentIndex
    talents={armorTalents}
    slot="body armor"
    basePath="/database/body-armor-talents/"
  />

<AdSenseUnit label="Advertisement (database category)" />
</DatabaseLayout>
