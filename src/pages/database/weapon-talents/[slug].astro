---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionTag from '../../../components/SectionTag.astro';
import { truncateDesc, metaDescription } from '../../../utils/seo';
import weaponTalents from '../../../data/weapon-talents.json';
import wtNotes from '../../../data/weapon-talent-notes.json';
import { isWeaponTalentIndexable } from '../../../utils/indexability.mjs';
import DbItemExtras from '../../../components/DbItemExtras.astro';
import { verifiedPatch, DATABASE_UPDATED } from '../../../data/site-config';
import DbIcon from '../../../components/DbIcon.astro';
import GameImage from '../../../components/GameImage.astro';
import { dbImage, imageObject, CARDS_RECORDED } from '../../../utils/db-images';
import talentSources from '../../../data/weapon-talent-sources.json';
import standardWeapons from '../../../data/standard-weapons.json';
import exoticWeapons from '../../../data/exotic-weapons.json';

export function getStaticPaths() {
  return weaponTalents.map((talent: any) => ({
    params: {
      slug: talent.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
    },
    props: { talent }
  }));
}

const { talent } = Astro.props;
// Talents checked in the in-game Build-Making Database carry verifiedInGame (all 69 on 2026-10-28).
const lastVerified = talent.verifiedInGame ? verifiedPatch() : verifiedPatch('Patch 1.1.2.2');

const slug = talent.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
// The talent's card in the in-game Build-Making Database, with the weapons that can roll it.
const cardImage = dbImage(`weapon-talents/${slug}`);
const siteUrl = 'https://resurgencebuilds.com';

// The weapons that can roll it: the talent's Source list, read off our recordings of the game
// (research/build-database/weapon-talent-sources.json; src/data has the site copy).
const sources: { name: string; classOrder: string[]; weapons: { name: string; slug: string; class: string; tier: string }[] } | undefined =
  (talentSources as any).talents[slug];
const sourcesRecorded = new Date(`${(talentSources as any).checked}T12:00:00Z`).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric' });
// Every standard weapon has its own page.
const pagedWeapons = new Set((standardWeapons as any[]).map((w) => w.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')));
const classPlural: Record<string, string> = { 'Assault Rifle': 'Assault rifles', SMG: 'SMGs', LMG: 'LMGs', 'Marksman Rifle': 'Marksman rifles', Rifle: 'Rifles', Shotgun: 'Shotguns' };
// Exotic-only talents (Breathe Free, Play Rough) come fixed on their exotic instead.
const exoticWeapon: any = (exoticWeapons as any[]).find((e) => e.talentName === talent.name);
const exoticOf = exoticWeapon ? { name: exoticWeapon.name, slug: exoticWeapon.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') } : null;
const sourceGroups = sources ? sources.classOrder.map((cls) => ({ cls, weapons: sources.weapons.filter((w) => w.class === cls) })) : [];

// A short label for the header pill, from the talent text's keywords.
function archetypeLabel(description: string): string {
  const d = description.toLowerCase();
  if (d.includes('skill damage') && d.includes('weapon damage')) return 'Hybrid DPS / Engineering';
  if (d.includes('engineering') || d.includes('skill intensity') || d.includes('skill cooldown') || d.includes('skill duration') || d.includes('skill critical') || d.includes('skill multi-shot') || d.includes('skill damage')) return 'Engineering / Skill Build';
  if (d.includes('critical hit') || d.includes('critical damage') || d.includes('crit')) return 'DPS / Crit Build';
  if (d.includes('armor') || d.includes('damage reduction') || d.includes('toughness') || d.includes('extra health') || d.includes('max health') || d.includes('incoming damage')) return 'Tank / Survivability';
  if (d.includes('healing') || d.includes('health') || d.includes('rescue') || d.includes('restore')) return 'Support / Healer';
  if (d.includes('weapon damage') || d.includes('rate of fire') || d.includes('headshot')) return 'DPS / Firepower';
  if (d.includes('reload')) return 'Utility / Quality of Life';
  return 'Versatile';
}

const archetype = { label: archetypeLabel(talent.description) };

// Per-item editorial content (usage notes, meta builds, patch history).
// Pages become indexable once their unique text (talent text, notes, Source list)
// clears the thin-content threshold; the rest are noindexed.
// The same check drives the sitemap filter via src/utils/indexability.mjs.
const notes: any = (wtNotes as any)[slug];
const indexable = isWeaponTalentIndexable(talent, notes, sources);

const title = `${talent.name}: Weapon Talent`;
const description = metaDescription(notes?.usageNotes, `${talent.name} weapon talent in The Division Resurgence: what it does and which weapons can roll it.`);

const breadcrumbs = [
  { name: 'Weapon Talents', url: '/database/weapon-talents/' },
  { name: talent.name, url: '#' }
];

const talentLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: `${siteUrl}/database/weapon-talents/${slug}/`,
  author: { '@type': 'Person', '@id': `${siteUrl}/author/rapidf5/#person`, name: 'RapidF5', url: `${siteUrl}/author/rapidf5/` },
  publisher: { '@type': 'Organization', '@id': `${siteUrl}/#organization`, name: 'Resurgence Builds' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${siteUrl}/database/weapon-talents/${slug}/`, lastReviewed: talent.verifiedInGame || '2026-05-30' },
  datePublished: '2026-05-30',
  dateModified: DATABASE_UPDATED,
  image: cardImage ? imageObject(cardImage) : { '@type': 'ImageObject', url: `${siteUrl}/images/resurgence-builds-official-logo.png`, width: 1024, height: 1024 },
  inLanguage: 'en-US',
  about: { '@id': `${siteUrl}/#division-resurgence` },
};
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} jsonLd={talentLd} noindex={!indexable} ogImage={cardImage?.src} noAds>
  <div class="container section">
    <Breadcrumbs items={breadcrumbs} />
    <SectionTag label="Weapon Talent" />

    <div style="max-width: 700px;">
      <!-- Header -->
      <div style="margin-bottom: var(--sp-8); padding-bottom: var(--sp-6); border-bottom: 1px solid rgba(255,255,255,0.08);">
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-4);">
          <DbIcon id={`weapon-talents/${slug}`} size={64} alt={`${talent.name} weapon talent icon in The Division Resurgence`} eager />
          <h1 style="font-family: var(--font-heading); font-size: var(--text-4xl); font-weight: 900; letter-spacing: -0.03em; margin: 0; background: linear-gradient(135deg, #fff 60%, var(--accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">{talent.name}</h1>
          <span style="display: inline-flex; align-items: center; font-family: var(--font-mono); font-size: var(--step--2); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); background: rgba(242,104,34,0.12); border: 1px solid rgba(242,104,34,0.25); padding: 5px 14px; border-radius: 999px;">{archetype.label}</span>
        </div>
        <div style="display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: var(--text-xs); color: #6DAA45; background: rgba(109, 170, 69, 0.1); border: 1px solid rgba(109, 170, 69, 0.25); padding: 6px 14px; border-radius: 999px; margin-top: var(--sp-4); letter-spacing: 0.02em;">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          <span>Last verified for <strong>{lastVerified}</strong></span>
        </div>
      </div>

      <!-- Overview (editorial notes only) -->
      {notes && (
      <div style="margin-bottom: var(--sp-8);">
        <h2 style="font-family: var(--font-heading); font-size: var(--text-lg); font-weight: 800; color: #fff; margin: 0 0 var(--sp-4) 0; padding-bottom: var(--sp-2); border-bottom: 1px solid rgba(255,255,255,0.08);">Overview</h2>
        <p style="color: var(--ink); line-height: 1.75; font-size: var(--text-base);">
          {notes.usageNotes}
        </p>
      </div>
      )}

      <!-- How It Works -->
      <div style="margin-bottom: var(--sp-8);">
        <h2 style="font-family: var(--font-heading); font-size: var(--text-lg); font-weight: 800; color: #fff; margin: 0 0 var(--sp-4) 0; padding-bottom: var(--sp-2); border-bottom: 1px solid rgba(255,255,255,0.08);">How It Works</h2>
        <div style="padding: var(--sp-5); background: rgba(0,0,0,0.25); border-left: 3px solid var(--accent); border-radius: 0 8px 8px 0;">
          <p style="margin: 0; color: #e8e8f0; line-height: 1.75; font-size: var(--text-base); font-weight: 500;">{talent.description}</p>
        </div>
        {talent.note && <p class="item-note">{talent.note}</p>}
      </div>

      {cardImage && (
        <figure class="game-figure game-figure--wide">
          <GameImage
            image={cardImage}
            eager
            alt={`${talent.name} weapon talent card in The Division Resurgence, with the weapons that can roll it`}
            sizes="(max-width: 760px) calc(100vw - 32px), 720px"
          />
          <figcaption>{talent.name} in the game's Build-Making Database, recorded {CARDS_RECORDED}. The Source list shows the weapons that can roll it, with their tier.</figcaption>
        </figure>
      )}

      {sources ? (
        <section class="talent-sources" aria-labelledby="talent-sources-title">
          <h2 id="talent-sources-title" class="talent-sources__title">Weapons That Can Roll {talent.name}</h2>
          <p class="talent-sources__lead">{sources.weapons.length} weapons in {sourceGroups.length} {sourceGroups.length === 1 ? 'class' : 'classes'}, at every rarity. A weapon that isn't listed can't roll {talent.name} (the game's Source list, recorded {sourcesRecorded}).</p>
          {sourceGroups.map((g) => (
            <div class="talent-sources__group">
              <h3 class="talent-sources__class">{classPlural[g.cls]} <span>{g.weapons.length}</span></h3>
              <ul class="weapon-chips">
                {g.weapons.map((w) => {
                  const icon = dbImage(`weapon-icons/${w.slug}`);
                  const body = (
                    <>
                      {icon && <img src={icon.src} srcset={icon.srcset.map(([iw, u]) => `${u} ${iw}w`).join(', ')} sizes="(max-width: 640px) 42vw, 150px" width={icon.width} height={icon.height} alt="" loading="lazy" decoding="async" />}
                      <span class="weapon-chip__name">{w.name}</span>
                      <span class="weapon-chip__tier">{w.tier}</span>
                    </>
                  );
                  return <li>{pagedWeapons.has(w.slug) ? <a class="weapon-chip" href={`/database/weapons/${w.slug}/`}>{body}</a> : <span class="weapon-chip">{body}</span>}</li>;
                })}
              </ul>
            </div>
          ))}
        </section>
      ) : exoticOf ? (
        <p class="item-note">{talent.name} is the <a href={`/database/exotic-weapons/${exoticOf.slug}/`}>{exoticOf.name}</a>'s own talent: it comes fixed on that exotic and never rolls on a standard weapon.</p>
      ) : null}

      <!-- Meta Builds (unique per item, only for pages with editorial notes) -->
      {notes && notes.metaBuilds?.length > 0 && (
        <div style="margin-bottom: var(--sp-8);">
          <h2 style="font-family: var(--font-heading); font-size: var(--text-lg); font-weight: 800; color: #fff; margin: 0 0 var(--sp-4) 0; padding-bottom: var(--sp-2); border-bottom: 1px solid rgba(255,255,255,0.08);">Meta Builds Running {talent.name}</h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--sp-3);">
            {notes.metaBuilds.map((b: any) => (
              <a href={b.url} style="display: block; padding: var(--sp-4); background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; text-decoration: none; color: #fff; font-weight: 600; transition: all 0.2s;">{b.title} &rarr;</a>
            ))}
          </div>
        </div>
      )}

      <!-- Patch History (unique per item) -->
      {notes && notes.patchHistory?.length > 0 && (
        <div style="margin-bottom: var(--sp-8);">
          <h2 style="font-family: var(--font-heading); font-size: var(--text-lg); font-weight: 800; color: #fff; margin: 0 0 var(--sp-4) 0; padding-bottom: var(--sp-2); border-bottom: 1px solid rgba(255,255,255,0.08);">Patch History</h2>
          {notes.patchHistory.map((p: any) => (
            <div style="padding: var(--sp-4); background: rgba(0,0,0,0.25); border-left: 3px solid var(--accent); border-radius: 0 8px 8px 0; margin-bottom: var(--sp-3);">
              <div style="font-family: var(--font-mono); font-size: var(--text-xs); color: var(--accent); margin-bottom: var(--sp-2);">{p.label} · {p.date}</div>
              <p style="margin: 0; color: var(--ink); line-height: 1.7; font-size: var(--text-sm);">{p.note} {p.sourceUrl && <a href={p.sourceUrl} style="color: var(--accent);">Patch notes &rarr;</a>}</p>
            </div>
          ))}
        </div>
      )}

      {talent.upgradedName && (
        <div style="margin-bottom: var(--sp-8);">
          <h2 style="font-family: var(--font-heading); font-size: var(--text-lg); font-weight: 800; color: var(--accent); margin: 0 0 var(--sp-4) 0; padding-bottom: var(--sp-2); border-bottom: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; gap: var(--sp-3);">
            {talent.icon && <img src={talent.icon.replace('.webp', '2.webp')} alt={talent.upgradedName} width="24" height="24" loading="lazy" style="width: 24px; height: 24px; object-fit: contain;" onerror="this.style.display='none'" />}
            Upgraded: {talent.upgradedName}
          </h2>
          <div style="padding: var(--sp-5); background: rgba(242,104,34,0.05); border-left: 3px solid var(--accent); border-radius: 0 8px 8px 0;">
            <p style="margin: 0; color: #e8e8f0; line-height: 1.75; font-size: var(--text-base); font-weight: 500;">{talent.upgradedDescription || 'Tier II values not recorded yet.'}</p>
          </div>
        </div>
      )}

      <DbItemExtras kind="weapon-talent" name={talent.name} drops={false} exclude={notes?.metaBuilds?.map((b: any) => b.url) ?? []} />

      <!-- Related links -->
      <div style="display: flex; flex-wrap: wrap; gap: var(--sp-3); padding-top: var(--sp-6); border-top: 1px solid rgba(255,255,255,0.08);">
        <a href="/database/weapon-talents/" style="font-family: var(--font-mono); font-size: var(--text-sm); color: var(--accent); text-decoration: none; padding: var(--sp-2) var(--sp-4); background: rgba(242,104,34,0.08); border: 1px solid rgba(242,104,34,0.2); border-radius: 6px; transition: all 0.2s;">&larr; All Weapon Talents</a>
        <a href="/database/weapons/" style="font-family: var(--font-mono); font-size: var(--text-sm); color: var(--accent); text-decoration: none; padding: var(--sp-2) var(--sp-4); background: rgba(242,104,34,0.08); border: 1px solid rgba(242,104,34,0.2); border-radius: 6px; transition: all 0.2s;">Weapons Database</a>
        <a href="/database/gear-set-effects/" style="font-family: var(--font-mono); font-size: var(--text-sm); color: var(--accent); text-decoration: none; padding: var(--sp-2) var(--sp-4); background: rgba(242,104,34,0.08); border: 1px solid rgba(242,104,34,0.2); border-radius: 6px; transition: all 0.2s;">Gear Sets</a>
        <a href="/database/os-protocols/" style="font-family: var(--font-mono); font-size: var(--text-sm); color: var(--accent); text-decoration: none; padding: var(--sp-2) var(--sp-4); background: rgba(242,104,34,0.08); border: 1px solid rgba(242,104,34,0.2); border-radius: 6px; transition: all 0.2s;">OS Protocols</a>
        <a href="/tier-list/" style="font-family: var(--font-mono); font-size: var(--text-sm); color: var(--accent); text-decoration: none; padding: var(--sp-2) var(--sp-4); background: rgba(242,104,34,0.08); border: 1px solid rgba(242,104,34,0.2); border-radius: 6px; transition: all 0.2s;">Tier List</a>
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .talent-sources { margin-bottom: var(--sp-8); }
  .talent-sources__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 800;
    color: #fff;
    margin: 0 0 var(--sp-3) 0;
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .talent-sources__lead { color: var(--ink); line-height: 1.7; font-size: var(--text-sm); margin: 0 0 var(--sp-5); }
  .talent-sources__group { margin-bottom: var(--sp-5); }
  .talent-sources__class {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin: 0 0 var(--sp-2);
  }
  .talent-sources__class span { color: var(--ink-muted); margin-left: 6px; }
  .weapon-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--sp-2);
  }
  .weapon-chips li { margin: 0; max-width: none; }
  .weapon-chip {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 6px 8px;
    align-items: center;
    height: 100%;
    padding: 8px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.07);
    background: rgba(0,0,0,0.22);
    color: #e8e8f0;
    text-decoration: none;
  }
  a.weapon-chip:hover { border-color: rgba(242,104,34,0.45); color: #fff; }
  .weapon-chip img { grid-column: 1 / -1; width: 100%; height: auto; border-radius: 4px; }
  .weapon-chip__name { font-size: var(--text-sm); font-weight: 600; line-height: 1.3; }
  .weapon-chip__tier {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-muted);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 4px;
    padding: 1px 5px;
  }
</style>
