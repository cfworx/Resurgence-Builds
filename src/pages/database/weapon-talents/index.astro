---
import DatabaseLayout from '../../../layouts/DatabaseLayout.astro';
import weaponTalents from '../../../data/weapon-talents.json';
import AdSenseUnit from '../../../components/AdSenseUnit.astro';
import DbIcon from '../../../components/DbIcon.astro';
import { verifiedPatch } from '../../../data/site-config';
import talentSources from '../../../data/weapon-talent-sources.json';
// All 69 talents were re-checked in the in-game Build-Making Database on 2026-10-28 (Season 2 Phase 2).
const lastVerified = verifiedPatch();

const title = "Division Resurgence Weapon Talents & Attachments Guide";
const description = "Every weapon talent in Division Resurgence. Some of these will triple your DPS. Most will make you wonder what Ubisoft was thinking.";
const breadcrumbs = [
  { name: 'Weapon Talents', url: '/database/weapon-talents/' }
];

const faqs = [
  { question: "What are weapon talents in Division Resurgence?", answer: "Weapon talents are passive or conditional bonuses that roll on weapons, and they can change how a gun performs, from stacking damage on consecutive hits to returning bullets to the magazine. A weapon carries two rolled talent lines (Died Again Gaming's Scorpio breakdown shows each line drawing from its own list), and exotics add their own fixed talent on top. Talents roll on tier 0 and tier 1 guns too, not just Tier 2, and they come in ranks: a rank II talent is about 1.4 times rank I, like Strained's 10% and 14% in Ubisoft's Season 2 Phase 2 notes. The talents are often more important than the base stats." },
  { question: "What is the best weapon talent in Division Resurgence?", answer: "The best weapon talent depends on your weapon type and build. For sustained DPS with ARs and LMGs, talents that ramp damage on hits are king. For burst damage with Marksman Rifles, look for talents that reward precision. SMG builds love anything that procs on close-range kills. Read the talent descriptions below and match one to how you actually play, not what sounds cool on paper." },
  { question: "Can you change weapon talents in Division Resurgence?", answer: "Yes, through recalibration, but it's a reroll, not a pick: the talent line comes back as a random talent from its pool. TikTokAndy landed Misdirection Insurance on his Double Barrel 'after like the third or the fourth roll' and called that insanely lucky, while the last talent on his Lightweight M4 kept coming out wrong roll after roll. Budget your materials before you chase one specific talent." },
];

function toSlug(name: string) {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}
// How many weapons can roll each talent: its Source list, recorded from the game.
const sourceTalents: Record<string, any> = (talentSources as any).talents;

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'The Division Resurgence Weapon Talents',
  description: description,
  numberOfItems: weaponTalents.length,
  itemListElement: weaponTalents.map((item: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${Astro.url.origin}/database/weapon-talents/${toSlug(item.name)}/`,
    item: {
      '@type': 'Thing',
      '@id': `${Astro.url.href}#item-${i}`,
      name: item.name || item.talent || item.attribute || item.protocolName || 'Item',
      description: item.description || item.talentDescription || item.effect || item.notes || `Details for ${item.name || item.talent || item.attribute || item.protocolName || 'item'}`,
      url: `${Astro.url.origin}/database/weapon-talents/${toSlug(item.name)}/`,
      subjectOf: { '@id': 'https://resurgencebuilds.com/#division-resurgence' }
    }
  })),
};
---

<DatabaseLayout
  {title}
  {description}
  {breadcrumbs}
  modified="2026-10-28"
  heading="Weapon Talents"
  subheading="The complete list of weapon talents and their effects. Slot the right one and watch your damage multiply obscenely."
  jsonLd={itemListLd}
  lastVerified={lastVerified}
  {faqs}
>
  <div class="db-grid" id="talents-grid">
    {weaponTalents.map((talent) => (
      <a href={`/database/weapon-talents/${toSlug(talent.name)}/`} class="db-card-link">
        <article class="db-card">
          <div class="db-card__header talent-head">
            <DbIcon id={`weapon-talents/${toSlug(talent.name)}`} size={52} />
            <h2 class="db-card__title">{talent.name}</h2>
          </div>
          
          <div class="db-card__body">
            <div class="talent-desc">
              <p>{talent.description}</p>
            </div>
            {sourceTalents[toSlug(talent.name)] && (
              <p class="talent-rolls">Rolls on {sourceTalents[toSlug(talent.name)].weapons.length} weapons</p>
            )}
          </div>
        </article>
      </a>
    ))}
  </div>
<AdSenseUnit label="Advertisement (database category)" />
</DatabaseLayout>

<style>
  /* Each card fills its grid cell, so the cards in a row line up whatever their text length. */
  .db-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .db-card-link .db-card {
    height: 100%;
  }
  .talent-head { justify-content: flex-start; align-items: center; flex-wrap: nowrap; }
  .talent-head .db-card__title { margin: 0; }
  .talent-rolls {
    margin: auto 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--accent);
  }
</style>
