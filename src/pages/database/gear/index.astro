---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionTag from '../../../components/SectionTag.astro';

const breadcrumbs = [
  { name: 'Database', url: '/database/' },
  { name: 'Gear', url: '/database/gear/' }
];

const title = "All Gear — Division Resurgence Database";
const description = "Complete Division Resurgence gear database. Every piece of High-End and Superior gear.";
const noindex = true;

---

<BaseLayout {title} {description} {breadcrumbs} noindex={true} noAds={true}>
  <div class="container section">
    <Breadcrumbs items={breadcrumbs} />
    <SectionTag label="Gear Database" />
    <h1 class="heading-accent">All Gear</h1>
    <p style="color: var(--ink-muted); margin-bottom: var(--sp-6); max-width: 800px;">
      Looking for gear info? Browse <a href="/database/gear-set-effects/">Gear Set Effects</a>, <a href="/database/body-armor-talents/">Body Armor Talents</a>, <a href="/database/backpack-talents/">Backpack Talents</a>, and <a href="/database/bonus-attributes/">Bonus Attributes</a> in the database.
    </p>
  </div>
</BaseLayout>
