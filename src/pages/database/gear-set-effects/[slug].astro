---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionTag from '../../../components/SectionTag.astro';
import AdSenseUnit from '../../../components/AdSenseUnit.astro';
import { truncateDesc, metaDescription } from '../../../utils/seo';
import gearSets from '../../../data/gear-set-effects.json';
import armoryGear from '../../../data/armory-gear.json';
import DbItemExtras from '../../../components/DbItemExtras.astro';
import { buildsWearingSet, buildSetLoadouts, fmtDate } from '../../../utils/db-enrich';
import { verifiedPatch, DATABASE_UPDATED } from '../../../data/site-config';
const lastVerified = verifiedPatch(); // Set text, tiers and Armory pieces re-checked in game on 2026-10-28 (Season 2 Phase 2). Pass an older label here if a later patch changes sets before they're re-checked.

export function getStaticPaths() {
  return gearSets.map((set: any) => ({
    params: {
      slug: set.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
    },
    props: { set }
  }));
}

const { set } = Astro.props;

const slug = set.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const siteUrl = 'https://resurgencebuilds.com';

// Analyze bonus text to determine build archetype
const allBonuses = `${set.bonus2} ${set.bonus3} ${set.bonus4}`.toLowerCase();

const isDPS = /weapon|crit|headshot|firepower|rate of fire|reload|magazine|accuracy|optimal range|multi-shot/.test(allBonuses);
const isSkill = /skill|engineering|signature ability/.test(allBonuses);
const isTank = /armor|health|damage reduction|toughness|received healing|extra protection/.test(allBonuses);
const isHealer = /healing intensity|extra protection|received healing/.test(allBonuses);
const isHybrid = (isDPS && isSkill) || (isDPS && isTank) || (isSkill && isTank);

const archetype = isHealer ? 'Healer/Support' :
                  isTank && !isDPS && !isSkill ? 'Tank' :
                  isSkill && !isDPS ? 'Skill DPS / Engineering' :
                  isDPS && !isSkill && !isTank ? 'Weapon DPS' :
                  isHybrid && isDPS && isSkill ? 'Hybrid DPS/Skill' :
                  isHybrid && isDPS && isTank ? 'Hybrid DPS/Tank' :
                  'Versatile';

const specRecommendation: Record<string, string> = {
  'Weapon DPS': 'Vanguard and Breacher builds that lead with bullets. Stack this with a Firepower OS Protocol and weapon talents like Killer, Concentrated Fire, or In Sync.',
  'Skill DPS / Engineering': 'Demolitionist and Tech Operator builds where your skills are doing the real work. Pair with an Engineering OS Protocol: Surgical Engineering or Tactical Layering are the move.',
  'Tank': 'Bulwark builds and face-tanking Field Medics. Run a Toughness OS Protocol like Pummeling Shield or Heavy Armor and become the team\'s human shield.',
  'Healer/Support': `Field Medic and support-focused builds. Your job is keeping everyone alive: stack Healing Intensity and pair with ${['Captain Cow', 'Dr. Medic'].filter((n) => n !== set.name).join(' or ')} pieces for maximum healing output.`,
  'Hybrid DPS/Skill': 'Builds that want their guns AND skills hitting hard. Tech Operators running Striker Drone + an AR, or Vanguards who lean on Scanning Pulse for crit buffs.',
  'Hybrid DPS/Tank': 'Bruiser builds: you want to deal damage AND eat shots. Bulwark Breachers or Vanguards who push aggressively into enemies.',
  'Versatile': 'Flexible enough to slot into multiple build types. Check what your 4-piece bonus actually does and build around that specific stat.',
};

const overviewGuide: Record<string, string> = {
  'Fury Strike': `Fury Strike is the go-to crit set in Division Resurgence. The 2-piece gives you extra range, the 3-piece adds Crit Chance, and the 4-piece stacks Crit Damage on top. If you're building a Vanguard or Breacher DPS that wants every shot to potentially delete something, this is your set. It rolls on every tier from T0 up, so you can start collecting pieces long before endgame.`,
  'Quick Draw': `Quick Draw is built for marksmen and headshot hunters. Reload Speed and Magazine Size at 2 and 3 pieces keep you in the fight, and the 4-piece bonus is a fat Headshot Damage boost. Pair this with a Marksman Rifle and the One Shot One Kill playstyle or run it on an AR build where you're consistently landing heads. If your aim is mid, think twice: the 4-piece only pays off on headshots.`,
  'Phalanx Attack': `Phalanx Attack is the sustained DPS king. Magazine Size, Rate of Fire, and Multi-Shot Chance: this set wants you to never stop shooting. It's the backbone of LMG builds running Strawberry Milkshake and a staple in any build that values total damage output over burst. Multi-Shot Chance at 4 pieces means every bullet has a chance to hit twice. On an LMG with 100-round mags, that's disgusting.`,
  'One Shot One Kill': `One Shot One Kill is a precision set for agents with good aim. Accuracy and Headshot Damage bonuses feed directly into Marksman Rifle and Rifle builds. The 4-piece adds +18% Firepower, the main weapon-damage attribute, so it lifts your body shots too. If you're hitting heads consistently, it's the headshot answer to Fury Strike's crits. It rolls on T1 and T2 gear, not T0.`,
  'Gunny Johnny': `Gunny Johnny is a workhorse DPS set that buffs your gun from every angle: Rate of Fire, Reload Speed, and flat Weapon Damage. It doesn't specialize in crits or headshots, so it works with any gun. It's also the only set whose 2-piece gives Rate of Fire, which is why TikTokAndy's Phalanx Attack Commando builds carry two pieces of it. One catch: it only rolls on T2 gear, so it's an endgame set, not a starter.`,
  'Mechanical Enemy': `Mechanical Enemy bridges the gap between weapon DPS and skill builds. Crit Chance and Optimal Range for your guns, plus Skill Cooldown Recovery for your skills. It's an oddball hybrid set: great for Tech Operators who shoot between skill deployments or Vanguards who want their Scanning Pulse back faster. Not best-in-slot for either role, but solid if you're juggling both. It only rolls on T2 gear.`,
  'Jackpot': `Jackpot is THE skill crit set. Skill Radius, Skill Crit Chance, and Skill Crit Damage: the entire set exists to make your skills crit harder. Tactical Pharma Field Medics and Tech Operators run it as the 4-piece in our build library, and PVE Enjoyer's Demolitionist carries a 2-piece next to Fire Cycle. Run 2 pieces of Jackpot with 4 pieces of another Engineering set, or go full 4-piece if you want maximum skill crit scaling.`,
  'Long-term Effect': `Long-term Effect is the core Engineering set. Skill Health keeps your deployables alive, Skill Duration extends their uptime, and the 4-piece gives you +18% Engineering, the only Engineering bonus on any gear set. That makes it the natural 4-piece for builds where skills do the work: Tampishach's Tech Aegis pairs it with two Jackpot pieces, and TikTokAndy's Aegis team healer with Mechanical Expert.`,
  'Dr. Medic': `Dr. Medic is a dedicated healer set. Healing Intensity, Skill Intensity, and Release Extra Protection: everything here is about keeping your team alive. Field Medic mains who run Support Station or Healing Hive should have this on their radar. It's not flashy, but when your squad survives a Legendary wipe because your heals actually chunked, you'll appreciate it.`,
  'Boom-Shakalaka': `Boom-Shakalaka is a skill utility set focused on cooldowns, radius, and intensity. The 4-piece Skill Intensity bonus amplifies everything your skills do: damage, healing, CC effects. In our build library it's a 2-piece pick for the cooldown, next to Mechanical Expert on AgentHuntzman's Recon Vanguard and next to Jackpot on LtFoe's Double Agent Tech Op. A Demolitionist who wants Seeker Mines and Turrets to cover more ground and cycle faster has a case for all four pieces. The name alone is worth running this set.`,
  'Fire Cycle': `Fire Cycle is for skill builds that want Signature Ability uptime and Multi-Shot procs. Skill Crit Damage at 2 pieces, Signature Ability Charge Efficiency at 3, and Skill Multi-Shot at 4. That last one gives every skill hit a chance to deal its damage an extra time. Demolitionist Artillery Turret and Explosive Seeker Mine builds get absurd value from this. It only rolls on T2 gear, which is why PVE Enjoyer's 333k Demolitionist build asks for Fire Cycle T2.`,
  'Mechanical Expert': `Mechanical Expert is all about Signature Ability uptime. Skill Duration and Cooldown Recovery keep your skills deployed, and the 4-piece gives you +24% Signature Ability Charge Efficiency, the biggest SACE bonus of any gear set (Fire Cycle's 3-piece is +18%). Run this if your build revolves around getting your Signature Ability as fast as possible, especially on Demolitionist or Vanguard.`,
  'Captain Cow': `Captain Cow is a healer/support hybrid with a funny name and serious utility. Movement Speed for repositioning, Skill Duration for keeping your heals active longer, and Healing Intensity at 4 pieces for fat heals. On paper it's made for Combat Medicine Field Medics running Support Station: the longer your station stays deployed, the more healing it pumps out. Don't let the name fool you, this set slaps.`,
  'Healing Elites': `Healing Elites is a tank/healer hybrid set that makes you nearly impossible to kill. Received Healing, Release Extra Protection, and a massive +28% Armor at 4 pieces. Bulwark builds running a Phalanx Shield become actual walls with this set. If your team's Field Medic is good, Healing Elites turns you into an unkillable raid boss. It only rolls on T2 gear, so plan on an endgame farm.`,
  'Self-Propelled Shield': `Self-Propelled Shield is a pure survivability set: Armor, Movement Speed, and Max Health. No damage bonuses, just raw stats that keep you alive. This is a tank set for Bulwark agents who want to push aggressively with a Phalanx Shield without getting melted. The Movement Speed bonus is underrated: a tank that can actually reposition is way more useful than a stationary one.`,
  'Fearless Warrior': `Fearless Warrior is the bruiser's gear set. Damage Reduction, Damage Bonus, and Toughness: it makes you tanky AND makes you hit harder. It suits any frontline build that refuses to choose between offense and defense, Bulwark Breachers included. Pair with a Toughness OS Protocol for disgusting survivability.`,
};

const overview = overviewGuide[set.name] || `${set.name} gives you ${set.bonus2} at 2 pieces, ${set.bonus3} at 3 pieces, and ${set.bonus4} at 4 pieces. Build around the 4-piece bonus: that's where the real power spike lives.`;

// Where it drops: the Armory lists the sets each gear piece can roll (2 on T0 pieces, 3 on T1, 4 on T2).
const SLOT_ORDER = ['Mask', 'Body Armor', 'Knee Pads', 'Backpack', 'Gloves', 'Holster'];
const tiers: string[] = set.tiers || [];
const listJoin = (xs: string[]) => xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`;
const tierList = (ts: string[]) => listJoin(ts);
const tierPieces = tiers.map((tier) => ({
  tier,
  pieces: armoryGear.pieces
    .filter((p) => p.tier === tier && p.sets.includes(set.name))
    .sort((a, b) => SLOT_ORDER.indexOf(a.slot) - SLOT_ORDER.indexOf(b.slot)),
}));
// Other sets the same pieces can roll, with the tiers where they share them.
const sisterSets = [...new Set(tierPieces.flatMap((t) => t.pieces.flatMap((p) => p.sets)))]
  .filter((n) => n !== set.name)
  .map((n) => ({ n, shared: tiers.filter((t) => tierPieces.find((x) => x.tier === t)?.pieces.some((p) => p.sets.includes(n))) }))
  .sort((a, b) => b.shared.length - a.shared.length || gearSets.findIndex((s) => s.name === a.n) - gearSets.findIndex((s) => s.name === b.n))
  .map(({ n, shared }) => shared.length === tiers.length ? n : `${n} (${tierList(shared)})`);
const tierPhrase = tiers.length === 3 ? 'T0, T1 and T2 gear' : tiers.length === 2 ? `${tierList(tiers)} gear, not T0` : `${tiers[0]} gear only`;
const pieceCount = tierPieces.reduce((n, t) => n + t.pieces.length, 0);
const countWord = (n: number) => ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'][n] ?? String(n);
const dropIntro = `${set.name} rolls on ${tierPhrase}. The Armory shows one piece per slot${tiers.length > 1 ? ' at each tier' : ''} that can carry it, ${countWord(pieceCount)} in all. The same pieces can also come with ${listJoin(sisterSets)}, so a drop of one of them isn't always ${set.name}.`;
const LATER_TIERS = 'T2 comes at level 40 from daily quests, Elite missions and their weekly chest, and Legendary runs.';
const farmTip = tiers[0] === 'T0'
  ? `T0 pieces come from the story, but AgentHuntzman's advice is to build your first real set on T1, which starts dropping around Challenging difficulty and becomes the farm on Heroic. ${LATER_TIERS}`
  : tiers[0] === 'T1'
  ? `You won't see it on T0 story gear. T1 starts dropping around Challenging difficulty and becomes the farm on Heroic. ${LATER_TIERS}`
  : `T2 drops at level 40: daily quests have a chance at it (Ubisoft's Season 2 Phase 2 notes), and creators point at Elite missions, the weekly Elite chest and Legendary runs.`;

// Build guides on this site that wear the set, read from each guide's planner link.
const wearers = await buildsWearingSet(set.id);
const totalLoadouts = (await buildSetLoadouts()).length;
const asFour = wearers.filter((w) => w.pieces >= 4);
const asPart = wearers.filter((w) => w.pieces < 4);
const num = countWord;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const partSizes = [...new Set(asPart.map((w) => w.pieces))];
const partDesc = partSizes.length === 1 ? `${num(partSizes[0])} pieces` : 'a few pieces';
const wearerName = (w: { title: string; creator: string | null }) => w.creator && !w.title.includes(w.creator) ? `${w.creator}'s ${w.title}` : w.title;
const usageLine = wearers.length === 0
  ? `None of the ${totalLoadouts} build guides on our site wear ${set.name} yet.`
  : `${asFour.length ? `${cap(num(asFour.length))} of the ${totalLoadouts} build guides on our site ${asFour.length === 1 ? 'runs' : 'run'} it as the 4-piece` : `None of the ${totalLoadouts} build guides on our site run it as the 4-piece`}${asPart.length ? `${asFour.length ? ` and ${num(asPart.length)} more` : `, but ${num(asPart.length)}`} ${asPart.length === 1 ? 'wears' : 'wear'} ${partDesc} beside another set` : ''}.`;

const title = `${set.name} Gear Set`;
const description = metaDescription(set.summary, `${set.name} gear set in The Division Resurgence: 2, 3 and 4-piece bonuses, the ${tierList(tiers)} gear it rolls on, and the builds that run it.`);

const breadcrumbs = [
  { name: 'Gear Sets', url: '/database/gear-set-effects/' },
  { name: set.name, url: '#' }
];

const faqs = [
  {
    question: `Is ${set.name} good in Division Resurgence?`,
    answer: `${set.name} is a ${archetype} gear set: ${set.bonus2} at 2 pieces, ${set.bonus3} at 3 and ${set.bonus4} at 4. ${usageLine} ${wearers.length ? 'They are listed on this page.' : 'Whether it works for you comes down to how much your build leans on those stats.'}`
  },
  {
    question: `What builds use ${set.name} in Division Resurgence?`,
    answer: `${wearers.length ? `On our site: ${listJoin(wearers.map((w) => `${wearerName(w)} (${w.pieces}-piece${w.partner ? `, with ${w.partnerPieces}-piece ${w.partner}` : ''})`))}. ` : `None of our ${totalLoadouts} build guides wear it yet. `}On paper it fits ${specRecommendation[archetype] || 'builds that stack the stats this set provides. Check the 4-piece bonus and build around it.'}`
  },
  {
    question: `Where does ${set.name} drop in Division Resurgence?`,
    answer: `${set.name} rolls on ${tierPhrase}, per the in-game Armory and the Build-Making Database (checked October 28, 2026). ${farmTip} Our gear farming guide covers where each tier drops.`
  }
];

const setLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: `${siteUrl}/database/gear-set-effects/${slug}/`,
  author: { '@type': 'Person', '@id': `${siteUrl}/author/rapidf5/#person`, name: 'RapidF5' },
  publisher: { '@type': 'Organization', '@id': `${siteUrl}/#organization`, name: 'Resurgence Builds' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${siteUrl}/database/gear-set-effects/${slug}/` },
  datePublished: '2026-05-30',
  dateModified: DATABASE_UPDATED,
  image: { '@type': 'ImageObject', url: `${siteUrl}/images/resurgence-builds-official-logo.png`, width: 800, height: 800 },
  inLanguage: 'en-US',
  lastReviewed: set.verifiedInGame || '2026-05-30',
  wordCount: 500,
  about: { '@id': `${siteUrl}/#division-resurgence` },
};

const bonuses = [
  { count: 2, label: '2-Piece Bonus', value: set.bonus2, color: '#3b82f6', bg: 'rgba(59,130,246,0.1)', border: 'rgba(59,130,246,0.25)' },
  { count: 3, label: '3-Piece Bonus', value: set.bonus3, color: '#a855f7', bg: 'rgba(168,85,247,0.1)', border: 'rgba(168,85,247,0.25)' },
  { count: 4, label: '4-Piece Bonus', value: set.bonus4, color: '#F5CC45', bg: 'rgba(245,204,69,0.1)', border: 'rgba(245,204,69,0.25)' },
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} jsonLd={setLd} faqs={faqs}>
  <div class="container section">
    <Breadcrumbs items={breadcrumbs} />
    <SectionTag label="Gear Set" />

    <div class="gearset-detail">
      <!-- Header -->
      <div class="gearset-header">
        <div class="gearset-header__top">
          <h1 class="gearset-title">{set.name}</h1>
          <span class="gearset-archetype-badge">{archetype}</span>
        </div>
        <div class="gearset-verified">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          <span>Last verified for <strong>{lastVerified}</strong></span>
        </div>
      </div>

      <!-- Overview -->
      <div class="gearset-section">
        <h2 class="gearset-section__title">Overview</h2>
        <div class="gearset-prose">
          <p>{overview}</p>
        </div>
      </div>

      <!-- Set Bonuses -->
      <div class="gearset-section">
        <h2 class="gearset-section__title">Set Bonuses</h2>
        <div class="gearset-bonuses-grid">
          {bonuses.map((bonus) => (
            <div class="gearset-bonus-card" style={`border-color: ${bonus.border}; background: ${bonus.bg};`}>
              <div class="gearset-bonus-card__header">
                <span class="gearset-bonus-count" style={`background: ${bonus.color}; color: #000;`}>{bonus.count}</span>
                <span class="gearset-bonus-label">{bonus.label}</span>
              </div>
              <p class="gearset-bonus-value">{bonus.value}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Where it drops -->
      <div class="gearset-section">
        <h2 class="gearset-section__title">Where It Drops</h2>
        <div class="gearset-prose">
          <p>{dropIntro}</p>
          <p>{farmTip} Our <a href="/guides/division-resurgence-gear-farming-guide/">gear farming guide</a> has the details.</p>
        </div>
        <div class="gearset-tiers">
          {tierPieces.map(({ tier, pieces }) => (
            <section class="gearset-tier" aria-label={`${tier} pieces that can roll ${set.name}`}>
              <h3 class="gearset-tier__title"><span class="gearset-tier__badge">{tier}</span> pieces</h3>
              <ul class="gearset-pieces">
                {pieces.map((p) => (
                  <li><span class="gearset-pieces__slot">{p.slot}</span><span class="gearset-pieces__name">{p.name}</span></li>
                ))}
              </ul>
            </section>
          ))}
        </div>
        <p class="gearset-note">Source: the in-game Armory (its Season 1 pages show the sets each gear piece can roll) and this set's Source list in the Build-Making Database, both checked {fmtDate(armoryGear.checked)}.</p>
      </div>

      <!-- Best Builds -->
      <div class="gearset-section">
        <h2 class="gearset-section__title">Best Builds & Playstyles</h2>
        <div class="gearset-prose">
          <p><strong style="color: #fff;">Build Archetype:</strong> <span style={`color: ${isDPS ? 'var(--accent)' : isSkill ? '#F5CC45' : isTank ? '#3a7bd5' : '#6DAA45'};`}>{archetype}</span></p>
          <p>{specRecommendation[archetype] || 'This set works best when you build around the 4-piece bonus. Check what stat it provides and pick a specialization, OS Protocol, and weapon talents that multiply that stat.'}</p>
          <p>Most endgame builds run a 4-piece gear set core with 2 pieces from a complementary set. {usageLine}</p>
        </div>
        {wearers.length > 0 && (
          <ul class="gearset-builds">
            {wearers.map((w) => (
              <li>
                <a href={w.url}>{w.title}</a>
                <span class="gearset-builds__meta">{w.creator && !w.title.includes(w.creator) ? `${w.creator} · ` : ''}{w.specialization} · {w.pieces}-piece{w.partner ? `, with ${w.partnerPieces}-piece ${w.partner}` : ''}</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- FAQ (the same questions go into the page's FAQ structured data) -->
      <div class="gearset-section faq-section">
        <h2 class="gearset-section__title">Frequently Asked Questions</h2>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details class="faq-item">
              <summary class="faq-question">{faq.question}</summary>
              <p class="faq-answer">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>

      <DbItemExtras kind="gear-set" name={set.name} drops={false} exclude={wearers.map((w) => w.url)} />

      <!-- Related Links -->
      <div class="gearset-related">
        <a href="/database/gear-set-effects/" class="gearset-link">&larr; All Gear Sets</a>
        <a href="/database/os-protocols/" class="gearset-link">OS Protocols</a>
        <a href="/tier-list/" class="gearset-link">Build Tier List</a>
        <a href="/builder/" class="gearset-link">Build Planner</a>
      </div>
    </div>

    <AdSenseUnit label="Advertisement (database item)" />
  </div>
</BaseLayout>

<style>
  .gearset-detail {
    max-width: 700px;
  }

  .gearset-header {
    margin-bottom: var(--sp-8);
  }

  .gearset-header__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
  }

  .gearset-title {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin: 0;
    background: linear-gradient(135deg, #fff 60%, var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .gearset-archetype-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    background: rgba(242,104,34,0.12);
    border: 1px solid rgba(242,104,34,0.25);
    padding: 5px 14px;
    border-radius: 999px;
  }

  .gearset-verified {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: #6DAA45;
    background: rgba(109, 170, 69, 0.1);
    border: 1px solid rgba(109, 170, 69, 0.25);
    padding: 6px 14px;
    border-radius: 999px;
    margin-top: var(--sp-4);
    letter-spacing: 0.02em;
  }

  /* Sections */
  .gearset-section {
    margin-bottom: var(--sp-8);
  }

  .gearset-section__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 800;
    color: #fff;
    margin: 0 0 var(--sp-4) 0;
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .gearset-prose {
    color: #c8c8d0;
    line-height: 1.75;
    font-size: var(--text-base);
  }

  .gearset-prose p {
    margin: 0 0 var(--sp-4) 0;
  }

  .gearset-prose p:last-child {
    margin-bottom: 0;
  }

  .gearset-prose ul {
    padding-left: var(--sp-6);
    margin: var(--sp-3) 0 var(--sp-4) 0;
  }

  .gearset-prose li {
    margin-bottom: var(--sp-2);
    color: #c8c8d0;
    line-height: 1.7;
  }

  /* Bonuses Grid */
  .gearset-bonuses-grid {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

