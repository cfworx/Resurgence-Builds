---
import DatabaseLayout from '../../../layouts/DatabaseLayout.astro';
import bonusAttributes from '../../../data/bonus-attributes.json';
import AdSenseUnit from '../../../components/AdSenseUnit.astro';
import { verifiedPatch } from '../../../data/site-config';
import { attrGuide, statInteraction } from '../../../data/bonus-attribute-guides';
import inGame from '../../../data/bonus-attributes-in-game.json';

// Laid out as cards you can open (Cory, November 5: the old page was one long column of text). Each card shows
// the stat's own description from the in-game Build-Making Database (checked October 28, 2026); our notes open
// under it. Ids stay the attribute slugs, so links like #weapon-critical-hit-chance still land on the card.
const gameText = (name: string): string | undefined => (inGame.descriptions as Record<string, string>)[name];
// Not in the Build-Making Database's list yet: Season 2 Phase 1 added them to weapon rolls
const SHORT_TEXT: Record<string, string> = {
  'All Weapon Damage': 'Raises weapon damage of every damage type. Weapons roll it since Season 2 Phase 1.',
  'All Skill Damage': 'Raises skill damage of every damage type. Weapons roll it since Season 2 Phase 1.',
};
// Damage-type attributes: still listed by the in-game database, out of weapon rolls since Season 2 Phase 1
const damageTypeAttrs: string[] = inGame.listed.filter((n: string) => /(Blast|Piercing|Shredding) Damage$/.test(n));
const lastVerified = verifiedPatch('Patch 1.2.1'); // Bump: drop the arg ONLY after re-verifying this page's content in-game (CURRENT_PATCH is a ceiling, not an auto-bump)

const attrCount = bonusAttributes.reduce((n: number, c: any) => n + c.attributes.length, 0);
const title = `Bonus Attributes: All ${attrCount} Stats Explained`;
const description = "Every bonus attribute that can roll on your gear in Division Resurgence, organized by Firepower, Toughness, Engineering, and Universal pools. Know your rolls or suffer.";
const breadcrumbs = [
  { name: 'Weapon/Gear Bonus Attributes', url: '/database/bonus-attributes/' }
];

const toSlug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const POOL: Record<string, { color: string; icon: string }> = {
  Firepower: { color: '#F87171', icon: 'M12 2v4M12 18v4M2 12h4M18 12h4M12 8a4 4 0 100 8 4 4 0 000-8z' },
  Toughness: { color: '#60A5FA', icon: 'M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6l8-3z' },
  Engineering: { color: '#FACC15', icon: 'M12 9a3 3 0 100 6 3 3 0 000-6zM19.4 15a1.7 1.7 0 00.3 1.8l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.8-.3 1.7 1.7 0 00-1 1.5V21a2 2 0 11-4 0v-.1a1.7 1.7 0 00-1.1-1.5 1.7 1.7 0 00-1.8.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.8 1.7 1.7 0 00-1.5-1H3a2 2 0 110-4h.1a1.7 1.7 0 001.5-1.1 1.7 1.7 0 00-.3-1.8l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.8.3H9a1.7 1.7 0 001-1.5V3a2 2 0 114 0v.1a1.7 1.7 0 001 1.5 1.7 1.7 0 001.8-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.8V9a1.7 1.7 0 001.5 1H21a2 2 0 110 4h-.1a1.7 1.7 0 00-1.5 1z' },
  Universal: { color: '#C4C7CE', icon: 'M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6 6.6 19.5l1.2-6L3.3 9.3l6.1-.7L12 3z' },
  'Damage type': { color: '#9CA3AF', icon: 'M4 20L20 4M8 4h12v12' },
};

type Card = { name: string; slug: string; pool: string; text?: string };
const groups: { pool: string; id: string; cards: Card[]; note?: string }[] = [
  ...bonusAttributes.map((c: any) => ({
    pool: c.category,
    id: toSlug(c.category),
    cards: c.attributes.map((a: string) => ({ name: a, slug: toSlug(a), pool: c.category, text: gameText(a) || SHORT_TEXT[a] })),
  })),
  {
    pool: 'Damage type',
    id: 'damage-type-attributes',
    note: 'Still in the game\'s list, but weapons stopped rolling these in Season 2 Phase 1 (they roll All Weapon or All Skill Damage instead). Older weapons keep the rolls they had.',
    cards: damageTypeAttrs.map((a) => ({ name: a, slug: toSlug(a), pool: 'Damage type', text: gameText(a) })),
  },
];
const total = groups.reduce((n, g) => n + g.cards.length, 0);

// The quick answer: which stats each kind of build chases (the same picks as the FAQ below)
const PICKS = [
  { label: 'Gun damage', pool: 'Firepower', attrs: ['Weapon Critical Hit Chance', 'Weapon Critical Hit Damage'] },
  { label: 'Tanks', pool: 'Toughness', attrs: ['Max Health', 'Armor', 'Damage Reduction'] },
  { label: 'Skill builds', pool: 'Engineering', attrs: ['Skill Intensity', 'Skill Cooldown Recovery'] },
  { label: 'Any build', pool: 'Universal', attrs: ['Damage to Elites', 'Received Healing'] },
];

const faqs = [
  { question: "What are bonus attributes in Division Resurgence?", answer: "Bonus attributes are the secondary stats that roll on gear and weapons next to the core stats. A gear piece shows Firepower, Toughness and Engineering values together, plus two bonus attributes such as Weapon Critical Hit Chance, Skill Intensity or Damage Reduction. We group the attributes by the core stat they feed, but a piece isn't locked to one group: TikTokAndy's Tier 1 body armor with a strong Firepower roll came with Skill Cooldown Recovery next to Weapon Critical Hit Damage." },
  { question: "What bonus attributes should I prioritize in Division Resurgence?", answer: "For DPS builds: Weapon Critical Hit Chance and Weapon Critical Hit Damage are king. For tank builds: Max Health, Armor, and Damage Reduction. For skill builds: Skill Intensity and Skill Cooldown Recovery. Universal attributes like Damage to Elites and Received Healing fit any build. The right bonus attributes turn a mediocre build into something that actually melts." },
  { question: "Can you recalibrate bonus attributes in Division Resurgence?", answer: "Yes, but it's a reroll, not a pick. Creators spend recalibration manuals to reroll one attribute line, and the result is random: TikTokAndy rerolls his mask's Armor line hoping for Skill Critical Damage, says the manuals (his 'books') are at a premium, and Died Again Gaming remembers wasting booklets on rolls that came back useless. Spend them on the line that's furthest from what your build wants." },
];

const allAttrs: Array<{ name: string; category: string }> = [];
bonusAttributes.forEach((cat: any) => cat.attributes.forEach((attr: string) => allAttrs.push({ name: attr, category: cat.category })));
const siteUrl = 'https://resurgencebuilds.com';
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'The Division Resurgence Weapon/Gear Bonus Attributes',
  description,
  numberOfItems: allAttrs.length,
  itemListElement: allAttrs.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${siteUrl}/database/bonus-attributes/#${toSlug(item.name)}`,
    item: {
      '@type': 'Thing',
      '@id': `${siteUrl}/database/bonus-attributes/#${toSlug(item.name)}`,
      name: item.name,
      description: `${item.name}, a ${item.category} bonus attribute in Division Resurgence`,
      url: `${siteUrl}/database/bonus-attributes/#${toSlug(item.name)}`,
      subjectOf: { '@id': 'https://resurgencebuilds.com/#division-resurgence' }
    }
  })),
};
---

<DatabaseLayout
  {title}
  {description}
  {breadcrumbs}
  modified="2026-10-28"
  heading="Bonus Attributes"
  subheading={`All ${attrCount} stats that roll on your gear and guns, by the core stat they feed. Open any card for the details.`}
  jsonLd={itemListLd}
  lastVerified={lastVerified}
  {faqs}
>
  <!-- The quick answer -->
  <section class="ab-pick" aria-labelledby="ab-pick-h">
    <h2 class="ab-h2" id="ab-pick-h">What to chase</h2>
    <div class="ab-pick__grid">
      {PICKS.map((p) => (
        <div class="ab-pick__col" style={`--pool:${POOL[p.pool].color}`}>
          <h3 class="ab-pick__label">{p.label}</h3>
          <ul class="ab-pick__chips">
            {p.attrs.map((a) => <li><a class="ab-chip" href={`#${toSlug(a)}`} data-open={toSlug(a)}>{a}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Show one pool at a time -->
  <div class="ab-filter" role="group" aria-label="Show">
    <button type="button" class="ab-filter__btn" data-filter="all" aria-pressed="true">All <span>{total}</span></button>
    {groups.map((g) => (
      <button type="button" class="ab-filter__btn" data-filter={g.id} aria-pressed="false" style={`--pool:${POOL[g.pool].color}`}>
        <i aria-hidden="true"></i>{g.pool === 'Damage type' ? 'Old damage types' : g.pool} <span>{g.cards.length}</span>
      </button>
    ))}
  </div>

  <div class="ab-groups" id="ab-groups" data-show="all">
    {groups.map((g) => (
      <section class="ab-pool" id={g.id} data-group={g.id} style={`--pool:${POOL[g.pool].color}`} aria-labelledby={`${g.id}-h`}>
        <h2 class="ab-pool__h" id={`${g.id}-h`}>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={POOL[g.pool].icon} /></svg>
          {g.pool === 'Damage type' ? 'Old damage types' : g.pool}
          <span class="ab-pool__n">{g.cards.length}</span>
        </h2>
        {g.note && <p class="ab-pool__note">{g.note}</p>}
        <div class="ab-grid">
          {g.cards.map((c) => {
            const info = attrGuide[c.name];
            const works = statInteraction[c.slug];
            return (
              <details class="ab-card" id={c.slug} data-pool-name={g.pool === 'Damage type' ? 'Old damage type' : g.pool}>
                <summary class="ab-card__top">
                  <span class="ab-card__name">{c.name}</span>
                  {c.text && <span class="ab-card__text">{c.text}</span>}
                  <span class="ab-card__chev" aria-hidden="true"></span>
                </summary>
                {info && (
                  <div class="ab-card__more">
                    <p class="ab-card__lead">{info.overview}</p>
                    <dl>
                      {info.bestBuilds && <div><dt>Best builds</dt><dd>{info.bestBuilds}</dd></div>}
                      {info.howToGet && <div><dt>How to get it</dt><dd>{info.howToGet}</dd></div>}
                      {info.whyItMatters && <div><dt>Why it matters</dt><dd>{info.whyItMatters}</dd></div>}
                      {works && <div><dt>Works with</dt><dd>{works}</dd></div>}
                    </dl>
                  </div>
                )}
              </details>
            );
          })}
        </div>
      </section>
    ))}
  </div>

  <!-- How rolls work, in four lines -->
  <section class="ab-facts" aria-labelledby="ab-facts-h">
    <h2 class="ab-h2" id="ab-facts-h">How rolls work</h2>
    <ul class="ab-facts__grid">
      <li><b>2 per piece</b><span>High-End gear and weapons come with 2 different bonus attributes. Superior gear gets 1.</span></li>
      <li><b>Pools mix</b><span>A piece isn't locked to its biggest core stat: Firepower gear can still roll a skill stat.</span></li>
      <li><b>Reroll one line</b><span>Recalibration rerolls one attribute at random, so spend manuals on your worst line.</span></li>
      <li><b>Season 2 Phase 1</b><span>Weapons now roll All Weapon or All Skill Damage instead of Blast, Piercing or Shredding.</span></li>
    </ul>
    <details class="ab-mods">
      <summary>Mod changes in Season 2 Phase 1</summary>
      <ul>
        <li>Weapon mods: main stat +100%, attribute bonuses -25%.</li>
        <li>New weapon mods roll Weapon Damage, Skill Intensity, Headshot Damage, Weapon Critical Hit Damage and Skill Critical Damage instead of damage-type and All Damage rolls. Mods you already own keep theirs.</li>
        <li>Gear mods lost Elite Enemy and Enemy Leader Resistance, and can now roll Max Health, Armor, Received Healing, weapon and skill crit chance, crit damage and multi-shot, Weapon Damage, Skill Intensity, Headshot Damage and Signature Ability Charge Efficiency.</li>
      </ul>
      <p>More on how the core stats, crits and talents fit together in our <a href="/guides/division-resurgence-stats-explained/">stats guide</a>.</p>
    </details>
  </section>

  <AdSenseUnit label="Advertisement (database category)" />

  <!-- One panel for every card's details (the cards still open in place without JavaScript) -->
  <dialog class="ab-sheet" id="ab-sheet" aria-labelledby="ab-sheet-title">
    <div class="ab-sheet__panel">
      <header class="ab-sheet__hd">
        <span class="ab-sheet__pool" id="ab-sheet-pool"></span>
        <h2 class="ab-sheet__title" id="ab-sheet-title"></h2>
        <p class="ab-sheet__game" id="ab-sheet-game"></p>
        <button type="button" class="ab-sheet__x" id="ab-sheet-x" aria-label="Close">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </header>
      <div class="ab-sheet__body" id="ab-sheet-body"></div>
      <footer class="ab-sheet__ft">
        <button type="button" class="ab-sheet__nav" id="ab-sheet-prev"><span aria-hidden="true">&#8249;</span> <span id="ab-sheet-prev-name"></span></button>
        <button type="button" class="ab-sheet__nav ab-sheet__nav--next" id="ab-sheet-next"><span id="ab-sheet-next-name"></span> <span aria-hidden="true">&#8250;</span></button>
      </footer>
    </div>
  </dialog>

<style>
  .ab-h2 { margin: 0 0 var(--sp-3); font-family: var(--font-heading); font-size: var(--step-1); font-weight: 800; color: var(--ink-heading, #fff); }
  .ab-h2::before, .ab-h2::after { display: none; }

  /* What to chase: four short columns of chips */
  .ab-pick { margin: var(--sp-6) 0 var(--sp-6); }
  .ab-pick__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-3); }
  @media (min-width: 60em) { .ab-pick__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .ab-pick__col {
    padding: var(--sp-3); border-radius: 10px; min-width: 0;
    background: color-mix(in srgb, var(--pool) 7%, #141519); border: 1px solid color-mix(in srgb, var(--pool) 28%, transparent);
  }
  .ab-pick__label { margin: 0 0 var(--sp-2); font-family: var(--font-heading); font-size: var(--step--1); font-weight: 800; color: var(--pool); }
  .ab-pick__label::before, .ab-pick__label::after { display: none; }
  .ab-pick__chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .ab-pick__chips li { margin: 0; max-width: 100%; }
  .ab-chip {
    display: inline-flex; align-items: center; min-height: 32px; padding: 4px 10px; max-width: 100%;
    border-radius: 999px; background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.1);
    color: #e8e8ec; font-size: var(--step--2); font-weight: 600; line-height: 1.25; text-decoration: none;
  }
  .ab-chip:hover { border-color: var(--pool); color: #fff; }
  @media (pointer: coarse) { .ab-chip { min-height: 44px; } }

  /* Filter chips */
  .ab-filter { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin: 0 0 var(--sp-6); }
  .ab-filter__btn {
    display: inline-flex; align-items: center; gap: 7px; min-height: var(--control); padding: 0 14px;
    border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(0, 0, 0, 0.3);
    color: #c8c8d0; font: 600 var(--step--1)/1 var(--font-body, inherit); cursor: pointer;
  }
  .ab-filter__btn i { width: 9px; height: 9px; border-radius: 50%; background: var(--pool, var(--accent)); }
  .ab-filter__btn span { color: var(--ink-muted); font-weight: 500; }
  .ab-filter__btn:hover { border-color: rgba(255, 255, 255, 0.3); color: #fff; }
  .ab-filter__btn[aria-pressed="true"] { border-color: var(--pool, var(--accent)); background: color-mix(in srgb, var(--pool, var(--accent)) 14%, transparent); color: #fff; }

  /* Pools */
  .ab-groups[data-show]:not([data-show="all"]) .ab-pool { display: none; }
  .ab-groups[data-show="firepower"] .ab-pool[data-group="firepower"],
  .ab-groups[data-show="toughness"] .ab-pool[data-group="toughness"],
  .ab-groups[data-show="engineering"] .ab-pool[data-group="engineering"],
  .ab-groups[data-show="universal"] .ab-pool[data-group="universal"],
  .ab-groups[data-show="damage-type-attributes"] .ab-pool[data-group="damage-type-attributes"] { display: block; }
  .ab-pool { margin: 0 0 var(--sp-8); scroll-margin-top: calc(var(--nav-height, 64px) + 16px); }
  .ab-pool__h {
    display: flex; align-items: center; gap: 10px; margin: 0 0 var(--sp-3); padding: 0; border: 0; background: none;
    font-family: var(--font-heading); font-size: var(--step-2); font-weight: 900; color: var(--pool);
  }
  .ab-pool__h::before, .ab-pool__h::after { display: none; }
  .ab-pool__n { font-family: var(--font-body, inherit); font-size: var(--step--1); font-weight: 600; color: var(--ink-muted); }
  .ab-pool__note { max-width: 70ch; margin: calc(var(--sp-2) * -1) 0 var(--sp-3); color: #b8b8c0; font-size: var(--step--1); line-height: var(--lh-small); }

  /* Cards: the stat's in-game description up front, our notes when opened */
  /* phones: two columns of names (the description is in the panel); wider: the description on the card */
  .ab-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-2); }
  @media (min-width: 40em) { .ab-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-3); } }
  @media (min-width: 64em) { .ab-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .ab-card {
    min-width: 0; border-radius: 10px; scroll-margin-top: calc(var(--nav-height, 64px) + 16px); cursor: pointer;
    background: linear-gradient(180deg, #18191d, #121316); border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow: inset 3px 0 0 var(--pool);
    transition: border-color 0.15s ease;
  }
  .ab-card:hover { border-color: color-mix(in srgb, var(--pool) 45%, transparent); }
  .ab-card[open] { grid-column: 1 / -1; border-color: color-mix(in srgb, var(--pool) 55%, transparent); cursor: auto; }
  .ab-card:target, .ab-card.is-flash { animation: ab-flash 1.4s ease-out; }
  @keyframes ab-flash { 0% { box-shadow: inset 3px 0 0 var(--pool), 0 0 0 2px var(--pool); } 100% { box-shadow: inset 3px 0 0 var(--pool), 0 0 0 0 transparent; } }
  .ab-card__top {
    position: relative; display: flex; flex-direction: column; gap: 6px; min-height: 84px;
    padding: 14px 44px 14px 18px; cursor: pointer; list-style: none;
  }
  .ab-card__top::-webkit-details-marker { display: none; }
  .ab-card__top:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; border-radius: 10px; }
  @supports selector(:has(a)) {
    .ab-card__top:focus-visible { outline: none; }
    .ab-card:has(> .ab-card__top:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
  }
  .ab-card__name { font-family: var(--font-heading); font-size: var(--step-0); font-weight: 800; line-height: 1.2; color: #fff; }
  .ab-card__text { font-size: var(--step--1); line-height: 1.45; color: #b9bcc4; }
  .ab-card__chev { position: absolute; top: 17px; right: 14px; width: 14px; height: 14px; }
  .ab-card__chev::before, .ab-card__chev::after {
    content: ''; position: absolute; left: 0; top: 6px; width: 14px; height: 2px; border-radius: 1px;
    background: var(--ink-muted); transition: transform 0.2s ease, background-color 0.15s ease;
  }
  .ab-card__chev::after { transform: rotate(90deg); }
  .ab-card:hover .ab-card__chev::before, .ab-card:hover .ab-card__chev::after,
  .ab-card[open] .ab-card__chev::before, .ab-card[open] .ab-card__chev::after { background: var(--pool); }
  .ab-card[open] .ab-card__chev::after { transform: rotate(0deg); }
  .ab-card__more { padding: 0 18px 16px; border-top: 1px solid rgba(255, 255, 255, 0.06); font-size: var(--step--1); line-height: var(--lh-small, 1.55); color: #c8c8d0; }
  .ab-card__more p, .ab-card__more dd { max-width: none; }
  .ab-card__lead { margin: 12px 0; color: #e2e2e8; }
  .ab-card__more dl { display: grid; gap: 10px; margin: 0; }
  .ab-card__more dt { margin: 0 0 2px; font-weight: 700; font-size: var(--step--2); color: var(--pool); }
  .ab-card__more dd { margin: 0; }
  /* Phones: names only, two to a row (after the rules above so these win) */
  @media (max-width: 39.99em) {
    .ab-card__top { min-height: 64px; padding: 12px 30px 12px 14px; justify-content: center; }
    .ab-card__name { font-size: var(--step--1); hyphens: auto; }
    .ab-card:not([open]) .ab-card__text { display: none; }
    .ab-card:not([open]) .ab-card__chev { top: 50%; right: 10px; margin-top: -7px; }
  }

  /* How rolls work */
  .ab-facts { margin: var(--sp-4) 0 var(--sp-8); }
  .ab-facts__grid { list-style: none; margin: 0 0 var(--sp-3); padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--sp-3); }
  @media (min-width: 40em) { .ab-facts__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64em) { .ab-facts__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .ab-facts__grid li {
    display: flex; flex-direction: column; gap: 4px; margin: 0; padding: var(--sp-3) var(--sp-4); max-width: none;
    border-radius: 10px; background: rgba(0, 0, 0, 0.25); border: 1px solid rgba(255, 255, 255, 0.07);
  }
  .ab-facts__grid b { font-family: var(--font-heading); font-size: var(--step-0); font-weight: 800; color: var(--accent); }
  .ab-facts__grid span { font-size: var(--step--1); line-height: 1.45; color: #c8c8d0; }
  .ab-mods { border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px; background: rgba(0, 0, 0, 0.2); }
  .ab-mods summary { display: flex; align-items: center; min-height: var(--control); padding: 0 var(--sp-4); cursor: pointer; font-weight: 600; color: #e2e2e8; }
  .ab-mods summary:hover { color: var(--accent); }
  .ab-mods ul { margin: 0; padding: 0 var(--sp-4) 0 calc(var(--sp-4) * 2); color: #c8c8d0; font-size: var(--step--1); line-height: 1.55; }
  .ab-mods li { margin: 0 0 6px; max-width: 75ch; }
  .ab-mods p { margin: var(--sp-2) var(--sp-4) var(--sp-4); font-size: var(--step--1); color: #b8b8c0; }
  .ab-mods a { color: var(--accent); }

  /* The details panel: a centered card on wide screens, a sheet from the bottom on phones */
  .ab-sheet { padding: 0; border: 0; background: transparent; color: inherit; max-width: none; max-height: none; width: 100%; height: 100%; }
  .ab-sheet::backdrop { background: rgba(5, 6, 8, 0.72); backdrop-filter: blur(3px); }
  .ab-sheet[open] { display: grid; place-items: center; }
  .ab-sheet__panel {
    --pool: var(--accent);
    position: relative; display: flex; flex-direction: column; width: min(760px, calc(100vw - 32px)); max-height: min(84vh, 820px);
    border-radius: 14px; background: linear-gradient(180deg, #1a1b20, #121317); border: 1px solid color-mix(in srgb, var(--pool) 40%, rgba(255, 255, 255, 0.08));
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), inset 0 3px 0 var(--pool); overflow: hidden;
  }
  .ab-sheet[open] .ab-sheet__panel { animation: ab-sheet-in 0.22s cubic-bezier(0.2, 0.9, 0.3, 1); }
  @keyframes ab-sheet-in { from { opacity: 0; transform: translateY(14px) scale(0.98); } to { opacity: 1; transform: none; } }
  .ab-sheet__hd { position: relative; padding: var(--sp-5) 60px var(--sp-4) var(--sp-5); border-bottom: 1px solid rgba(255, 255, 255, 0.07); }
  .ab-sheet__pool { display: block; margin-bottom: 4px; font-size: var(--step--2); font-weight: 700; color: var(--pool); }
  .ab-sheet__title { margin: 0; padding: 0; border: 0; background: none; font-family: var(--font-heading); font-size: var(--step-2); font-weight: 900; line-height: 1.15; color: #fff; }
  .ab-sheet__title::before, .ab-sheet__title::after { display: none; }
  .ab-sheet__game { margin: 8px 0 0; max-width: none; font-size: var(--step--1); line-height: 1.5; color: #c9ccd3; }
  .ab-sheet__game:empty { display: none; }
  .ab-sheet__x {
    position: absolute; top: 12px; right: 12px; display: grid; place-items: center; width: 44px; height: 44px;
    border: 0; border-radius: 10px; background: rgba(255, 255, 255, 0.05); color: #c8c8d0; cursor: pointer;
  }
  .ab-sheet__x:hover { background: rgba(255, 255, 255, 0.1); color: #fff; }
  .ab-sheet__body { overflow-y: auto; overscroll-behavior: contain; padding: var(--sp-4) var(--sp-5) var(--sp-5); font-size: var(--step--1); line-height: 1.55; color: #c8c8d0; }
  .ab-sheet__body:empty { display: none; }
  .ab-sheet__body .ab-card__more { padding: 0; border: 0; }
  .ab-sheet__body .ab-card__lead { margin-top: 0; font-size: var(--step-0); line-height: 1.5; }
  @media (min-width: 48em) {
    .ab-sheet__body dl { display: block; columns: 2; column-gap: var(--sp-6); }
    .ab-sheet__body dl > div { break-inside: avoid; padding-bottom: var(--sp-4); }
  }
  .ab-sheet__ft { display: flex; justify-content: space-between; gap: var(--sp-2); padding: var(--sp-2) var(--sp-3) max(var(--sp-2), env(safe-area-inset-bottom)); border-top: 1px solid rgba(255, 255, 255, 0.07); }
  .ab-sheet__nav {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px; max-width: 48%; padding: 0 12px;
    border: 0; border-radius: 8px; background: none; color: #c8c8d0; font: 600 var(--step--1)/1.2 var(--font-body); cursor: pointer; text-align: left;
  }
  .ab-sheet__nav span:not([aria-hidden]) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ab-sheet__nav [aria-hidden] { font-size: 1.4em; line-height: 1; color: var(--pool); }
  .ab-sheet__nav:hover { background: rgba(255, 255, 255, 0.06); color: #fff; }
  .ab-sheet__nav--next { margin-left: auto; text-align: right; }
  .ab-sheet__nav[hidden] { display: none; }
  @media (max-width: 39.99em) {
    .ab-sheet[open] { place-items: end stretch; }
    .ab-sheet__panel { width: 100%; max-height: 88dvh; border-radius: 16px 16px 0 0; }
    .ab-sheet[open] .ab-sheet__panel { animation-name: ab-sheet-up; }
    @keyframes ab-sheet-up { from { transform: translateY(40px); opacity: 0.4; } to { transform: none; opacity: 1; } }
    .ab-sheet__hd { padding: var(--sp-4) 60px var(--sp-3) var(--sp-4); }
    .ab-sheet__body { padding: var(--sp-3) var(--sp-4) var(--sp-4); }
  }
  :global(html.ab-lock) { overflow: hidden; scrollbar-gutter: stable; }

  @media (prefers-reduced-motion: reduce) {
    .ab-card:target, .ab-card.is-flash, .ab-sheet[open] .ab-sheet__panel { animation: none; }
    .ab-card__chev::before, .ab-card__chev::after { transition: none; }
  }
</style>

<script>
  // Filter by pool. A card opens its details in the panel (in place, if the browser has no <dialog>),
  // "What to chase" chips and links like #weapon-damage open the same panel, and the panel's arrows step
  // through the cards on show.
  const wrap = document.getElementById('ab-groups');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.ab-filter__btn'));
  const show = (id: string) => {
    if (!wrap) return;
    wrap.dataset.show = id;
    for (const b of buttons) b.setAttribute('aria-pressed', b.dataset.filter === id ? 'true' : 'false');
  };
  for (const b of buttons) b.addEventListener('click', () => show(b.dataset.filter || 'all'));

  const sheet = document.getElementById('ab-sheet') as HTMLDialogElement | null;
  const canSheet = !!(sheet && typeof sheet.showModal === 'function');
  const cards = Array.from(document.querySelectorAll<HTMLDetailsElement>('.ab-card'));
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  let current: HTMLDetailsElement | null = null;

  const visible = () => cards.filter((c) => c.offsetParent !== null);
  const fill = (card: HTMLDetailsElement) => {
    current = card;
    const panel = sheet!.querySelector<HTMLElement>('.ab-sheet__panel')!;
    panel.style.setProperty('--pool', getComputedStyle(card).getPropertyValue('--pool'));
    $('ab-sheet-pool').textContent = card.dataset.poolName || '';
    $('ab-sheet-title').textContent = card.querySelector('.ab-card__name')?.textContent || '';
    $('ab-sheet-game').textContent = card.querySelector('.ab-card__text')?.textContent || '';
    const more = card.querySelector('.ab-card__more');
    $('ab-sheet-body').replaceChildren(...(more ? [more.cloneNode(true)] : []));
    $('ab-sheet-body').scrollTop = 0;
    const list = visible();
    const i = list.indexOf(card);
    const prev = list[i - 1];
    const next = list[i + 1];
    const nameOf = (c?: HTMLDetailsElement) => (c ? c.querySelector('.ab-card__name')?.textContent || '' : '');
    $('ab-sheet-prev').hidden = !prev;
    $('ab-sheet-next').hidden = !next;
    $('ab-sheet-prev-name').textContent = nameOf(prev);
    $('ab-sheet-next-name').textContent = nameOf(next);
    $('ab-sheet-prev').setAttribute('aria-label', `Previous: ${nameOf(prev)}`);
    $('ab-sheet-next').setAttribute('aria-label', `Next: ${nameOf(next)}`);
    history.replaceState(null, '', `#${card.id}`);
  };
  const openCard = (card: HTMLDetailsElement) => {
    if (!canSheet) { card.open = true; card.scrollIntoView({ block: 'start' }); return; }
    fill(card);
    if (!sheet!.open) {
      sheet!.showModal();
      document.documentElement.classList.add('ab-lock');
    }
  };
  const step = (d: number) => {
    if (!current) return;
    const list = visible();
    const next = list[list.indexOf(current) + d];
    if (next) fill(next);
  };

  if (canSheet && sheet) {
    for (const card of cards) {
      card.querySelector('summary')?.setAttribute('aria-haspopup', 'dialog');
      card.addEventListener('click', (e) => { e.preventDefault(); openCard(card); });
    }
    sheet.addEventListener('close', () => {
      document.documentElement.classList.remove('ab-lock');
      history.replaceState(null, '', location.pathname + location.search);
      if (current) {
        current.scrollIntoView({ block: 'nearest' });
        current.querySelector('summary')?.focus({ preventScroll: true });
      }
    });
    sheet.addEventListener('click', (e) => { if (e.target === sheet) sheet.close(); });
    $('ab-sheet-x').addEventListener('click', () => sheet.close());
    $('ab-sheet-prev').addEventListener('click', () => step(-1));
    $('ab-sheet-next').addEventListener('click', () => step(1));
    sheet.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
    });
  }

  const bySlug = (slug: string) => {
    const el = document.getElementById(slug);
    return el instanceof HTMLDetailsElement && el.classList.contains('ab-card') ? el : null;
  };
  const reveal = (card: HTMLDetailsElement) => {
    const group = card.closest<HTMLElement>('[data-group]');
    if (wrap && wrap.dataset.show !== 'all' && group && group.dataset.group !== wrap.dataset.show) show('all');
  };
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-open]')) {
    a.addEventListener('click', (e) => {
      const card = bySlug(a.dataset.open || '');
      if (!card) return;
      e.preventDefault();
      reveal(card);
      openCard(card);
    });
  }
  const fromHash = () => {
    const card = bySlug(decodeURIComponent(location.hash.slice(1)));
    if (!card) return;
    reveal(card);
    if (canSheet) card.scrollIntoView({ block: 'center' });
    openCard(card);
  };
  fromHash();
  window.addEventListener('hashchange', fromHash);
</script>
</DatabaseLayout>
