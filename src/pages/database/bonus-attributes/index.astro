---
import DatabaseLayout from '../../../layouts/DatabaseLayout.astro';
import bonusAttributes from '../../../data/bonus-attributes.json';
import AdSenseUnit from '../../../components/AdSenseUnit.astro';
import { verifiedPatch } from '../../../data/site-config';
import { attrGuide, statInteraction } from '../../../data/bonus-attribute-guides';
const lastVerified = verifiedPatch('Patch 1.2.1'); // Bump: drop the arg ONLY after re-verifying this page's content in-game (CURRENT_PATCH is a ceiling, not an auto-bump)

const attrCount = bonusAttributes.reduce((n: number, c: any) => n + c.attributes.length, 0);
const title = `Bonus Attributes: All ${attrCount} Stats Explained`;
const description = "Every bonus attribute that can roll on your gear in Division Resurgence, organized by Firepower, Toughness, Engineering, and Universal pools. Know your rolls or suffer.";
const breadcrumbs = [
  { name: 'Weapon/Gear Bonus Attributes', url: '/database/bonus-attributes/' }
];

const toSlug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const getCategoryColor = (cat: string) => {
  switch(cat.toLowerCase()) {
    case 'firepower': return { color: '#f87171', bg: 'rgba(239,68,68,0.08)', border: 'rgba(239,68,68,0.25)' };
    case 'toughness': return { color: '#60a5fa', bg: 'rgba(59,130,246,0.08)', border: 'rgba(59,130,246,0.25)' };
    case 'engineering': return { color: '#facc15', bg: 'rgba(234,179,8,0.08)', border: 'rgba(234,179,8,0.25)' };
    default: return { color: '#b8b8c0', bg: 'rgba(255,255,255,0.04)', border: 'rgba(255,255,255,0.1)' };
  }
};

const faqs = [
  { question: "What are bonus attributes in Division Resurgence?", answer: "Bonus attributes are the secondary stats that roll on gear and weapons next to the core stats. A gear piece shows Firepower, Toughness and Engineering values together, plus two bonus attributes such as Weapon Critical Hit Chance, Skill Intensity or Damage Reduction. We group the attributes by the core stat they feed, but a piece isn't locked to one group: TikTokAndy's Tier 1 body armor with a strong Firepower roll came with Skill Cooldown Recovery next to Weapon Critical Hit Damage." },
  { question: "What bonus attributes should I prioritize in Division Resurgence?", answer: "For DPS builds: Weapon Critical Hit Chance and Weapon Critical Hit Damage are king. For tank builds: Max Health, Armor, and Damage Reduction. For skill builds: Skill Intensity and Skill Cooldown Recovery. Universal attributes like Damage to Elites and Received Healing fit any build. The right bonus attributes turn a mediocre build into something that actually melts." },
  { question: "Can you recalibrate bonus attributes in Division Resurgence?", answer: "Yes, but it's a reroll, not a pick. Creators spend recalibration manuals to reroll one attribute line, and the result is random: TikTokAndy rerolls his mask's Armor line hoping for Skill Critical Damage, says the manuals (his 'books') are at a premium, and Died Again Gaming remembers wasting booklets on rolls that came back useless. Spend them on the line that's furthest from what your build wants." },
];

const allAttrs: Array<{name: string; category: string}> = [];
bonusAttributes.forEach((cat: any) => {
  cat.attributes.forEach((attr: string) => {
    allAttrs.push({ name: attr, category: cat.category });
  });
});

const siteUrl = 'https://resurgencebuilds.com';

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'The Division Resurgence Weapon/Gear Bonus Attributes',
  description: description,
  numberOfItems: allAttrs.length,
  itemListElement: allAttrs.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${siteUrl}/database/bonus-attributes/#${toSlug(item.name)}`,
    item: {
      '@type': 'Thing',
      '@id': `${siteUrl}/database/bonus-attributes/#${toSlug(item.name)}`,
      name: item.name,
      description: `${item.name}, a ${item.category} bonus attribute in Division Resurgence`,
      url: `${siteUrl}/database/bonus-attributes/#${toSlug(item.name)}`,
      subjectOf: { '@id': 'https://resurgencebuilds.com/#division-resurgence' }
    }
  })),
};
---

<DatabaseLayout
  {title}
  {description}
  {breadcrumbs}
  heading="Bonus Attributes"
  subheading={`All ${allAttrs.length} bonus attributes across ${bonusAttributes.length} stat pools, every stat explained in full on this page. Know your rolls, or suffer.`}
  jsonLd={itemListLd}
  lastVerified={lastVerified}
  {faqs}
>
  <div style="color: #c8c8d0; line-height: 1.75; font-size: var(--text-base); margin-bottom: var(--sp-8); max-width: 72ch;">
    <p>Bonus attributes are the secondary stats on every gear piece in Division Resurgence. Each piece carries Firepower, Toughness and Engineering values (TikTokAndy's T2 Phalanx holster reads 200 Firepower, 33 Toughness and 64 Engineering) plus two bonus attributes like Weapon Critical Hit Chance, Skill Intensity, or Damage Reduction. We group the attributes below by the core stat they feed, but the groups aren't walled off by a piece's biggest stat: creators' gear mixes them freely.</p>
    <p>There are {allAttrs.length} bonus attributes across {bonusAttributes.length} pools: <strong>Firepower</strong> (offensive weapon stats), <strong>Toughness</strong> (survivability), <strong>Engineering</strong> (skill scaling), and <strong>Universal</strong> (attributes that roll on any core type). Universal attributes like Damage to Elites and Received Healing are the most flexible options for builds that need cross-category value. For how the core stats, crit and talent ranks fit together, see our <a href="/guides/division-resurgence-stats-explained/" style="color: var(--accent);">stats guide</a>.</p>
    <p>Recalibration rerolls an attribute line at random and costs recalibration manuals, which TikTokAndy says are at a premium. Pick the line that's furthest from what your build wants before you spend one, especially on Tier 2 endgame gear that you cannot easily replace.</p>
    <p><strong>Update (October 2026):</strong> Season 2 Phase 1 reshuffled the pools. Weapons no longer roll Blast, Piercing or Shredding Weapon or Skill Damage: Ubisoft replaced them with All Weapon Damage and All Skill Damage, which this list now shows in their place. Ubisoft's notes cover weapons and weapon mods, not gear pieces, and older weapons may still carry the old rolls, so check yours in the Armory. Weapon mods were reworked (main stat +100%, attribute bonuses -25%), and newly dropped weapon mods lost the damage-type and All Damage rolls in exchange for Weapon Damage, Skill Intensity, Headshot Damage, Weapon Critical Hit Damage and Skill Critical Damage. Mods you already own keep their rolls. Gear mods lost Elite Enemy and Enemy Leader Resistance and can now roll Max Health, Armor, Received Healing, weapon and skill crit chance, crit damage and multi-shot, Weapon Damage, Skill Intensity, Headshot Damage and Signature Ability Charge Efficiency. The per-stat notes below were written before that patch unless they say otherwise.</p>
  </div>

  <!-- Jump nav: a fold, closed on phones (20+ links at 44px would be a long block before the content), open wider -->
  <details class="attr-jumpnav" data-jumpnav>
  <summary class="attr-jumpnav__summary">Jump to an attribute</summary>
  <nav class="attr-jumpnav__groups" aria-label="Jump to attribute">
    {bonusAttributes.map((category) => {
      const palette = getCategoryColor(category.category);
      return (
        <div class="attr-jumpnav__group">
          <a href={`#${toSlug(category.category)}`} class="attr-jumpnav__cat" style={`color:${palette.color};border-color:${palette.border};background:${palette.bg};`}>{category.category}</a>
          {category.attributes.map((attr: string) => (
            <a href={`#${toSlug(attr)}`} class="attr-jumpnav__link">{attr}</a>
          ))}
        </div>
      );
    })}
  </nav>
  </details>
  <script is:inline>(function () { var d = document.querySelector('[data-jumpnav]'); if (d && window.matchMedia('(min-width: 45em)').matches) d.open = true; })();</script>

  <!-- Sort control -->
  <div class="attr-sort" role="group" aria-label="Sort attributes">
    <span class="attr-sort__label">Sort:</span>
    <button type="button" class="attr-sort__btn is-active" data-sort="pool">By stat pool</button>
    <button type="button" class="attr-sort__btn" data-sort="az">A to Z</button>
  </div>

  <div id="attr-sections">
    {bonusAttributes.map((category) => {
      const palette = getCategoryColor(category.category);
      return (
        <section class="attr-pool" id={toSlug(category.category)} data-pool={category.category}>
          <h2 class="attr-pool__title" style={`color:${palette.color};border-color:${palette.border};`}>{category.category} <span class="attr-pool__count">{category.attributes.length} stats</span></h2>
          {category.attributes.map((attr: string) => {
            const slug = toSlug(attr);
            const info = attrGuide[attr];
            return (
              <article class="attr-entry" id={slug} data-name={attr} data-pool={category.category}>
                <h3 class="attr-entry__title">
                  <a href={`#${slug}`} class="attr-entry__anchor" aria-label={`Link to ${attr}`}>#</a>
                  {attr}
                  <span class="attr-entry__badge" style={`color:${palette.color};border-color:${palette.border};background:${palette.bg};`}>{category.category}</span>
                </h3>
                {info ? (
                  <div class="attr-entry__body">
                    <p>{info.overview}</p>
                    <details class="attr-entry__more">
                      <summary>Why it matters, how to get it &amp; best builds</summary>
                      <h4>Why it matters</h4>
                      <p>{info.whyItMatters}</p>
                      <h4>How to get it</h4>
                      <p>{info.howToGet}</p>
                      <h4>Best builds</h4>
                      <p>{info.bestBuilds}</p>
                      {statInteraction[slug] && (
                        <Fragment>
                          <h4>Stat interactions</h4>
                          <p>{statInteraction[slug]}</p>
                        </Fragment>
                      )}
                    </details>
                  </div>
                ) : (
                  <div class="attr-entry__body">
                    <p>{attr} is a {category.category} bonus attribute that rolls on gear with a {category.category} core stat. Full breakdown coming after in-game verification.</p>
                  </div>
                )}
              </article>
            );
          })}
        </section>
      );
    })}
  </div>

<AdSenseUnit label="Advertisement (database category)" />

<style>
  .attr-jumpnav {
    margin-bottom: var(--sp-6);
    padding: var(--sp-2) var(--sp-4) var(--sp-2) calc(var(--inset) - 1px);
    background: rgba(0,0,0,0.25);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
  }
  .attr-jumpnav__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    min-height: var(--control);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }
  .attr-jumpnav__summary::-webkit-details-marker { display: none; }
  .attr-jumpnav__summary::after { content: '＋'; font-size: var(--step-1); line-height: 1; color: var(--accent); }
  .attr-jumpnav[open] > .attr-jumpnav__summary::after { content: '－'; }
  .attr-jumpnav__groups {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-2) 0 var(--sp-2);
  }
  .attr-jumpnav__group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2); /* 8px between separate targets */
  }
  .attr-jumpnav__cat {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 10px;
    border: 1px solid;
    border-radius: 999px;
    text-decoration: none;
  }
  .attr-jumpnav__link {
    font-size: var(--text-xs);
    color: #b8b8c0;
    text-decoration: none;
    padding: 3px 8px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    transition: all 0.15s;
  }
  .attr-jumpnav__link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .attr-sort {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-8); /* the first pool's heading sits closer to its own list than to these buttons */
  }
  .attr-sort__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #8888a0;
  }
  .attr-sort__btn {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: #b8b8c0;
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    padding: 5px 12px;
    min-height: var(--control-sm);
    cursor: pointer;
    transition: all 0.15s;
  }
  /* touch screens: 44px sort buttons and jump links */
  @media (pointer: coarse) {
    .attr-sort__btn { min-height: var(--control); }
    .attr-jumpnav__link, .attr-jumpnav__cat { display: inline-flex; align-items: center; min-height: var(--control); }
  }
  .attr-sort__btn.is-active {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(242,104,34,0.08);
  }
  .attr-pool {
    margin-bottom: var(--sp-12);
  }
  .attr-pool__title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 900;
    margin: 0 0 var(--sp-5) 0;
    padding-bottom: var(--sp-2);
    border-bottom: 2px solid;
  }
  .attr-pool__count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--ink-muted); /* solid grey: the pool colour at 60% was 3.2-4.2:1 at 13px */
    margin-left: var(--sp-2);
  }
  .attr-entry {
    max-width: calc(var(--measure) + 2 * var(--sp-5));
    margin-bottom: var(--sp-6);
    padding: var(--sp-5);
    background: rgba(0,0,0,0.2);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px;
  }
  .attr-entry:target {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px rgba(242,104,34,0.3);
  }
  .attr-entry__title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-2);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 800;
    color: #fff;
    margin: 0 0 var(--sp-3) 0;
  }
  .attr-entry__anchor {
    color: var(--ink-muted); /* the faint 25% white was 2:1 */
    text-decoration: none;
  }
  .attr-entry__anchor:hover { color: var(--accent); }
  .attr-entry__badge {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border: 1px solid;
    border-radius: 999px;
  }
  .attr-entry__body {
    color: #c8c8d0;
    line-height: 1.7;
    font-size: var(--text-sm);
  }
  .attr-entry__body p { margin: 0 0 var(--sp-3) 0; }
  .attr-entry__more {
    margin-top: var(--sp-2);
    border-top: 1px solid rgba(255,255,255,0.06);
    padding-top: var(--sp-3);
  }
  /* a readable toggle (it repeats on every attribute, so it isn't 13px small print), 44px tall on touch screens */
  .attr-entry__more summary {
    cursor: pointer;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--accent);
    padding-block: var(--sp-1);
  }
  @media (pointer: coarse) {
    .attr-entry__more summary { padding-block: 10px; }
  }
  .attr-entry__more h4 {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: #fff;
    margin: var(--sp-4) 0 var(--sp-2) 0;
  }
</style>

<script>
  // Sort toggle: "By stat pool" (default DOM order) vs "A to Z" (flat alphabetical)
  const wrap = document.getElementById('attr-sections');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.attr-sort__btn');
  if (wrap) {
    const pools = Array.from(wrap.querySelectorAll<HTMLElement>('.attr-pool'));
    const originalOrder = pools.map(p => ({ pool: p, entries: Array.from(p.querySelectorAll<HTMLElement>('.attr-entry')) }));
    let flat: HTMLElement | null = null;

    function sortAZ() {
      if (!flat) {
        flat = document.createElement('section');
        flat.className = 'attr-pool';
        flat.id = 'attr-flat';
        const all = originalOrder.flatMap(o => o.entries);
        all.sort((a, b) => (a.dataset.name || '').localeCompare(b.dataset.name || ''));
        all.forEach(e => flat!.appendChild(e));
      } else {
        // re-append (entries may have been restored to pools)
        const all = Array.from(document.querySelectorAll<HTMLElement>('.attr-entry'));
        all.sort((a, b) => (a.dataset.name || '').localeCompare(b.dataset.name || ''));
        all.forEach(e => flat!.appendChild(e));
      }
      pools.forEach(p => { p.style.display = 'none'; });
      wrap!.appendChild(flat);
    }

    function sortPool() {
      originalOrder.forEach(o => {
        o.entries.forEach(e => o.pool.appendChild(e));
        o.pool.style.display = '';
      });
      if (flat && flat.parentNode) flat.parentNode.removeChild(flat);
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.toggle('is-active', b === btn));
        if (btn.dataset.sort === 'az') sortAZ(); else sortPool();
      });
    });
  }
</script>
</DatabaseLayout>
