---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionTag from '../../../components/SectionTag.astro';
import AdSenseUnit from '../../../components/AdSenseUnit.astro';
import DbItemExtras from '../../../components/DbItemExtras.astro';
import { DATABASE_UPDATED } from '../../../data/site-config';
import WeaponAttributes from '../../../components/WeaponAttributes.astro';
import { truncateDesc, metaDescription } from '../../../utils/seo';
import exoticWeapons from '../../../data/exotic-weapons.json';

export function getStaticPaths() {
  // Exotics with unverified stat lines (statsVerified: false) are in the planner only.
  return exoticWeapons.filter((w: any) => w.statsVerified !== false).map((weapon: any) => ({
    params: {
      slug: weapon.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
    },
    props: { weapon }
  }));
}

const { weapon } = Astro.props;
const typeArticle = /^(SMG|LMG|[AEIOU])/.test(weapon.type) ? 'an' : 'a';
const theName = weapon.name.startsWith('The ') ? weapon.name : `The ${weapon.name}`;

const title = `${weapon.name}: Exotic ${weapon.type}`;
const description = metaDescription(weapon.summary, `${weapon.name} exotic ${weapon.type} in The Division Resurgence: stats, the ${weapon.talentName} talent, and which builds use it.`);

const breadcrumbs = [
  { name: 'Exotic Weapons', url: '/database/exotic-weapons/' },
  { name: weapon.name, url: '#' }
];

const faqs = [
  {
    question: `Is ${weapon.name} good in Division Resurgence?`,
    answer: `${weapon.name} is an exotic ${weapon.type}: ${weapon.damage} damage, ${weapon.rpm} RPM, and the "${weapon.talentName}" talent that completely changes how you play. ${weapon.talentDescription.substring(0, 200)}${weapon.talentDescription.length > 200 ? '...' : ''}: yeah, it's worth ${weapon.acquisition ? 'unlocking' : 'farming for'}. Scroll down for the full breakdown.`
  },
  {
    question: `What builds use ${weapon.name}?`,
    answer: `You want to build entirely around the "${weapon.talentName}" talent: that's the whole point of running an exotic. As ${typeArticle} ${weapon.type}, pair it with specs that stack the matching core stat, then find gear sets and OS Protocols that feed into what the talent does. Don't just slap it on any random loadout.`
  },
  {
    question: `How do I get ${weapon.name} in Division Resurgence?`,
    answer: weapon.acquisition
      ? `${weapon.name} started as a battle pass unlock: ${weapon.acquisition}. Check the "How to Get" section below for the details.`
      : `${weapon.name} drops from endgame stuff: Conflicts, Dark Zone, Legendary missions. Exotic drop rates are brutal, so target activities that have ${weapon.type}s in the loot pool. Weekly bounties and targeted loot zones give you a shot too. Since Season 2 Phase 2, Exotic Sealed Caches are also Ubisoft's official way to get exotics from previous seasons. Prepare to grind.`
  }
];

const slug = weapon.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const siteUrl = 'https://resurgencebuilds.com';

const weaponLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: `${siteUrl}/database/exotic-weapons/${slug}/`,
  author: { '@type': 'Person', '@id': `${siteUrl}/author/rapidf5/#person`, name: 'RapidF5' },
  publisher: { '@type': 'Organization', '@id': `${siteUrl}/#organization`, name: 'Resurgence Builds' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${siteUrl}/database/exotic-weapons/${slug}/` },
  datePublished: '2026-05-29',
  dateModified: DATABASE_UPDATED,
  image: weapon.image ? { '@type': 'ImageObject', url: `${siteUrl}${weapon.image}`, width: 620, height: 310 } : { '@type': 'ImageObject', url: `${siteUrl}/images/resurgence-builds-official-logo.png`, width: 800, height: 800 },
  inLanguage: 'en-US',
  lastReviewed: weapon.verifiedInGame || '2026-05-30',
  wordCount: 800,
  about: { '@id': `${siteUrl}/#division-resurgence` },
};

const itemLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': `${siteUrl}/database/exotic-weapons/${slug}/#item`,
  name: `${weapon.name}: Exotic ${weapon.type} in Division Resurgence`,
  description: `${weapon.name} exotic ${weapon.type} in Division Resurgence. ${weapon.damage} damage, ${weapon.rpm} RPM, ${weapon.mag} mag. Exotic talent: ${weapon.talentName}.`,
  genre: 'Video Game Item Database',
  isPartOf: {
    '@type': 'VideoGame',
    name: 'Tom Clancy\'s The Division Resurgence',
    gamePlatform: ['iOS', 'Android'],
    applicationCategory: 'Game',
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Weapon Class', value: weapon.type },
    { '@type': 'PropertyValue', name: 'Rarity', value: 'Exotic' },
    { '@type': 'PropertyValue', name: 'Talent', value: weapon.talentName },
    { '@type': 'PropertyValue', name: 'RPM', value: String(weapon.rpm) },
    { '@type': 'PropertyValue', name: 'Magazine', value: String(weapon.mag) },
    { '@type': 'PropertyValue', name: 'Damage', value: String(weapon.damage) },
  ]
};
---

<BaseLayout {title} {description} {breadcrumbs} faqs={faqs} jsonLd={[weaponLd, itemLd]} ogImage={weapon.image || undefined}>
  <div class="container section">
    <Breadcrumbs items={breadcrumbs} />
    <SectionTag label="Exotic Weapon" />

    <div class="weapon-detail">
      <div class="weapon-detail__header">
        <h1 class="weapon-detail__name">{weapon.name}</h1>
        <span class="weapon-type-badge">{weapon.type}</span>
      </div>

      {weapon.image && (
        <div style="margin-bottom: var(--sp-6); border-radius: 8px; overflow: hidden; border: 1px solid var(--border);">
          <img src={weapon.image} alt={`${weapon.name} Exotic ${weapon.type} in Division Resurgence`} width="1200" height="583" style="width: 100%; height: auto; display: block;" />
        </div>
      )}

      <!-- Stats Grid -->
      <div class="weapon-stats">
        <h2 class="weapon-stats__heading">Weapon Stats</h2>
        <div class="weapon-stats__grid">
          <div class="weapon-stat">
            <span class="weapon-stat__label">Damage</span>
            <span class="weapon-stat__value">{weapon.damage}</span>
          </div>
          <div class="weapon-stat">
            <span class="weapon-stat__label">RPM</span>
            <span class="weapon-stat__value">{weapon.rpm}</span>
          </div>
          <div class="weapon-stat">
            <span class="weapon-stat__label">MAG</span>
            <span class="weapon-stat__value">{weapon.mag}</span>
          </div>
        </div>
      </div>

      {weapon.caveat && weapon.note && <p class="item-note">{weapon.note}</p>}

      <WeaponAttributes 
        accuracy={weapon.accuracy} 
        reloadSpeed={weapon.reloadSpeed} 
        optimalRange={weapon.optimalRange} 
        movementSpeed={weapon.movementSpeed} 
        stability={weapon.stability} 
      />

      <!-- Talent Section -->
      <div class="weapon-talent">
        <h2 class="weapon-talent__heading">Exotic Talent</h2>
        <div class="weapon-talent__card">
          <h3 class="weapon-talent__name">{weapon.talentName}</h3>
          <p class="weapon-talent__desc">{weapon.talentDescription}</p>
        </div>
        {weapon.possibleTalents?.length > 0 && (
          <div class="weapon-talent__pool">
            <h3 class="weapon-talent__pool-title">Possible talents</h3>
            <p class="weapon-talent__pool-note">Its rolled talents come from this pool, per the in-game Build-Making Database card (October 28, 2026).</p>
            <ul class="weapon-talent__pool-list">
              {weapon.possibleTalents.map((t: string) => (
                <li><a href={`/database/weapon-talents/${t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}/`}>{t}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <!-- Overview -->
      <div style="margin-bottom: var(--sp-8);">
        <h2 class="weapon-stats__heading">Overview</h2>
        <div style="color: #c8c8d0; line-height: 1.75; font-size: var(--text-base);">
          <p><strong style="color: #fff;">{theName}</strong> is one of only six exotics in Division Resurgence so far, so yeah, it's kind of a big deal. The whole reason you run an exotic over a regular {weapon.type} is the talent: <strong style="color: #F5CC45;">{weapon.talentName}</strong> completely changes how you play. Stat-wise, you're looking at {weapon.damage} base damage, {weapon.rpm} RPM, and a {weapon.mag}-round mag. {weapon.type === 'Shotgun' ? 'Low RPM, small mag: every trigger pull is a deliberate decision, and the talent is doing as much work as the pellets.' : weapon.name === 'The Bighorn' ? 'It fires full-auto from the hip, but aiming switches it to semi-auto with a big damage bonus on every shot, so it plays like two guns in one.' : weapon.type === 'Rifle' ? 'At 100 RPM with a 5-round magazine, every shot counts, and the talent decides which ones crit.' : weapon.rpm >= 800 ? 'That high fire rate means you\'re getting up close and proccing talent effects as fast as possible.' : weapon.rpm >= 600 ? 'It sits in a sweet spot between sustained DPS and burst: works at most ranges without feeling awkward.' : 'Big magazine, steady damage: this thing rewards you for holding the trigger and letting talents stack up over long engagements.'}</p>
        </div>
      </div>

      <!-- How the Talent Works -->
      <div style="margin-bottom: var(--sp-8);">
        <h2 class="weapon-stats__heading">How {weapon.talentName} Works</h2>
        <div style="color: #c8c8d0; line-height: 1.75; font-size: var(--text-base);">
          {weapon.name === 'Lady Death' && (
            <Fragment>
              <p><strong style="color: #fff;">Breathe Free</strong> is a movement-based stacking talent. While moving, you gain 4 stacks per second (8 while sprinting), up to 40 stacks maximum. Each round fired consumes 1 stack and grants <strong style="color: var(--accent);">+15% Weapon Damage</strong>. Deploying a skill consumes 10 stacks and grants <strong style="color: var(--accent);">+15% Skill Damage</strong>. Kills grant +10% Movement Speed for 10 seconds.</p>
              <p>The optimal loop: sprint-stack to 40 before engaging, unload your mag for the boosted damage, deploy a skill mid-fight for the skill damage bonus, then reposition. Lady Death rewards aggressive players who are constantly moving: standing still means zero stacks and zero bonus damage. In the Dark Zone, the movement speed on kill chains into repositioning, making Lady Death one of the strongest PvP SMGs in the game.</p>
            </Fragment>
          )}
          {weapon.name === 'Warlord' && (
            <Fragment>
              <p><strong style="color: #fff;">Play Rough</strong> gives you <strong style="color: var(--accent);">25% damage reduction while firing</strong>. When you stop firing, the tooltip says it "applies 60% of the reduced damage" and grants +10% Skill Damage for 10 seconds. It doesn't say who takes that 60%; the natural reading, and the one our exotic weapons guide uses, is that you do, so you bank a 40% net saving and pay the rest back once you let go of the trigger. That makes it a tank-DPS hybrid: keep shooting through the punishment, and pick your moment to stop.</p>
              <p><strong style="color: #F5CC45;">Warning: The Warlord Trap:</strong> Warlord is a T1 Exotic AR from the Season 1 Battle Pass (and in the Dark Zone vendor since Season 1 Phase 2). Committing to it means PvP for weapon proficiency: in Died Again Gaming's June read of the task list, level 8 asks for 30 agent kills or assists with the Warlord, which means PvP: he wasn't sure Conflict counts, so his plan was going Rogue in the Dark Zone. Check the task text in your Armory before you plan around it. There was also a proficiency tracking bug; Ubisoft's official bug reporter marked the main proficiency issues fixed in August and September 2026, and on October 23 it marked the Warlord-specific report, TDR-183 "Warlord Proficiency Tier 8 not progressing," Done as well (<a href="/news/bug-reporter-fixes-october-23/" style="color: var(--accent);">our roundup</a>). Make sure the build actually needs Warlord before investing the PvP grind time. For PvE-only players, the proficiency gate can be a blocker.</p>
            </Fragment>
          )}
          {weapon.name === 'Scorpio' && (
            <Fragment>
              <p><strong style="color: #fff;">Septicemia</strong> is a stacking debuff engine: every hit applies <strong style="color: var(--accent);">Venom for 2.5 seconds, up to 7 stacks</strong>, and the target's debuff escalates as stacks climb: 1 stack inflicts Bleed for 10 seconds, 3 stacks add Confusion for 2 seconds, 6 stacks add Shock for 3 seconds, and at 7 stacks the target takes <strong style="color: var(--accent);">additional damage equal to 10% of damage dealt for 10 seconds</strong>.</p>
              <p>The rhythm matters more than the DPS sheet: at 130 RPM you need sustained, deliberate hits on the same target to climb the ladder before Venom's 2.5-second timer drops stacks. That makes Scorpio less of a one-tap deleter and more of a debuff platform: the Shock at 6 and the 10% damage amp at 7 are effectively soft crowd-control plus a team-wide damage window on elites and bosses. We haven't re-tested it since Season 1 Phase 3, so treat this as the launch-window verdict.</p>
            </Fragment>
          )}
          {weapon.name === 'Strawberry Milkshake' && (
            <Fragment>
              <p>The Strawberry Milkshake carries <strong style="color: var(--accent);">Anarchy</strong> (hits inflict a stacking damage-over-time debuff, up to 50 stacks, that jumps to a nearby enemy on kill) as its fixed exotic talent, plus <strong style="color: #fff;">two rolled talent lines</strong>. Died Again Gaming's launch copy rolled <strong style="color: var(--accent);">Concentrated Fire</strong> and <strong style="color: var(--accent);">Damage Trade</strong>, while the replacement copies Ubisoft sent out in July came with Proficient Reload II and Swift Taunt II, so check what yours has before you plan a build around it.</p>
              <p><strong style="color: #F5CC45;">Community reality check:</strong> The Anarchy DoT is effectively non-functional in practice: the per-tick damage is negligible. Do NOT build around the DoT mechanic. The Strawberry Milkshake's real value is the 100-round magazine plus whatever lands on its two talent lines: Concentrated Fire stacks crit damage on a boss you never stop shooting, and our Milkshake Machine build rolls In Sync and Swift Taunt on the gun itself. Phalanx Attack (Magazine Size, Rate of Fire, then Weapon Multi-Shot at 4 pieces) is the natural gear set for the sustained-fire engine.</p>
              <p><strong style="color: #fff;">Damage type note:</strong> Strawberry Milkshake deals <strong>Shredding</strong> damage. The Armory listed it as Piercing until the Season 1 Phase 3 patch fixed the label, and you'll still see it misreported as Blast. Matters for armor-type matchups against specific enemy types.</p>
              <p><strong style="color: #F5CC45;">Update (October 2026):</strong> Ubisoft has since fixed the Milkshake dropping with level 1 talents instead of level 2 (Season 1 Phase 3, with Ubisoft promising an updated copy for existing owners) and a bug where Anarchy's debuff was applied on heal (Season 2 Phase 1). We haven't re-tested the DoT since, so the reality check above is the pre-fix read.</p>
            </Fragment>
          )}
          {weapon.name === 'The Bighorn' && (
            <Fragment>
              <p><strong style="color: #fff;">Big Game Hunter</strong> splits the gun in two. From the hip it's an 800 RPM assault rifle. Aim down sights and it switches to semi-auto, and every aimed shot deals an extra <strong style="color: var(--accent);">300% Weapon Damage</strong>. Headshots then stack <strong style="color: var(--accent);">+3.30% Headshot Damage for 20 seconds, up to 50 stacks</strong>, which is +165% at the cap. Once you're at max stacks you lose 10 stacks every 4 seconds, and only more headshots stop the decay.</p>
              <p>TikTokAndy's first look, in his September 16 video, showed what the stacks do: headshots of about 7,000 to 11,000 just before he hit level 40, then 15,000 to 17,000 in the level 40 Dark Zone. That's one player's copy with mods fitted, not a benchmark.</p>
            </Fragment>
          )}
          {weapon.name === 'Diamondback' && (
            <Fragment>
              <p><strong style="color: #fff;">Agonizing Bite</strong> marks one random enemy. Hitting that enemy is a guaranteed <strong style="color: var(--accent);">Critical Hit</strong> and uses up the mark. After you hit a marked target, all your shots are guaranteed Critical Hits and grant <strong style="color: var(--accent);">+10% Skill Critical Hit Chance for 5 seconds</strong>. A new enemy is marked afterward, and every reload marks a new one too.</p>
              <p>The catch is the gun around it. At 100 RPM with a 5-round magazine, five seconds of guaranteed crits doesn't cover many shots, which is the complaint Brazilian creator Capitão Wasabi pinned under his September 23 video.</p>
            </Fragment>
          )}
        </div>
      </div>

      <!-- Build Strategy -->
      <div style="margin-bottom: var(--sp-8);">
        <h2 class="weapon-stats__heading">Build Strategy</h2>
        <div style="color: #c8c8d0; line-height: 1.75; font-size: var(--text-base);">
          <p>With exotics, the talent IS the build. Everything else revolves around it. {weapon.name === 'Scorpio' ? 'Scorpio wants to live in shotgun range, which points straight at Bulwark Breacher (shield brawling keeps you alive at 16 meters) or any close-range Firepower loadout. Build for sustained target focus: the Venom ladder resets if you spray between targets, so single-target discipline beats spread damage. The Shock at 6 stacks and the 10% damage amp at 7 also make it a genuinely interesting team-support pick against bosses: you soften the target while the DPS players collect the credit. Verified builds running Scorpio will show up here as the community settles the meta.' : weapon.name === 'Lady Death' ?'Lady Death builds go hard on Firepower and Weapon Damage so every stack of that +15% WD bonus hits like a freight train. Vanguard for Tactical Link synergy, or Bulwark Breacher if you like the aggressive shield-rush playstyle. Gear sets: Fury Strike 4pc (Crit) for fat per-shot damage, or Quick Draw 4pc for Headshot Damage if your aim is cracked.' : weapon.name === 'The Bighorn' ? 'The Bighorn rewards aim more than any other exotic: aimed shots carry the +300% Weapon Damage, and only headshots build and keep its stacks. That points at Firepower specs (Vanguard Commando or Bulwark Breacher) and at stats that help headshots land and hit harder: Headshot Damage, Accuracy and Stability.' : weapon.name === 'Diamondback' ? 'The Diamondback is a mark-and-burst rifle: hit the marked enemy, make the 5-second crit window count, and reload when you want a fresh mark. Weapon Critical Hit Damage turns those guaranteed crits into damage, and the +10% Skill Critical Hit Chance gives a hybrid build with damaging skills a second reason to run it.' : weapon.name === 'Warlord' ? 'Warlord turns you into a tank-DPS hybrid. Stack Toughness if you want to be unkillable, Firepower if you want to deal more: either works. That 25% DR while firing is nuts for Legendary missions where adds are constantly shooting at you. Pair with Fearless Warrior if you want to face-tank everything, or Fury Strike if you\'d rather crit harder.' : 'Strawberry Milkshake is all about never stopping shooting. That 100-round mag means Concentrated Fire hits max stacks, Multi-Shot keeps proccing, and you just don\'t reload. Run Phalanx Attack 4pc for +18% Mag Size and +12% Multi-Shot, Fury Strike 2pc for Crit Chance, Glass Cannon Body Armor for +20% damage, and Dominating Presence OS for even more Multi-Shot per enemy in range (it only started granting Multi-Shot after a Season 2 Phase 1 fix, and Phase 2 capped it at 35% at base level). It\'s a machine.'}</p>
          <p>Hit the <a href="/tier-list/" style="color: var(--accent);">Build Tier List</a> for verified loadouts running {weapon.name}, or use the <a href="/builder/" style="color: var(--accent);">Build Planner</a> to cook up your own.</p>
        </div>
      </div>

      <!-- How to Get -->
      <div style="margin-bottom: var(--sp-8);">
        <h2 class="weapon-stats__heading">How to Get {weapon.name}</h2>
        <div style="color: #c8c8d0; line-height: 1.75; font-size: var(--text-base);">
          {weapon.name === 'Scorpio' ? (
            <Fragment>
              <p><strong style="color: #F5CC45;">Update (October 2026):</strong> the Phase 3 pass is long gone, but Scorpio isn't. Ubisoft added it to the <strong style="color: #fff;">Dark Zone vendor</strong> in Season 2 Phase 1, cut the vendor's exotic price from 17,500 to 15,000 DZ Credits in Season 2 Phase 2, and added <strong style="color: #fff;">Exotic Sealed Caches</strong> in Season 2 Phase 2 as a way to get exotics from previous seasons. Since Phase 2, exotics no longer come with exotic mods pre-installed. Exotic mods can be swapped off since Season 2 Phase 1 and now come from the pass, weekly quests, Elite Mission challenge chests and the DZ vendor's weekly exotic mod crates (2,500 DZ Credits each).</p>
              <p>Scorpio launched as a <strong style="color: #fff;">Classified Ops Pass 1.3 exclusive</strong>: it unlocked at <strong style="color: var(--accent);">tier 5 of the premium track</strong> (the free track carried its Tactical Augmentation module instead). Tier 5 was an easy climb, so buying the Premium Pass ($9.99) effectively got you the gun within your first session or two of pass play; the Elite Pass ($19.99) instantly completed 10 tiers, which meant Scorpio the moment the purchase cleared.</p>
              <p>About the confusion at launch: Ubisoft's Phase 3 announcement said the Scorpio "can be grabbed for free", but that wording referred to the Tactical Augmentation module on the free track, not the weapon. We verified the weapon's premium tier 5 placement in-game.</p>
            </Fragment>
          ) : (weapon.name === 'The Bighorn' || weapon.name === 'Diamondback') ? (
            <Fragment>
              {weapon.name === 'The Bighorn' ? (
                <p>The Bighorn was the <strong style="color: #fff;">Season 2 Phase 1 Classified Ops Pass</strong> exotic, on the free and premium track. That pass ended when Phase 2 began on September 16, 2026, so <strong style="color: #fff;">Exotic Sealed Caches</strong> are the way to get it now: Ubisoft added them in Season 2 Phase 2 to hand out exotics from previous seasons.</p>
              ) : (
                <p>The Diamondback is on the <strong style="color: #fff;">free and premium track</strong> of the current Season 2 Phase 2 Classified Ops Pass, which Ubisoft extended on October 21, 2026 "until we are ready to release a much bigger update later this year." Ubisoft also added Diamondback rewards to Dark Zone vendors, reward caches, weekly reward pools and exotic mod sources, and The Diamondback Cache is one of the Exotic Sealed Cache rewards.</p>
              )}
              <p>Since Season 2 Phase 2, exotics no longer come with exotic mods pre-installed. Those mods now come from the pass, weekly quests, Elite Mission challenge chests and the Dark Zone vendor's weekly exotic mod crates (2,500 DZ Credits each). The full rundown is in our <a href="/guides/division-resurgence-exotic-weapons-list-2026/" style="color: var(--accent);">exotic weapons list</a>.</p>
            </Fragment>
          ) : (
            <Fragment>
              <p>Exotics drop from endgame activities: Legendary/Elite missions, Dark Zone, and Conflicts. Drop rates are pain. Expect to run dozens of activities before you see one. {weapon.name === 'Warlord' ? 'Warlord is the exception: a T1 version came from the Season 1 Battle Pass, and the Dark Zone vendor has sold it since Season 1 Phase 2 (15,000 DZ Credits since Season 2 Phase 2, down from 17,500), making it the easiest exotic to get your hands on. The catch? Upgrading proficiency means PvP kills. Hope you like the Dark Zone.' : 'Focus on Legendary missions for the best drop rates, and run activities that have ' + weapon.type + 's in the targeted loot pool so you\'re not just praying to RNG.'}{weapon.name === 'Strawberry Milkshake' ? ' Strawberry Milkshake itself was the free exotic on the Season 1 Phase 2 Classified Ops Pass.' : ''}</p>
              <p>T2 isn't only a drop-luck thing. Died Again Gaming said in June that he believes exotics drop as T1, and that they go to T2 with an Exotic Weapon Enhancement Kit (Ubisoft stocks them at the Dark Zone vendor) once you have six T2 weapons at max proficiency, and that copies you get after enhancing drop at T2 (<a href="/guides/division-resurgence-gear-farming-guide/" style="color: var(--accent);">how enhancing works</a>). T1 still holds its own in most content. You can start leveling weapon proficiency on any tier, so the second you get one, any tier, start grinding those proficiency kills.</p>
              <p><strong style="color: #F5CC45;">Update (October 2026):</strong> since Season 2 Phase 2, Exotic Sealed Caches are Ubisoft's official way to get exotics from previous seasons, and exotics no longer come with exotic mods pre-installed. Those mods now come from the pass, weekly quests, Elite Mission challenge chests and the Dark Zone vendor's weekly exotic mod crates (2,500 DZ Credits each).</p>
            </Fragment>
          )}
        </div>
      </div>
      <DbItemExtras kind="exotic-weapon" name={weapon.name} />

      <!-- Back Link -->
      <div class="weapon-detail__back">
        <a href="/database/exotic-weapons/" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
          Back to All Exotics
        </a>
      </div>
    </div>

    <AdSenseUnit label="Advertisement (database item)" />
  </div>
</BaseLayout>

<style>
  .weapon-detail {
    max-width: 48rem;
  }

  .weapon-detail__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
    margin-bottom: var(--sp-8);
    padding-bottom: var(--sp-6);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .weapon-detail__name {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin: 0;
    background: linear-gradient(135deg, #fff 60%, var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @media (min-width: 45em) {
    .weapon-detail__name {
      font-size: var(--text-5xl);
    }
  }

  .weapon-type-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
