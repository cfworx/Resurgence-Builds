---
import DatabaseLayout from '../../../layouts/DatabaseLayout.astro';
import allExoticWeapons from '../../../data/exotic-weapons.json';
// Exotics with unverified stat lines (statsVerified: false) are in the planner only, not the database.
const exoticWeapons = allExoticWeapons.filter((w: any) => w.statsVerified !== false);
import AdSenseUnit from '../../../components/AdSenseUnit.astro';
import GameImage from '../../../components/GameImage.astro';
import { dbImage } from '../../../utils/db-images';
import { verifiedPatch } from '../../../data/site-config';
// All six exotics were re-checked in the in-game Build-Making Database on 2026-10-28 (Season 2 Phase 2).
const lastVerified = verifiedPatch();

const title = "Exotic Weapons: Full List & Stats";
const description = "Division Resurgence exotic weapons with stats and talents. Each one bends the rules differently. Most are broken. That's the point.";
const breadcrumbs = [
  { name: 'Exotic Weapons', url: '/database/exotic-weapons/' }
];

const slugify = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const faqs = [
  { question: "How do you get exotic weapons in Division Resurgence?", answer: "Mostly by paying attention to the pass. Each Classified Ops Pass phase since Season 1 Phase 2 has shipped a new exotic (Strawberry Milkshake, Scorpio, The Bighorn, Diamondback), the Dark Zone vendor sells some older ones (Warlord since Season 1 Phase 2, Scorpio since Season 2 Phase 1) for 15,000 DZ Credits, and since Season 2 Phase 2 Exotic Sealed Caches can drop exotics from previous seasons. Check each exotic's detail page on this site for its specific source." },
  { question: "What is the best exotic weapon in Division Resurgence?", answer: "It shifts with every patch, but the strongest exotics are the ones whose unique talent synergizes with a specific build archetype. An exotic with a mediocre talent on paper can be S-tier if it enables a broken combo with certain gear sets or skills." },
  { question: "Can you recalibrate exotic weapons in Division Resurgence?", answer: "Partly. The unique exotic talent is fixed, so you can't reroll the thing that makes the gun special. Exotics do have their own recalibration materials, though: Exotic Weapon Recalibration Manuals and Booklets, which come from weekly rewards, the Dark Zone (their drops there were fixed in Season 2 Phase 1) and Exotic Sealed Caches. Exotic mods can also be swapped off since Season 2 Phase 1. That's the exotic life." },
];

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'The Division Resurgence Exotic Weapons',
  description: description,
  numberOfItems: exoticWeapons.length,
  itemListElement: exoticWeapons.map((item: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${Astro.url.origin}/database/exotic-weapons/${slugify(item.name)}/`,
    item: {
      '@type': 'Thing',
      '@id': `${Astro.url.href}#item-${i}`,
      name: item.name || item.talent || item.attribute || item.protocolName || 'Item',
      description: item.description || item.talentDescription || item.effect || item.notes || `Details for ${item.name || item.talent || item.attribute || item.protocolName || 'item'}`,
      url: `${Astro.url.origin}/database/exotic-weapons/${slugify(item.name)}/`,
      subjectOf: { '@id': 'https://resurgencebuilds.com/#division-resurgence' }
    }
  })),
};
---

<DatabaseLayout
  {title}
  {description}
  {breadcrumbs}
  heading="Exotic Weapons"
  subheading="The rarest and most powerful weapons in Resurgence. Each one bends the rules in a different way. Most are broken. That's the point."
  jsonLd={itemListLd}
  ogImage={dbImage('exotic-weapons/diamondback', 'hero')?.src}
  lastVerified={lastVerified}
  {faqs}
>
  <p style="color: #c8c8d0; line-height: 1.7; font-size: var(--text-sm); max-width: var(--measure); margin-bottom: var(--sp-6);"><strong style="color: #F5CC45;">Update (October 28, 2026):</strong> every stat line on this page now comes from the in-game Build-Making Database: Level 1, T1 base values with no mods. That put The Bighorn and the Diamondback in the database and corrected numbers we had taken from creators' cards with mods fitted: Lady Death's reload and range, Warlord's accuracy, reload, range and stability, Strawberry Milkshake's accuracy and range, and Scorpio's accuracy, reload, stability and damage. The full list of changes is in our <a href="/guides/division-resurgence-exotic-weapons-list-2026/" style="color: var(--accent);">exotic weapons list</a>. Since Season 2 Phase 2, exotics no longer ship with exotic mods pre-installed.</p>

  <div class="db-grid" id="exotics-grid">
      {exoticWeapons.map((weapon, i) => (
        <article class="db-card exotic-card">
          <a href={`/database/exotic-weapons/${slugify(weapon.name)}/`} class="exotic-card-link" aria-label={`View ${weapon.name} exotic weapon details`}>
            {dbImage(`exotic-weapons/${slugify(weapon.name)}`, 'hero') && (
              <div class="exotic-card__image exotic-thumb">
                <GameImage
                  image={dbImage(`exotic-weapons/${slugify(weapon.name)}`, 'hero')!}
                  alt={`${weapon.name}, exotic ${weapon.type} in The Division Resurgence, on its in-game card`}
                  sizes="(max-width: 640px) calc(100vw - 64px), 360px"
                  eager={i < 2}
                />
              </div>
            )}
            <div class="db-card__header">
              <div>
                <h2 class="db-card__title">{weapon.name}</h2>
                <span class="weapon-type">{weapon.type}</span>
              </div>
            </div>
            
            <div class="db-card__body">
              <div class="stats-grid">
                <div class="stat-item">
                  <span class="stat-label">Damage</span>
                  <span class="stat-value">{weapon.damage}</span>
                </div>
                <div class="stat-item">
                  <span class="stat-label">RPM</span>
                  <span class="stat-value">{weapon.rpm}</span>
                </div>
                <div class="stat-item">
                  <span class="stat-label">MAG</span>
                  <span class="stat-value">{weapon.mag}</span>
                </div>
                <div class="stat-item">
                  <span class="stat-label">Accuracy</span>
                  <span class="stat-value">{weapon.accuracy}</span>
                </div>
                <div class="stat-item">
                  <span class="stat-label">Reload</span>
                  <span class="stat-value">{weapon.reloadSpeed}</span>
                </div>
                <div class="stat-item">
                  <span class="stat-label">Opt. Range</span>
                  <span class="stat-value">{weapon.optimalRange}</span>
                </div>
                <div class="stat-item">
                  <span class="stat-label">Movement</span>
                  <span class="stat-value">{weapon.movementSpeed}</span>
                </div>
                <div class="stat-item">
                  <span class="stat-label">Stability</span>
                  <span class="stat-value">{weapon.stability}</span>
                </div>
              </div>

              <div class="talent-section">
                <h3 class="talent-name">{weapon.talentName}</h3>
                <p class="talent-desc-text">{weapon.talentDescription}</p>
                {weapon.caveat && weapon.note && <p class="item-note">{weapon.note}</p>}
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
<AdSenseUnit label="Advertisement (database category)" />
</DatabaseLayout>

<style is:global>
  .exotic-card__image { margin-bottom: var(--sp-4); border-radius: 6px; overflow: hidden; border: 1px solid rgba(255,255,255,0.06); background: rgba(0,0,0,0.3); }
  .exotic-card__image img { display: block; width: 100%; height: auto; }
  .exotic-card-link {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    text-decoration: none;
    color: inherit;
  }

  .exotic-card-link:hover {
    color: inherit;
  }
</style>
