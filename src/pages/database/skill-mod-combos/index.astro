---
import DatabaseLayout from '../../../layouts/DatabaseLayout.astro';
import { fixPlurals } from '../../../utils/seo';
import skillMods from '../../../data/skill-mod-combos.json';
import AdSenseUnit from '../../../components/AdSenseUnit.astro';
import DbIcon from '../../../components/DbIcon.astro';
import { verifiedPatch } from '../../../data/site-config';
// 89 of the 90 combos were re-checked in the in-game Build-Making Database on 2026-10-28 (Season 2 Phase 2).
// Ammo Refill is the exception: the database still shows its pre-Season 2 text (see its note).
const lastVerified = verifiedPatch();

const title = "Division Resurgence Skill Mod Combos & Mods Guide";
const description = "Every Skill Mod Combo in Division Resurgence and their 2-piece and 3-piece set bonuses. Pair them wrong and your build is a participation trophy.";
const breadcrumbs = [
  { name: 'Skill Mod Combos', url: '/database/skill-mod-combos/' }
];

const specializations = [...new Set(skillMods.map(m => m.specialization))];

const getSpecClass = (spec: string) => {
  const s = spec.toLowerCase();
  if (s.includes('demolitionist')) return 'tag--demo';
  if (s.includes('tech operator')) return 'tag--tech';
  if (s.includes('bulwark')) return 'tag--bulwark';
  if (s.includes('vanguard')) return 'tag--vanguard';
  if (s.includes('medic')) return 'tag--medic';
  return '';
};

const toSlug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const faqs = [
  { question: "What are skill mod combos in Division Resurgence?", answer: "Skill mod combos are set bonuses you get from equipping matching skill mods. Slot 2 mods from the same combo set for a 2-piece bonus, or go all-in with 3 matching mods for the full 3-piece bonus. They're tied to specific specializations, so make sure you're matching mods that work with your class." },
  { question: "How do I get skill mods in Division Resurgence?", answer: "Since Season 2 Phase 2, Dark Zone daily quests reward Skill Mods. Each specialization focus also has a Sealed Cache full of its skill mod pieces, and Ubisoft publishes the odds (our drop rates page has every row). Spares are worth dismantling: blue, purple and yellow skill mods pay 15, 75 and 750 Dark Zone Credits." },
  { question: "Do skill mod combo bonuses stack with gear set bonuses?", answer: "Yes, they stack. Skill mod combo bonuses are completely separate from gear set bonuses. You can run a full 4-piece gear set and a 3-piece skill mod combo at the same time. This is how endgame skill builds get absurd: layering every bonus source the game gives you." },
];

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'The Division Resurgence Skill Mod Combos',
  description: description,
  numberOfItems: skillMods.length,
  itemListElement: skillMods.map((item: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://resurgencebuilds.com/database/skill-mod-combos/${toSlug(item.name)}/`,
    item: {
      '@type': 'Thing',
      '@id': `https://resurgencebuilds.com/database/skill-mod-combos/${toSlug(item.name)}/`,
      name: item.name,
      description: `${item.name}, ${item.specialization} Skill Mod Combo. 2pc: ${fixPlurals(item.bonus2)}. 3pc: ${fixPlurals(item.bonus3)}`,
      url: `https://resurgencebuilds.com/database/skill-mod-combos/${toSlug(item.name)}/`,
      subjectOf: { '@id': 'https://resurgencebuilds.com/#division-resurgence' }
    }
  })),
};
---

<DatabaseLayout
  {title}
  {description}
  {breadcrumbs}
  modified="2026-10-28"
  heading="Skill Mod Combos"
  subheading="Pairing the right skill mods unlocks powerful synergy bonuses. Two pieces or three: know which combo fits your chaos."
  jsonLd={itemListLd}
  lastVerified={lastVerified}
  {faqs}
>
  <p style="color: #c8c8d0; line-height: 1.7; font-size: var(--text-sm); max-width: var(--measure); margin-bottom: var(--sp-4);"><strong style="color: #F5CC45;">Update (October 28, 2026):</strong> we checked all 90 sets against the in-game Build-Making Database. 86 already matched our text, give or take the game's "second(s)" wording. Three changed: <a href="/database/skill-mod-combos/berserker/" style="color: var(--accent);">Berserker</a> now reads +60% Weapon Critical Hit Damage (Ubisoft fixed its bonus in Season 2 Phase 2; we had the old +100% Critical Hit Chance tooltip), <a href="/database/skill-mod-combos/commando/" style="color: var(--accent);">Commando</a> uses the game's exact wording (same 10.20% for 10 seconds), and Thermobaric Grenades gained a missing "but". The database still shows <a href="/database/skill-mod-combos/ammo-refill/" style="color: var(--accent);">Ammo Refill</a>'s pre-Season 2 text, so we kept the patched values there. Each set's page now lists the rarities it comes in: every set has High-End and Superior pieces, and 21 sets (one per skill) also come in Specialized.</p>
  <p id="tiers" style="color: #c8c8d0; line-height: 1.7; font-size: var(--text-sm); max-width: var(--measure); margin-bottom: var(--sp-4); scroll-margin-top: 90px;"><strong style="color: #F5CC45;">The numbers are the lowest tier.</strong> Each set's 2-piece shows its full range, but the 3-piece text here is the lowest of its tiers, which is what the in-game database shows. Equipped sets can read more. Ubisoft's own preview gave <a href="/database/skill-mod-combos/heavy-weight/" style="color: var(--accent);">Heavy Weight</a>'s four tiers as 2, 3, 4 and 5% of Max Health, so the top tier is two and a half times the bottom, and creator screens fit that: Demø2x's Tech Operator sets in his <a href="https://www.youtube.com/watch?v=ufNZIXHoR00" style="color: var(--accent);">October 14 build video</a> read a 12.40% chance on <a href="/database/skill-mod-combos/thermite-charge/" style="color: var(--accent);">Thermite Charge</a> (5% here), +15% on <a href="/database/skill-mod-combos/stabilized-flight/" style="color: var(--accent);">Stabilized Flight</a> (+6%) and +27.20% on <a href="/database/skill-mod-combos/optimized-targeting/" style="color: var(--accent);">Optimized Targeting</a> (+10.80%). TikTokAndy's Commando sets on his <a href="https://www.youtube.com/watch?v=RYtZyN_0P0Y" style="color: var(--accent);">October 27 build card</a> read exactly our text. GGReborn's Vanguard sets on October 31 add a clue: his all-purple <a href="/database/skill-mod-combos/optimized-armor/" style="color: var(--accent);">Optimized Armor</a> and <a href="/database/skill-mod-combos/field-supplies/" style="color: var(--accent);">Field Supplies</a>, five upgrades each, read exactly our text and the bottom of their 2-piece ranges, while his <a href="/database/skill-mod-combos/tactical-loop/" style="color: var(--accent);">Tactical Loop</a>, two gold pieces and one purple, reads up to 16 stacks (8 here) and the top of its 2-piece range. Upgrades alone didn't move a set up; what does isn't confirmed, so compare your own tooltip.</p>
  <p style="color: var(--ink-muted); font-size: var(--text-sm); line-height: 1.7; max-width: var(--measure); margin: 0 0 var(--sp-5) 0;">Names here are the ones the game shows on its tooltips. Ubisoft's official <a href="/database/drop-rates/">drop-rate table</a> uses different names for some sets (31 of its 90 set names don't match this list), so if a cache row names a set you can't find here, match it by skill and check the effect text in game.</p>

  <div class="db-filters">
    <div class="filter-group" id="filter-spec">
      <span class="filter-label">Specialization:</span>
      <div class="filter-bar">
        <button class="filter-btn is-active" data-filter="all">All</button>
        {specializations.map(s => <button class="filter-btn" data-filter={s}>{s}</button>)}
      </div>
    </div>
  </div>

  <div class="db-grid" id="combos-grid">
    {skillMods.map((mod) => (
      <a href={`/database/skill-mod-combos/${toSlug(mod.name)}/`} class="db-card-link" data-spec={mod.specialization} style="text-decoration:none;color:inherit;display:block;">
        <article class="db-card" style="height:100%;">
          <div class="db-card__header" style="justify-content:flex-start;align-items:center;flex-wrap:nowrap;">
            <DbIcon id={`skill-mod-combos/${toSlug(mod.name)}`} size={52} />
            <div>
              <h2 class="db-card__title">{mod.name}</h2>
              <span class={`tag ${getSpecClass(mod.specialization)}`} style="margin-top:var(--sp-2);display:inline-block;">{mod.specialization}</span>
            </div>
          </div>
          
          <div class="db-card__body">
            <div class="bonus-block">
              <div class="bonus-group">
                <span class="bonus-label bonus-label-2">
                  <span class="bonus-badge bonus-badge-2">2</span>
                  Piece Bonus
                </span>
                <p class="bonus-text">{fixPlurals(mod.bonus2)}</p>
              </div>
            </div>

            <div class="bonus-block">
              <div class="bonus-group">
                <span class="bonus-label bonus-label-3">
                  <span class="bonus-badge bonus-badge-3">3</span>
                  Piece Bonus
                </span>
                <p class="bonus-text">{fixPlurals(mod.bonus3)}</p>
                {mod.caveat && mod.note && <p class="item-note">{mod.note}</p>}
              </div>
            </div>
          </div>
        </article>
      </a>
    ))}
  </div>
<AdSenseUnit label="Advertisement (database category)" />
</DatabaseLayout>

<script>
  let currentSpec = 'all';

  const filterSpecBar = document.getElementById('filter-spec');
  const grid = document.getElementById('combos-grid');

  const updateFilters = () => {
    requestAnimationFrame(() => {
      grid?.querySelectorAll('.db-card-link').forEach(link => {
        const el = link as HTMLElement;
        const matchesSpec = currentSpec === 'all' || el.dataset.spec === currentSpec;
        el.style.display = matchesSpec ? '' : 'none';
      });
    });
  };

  if (filterSpecBar && grid) {
    filterSpecBar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.filter-btn');
      if (!btn) return;
      filterSpecBar.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      currentSpec = btn.getAttribute('data-filter') || 'all';
      updateFilters();
    });
  }
</script>
