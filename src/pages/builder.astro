---
import BaseLayout from '../layouts/BaseLayout.astro';
import gearSets from '../data/gear-set-effects.json';
import weaponTalents from '../data/weapon-talents.json';
import exoticWeapons from '../data/exotic-weapons.json';
import standardWeapons from '../data/standard-weapons.json';
import bodyArmorTalents from '../data/body-armor-talents.json';
import backpackTalents from '../data/backpack-talents.json';
import osProtocols from '../data/os-protocols.json';
import skillModCombos from '../data/skill-mod-combos.json';
import bonusAttributes from '../data/bonus-attributes.json';
import weaponBonusAttributes from '../data/weapon-bonus-attributes.json';
import plannerSpecs from '../data/planner-specs.json';
import templateNotes from '../data/planner-template-notes.json';
import talentSources from '../data/weapon-talent-sources.json';
import gearSources from '../data/gear-sources.json';
import { getCollection } from 'astro:content';
import { CURRENT_PATCH } from '../data/site-config';
import { SOURCES_RECORDED, RECAL_FIX } from '../utils/rolls';
import { dbImage, type DbImage } from '../utils/db-images';

// Templates: every build guide with a plannerHash, grouped by specialization in the picker
const notes: Record<string, unknown> = templateNotes;
const allBuilds = await getCollection('builds');
const templates = allBuilds
  .filter(b => b.data.plannerHash)
  .map(b => ({
    id: b.id,
    name: b.data.title.trim(),
    spec: b.data.specialization,
    hash: b.data.plannerHash,
    note: notes[b.id] || null,
  }))
  .sort((a, b) => a.spec.localeCompare(b.spec) || a.name.localeCompare(b.name));

const title = 'Division Resurgence Build Planner';
const description = 'Plan a Division Resurgence loadout: gear sets and attributes, weapons and talents, OS Protocol and skill mods. See stat totals, set bonuses and build checks, then share the build as a link.';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Build Planner', url: '/builder/' }
];
const jsonLd = {
  '@type': 'WebApplication',
  '@id': 'https://resurgencebuilds.com/builder/#app',
  name: 'Division Resurgence Build Planner',
  url: 'https://resurgencebuilds.com/builder/',
  applicationCategory: 'GameApplication',
  operatingSystem: 'Any (browser)',
  browserRequirements: 'Requires JavaScript. Modern evergreen browser.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  about: { '@id': 'https://resurgencebuilds.com/#division-resurgence' },
  publisher: { '@id': 'https://resurgencebuilds.com/#organization' }
};

// What can roll where, from the game's Build-Making Database Source lists (research/build-database):
// each weapon's talent pool, and for each gear set the body armor and backpack talents a piece of that
// set can carry (with the pieces, so the planner can name them).
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const talentIdBySlug: Record<string, string> = Object.fromEntries(weaponTalents.map((t: any) => [slugify(t.name), t.id]));
const talentIdByName: Record<string, string> = Object.fromEntries(weaponTalents.map((t: any) => [t.name, t.id]));
talentIdByName['Precision Support'] = talentIdByName['Precise Support'];
const weaponIdBySlug: Record<string, string> = Object.fromEntries(standardWeapons.map((w: any) => [slugify(w.name), w.id]));
const weaponPools: Record<string, string[]> = {};
for (const [tslug, t] of Object.entries((talentSources as any).talents) as [string, any][]) {
  const tid = talentIdBySlug[tslug];
  if (!tid) continue;
  for (const w of t.weapons) {
    const wid = weaponIdBySlug[w.slug];
    if (wid) (weaponPools[wid] ||= []).push(tid);
  }
}
for (const e of exoticWeapons as any[]) {
  if (Array.isArray(e.possibleTalents)) weaponPools[e.id] = e.possibleTalents.map((n: string) => talentIdByName[n]).filter(Boolean);
}
const setIdBySlug: Record<string, string> = Object.fromEntries(gearSets.map((g: any) => [slugify(g.name), g.id]));
const gs = gearSources as any;
const gearRolls: Record<string, Record<string, Record<string, string[]>>> = { body: {}, backpack: {} };
for (const [kind, slot, list] of [['bodyArmorTalents', 'body', bodyArmorTalents], ['backpackTalents', 'backpack', backpackTalents]] as const) {
  const idBySlug: Record<string, string> = Object.fromEntries((list as any[]).map((t) => [slugify(t.name), t.id]));
  for (const [tslug, t] of Object.entries(gs[kind]) as [string, any][]) {
    const tid = idBySlug[tslug];
    if (!tid) continue;
    for (const p of t.pieces) {
      const piece = gs.pieces[p.slug];
      for (const [sslug, set] of Object.entries(gs.sets) as [string, any][]) {
        if (!set.pieces.some((x: any) => x.slug === p.slug)) continue;
        const sid = setIdBySlug[sslug];
        ((gearRolls[slot][sid] ||= {})[tid] ||= []).push(`${piece.name} (${piece.tier})`);
      }
    }
  }
}

// In-game art for every item the planner shows: weapon tiles, talent, set, OS Protocol and skill mod icons. Paths
// under /images/db/ without ".webp", keyed by item id (exotic talents by "et:" + the exotic's id).
const img: Record<string, string> = {};
const put = (id: string, url?: string) => { if (url) img[id] = url.replace(/^\/images\/db\//, '').replace(/\.webp$/, ''); };
const smallest = (im?: DbImage) => im?.srcset[0]?.[1];
for (const w of standardWeapons as any[]) put(w.id, dbImage(`weapon-icons/${slugify(w.name)}`, 'card')?.src);
for (const e of exoticWeapons as any[]) {
  put(e.id, dbImage(`exotic-weapons/${slugify(e.name)}`, 'hero')?.src);
  put(`et:${e.id}`, smallest(dbImage(`weapon-talents/${slugify(e.talentName)}`, 'icon')));
}
for (const [list, folder] of [[weaponTalents, 'weapon-talents'], [gearSets, 'gear-set-effects'], [bodyArmorTalents, 'body-armor-talents'],
  [backpackTalents, 'backpack-talents'], [osProtocols, 'os-protocols'], [skillModCombos, 'skill-mod-combos']] as const) {
  for (const x of list as any[]) put(x.id, smallest(dbImage(`${folder}/${slugify(x.name)}`, 'icon')));
}

// Only what the engine reads goes into the payload
const omit = <T extends Record<string, unknown>>(list: T[], keys: string[]) =>
  list.map(item => Object.fromEntries(Object.entries(item).filter(([k]) => !keys.includes(k))));
const dataPayload = JSON.stringify({
  specs: plannerSpecs,
  gearSets: omit(gearSets, ['tiers', 'verifiedInGame']),
  weaponTalents: omit(weaponTalents, ['verifiedInGame']),
  exoticWeapons: omit(exoticWeapons, ['image', 'acquisition', 'possibleTalents']),
  standardWeapons: omit(standardWeapons, ['image', 'randomizedAttributes', 'talent1', 'armoryTier', 'dmgType']),
  bodyArmorTalents: omit(bodyArmorTalents, ['verifiedInGame']),
  backpackTalents: omit(backpackTalents, ['verifiedInGame']),
  osProtocols: omit(osProtocols, ['image', 'imageAlt', 'cooldown', 'verifiedInGame']),
  skillModCombos: omit(skillModCombos, ['rarities', 'verifiedInGame']),
  bonusAttributes,
  weaponBonusAttributes,
  templates,
  img,
  rolls: { recorded: SOURCES_RECORDED, weapons: weaponPools, gear: gearRolls,
    recalFixed: { patch: RECAL_FIX.patch, dateText: RECAL_FIX.dateText, weapons: RECAL_FIX.weapons } },
}).replace(/</g, '\\u003c');

const chevron = 'M6 9l6 6 6-6';
// The game's order for gear: mask, body armor and backpack on top, gloves, holster and knee pads below
const GEAR = [
  ['mask', 'Mask', 'icon-mask', false], ['body', 'Body armor', 'icon-shield', true], ['backpack', 'Backpack', 'icon-backpack', true],
  ['gloves', 'Gloves', 'icon-gloves', false], ['holster', 'Holster', 'icon-holster', false], ['kneepads', 'Knee pads', 'icon-kneepads', false],
] as const;
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
  noAds={true}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/builder-v4.css?v=2" />
  </Fragment>

  <div class="lab" id="lab">
    <noscript><p class="lab-msg">The planner needs JavaScript. Every loadout is also written out in full in the <a href="/builds/">build guides</a>.</p></noscript>
    <p class="lab-msg" id="labError" hidden>The planner didn't load. Reload the page to try again.</p>

    <header class="pl-bar">
      <div class="pl-bar__id">
        <div class="pl-title-row"><h1 class="pl-title">Build Planner</h1><span class="pl-data">{CURRENT_PATCH} data</span></div>
        <label class="sr-only" for="buildNameInput">Build name</label>
        <input type="text" class="pl-name" id="buildNameInput" placeholder="Name your build" maxlength="60" autocomplete="off" spellcheck="false" />
      </div>
      <div class="pl-bar__tools">
        <!-- Slot machine: spins every slot and fills it with a random loadout the game allows -->
        <button type="button" class="pl-slot" id="slotBtn" aria-label="Take your chances: fill every slot at random">
          <span class="pl-slot__reels" aria-hidden="true"><i><b>7</b><b>&#9733;</b><b>7</b></i><i><b>7</b><b>&#9733;</b><b>7</b></i><i><b>7</b><b>&#9733;</b><b>7</b></i></span>
          <span class="pl-slot__label" aria-hidden="true"><span>Take your chances</span><span>Stop the reels</span></span>
          <span class="pl-slot__lever" aria-hidden="true"><span></span></span>
        </button>
        <button type="button" class="pl-btn pl-btn--load" id="tplBtn" aria-haspopup="dialog">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h16M4 12h16M4 19h10"/></svg>
          <span id="tplLabel">Load a build guide</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d={chevron}/></svg>
        </button>
        <button type="button" class="pl-btn" id="mineBtn" aria-haspopup="dialog">My builds <span class="pl-btn__n" id="mineCount"></span></button>
        <span class="pl-bar__group" role="group" aria-label="History">
          <button type="button" class="pl-icon" id="undoBtn" aria-label="Undo" title="Undo (Ctrl+Z)" disabled>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 14L4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 010 11H11"/></svg>
          </button>
          <button type="button" class="pl-icon" id="redoBtn" aria-label="Redo" title="Redo (Ctrl+Shift+Z)" disabled>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 14l5-5-5-5"/><path d="M20 9H9.5a5.5 5.5 0 000 11H13"/></svg>
          </button>
          <button type="button" class="pl-icon" id="resetBtn" aria-label="Start over" title="Start over">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 109-9 9 9 0 00-6.4 2.6L3 8M3 4v4h4"/></svg>
          </button>
        </span>
        <span class="pl-bar__group pl-bar__share">
          <button type="button" class="pl-btn" id="saveBtn">Save</button>
          <button type="button" class="pl-btn" id="textBtn">Copy as text</button>
          <button type="button" class="pl-btn" id="cardBtn" aria-haspopup="dialog">Build card</button>
          <button type="button" class="pl-btn pl-btn--go" id="shareBtn">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1"/></svg>
            Copy link
          </button>
        </span>
      </div>
    </header>
    <p class="lab-note" id="labNote" role="status" hidden></p>
    <div class="share-link" id="shareLink" hidden>
      <label class="share-link__lbl" id="shareLinkLabel" for="shareLinkField">Copy this link</label>
      <textarea class="share-link__field" id="shareLinkField" rows="2" readonly></textarea>
    </div>

    <div class="pl-grid">
      <div class="pl-board">
        <section class="pl-agent" id="specPanel" aria-labelledby="specTitle">
          <div class="pl-agent__emblem" aria-hidden="true"><img id="specEmblem" src="/images/icons/icon-spec.webp" alt="" width="88" height="88" /></div>
          <div class="pl-agent__body">
            <h2 class="pl-h" id="specTitle">Specialization</h2>
            <div class="spec-grid" role="group" aria-labelledby="specTitle">
              {plannerSpecs.specs.map((sp) => (
                <button type="button" class="spec-btn" data-spec={sp.name} aria-pressed="false" aria-label={sp.name}>
                  <img src={sp.icon} alt="" class="sigil" width="32" height="32" />
                  <span class="nm">{sp.name}</span>
                </button>
              ))}
            </div>
            <div class="pl-focus">
              <span class="pl-focus__lbl" id="focusTitle">Focus</span>
              <button type="button" class="pl-focus__btn" id="subBtn" aria-haspopup="dialog" aria-labelledby="focusTitle subLabel" disabled>
                <span id="subLabel">Pick a specialization</span>
                <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d={chevron}/></svg>
              </button>
            </div>
          </div>
        </section>

        <section class="pl-sec" aria-labelledby="weaponsTitle">
          <h2 class="pl-h" id="weaponsTitle">Weapons</h2>
          <div class="pl-weapons">
            {[1, 2].map((n) => (
              <div class="wtile" id={`w${n}card`} data-weapon={n}>
                <button type="button" class="wtile__main" id={`w${n}btn`} data-wslot={n} aria-haspopup="dialog">
                  <span class="wtile__art"><img id={`w${n}img`} alt="" width="330" height="156" hidden /><span class="wtile__ph" aria-hidden="true"><img src="/images/icons/icon-weapon.webp" alt="" width="28" height="28" /></span></span>
                  <span class="wtile__txt">
                    <span class="wtile__role">{n === 1 ? 'Primary' : 'Secondary'}</span>
                    <span class="wtile__name" id={`w${n}name`}>Add a weapon</span>
                    <span class="wtile__sub" id={`w${n}sub`}></span>
                  </span>
                </button>
                <label class="wtile__tier" title="Weapon tier"><span class="sr-only">{n === 1 ? 'Primary weapon tier' : 'Secondary weapon tier'}</span>
                  <select id={`w${n}tier`} disabled>
                    <option value="">Tier</option>
                    <option value="T0">T0</option>
                    <option value="T1">T1</option>
                    <option value="T2">T2</option>
                  </select>
                </label>
                <div class="wtile__rows">
                  <div class="chip chip--exotic" id={`w${n}fixed`} hidden><img alt="" width="28" height="28" hidden /><span class="picktag__val"></span><span class="picktag__desc" hidden></span></div>
                  {[1, 2].map((j) => (
                    <button type="button" class="chip chip--talent" data-talent={`w${n}t${j}`} aria-haspopup="dialog" disabled><img alt="" width="28" height="28" hidden /><span class="picktag__val">Talent {j}</span><span class="picktag__desc" hidden></span></button>
                  ))}
                  <div class="wtile__attrs">
                    {[1, 2].map((j) => (
                      <button type="button" class="chip chip--attr weapon-bonus" data-wbonus={n} data-wbidx={j} aria-haspopup="dialog" disabled><span class="picktag__val">Attribute {j}</span></button>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <div class="pl-kitrow">
          <section class="pl-sec pl-sec--os" aria-labelledby="osTitle">
            <h2 class="pl-h" id="osTitle">OS Protocol</h2>
            <div class="ktile ktile--os">
              <button type="button" class="ktile__main" id="osSlot" aria-haspopup="dialog">
                <span class="ktile__icon"><img id="osImg" alt="" width="56" height="56" hidden /><img class="ktile__ph" src="/images/icons/icon-os.webp" alt="" width="28" height="28" /></span>
                <span class="ktile__txt"><span class="ktile__name" id="osName">Add an OS Protocol</span><span class="ktile__sub" id="osSub"></span></span>
              </button>
              <p class="ktile__desc" id="osDesc" hidden></p>
            </div>
          </section>

          <section class="pl-sec pl-sec--mods" aria-labelledby="modsTitle">
            <h2 class="pl-h" id="modsTitle">Skill Mods <span class="pl-count" id="skillCount">0 / 3</span></h2>
            <div class="pl-mods">
              {[0, 1, 2].map((i) => (
                <button type="button" class="ktile ktile--mod skill-slot" data-skill={i} aria-haspopup="dialog" disabled>
                  <span class="ktile__icon"><img alt="" width="48" height="48" hidden /><img class="ktile__ph" src="/images/icons/icon-skillmod.webp" alt="" width="24" height="24" /></span>
                  <span class="ktile__txt"><span class="ktile__kind skill-slot__skill">Skill {i + 1}</span><span class="ktile__name skill-slot__nm">Pick a specialization first</span><span class="ktile__sub skill-slot__sub"></span><span class="skill-slot__desc" hidden></span></span>
                </button>
              ))}
            </div>
          </section>
        </div>

        <section class="pl-sec" id="gearPanel" aria-labelledby="gearTitle">
          <h2 class="pl-h" id="gearTitle">Gear <span class="pl-count" id="gearPieces">0 / 6</span></h2>
          <div class="pl-gear">
            {GEAR.map(([slot, label, icon, talent]) => (
              <div class="gtile" data-gtile={slot}>
                <button type="button" class="gearslot" data-slot={slot} aria-haspopup="dialog">
                  <span class="gtile__top"><span class="gtile__slot">{label}</span><span class="gtile__count" data-count></span></span>
                  <span class="gtile__emblem"><img class="gtile__set" alt="" width="64" height="64" hidden /><img class="gtile__ph" src={`/images/icons/${icon}.webp`} alt="" width="30" height="30" /></span>
                  <span class="gearslot__val">Add a set</span>
                  <span class="gearslot__attrs"></span>
                </button>
                {talent && (
                  <button type="button" class="chip chip--talent gtile__talent" data-armortalent={slot} aria-haspopup="dialog"><img alt="" width="28" height="28" hidden /><span class="picktag__val">Talent</span><span class="picktag__desc" hidden></span></button>
                )}
                {talent && <p class="gtile__look" data-look={slot} hidden></p>}
              </div>
            ))}
          </div>
        </section>
      </div>

      <aside class="pl-intel" aria-label="Build summary">
        <section class="intel intel--score" id="checksPanel" aria-labelledby="checksTitle" tabindex="-1">
          <div class="ring" id="scoreRing">
            <svg viewBox="0 0 120 120" aria-hidden="true"><circle class="ring__track" cx="60" cy="60" r="52" /><circle class="ring__arc" id="ringArc" cx="60" cy="60" r="52" pathLength="100" /></svg>
            <span class="ring__num" id="rigScore">0</span>
          </div>
          <div class="intel__grade">
            <h2 class="pl-h" id="checksTitle">Build check</h2>
            <p class="rating__grade g-incomplete" id="ratingGrade">Not started</p>
            <p class="rating__score" id="ratingScore"></p>
          </div>
          <ul class="diag-list" id="diagList"><li class="diag diag--info"><span class="diag__txt">Pick a specialization to start.</span></li></ul>
        </section>

        <section class="intel" id="bonusPanel" aria-labelledby="bonusTitle">
          <h2 class="pl-h" id="bonusTitle">Set bonuses</h2>
          <div id="bonusList"><p class="empty">Two pieces of one set turn on its first bonus.</p></div>
        </section>

        <section class="intel" id="statsPanel" aria-labelledby="statsTitle">
          <h2 class="pl-h" id="statsTitle">Stats</h2>
          <p class="intel__hint">Set bonuses, OS stats, skill mod 2pc and your roll values. Talents aren't counted.</p>
          <div class="stat-list" id="statList"><p class="empty">Nothing to add up yet.</p></div>
        </section>
      </aside>
    </div>
  </div>

  <!-- List picker -->
  <div class="modal" id="modal" hidden>
    <div class="modal__panel" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal__hd">
        <h2 class="modal__title" id="modalTitle">Select</h2>
        <button type="button" class="modal__x" data-close aria-label="Close">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <div class="modal__search" id="modalSearchWrap">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg>
        <input type="search" id="modalSearch" enterkeyhint="search" aria-label="Search by name, stat or effect" placeholder="Search name, stat or effect" autocomplete="off" />
      </div>
      <div class="modal__list" id="modalList"></div>
    </div>
  </div>

  <!-- Gear piece and weapon attribute editor -->
  <div class="modal" id="editor" hidden>
    <div class="modal__panel modal__panel--editor" role="dialog" aria-modal="true" aria-labelledby="editorTitle">
      <div class="modal__hd">
        <h2 class="modal__title" id="editorTitle">Edit</h2>
        <button type="button" class="modal__x" data-close aria-label="Close">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <div class="editor" id="editorBody"></div>
      <div class="editor__ft">
        <button type="button" class="pl-btn" id="editorClear">Clear</button>
        <button type="button" class="pl-btn pl-btn--go" data-close>Done</button>
      </div>
    </div>
  </div>

  <!-- Saved builds -->
  <div class="modal" id="savesModal" hidden>
    <div class="modal__panel" role="dialog" aria-modal="true" aria-labelledby="savesTitle">
      <div class="modal__hd">
        <h2 class="modal__title" id="savesTitle">My builds</h2>
        <button type="button" class="modal__x" data-close aria-label="Close">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <div class="modal__list" id="savesList"></div>
      <p class="card-note">Saved in this browser only. Copy link to move a build to another device.</p>
    </div>
  </div>

  <!-- Build card -->
  <div class="modal" id="cardModal" hidden>
    <div class="modal__panel modal__panel--card" role="dialog" aria-modal="true" aria-labelledby="cardTitle">
      <div class="modal__hd">
        <h2 class="modal__title" id="cardTitle">Build card</h2>
        <button type="button" class="modal__x" data-close aria-label="Close">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <div class="card-preview" id="cardPreview"></div>
      <p class="card-note">Take a screenshot to share it as an image.</p>
    </div>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <!-- Slot machine payout: the spin's score, then spin again -->
  <div class="slot-win" id="slotWin" hidden>
    <div class="slot-win__panel">
      <div class="slot-win__num" aria-hidden="true"><span id="slotWinNum">0</span></div>
      <div class="slot-win__txt" role="status" aria-live="polite">
        <p class="slot-win__title" id="slotWinTitle"></p>
        <p class="slot-win__line" id="slotWinLine"></p>
      </div>
      <button type="button" class="slot-win__again" id="slotAgain">Spin again</button>
      <button type="button" class="slot-win__x" id="slotWinX" aria-label="Close">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>
  <div class="slot-fx" id="slotFx" aria-hidden="true"></div>

  <!-- Phones: the score and the link stay in reach while you edit -->
  <div class="mob-status" id="mobStatus">
    <button class="mob-status__score" id="mobStatusGo" type="button" aria-label="Go to the build check">
      <span class="mob-status__val" id="mobScore">0</span>
      <span class="mob-status__grade" id="mobGrade">Not started</span>
    </button>
    <button class="pl-btn pl-btn--go mob-status__share" id="mobShare" type="button">Copy link</button>
  </div>

  <script type="application/json" id="builder-data" set:html={dataPayload}></script>
  <script is:inline src="/js/builder-v3-engine.js?v=12"></script>
  <script is:inline>
    // If the engine didn't start (blocked or failed to load), say so instead of showing dead buttons
    if (!document.getElementById('lab').hasAttribute('data-ready')) document.getElementById('labError').hidden = false;
  </script>
</BaseLayout>
