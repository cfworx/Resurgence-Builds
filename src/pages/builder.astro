---
import BaseLayout from '../layouts/BaseLayout.astro';
import gearSets from '../data/gear-set-effects.json';
import weaponTalents from '../data/weapon-talents.json';
import exoticWeapons from '../data/exotic-weapons.json';
import standardWeapons from '../data/standard-weapons.json';
import bodyArmorTalents from '../data/body-armor-talents.json';
import backpackTalents from '../data/backpack-talents.json';
import osProtocols from '../data/os-protocols.json';
import skillModCombos from '../data/skill-mod-combos.json';
import bonusAttributes from '../data/bonus-attributes.json';
import weaponBonusAttributes from '../data/weapon-bonus-attributes.json';
import plannerSpecs from '../data/planner-specs.json';
import templateNotes from '../data/planner-template-notes.json';
import { getCollection } from 'astro:content';
import { CURRENT_PATCH } from '../data/site-config';

// Templates: every build guide with a plannerHash, grouped by specialization in the picker
const notes: Record<string, unknown> = templateNotes;
const allBuilds = await getCollection('builds');
const templates = allBuilds
  .filter(b => b.data.plannerHash)
  .map(b => ({
    id: b.id,
    name: b.data.title.trim(),
    spec: b.data.specialization,
    hash: b.data.plannerHash,
    note: notes[b.id] || null,
  }))
  .sort((a, b) => a.spec.localeCompare(b.spec) || a.name.localeCompare(b.name));

const title = 'Division Resurgence Build Planner';
const description = 'Plan a Division Resurgence loadout: gear sets and attributes, weapons and talents, OS Protocol and skill mods. See stat totals, set bonuses and build checks, then share the build as a link.';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Build Planner', url: '/builder/' }
];
const jsonLd = {
  '@type': 'WebApplication',
  '@id': 'https://resurgencebuilds.com/builder/#app',
  name: 'Division Resurgence Build Planner',
  url: 'https://resurgencebuilds.com/builder/',
  applicationCategory: 'GameApplication',
  operatingSystem: 'Any (browser)',
  browserRequirements: 'Requires JavaScript. Modern evergreen browser.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  about: { '@id': 'https://resurgencebuilds.com/#division-resurgence' },
  publisher: { '@id': 'https://resurgencebuilds.com/#organization' }
};

// Only what the engine reads goes into the payload (no images or wiki-style extras)
const omit = <T extends Record<string, unknown>>(list: T[], keys: string[]) =>
  list.map(item => Object.fromEntries(Object.entries(item).filter(([k]) => !keys.includes(k))));
const dataPayload = JSON.stringify({
  specs: plannerSpecs,
  gearSets,
  weaponTalents: omit(weaponTalents, ['verifiedInGame']),
  exoticWeapons: omit(exoticWeapons, ['image', 'acquisition', 'possibleTalents']),
  standardWeapons: omit(standardWeapons, ['image', 'randomizedAttributes', 'talent1', 'armoryTier', 'dmgType']),
  bodyArmorTalents: omit(bodyArmorTalents, ['verifiedInGame']),
  backpackTalents: omit(backpackTalents, ['verifiedInGame']),
  osProtocols: omit(osProtocols, ['image', 'imageAlt', 'cooldown', 'verifiedInGame']),
  skillModCombos: omit(skillModCombos, ['rarities', 'verifiedInGame']),
  bonusAttributes,
  weaponBonusAttributes,
  templates,
}).replace(/</g, '\\u003c');

const gearSetCount = gearSets.length;
const osCount = osProtocols.length;
const smcCount = skillModCombos.length;
const wtCount = weaponTalents.length;

const faqs = [
  { question: 'Where does the planner data come from?', answer: `From this site's database: ${gearSetCount} gear sets, ${wtCount} weapon talents, ${osCount} OS Protocols and ${smcCount} skill mod combos, kept current from Ubisoft's patch notes and drop tables. Templates come from our build guides, and numbers a creator read off their own screen are marked as theirs in the guide.` },
  { question: 'Are the stat totals exact?', answer: 'They add up set bonuses, OS Protocol stats, each skill mod combo\'s 2-piece bonus (shown as a range) and the roll values you type in. Rolls without a value are listed but not added, and talent effects are left out because they depend on conditions.' },
  { question: 'What does the score check?', answer: 'How complete the build is (40 points), whether each gear piece counts toward an active set bonus (30), whether your attributes fit your focus (20) and whether your OS Protocol matches it (10). Each warning takes 5 off. The Checks list shows what to look at.' },
  { question: 'How do I share a build?', answer: 'Click Copy build link. The link holds the whole build, including roll values and weapon tiers, and opens without an account.' },
];

const chevron = 'M6 9l6 6 6-6';
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
  faqs={faqs}
  noAds={true}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/builder-v3.css?v=7" />
  </Fragment>

  <section class="hero lab-hero">
    <div class="hero__scan" aria-hidden="true"></div>
    <div class="hero__inner">
      <h1 class="hero__title">Build <em>Planner</em></h1>
      <p class="hero__sub">Plan a Division Resurgence loadout and share it as a link.</p>
      <p class="hero__meta"><span class="chip">Data: {CURRENT_PATCH}</span></p>
    </div>
  </section>

  <div class="lab" id="lab">
    <noscript><p class="lab-msg">The planner needs JavaScript. Every loadout is also written out in full in the <a href="/builds/">build guides</a>.</p></noscript>
    <p class="lab-msg" id="labError" hidden>The planner didn't load. Reload the page to try again.</p>

    <div class="panel panel--bar">
      <span class="kicker bar__label" id="tplTitle">Template</span>
      <div class="bar__select">
        <button type="button" class="picker__btn" id="tplBtn" aria-haspopup="dialog" aria-labelledby="tplTitle tplLabel">
          <span id="tplLabel">Load a build guide</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d={chevron}/></svg>
        </button>
      </div>
      <button type="button" class="btn-ghost" id="resetBtn">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 109-9 9 9 0 00-6.4 2.6L3 8M3 4v4h4"/></svg>
        Reset
      </button>
    </div>
    <p class="lab-note" id="labNote" role="status" hidden></p>

    <div class="panel panel--bar panel--name">
      <label class="kicker bar__label" for="buildNameInput">Build name</label>
      <div class="build-name">
        <input type="text" class="build-name__input" id="buildNameInput" placeholder="Untitled build" maxlength="60" autocomplete="off" spellcheck="false" />
      </div>
    </div>

    <div class="lab__grid">

      <div class="col col--left">
        <section class="panel" id="specPanel" aria-labelledby="specTitle">
          <div class="panel__hd"><h2 class="kicker" id="specTitle">Specialization</h2></div>
          <div class="panel__bd">
            <div class="spec-grid" role="group" aria-labelledby="specTitle">
              {plannerSpecs.specs.map((sp, i) => (
                <button type="button" class={`spec-btn${i === plannerSpecs.specs.length - 1 ? ' spec-btn--full' : ''}`} data-spec={sp.name} aria-pressed="false">
                  <img src={sp.icon} alt="" class="sigil" width="32" height="32" />
                  <span class="nm">{sp.name}</span>
                </button>
              ))}
            </div>
            <div class="field">
              <span class="field__lbl" id="focusTitle">Focus</span>
              <button type="button" class="picker__btn picker__btn--sm" id="subBtn" aria-haspopup="dialog" aria-labelledby="focusTitle subLabel" disabled>
                <span id="subLabel">Pick a specialization</span>
                <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d={chevron}/></svg>
              </button>
            </div>
          </div>
        </section>

        <section class="panel" id="osPanel" aria-labelledby="osTitle">
          <div class="panel__hd"><h2 class="kicker" id="osTitle">OS Protocol</h2></div>
          <div class="panel__bd">
            <button type="button" class="slot slot--lg" id="osSlot" aria-haspopup="dialog">
              <span class="slot__icon"><img src="/images/icons/icon-os.webp" alt="" width="22" height="22" /></span>
              <span class="slot__body"><span class="slot__name" id="osName">Select OS Protocol</span><span class="slot__sub" id="osSub">Not set</span></span>
            </button>
            <p class="slot__desc" id="osDesc" hidden></p>
          </div>
        </section>

        <section class="panel" id="talentPanel" aria-labelledby="talentTitle">
          <div class="panel__hd"><h2 class="kicker" id="talentTitle">Armor talents</h2></div>
          <div class="panel__bd">
            <button type="button" class="picktag picktag--wide" data-armortalent="body" aria-haspopup="dialog"><span class="picktag__lbl">Body armor</span><span class="picktag__val">Not set</span><span class="picktag__desc" hidden></span></button>
            <button type="button" class="picktag picktag--wide" data-armortalent="backpack" aria-haspopup="dialog"><span class="picktag__lbl">Backpack</span><span class="picktag__val">Not set</span><span class="picktag__desc" hidden></span></button>
          </div>
        </section>

        <section class="panel" id="skillPanel" aria-labelledby="skillTitle">
          <div class="panel__hd"><h2 class="kicker" id="skillTitle">Skill mods</h2><span class="tag" id="skillCount">0 / 3</span></div>
          <div class="panel__bd skill-list">
            {[0, 1, 2].map(i => (
              <button type="button" class="skill-slot" data-skill={i} aria-haspopup="dialog" disabled>
                <span class="skill-slot__n" aria-hidden="true">{i + 1}</span>
                <span class="skill-slot__txt"><span class="skill-slot__skill"></span><span class="skill-slot__nm">Pick a specialization first</span><span class="skill-slot__sub"></span><span class="skill-slot__desc"></span></span>
              </button>
            ))}
          </div>
        </section>
      </div>

      <div class="col col--center">
        <section class="panel panel--loadout" id="gearPanel" aria-labelledby="gearTitle">
          <div class="panel__hd"><h2 class="kicker" id="gearTitle">Gear</h2><span class="tag" id="gearPieces">0 / 6</span></div>
          <div class="panel__bd">
            <div class="rig">
              <svg class="rig__trace" viewBox="0 0 600 360" preserveAspectRatio="none" aria-hidden="true">
                <path d="M150 70 L300 40 L450 70 M150 180 L300 180 L450 180 M150 290 L300 320 L450 290" />
              </svg>
              <div class="rig__col rig__col--l">
                {[['mask', 'Mask', 'icon-mask'], ['gloves', 'Gloves', 'icon-gloves'], ['holster', 'Holster', 'icon-holster']].map(([slot, label, icon]) => (
                  <button type="button" class="gearslot" data-slot={slot} aria-haspopup="dialog">
                    <span class="gearslot__ico"><img src={`/images/icons/${icon}.webp`} alt="" width="24" height="24" /></span>
                    <span class="gearslot__txt"><span class="gearslot__lbl">{label}</span><span class="gearslot__val">Empty</span><span class="gearslot__attrs"></span></span>
                  </button>
                ))}
              </div>
              <div class="rig__core" aria-hidden="true">
                <div class="rig__silhouette">
                  <span class="rig__score-lbl">Score</span>
                  <span class="rig__score" id="rigScore">0</span>
                  <img src="/images/resurgence-builds-official-logo.webp" alt="" class="rig__logo" width="120" height="120" />
                </div>
              </div>
              <div class="rig__col rig__col--r">
                {[['body', 'Body armor', 'icon-shield'], ['backpack', 'Backpack', 'icon-backpack'], ['kneepads', 'Kneepads', 'icon-kneepads']].map(([slot, label, icon]) => (
                  <button type="button" class="gearslot" data-slot={slot} aria-haspopup="dialog">
                    <span class="gearslot__ico"><img src={`/images/icons/${icon}.webp`} alt="" width="24" height="24" /></span>
                    <span class="gearslot__txt"><span class="gearslot__lbl">{label}</span><span class="gearslot__val">Empty</span><span class="gearslot__attrs"></span></span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        </section>

        <div class="weapon-row">
          {[1, 2].map(n => (
            <section class="panel" data-weapon={n} aria-labelledby={`w${n}title`}>
              <div class="panel__hd">
                <h2 class="kicker" id={`w${n}title`}>{n === 1 ? 'Primary weapon' : 'Secondary weapon'}</h2>
              </div>
              <div class="panel__bd">
                <button type="button" class="slot" id={`w${n}btn`} data-wslot={n} aria-haspopup="dialog">
                  <span class="slot__icon"><img src="/images/icons/icon-weapon.webp" alt="" width="20" height="20" /></span>
                  <span class="slot__body"><span class="slot__name" id={`w${n}name`}>Select weapon</span><span class="slot__sub" id={`w${n}sub`}>Not set</span></span>
                </button>
                <label class="tier"><span class="tier__lbl">Tier</span>
                  <select class="tier__sel" id={`w${n}tier`} aria-label={n === 1 ? 'Primary weapon tier' : 'Secondary weapon tier'} disabled>
                    <option value="">None</option>
                    <option value="T0">T0</option>
                    <option value="T1">T1</option>
                    <option value="T2">T2</option>
                  </select>
                </label>
                <div class="picktag is-fixed" id={`w${n}fixed`} hidden><span class="picktag__lbl">Exotic talent</span><span class="picktag__val"></span><span class="picktag__desc"></span></div>
                <div class="talent-pair">
                  {[1, 2].map(j => (
                    <button type="button" class="picktag" data-talent={`w${n}t${j}`} aria-haspopup="dialog" disabled><span class="picktag__lbl">Talent {j}</span><span class="picktag__val">Pick a weapon first</span><span class="picktag__desc" hidden></span></button>
                  ))}
                </div>
                <div class="weapon-bonuses">
                  {[1, 2].map(j => (
                    <button type="button" class="weapon-bonus" data-wbonus={n} data-wbidx={j} aria-haspopup="dialog" disabled><span class="picktag__lbl">Attribute {j}</span><span class="picktag__val">Pick a weapon first</span></button>
                  ))}
                </div>
              </div>
            </section>
          ))}
        </div>
      </div>

      <aside class="col col--right" aria-label="Build summary">
        <div class="share-row">
          <button type="button" class="btn-primary" id="shareBtn">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8h16v-8M12 3v13M7 8l5-5 5 5"/></svg>
            Copy build link
          </button>
          <button type="button" class="btn-ghost btn-ghost--card" id="cardBtn" aria-haspopup="dialog">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M3 9h18"/></svg>
            Build card
          </button>
        </div>
        <div class="share-link" id="shareLink" hidden>
          <label class="share-link__lbl" for="shareLinkField">Copy this link</label>
          <input type="text" class="share-link__field" id="shareLinkField" readonly />
        </div>

        <section class="panel panel--isac" id="checksPanel" aria-labelledby="checksTitle" tabindex="-1">
          <div class="panel__hd"><h2 class="kicker" id="checksTitle">Checks</h2></div>
          <div class="panel__bd">
            <div class="rating">
              <span class="rating__line"><span class="rating__grade g-incomplete" id="ratingGrade">Not started</span><span class="rating__score" id="ratingScore"></span></span>
              <div class="rating__meter" aria-hidden="true"><i id="ratingMeter"></i></div>
            </div>
            <ul class="diag-list" id="diagList"><li class="diag diag--info"><span class="diag__txt">Pick a specialization to start.</span></li></ul>
          </div>
        </section>

        <section class="panel" id="statsPanel" aria-labelledby="statsTitle">
          <div class="panel__hd"><h2 class="kicker" id="statsTitle">Stats</h2></div>
          <div class="panel__bd">
            <p class="panel__hint">Set bonuses, OS stats, skill mod 2pc and the roll values you enter. Talents aren't counted.</p>
            <div class="stat-list" id="statList"><p class="empty">Nothing to add up yet.</p></div>
          </div>
        </section>

        <section class="panel" id="bonusPanel" aria-labelledby="bonusTitle">
          <div class="panel__hd"><h2 class="kicker" id="bonusTitle">Set bonuses</h2></div>
          <div class="panel__bd" id="bonusList"><p class="empty">Equip 2 pieces of a set to activate it.</p></div>
        </section>
      </aside>

    </div>
  </div>

  <!-- List picker -->
  <div class="modal" id="modal" hidden>
    <div class="modal__panel" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal__hd">
        <h2 class="kicker" id="modalTitle">Select</h2>
        <button type="button" class="modal__x" data-close aria-label="Close">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <div class="modal__search" id="modalSearchWrap">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg>
        <input type="search" id="modalSearch" enterkeyhint="search" aria-label="Search by name, stat or effect" placeholder="Search name, stat or effect" autocomplete="off" />
      </div>
      <div class="modal__list" id="modalList"></div>
    </div>
  </div>

  <!-- Gear piece and weapon attribute editor -->
  <div class="modal" id="editor" hidden>
    <div class="modal__panel modal__panel--editor" role="dialog" aria-modal="true" aria-labelledby="editorTitle">
      <div class="modal__hd">
        <h2 class="kicker" id="editorTitle">Edit</h2>
        <button type="button" class="modal__x" data-close aria-label="Close">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <div class="editor" id="editorBody"></div>
      <div class="editor__ft">
        <button type="button" class="btn-ghost" id="editorClear">Clear</button>
        <button type="button" class="btn-primary" data-close>Done</button>
      </div>
    </div>
  </div>

  <!-- Build card -->
  <div class="modal" id="cardModal" hidden>
    <div class="modal__panel modal__panel--card" role="dialog" aria-modal="true" aria-labelledby="cardTitle">
      <div class="modal__hd">
        <h2 class="kicker" id="cardTitle">Build card</h2>
        <button type="button" class="modal__x" data-close aria-label="Close">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <div class="card-preview" id="cardPreview"></div>
      <p class="card-note">Take a screenshot to share it as an image.</p>
    </div>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <!-- Phones: score and grade stay in view while you edit -->
  <div class="mob-status" id="mobStatus">
    <div class="mob-status__grp"><span class="mob-status__lbl">Score</span><span class="mob-status__val" id="mobScore">0</span></div>
    <div class="mob-status__grp"><span class="mob-status__lbl">Build</span><span class="mob-status__val" id="mobGrade">Not started</span></div>
    <button class="mob-status__go" id="mobStatusGo" type="button">Checks</button>
  </div>

  <section class="lab-about">
    <h2>How the planner works</h2>
    <p>Pick a specialization and focus, then click any slot to fill it: gear sets and attributes, weapons and talents, armor talents, OS Protocol and skill mods. Templates load the loadouts from our <a href="/builds/">build guides</a>, and every option comes from our <a href="/database/">database</a>.</p>
    <p>Stats add up set bonuses, OS Protocol stats, skill mod 2-piece bonuses and the roll values you enter. Checks flag sets with no active bonus, pieces past a set's last bonus, attributes that don't fit your focus and missing slots.</p>

    <h2>Frequently asked questions</h2>
    <div class="lab-about__faqs">
      {faqs.map(faq => (
        <details class="lab-about__faq">
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <script type="application/json" id="builder-data" set:html={dataPayload}></script>
  <script is:inline src="/js/builder-v3-engine.js?v=7"></script>
  <script is:inline>
    // If the engine didn't start (blocked or failed to load), say so instead of showing dead buttons
    if (!document.getElementById('lab').hasAttribute('data-ready')) document.getElementById('labError').hidden = false;
  </script>
</BaseLayout>

<style is:global>
  /* Page background for the planner */
  body:has(.lab) {
    background-color: #05070b !important;
    background-image:
      radial-gradient(1200px 600px at 80% -10%, rgba(255,138,46,.08), transparent 60%),
      radial-gradient(900px 500px at -10% 20%, rgba(82,168,255,.05), transparent 55%),
      linear-gradient(rgba(82,168,255,.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(82,168,255,.04) 1px, transparent 1px) !important;
    background-size: auto, auto, 44px 44px, 44px 44px !important;
    background-attachment: fixed !important;
  }
  /* Scanline grain */
  body:has(.lab)::after {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: .5;
    background: repeating-linear-gradient(0deg, rgba(255,255,255,.012) 0 1px, transparent 1px 3px);
  }
  /* The planner uses the full width, not the page container */
  body:has(.lab) #main-content {
    padding: 0 !important;
    max-width: none !important;
  }
  body:has(.lab) #main-content > .container {
    max-width: none !important;
    padding: 0 !important;
  }
  .sigil {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }
  .spec-btn.is-active .sigil {
    filter: drop-shadow(0 0 6px rgba(255,138,46,.7)) drop-shadow(0 0 12px rgba(255,138,46,.3));
  }
  /* How it works + FAQ below the tool */
  .lab-about {
    position: relative;
    z-index: 2;
    max-width: 860px;
    margin: 0 auto;
    padding: 48px 16px 64px;
    color: #c8c8d0;
    line-height: 1.75;
  }
  .lab-about h2 {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 800;
    color: #fff;
    margin: 0 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255,138,46,.25);
  }
  .lab-about h2:not(:first-child) { margin-top: 40px; }
  .lab-about p { margin: 0 0 12px; }
  .lab-about a { color: var(--accent, #ff8a2e); }
  .lab-about__faq {
    border: 1px solid rgba(255,255,255,.1);
    background: rgba(0,0,0,.3);
    margin-bottom: 8px;
  }
  /* the whole question row is the tap target (at least 44px), not just its line of text */
  .lab-about__faq summary { cursor: pointer; color: #fff; font-weight: 600; padding: 10px 16px; min-height: 44px; }
  .lab-about__faq summary:focus-visible { outline-offset: -3px; }
  .lab-about__faq p { margin: 0 16px 12px; }
</style>
