---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionTag from '../../components/SectionTag.astro';
import AdSenseUnit from '../../components/AdSenseUnit.astro';
import TierBoard from '../../components/TierBoard.astro';
import osProtocols from '../../data/os-protocols.json';
import { dbImage } from '../../utils/db-images';
import { TIERS, compareItems, snapshotItems, snapshotUpdated, snapshotVotes, voteCount } from '../../utils/votes';
import '../../styles/tier-votes.css';

// Ranked by player votes since October 31, 2026 (Cory's call): every protocol can be ranked S to D right on this page
// (its Rank button) or on its database page, and this page sorts them by their average. See VOTES.md.
const slugify = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const SPEC_COLOR: Record<string, string> = { Engineering: '#F5CC45', Firepower: '#F26822', Toughness: '#3a7bd5' };
const RARITY_ORDER = ['High-End', 'Superior', 'Specialized', 'Standard'];
const items = [...osProtocols]
  .sort((a: any, b: any) => (RARITY_ORDER.indexOf(a.rarity) - RARITY_ORDER.indexOf(b.rarity)) || a.name.localeCompare(b.name))
  .map((p: any) => {
    const slug = slugify(p.name);
    return {
      id: slug,
      name: p.name,
      href: `/database/os-protocols/${slug}/`,
      sub: `${p.specialization} · ${p.rarity}`,
      image: dbImage(`os-protocols/${slug}`, 'icon')?.srcset[0][1],
      dot: SPEC_COLOR[p.specialization],
      group: p.specialization,
    };
  });

const snap = snapshotItems('os');
const totalVotes = snapshotVotes('os');
const rankedCount = items.filter((i) => snap[i.id]).length;
const ordered = [
  ...items.filter((i) => snap[i.id]).sort((x, y) =>
    (TIERS.indexOf(snap[x.id].tier!) - TIERS.indexOf(snap[y.id].tier!)) || compareItems({ ...snap[x.id], name: x.name }, { ...snap[y.id], name: y.name })),
  ...items.filter((i) => !snap[i.id]),
];
const typeCount = (t: string) => items.filter((i) => i.group === t).length;

const breadcrumbItems = [{ name: 'Tier Lists', url: '/tier-list/' }, { name: 'OS Protocol Tier List', url: '/tier-list/os-protocols/' }];
const title = 'OS Protocol Tier List: S to D Rankings';
const description = 'All 66 Division Resurgence OS Protocols ranked S to D by players. Tap Rank on any protocol, watch the list re-sort live, and see what the creators run per class.';
const RANKED_BY_PLAYERS = '2026-10-31T12:00:00.000Z';
const lastVote = snapshotUpdated('os');
const modified = lastVote && lastVote > RANKED_BY_PLAYERS ? lastVote : RANKED_BY_PLAYERS;
const siteUrl = 'https://resurgencebuilds.com';

const itemListLd = {
  '@type': 'ItemList',
  name: 'Division Resurgence OS Protocol Tier List, ranked by player votes',
  description,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  numberOfItems: ordered.length,
  itemListElement: ordered.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name, url: `${siteUrl}${p.href}` })),
};

const faqs = [
  { question: "Who ranks these OS Protocols?", answer: "Players do. Tap Rank on any protocol here, or use the vote on its database page. S is worth 5 points down to 1 for D, a protocol's average sets its tier, and one vote is enough to place it. It's one vote per reader per protocol, and you can change it anytime." },
  { question: "What is the best OS Protocol in Division Resurgence?", answer: "For the players' answer, check the S row above, which updates live. Going by creator results in Season 2 Phase 2, the two to know are Brains Over Brawn, on GGReborn's Season 2 Tactical Pharma build, and Cover Shooter, which TikTokAndy ran when he soloed Precious Cargo on Legendary with his Double Barrel Commando on October 6. In GGReborn's October 23 Lone Wolf test, Chain Reaction, Collateral Damage and Tactical Persistence finished within five seconds of Brains Over Brawn, so on that build the choice matters less than your stats." },
  { question: "How do OS Protocols work in Division Resurgence?", answer: "OS Protocols are unique gear-talent items that slot into your Operating System loadout. Each provides a main stat, three sub-stats, and a unique Talent that triggers under specific combat conditions. Died Again Gaming points out that any agent level can equip any rarity; higher rarities roll bigger stats and better talents." },
  { question: "How do you get and upgrade OS Protocols?", answer: "For golds, Died Again Gaming names two routes: the OS Protocol Sealed Cache (2% for Tier S, guaranteed within 50, per Ubisoft's published odds) and the fourth Weekly Bounty boss, whose Key Rewards he says now guarantee a random gold every week. For purples, his June farm was re-running that fourth boss after the weekly clear, since every kill had a chance at one. To upgrade, you level a protocol with Algorithm Data from bounties and world activities, and feed duplicates of the same protocol into its Talent Upgrade. Gold duplicates are rare, so a purple you can actually max is often the better bet, and he still runs a purple over a gold." },
  { question: "What is the best OS Protocol for Vanguard?", answer: "For a Commando damage build, Cover Shooter (Firepower, High-End). TikTokAndy switched his Double Barrel build to it in early October and calls it second to none for PvE with that gun; before that he ran Augmented Lethality, and his October 27 Lightweight M4 build tries Explosive Round. For team support, we'd look at Strategic Assistance: its assist-based Signature Ability Charge Efficiency and Skill Cooldown reduction feed Tactical Link and Scanning Pulse uptime." },
  { question: "What is the best OS Protocol for Field Medic?", answer: "For Tactical Pharma, Brains Over Brawn (Engineering, Specialized), which GGReborn runs on his Season 2 build. His October 23 Lone Wolf test had Chain Reaction, Collateral Damage and Tactical Persistence within five seconds of it, so use whichever of those you own. For Combat Medicine, Nadie's tank medic runs Pummeling Shield, and Medical Excellence is the pure-healer option." },
  { question: "What is the best OS Protocol for Bulwark?", answer: "Pummeling Shield (Toughness, High-End). The Stun proc on every 10 hits and the Extra Health regen on damage still define the class, and Nadie runs it on both of his creator builds here. Since the June 26, 2026 hotfix the stun lasts 1.5 seconds (was 2) and has a 10-second cooldown, so it's a periodic interrupt, not a stun-lock." },
  { question: "What is the best OS Protocol for Demolitionist?", answer: "For HE Munitions, we'd start with Surgical Engineering (Engineering, High-End): its 60% chance of +16% Skill Critical Damage on Skill Crits scales with the class's natural skill crit chance. We haven't found a Season 2 creator result for Demolitionist yet; PVE Enjoyer's pre-Season 2 Glass Cannon build runs Pressing Matter. Field Grenadier is the Demolitionist's Firepower focus, so it would look at Firepower protocols instead; we haven't seen a creator build for it." },
  { question: "What is the best OS Protocol for Tech Operator?", answer: "For an Aegis healer, Recursive Treatment, which TikTokAndy runs on his October Aegis Team Healer build. For skill damage, Brains Over Brawn is the pick on LtFoe's and Tampishach's Tech Op builds (both from before Season 2), and Tactical Layering (+15% Engineering per skill deployment, up to 3 stacks) suits Striker Drone rotations." },
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbItems} faqs={faqs} jsonLd={itemListLd}
  article={{ publishDate: '2026-05-29T12:00:00.000Z', modifiedDate: new Date(modified).toISOString(), author: 'RapidF5', tags: ['tier list', 'OS Protocols', 'Division Resurgence'] }}
>
  <div class="container section">
    <Breadcrumbs items={breadcrumbItems} />
    <SectionTag label="Ranked by Players" />
    <h1 class="heading-accent">OS Protocol Tier List</h1>
    <p class="tl-lede">All 66 protocols, ranked live by players. Tap <strong>Rank</strong> on any of them. No pressure, but they're all counting on you.</p>

    <p class="tlive tl-live" data-tv-live data-kind="os">
      <span class="tlive__on"><span class="tlive__dot" aria-hidden="true"></span><span data-tv-state>Live</span></span>
      <span data-tv-total>{voteCount(totalVotes)}</span>
      <span aria-hidden="true">·</span>
      <span data-tv-ranked>{rankedCount} of {items.length} ranked</span>
      <span aria-hidden="true">·</span>
      <span data-tv-ago>loading the latest</span>
    </p>

    <ol class="thow">
      <li><b>1</b><span>Find a protocol</span></li>
      <li><b>2</b><span>Tap Rank <span class="tier-chips" aria-hidden="true">{TIERS.map((t) => <span class={`tier-chip tier-chip--${t.toLowerCase()}`}>{t}</span>)}</span></span></li>
      <li><b>3</b><span>The average sets its tier</span></li>
    </ol>

    <div class="tfilters" data-tv-filters data-for="os" role="group" aria-label="Show one type of OS Protocol">
      <button type="button" class="tfilter" data-tv-filter data-value="all" aria-pressed="true">All {items.length}</button>
      {['Engineering', 'Firepower', 'Toughness'].map((t) => (
        <button type="button" class="tfilter" data-tv-filter data-value={t} aria-pressed="false"><span class="tfilter__dot" style={`--dot:${SPEC_COLOR[t]}`} aria-hidden="true"></span>{t} <span class="tfilter__n">{typeCount(t)}</span></button>
      ))}
    </div>

    <TierBoard kind="os" items={items} quick icons label="OS Protocols" />

    <details class="tl-fine">
      <summary>How the ranking works</summary>
      <ul>
        <li>Each vote is worth points: S 5, A 4, B 3, C 2, D 1. A protocol's average decides its tier: 4.5 and up is S, 3.5 A, 2.5 B, 1.5 C, anything lower D.</li>
        <li>Inside a tier, the higher average goes first. Ties go to the protocol with more votes.</li>
        <li>One vote per reader per protocol, changeable anytime, no account needed. Each protocol's database page has the same vote.</li>
      </ul>
    </details>

    <section class="tl-picks" aria-labelledby="tl-picks-h">
      <h2 id="tl-picks-h">What the creators run</h2>
      <p>Season 2 creator picks per class. Demolitionist has no Season 2 creator result yet, so it shows our pick. <a href="/guides/best-os-protocol/">The full per-class guide</a> has a backup for each.</p>
      <div class="tl-picks__grid">
        <a class="tl-pick" href="/database/os-protocols/cover-shooter/"><span>Vanguard (Commando)</span>Cover Shooter</a>
        <a class="tl-pick" href="/database/os-protocols/brains-over-brawn/"><span>Field Medic (Tactical Pharma)</span>Brains Over Brawn</a>
        <a class="tl-pick" href="/database/os-protocols/pummeling-shield/"><span>Bulwark</span>Pummeling Shield</a>
        <a class="tl-pick" href="/database/os-protocols/surgical-engineering/"><span>Demolitionist</span>Surgical Engineering</a>
        <a class="tl-pick" href="/database/os-protocols/recursive-treatment/"><span>Tech Operator (Aegis healer)</span>Recursive Treatment</a>
      </div>
    </section>

    <AdSenseUnit label="Advertisement (OS tier list)" />

    <section class="faq-section tl-faq" aria-labelledby="tl-faq">
      <h2 id="tl-faq">Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.question}</summary>
            <p class="faq-answer">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="tl-related">Full stats and talents are in the <a href="/database/os-protocols/">OS Protocols database</a>. Builds get the same treatment on the <a href="/tier-list/">build tier list</a>.</p>
  </div>
</BaseLayout>

<style>
  .tl-lede { margin: 0 0 var(--sp-3); font-size: var(--step-1); line-height: var(--lh-snug); color: var(--ink); max-width: var(--measure); }
  .tl-live { margin: 0 0 var(--sp-2); }
  .tfilter__n { margin-left: 4px; font-family: var(--font-mono); font-size: var(--step--2); opacity: 0.75; }
  .tl-fine {
    margin: var(--sp-5) 0 var(--sp-8);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.15);
  }
  .tl-fine > summary {
    display: flex;
    align-items: center;
    min-height: var(--control);
    padding: 0 var(--inset);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    cursor: pointer;
  }
  .tl-fine > summary:hover { color: var(--accent); }
  .tl-fine ul { margin: 0; padding: 0 var(--inset) var(--sp-4) calc(var(--inset) * 2); color: var(--ink); font-size: var(--step--1); line-height: var(--lh-small); }
  .tl-fine li { margin: 0 0 var(--sp-2); }
  .tl-picks { margin: 0 0 var(--sp-8); }
  .tl-picks h2 { font-size: var(--step-3); margin: 0 0 var(--sp-2); }
  .tl-picks p { margin: 0 0 var(--sp-4); color: var(--ink-muted); font-size: var(--step--1); }
  .tl-picks p a { color: var(--accent); }
  .tl-picks__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr)); gap: var(--sp-2); }
  .tl-pick {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--sp-3) calc(var(--inset) - 1px);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.2);
    color: var(--accent);
    font-weight: 700;
    font-size: var(--step--1);
    text-decoration: none;
  }
  .tl-pick:hover { border-color: var(--accent); }
  .tl-pick span {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .tl-faq { margin-top: var(--sp-8); }
  .tl-faq h2 { font-size: var(--step-3); margin: 0 0 var(--sp-4); }
  .tl-faq .faq-list { display: flex; flex-direction: column; gap: var(--sp-2); }
  .tl-related { margin: var(--sp-8) 0 0; color: var(--ink-muted); font-size: var(--step--1); }
  .tl-related a { color: var(--accent); }
</style>
