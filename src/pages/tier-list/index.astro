---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionTag from '../../components/SectionTag.astro';
import AdSenseUnit from '../../components/AdSenseUnit.astro';
import TierBoard from '../../components/TierBoard.astro';
import { getCollection } from 'astro:content';
import { postImage } from '../../utils/post-images';
import { TIERS, compareItems, snapshotItems, snapshotUpdated, snapshotVotes, voteCount } from '../../utils/votes';
import '../../styles/tier-votes.css';

// Ranked by player votes since October 31, 2026 (Cory's call): every build page ends with an S to D vote, and this
// page sorts the builds by their average. See VOTES.md. The page is drawn from the votes as of the last deploy and
// goes live in the browser.
const allBuilds = (await getCollection('builds')).sort((a, b) => b.data.lastUpdated.getTime() - a.data.lastUpdated.getTime());
const shortName = (title: string) => title.split(/: | \| | - /)[0];
const items = allBuilds.map((b) => ({
  id: b.id,
  name: shortName(b.data.title),
  href: `/builds/${b.id}/`,
  sub: `${b.data.specialization}${b.data.subclass ? ` · ${b.data.subclass}` : ''}`,
  image: postImage(b.data.featuredImage)?.small ?? b.data.featuredImage ?? '/images/default-cover.webp',
}));

const snap = snapshotItems('build');
const totalVotes = snapshotVotes('build');
const rankedCount = items.filter((i) => snap[i.id]).length;
// Ranked builds by tier and average, then the unranked ones newest first: the order the board shows.
const ordered = [
  ...items.filter((i) => snap[i.id]).sort((x, y) =>
    (TIERS.indexOf(snap[x.id].tier!) - TIERS.indexOf(snap[y.id].tier!)) || compareItems({ ...snap[x.id], name: x.name }, { ...snap[y.id], name: y.name })),
  ...items.filter((i) => !snap[i.id]),
];

const breadcrumbItems = [{ name: 'Tier List', url: '/tier-list/' }];
const title = 'Best Builds & Tier List - Division Resurgence';
const description = 'Every Division Resurgence build ranked S to D by players. Open a build, give it your rank, and watch this tier list re-sort live.';
const TIER_PUBLISHED = '2026-05-29';
const RANKED_BY_PLAYERS = '2026-10-31T12:00:00.000Z';
const lastVote = snapshotUpdated('build');
const modified = lastVote && lastVote > RANKED_BY_PLAYERS ? lastVote : RANKED_BY_PLAYERS;
const siteUrl = 'https://resurgencebuilds.com';

const itemListLd = {
  '@type': 'ItemList',
  name: 'Division Resurgence Build Tier List, ranked by player votes',
  description,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  numberOfItems: ordered.length,
  itemListElement: ordered.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    url: `${siteUrl}${b.href}`,
  })),
};

const faqs = [
  {
    question: 'How does the build tier list work?',
    answer: 'Players rank it. Every build guide ends with an S to D vote. Each vote is worth points (S 5, A 4, B 3, C 2, D 1), and a build\'s average sets its tier, so even one vote places it. The list re-sorts live as votes come in.',
  },
  {
    question: 'Can I change my vote?',
    answer: 'Yes. Open the build and pick another tier: the new pick replaces your old one. It\'s one vote per build, and you don\'t need an account.',
  },
  {
    question: 'Why is a build unranked?',
    answer: 'Nobody has voted on it yet. Open it, scroll to the end and rank it: the first vote sets its tier.',
  },
  {
    question: 'How do you stop people from spamming votes?',
    answer: 'One vote per reader per build. A cookie remembers your vote, voting again from the same network and browser (say, in a private window) replaces your vote instead of adding one, and only a few readers on one network count on the same build. We never store IP addresses, only a scrambled code made from them.',
  },
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbItems} ogImage="/images/site/division-resurgence-build-tier-list-firefight-1200.webp" faqs={faqs} jsonLd={itemListLd}
  article={{
    publishDate: new Date(TIER_PUBLISHED + 'T12:00:00Z').toISOString(),
    modifiedDate: new Date(modified).toISOString(),
    author: 'RapidF5',
    tags: ['tier list', 'best builds', 'meta', 'Division Resurgence'],
  }}
>
  <div class="container section">
    <Breadcrumbs items={breadcrumbItems} />
    <SectionTag label="Ranked by Players" />
    <h1 class="heading-accent">Division Resurgence Build Tier List</h1>
    <p class="tl-lede">You rank them. We count. Every build starts unranked, and the list moves live as votes come in.</p>

    <p class="tlive tl-live" data-tv-live data-kind="build">
      <span class="tlive__on"><span class="tlive__dot" aria-hidden="true"></span><span data-tv-state>Live</span></span>
      <span data-tv-total>{voteCount(totalVotes)}</span>
      <span aria-hidden="true">·</span>
      <span data-tv-ranked>{rankedCount} of {items.length} ranked</span>
      <span aria-hidden="true">·</span>
      <span data-tv-ago>loading the latest</span>
    </p>

    <ol class="thow">
      <li><b>1</b><span>Open a build</span></li>
      <li><b>2</b><span>Rank it at the end <span class="tier-chips" aria-hidden="true">{TIERS.map((t) => <span class={`tier-chip tier-chip--${t.toLowerCase()}`}>{t}</span>)}</span></span></li>
      <li><b>3</b><span>The average sets its tier</span></li>
    </ol>

    <TierBoard kind="build" items={items} label="builds" />

    <details class="tl-fine">
      <summary>How the ranking works</summary>
      <ul>
        <li>Each vote is worth points: S 5, A 4, B 3, C 2, D 1. A build's average decides its tier: 4.5 and up is S, 3.5 A, 2.5 B, 1.5 C, anything lower D.</li>
        <li>Inside a tier, the higher average goes first. Ties go to the build with more votes.</li>
        <li>One vote per reader per build, changeable anytime, no account needed.</li>
        <li>The builds are creators' setups and our own designs. The tiers are the players' call, not ours.</li>
      </ul>
    </details>

    <AdSenseUnit label="Advertisement (tier list 1)" />

    <section class="faq-section tl-faq" aria-labelledby="tl-faq">
      <h2 id="tl-faq">Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.question}</summary>
            <p class="faq-answer">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="tl-related">Next up: the <a href="/tier-list/os-protocols/">OS Protocol tier list</a>, also ranked by players, and the <a href="/builder/">Build Planner</a> to put your own build together.</p>

    <AdSenseUnit label="Advertisement (tier list 2)" />
  </div>
</BaseLayout>

<style>
  .tl-lede { margin: 0 0 var(--sp-3); font-size: var(--step-1); line-height: var(--lh-snug); color: var(--ink); max-width: var(--measure); }
  .tl-live { margin: 0 0 var(--sp-2); }
  .tl-fine {
    margin: var(--sp-5) 0 var(--sp-8);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.15);
  }
  .tl-fine > summary {
    display: flex;
    align-items: center;
    min-height: var(--control);
    padding: 0 var(--inset);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    cursor: pointer;
  }
  .tl-fine > summary:hover { color: var(--accent); }
  .tl-fine ul { margin: 0; padding: 0 var(--inset) var(--sp-4) calc(var(--inset) * 2); color: var(--ink); font-size: var(--step--1); line-height: var(--lh-small); }
  .tl-fine li { margin: 0 0 var(--sp-2); }
  .tl-faq { margin-top: var(--sp-8); }
  .tl-faq h2 { font-size: var(--step-3); margin: 0 0 var(--sp-4); }
  .tl-faq .faq-list { display: flex; flex-direction: column; gap: var(--sp-2); }
  .tl-related { margin: var(--sp-8) 0 0; color: var(--ink-muted); font-size: var(--step--1); }
  .tl-related a { color: var(--accent); }
</style>
