---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuildCard from '../../components/BuildCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionTag from '../../components/SectionTag.astro';
import AdSenseUnit from '../../components/AdSenseUnit.astro';
import { getCollection } from 'astro:content';
import { verifiedPatch } from '../../data/site-config';
const lastVerified = verifiedPatch('Patch 1.1.2.2'); // Bump: drop the arg ONLY after re-verifying this page's content in-game (CURRENT_PATCH is a ceiling, not an auto-bump)

const allBuilds = await getCollection('builds');

function assignTier(build) {
  const text = (build.data.title + ' ' + build.data.description + ' ' + (build.data.tags||[]).join(' ')).toLowerCase();
  
  if (text.includes('roguemadras') || text.includes('tactical pharma') || text.includes('jackpot striker drone') || text.includes('involuntary nap time')) return 'S';
  if (text.includes('saiynergy') || text.includes('breacher')) return 'A';
  if (text.includes('tampishach') || text.includes('tech aegis')) return 'B';
  if (text.includes('milkshake') || text.includes('strawberry')) return 'B';
  if (text.includes('disorient') || text.includes('tech-op')) return 'A';
  if (text.includes('nadie') || text.includes('muscular nurse')) return 'A';
  if (text.includes('ltfoe') || text.includes('double agent')) return 'A';
  if (text.includes('agenthuntzman') || (text.includes('vanguard') && text.includes('recon'))) return 'A';
  if (text.includes('pve enjoyer') || (text.includes('demolitionist') && text.includes('glass cannon'))) return 'A';

  return 'B';
}

// Creator builds we documented but haven't re-tested (verified: false) are listed separately, never auto-ranked.
const rankedBuilds = allBuilds.filter(b => b.data.verified !== false);
const unrankedBuilds = allBuilds
  .filter(b => b.data.verified === false)
  .sort((a, b) => b.data.lastUpdated.getTime() - a.data.lastUpdated.getTime());
const buildsWithTiers = rankedBuilds.map(b => ({ ...b, tier: assignTier(b) }));

const sTier = buildsWithTiers.filter(b => b.tier === 'S');
const aTier = buildsWithTiers.filter(b => b.tier === 'A');
const bTier = buildsWithTiers.filter(b => b.tier === 'B');
const cTier = buildsWithTiers.filter(b => b.tier === 'C');
const dTier = buildsWithTiers.filter(b => b.tier === 'D');

const breadcrumbItems = [{ name: 'Tier List', url: '/tier-list/' }];

const title = "Best Builds & Tier List - Division Resurgence";
// Fixed dates on purpose: the rankings were last re-tested for lastVerified, and the Season 2 notes were added on TIER_NOTES_UPDATED.
const TIER_PUBLISHED = '2026-05-29';
const TIER_NOTES_UPDATED = '2026-10-24';
const description = `Best Division Resurgence builds ranked S through D tier for PvE, Dark Zone PvP and Conflict. Ranked on ${lastVerified}, with Season 2 notes.`;

const siteUrl = 'https://resurgencebuilds.com';

// ItemList schema for ranked builds
const allRanked = [...sTier, ...aTier, ...bTier, ...cTier, ...dTier];
const itemListLd = {
  '@type': 'ItemList',
  name: `Division Resurgence Build Tier List (${lastVerified} rankings)`,
  description: description,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  numberOfItems: allRanked.length,
  itemListElement: allRanked.map((build, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: build.data.title,
    url: `${siteUrl}/builds/${build.id}/`,
  })),
};

const faqs = [
  {
    question: "How do you rank builds on the tier list?",
    answer: "Every build is tested in live gameplay: Legendary missions, Dark Zone PvP, and Conflict. We look at raw DPS output, survivability, team utility, and how forgiving the build is if you mess up a rotation. No theory-crafting from spreadsheets. If it doesn't perform in-game, it doesn't rank high."
  },
  {
    question: "How often is the tier list updated?",
    answer: "In theory, after every major patch. In practice, this list was last re-evaluated for Patch 1.1.2.2 and hasn't been re-tested since, even though Season 1 Phase 3, a June 26 hotfix and both Season 2 phases all shipped balance changes. Each build card links to a full guide with its own patch label and Last Updated date, so you can see exactly how stale it is before you farm anything."
  },
  {
    question: "I think my build is ranked too low. What do I do?",
    answer: "Send it through our contact page (pick Build Suggestion) with your loadout, stats, and gameplay clips. If your build is putting up numbers we can't argue with, we'll re-test it and adjust the ranking. We've moved builds up before - prove it and we'll own the mistake."
  },
  {
    question: "What's the best build for PvE in Division Resurgence?",
    answer: "For pure PvE damage, S-Tier builds like Tactical Pharma dominate Legendary content. The Demolitionist Glass Cannon build from PVE Enjoyer is also a top performer at 333k DPS with Fire Cycle T2. For group play, pair a DPS build with a Bulwark tank and Field Medic healer for the safest clears."
  },
  {
    question: "What's the best PvP build in the Dark Zone?",
    answer: "When we ranked this list, Bulwark Juggernaut builds with Shockwave Spike MK3 were the most feared PvP archetype because the stuns were borderline broken. Then the June 26 hotfix put Pummeling Shield's stun on a 10-second cooldown, and Season 2 Phase 1 cut Shockwave Spike's stun from 3.5 to 2 seconds and raised its cooldown from 12 to 14 seconds. For damage-focused PvP, SMG Lady Death builds on Vanguard Commando had the fastest TTK at close range. We haven't re-ranked PvP since those nerfs, so treat this as history, not gospel."
  },
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbItems} ogImage="/images/best-pve-dps-builds-division-resurgence.png" faqs={faqs} jsonLd={itemListLd}
  article={{
    publishDate: new Date(TIER_PUBLISHED + 'T12:00:00Z').toISOString(),
    modifiedDate: new Date(TIER_NOTES_UPDATED + 'T12:00:00Z').toISOString(),
    author: 'RapidF5',
    tags: ['tier list', 'best builds', 'meta', 'Division Resurgence'],
  }}
>
  <div class="container section">
    <Breadcrumbs items={breadcrumbItems} />
    <SectionTag label="Meta Ranking" />
    <h1 class="heading-accent">Division Resurgence Build Tier List</h1>
    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2); margin-bottom: var(--sp-4); font-size: var(--text-sm);">
      <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; background: rgba(34,197,94,0.12); border: 1px solid rgba(34,197,94,0.3); border-radius: 4px; color: #22c55e; font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.03em;">&#9989; Ranked on {lastVerified}</span>
      <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; background: rgba(252,211,77,0.08); border: 1px solid rgba(252,211,77,0.3); border-radius: 4px; color: #FCD34D; font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600;">Season 2 notes added Oct 2026</span>
      <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; background: rgba(242,104,34,0.08); border: 1px solid rgba(242,104,34,0.2); border-radius: 4px; color: var(--accent); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600;">{allRanked.length} builds ranked</span>
    </div>
    <p style="color:var(--ink-muted);margin-bottom:var(--sp-4); line-height: 1.7;">
      Every build on this list was in-game verified and ranked by real endgame performance for {lastVerified}. <strong>S-Tier</strong> builds are the best builds in Division Resurgence right now - so overtuned that running them feels like cheating and we respect that. <strong>A-Tier</strong> builds will carry you through anything if you have a functioning thumb. <strong>B-Tier</strong> builds work great but your teammates will still blame you when you wipe. <strong>C-Tier</strong> builds are for people who enjoy suffering. We don't judge. Much.
    </p>

    <!-- Methodology -->
    <div style="background: rgba(0,0,0,0.15); border: 1px solid var(--border); border-left: 3px solid var(--accent); border-radius: 0 8px 8px 0; padding: var(--sp-5) var(--sp-5) var(--sp-5) calc(var(--inset) - 3px); margin-bottom: var(--sp-6); max-width: 800px;">
      <h2 style="font-family: var(--font-heading); font-size: var(--text-base); font-weight: 800; color: #fff; margin: 0 0 var(--sp-2) 0;">How We Rank Builds</h2>
      <p style="color: var(--ink-muted); font-size: var(--text-sm); line-height: 1.7; margin: 0;">
        Every build is run in three scenarios: <strong style="color: var(--ink);">Legendary missions</strong> (sustained DPS and survivability), <strong style="color: var(--ink);">Dark Zone PvP</strong> (TTK and positioning), and <strong style="color: var(--ink);">Conflicts</strong> (team composition impact). We measure DPS output, clear times, death count, and team contribution across multiple runs. Builds that perform consistently across all three contexts rank higher than one-trick setups. These rankings were last re-tested for {lastVerified}; the update note below covers the official balance changes since.
      </p>
    </div>

    <div style="background: rgba(242,104,34,0.06); border: 1px solid rgba(242,104,34,0.2); border-radius: 8px; padding: var(--sp-4) var(--sp-5) var(--sp-4) calc(var(--inset) - 1px); margin-bottom: var(--sp-6); max-width: 800px;">
      <p style="color: var(--ink-muted); font-size: var(--text-sm); line-height: 1.7; margin: 0;">
        <strong style="color: var(--accent);">Update (October 2026):</strong> these tiers have not been re-tested since {lastVerified}. Since then Ubisoft shipped Season 1 Phase 3 (Thermobaric Grenades nerf, plus fixes to Aegis Burst, Medic Hypershot, Juggernaut and Recon dealing more damage than intended), a June 26 hotfix (80% damage reduction cap, Pummeling Shield stun cooldown), and two Season 2 phases (Shockwave Spike, Steady Reload and Commando Double Barrel nerfs, a Recycling rework, plus weapon and gear mod reworks). Stun-based Bulwark builds like Involuntary Nap Time and anything leaning on Aegis Burst are the most likely to have slipped. Check each build's patch label.
      </p>
    </div>

    <div class="tier-list">
      
      <!-- S-TIER -->
      <div class="tier-row">
        <div class="tier-label tier-s">S</div>
        <div class="tier-content">
          {sTier.length > 0 ? (
            <div class="tier-grid">
              {sTier.map(build => (
                <a href={`/builds/${build.id}/`} class="tier-card">
                  <div class="tier-card__img" style={`background-image: url('${build.data.featuredImage || '/images/default-cover.webp'}')`}></div>
                  <div class="tier-card__info">
                    <h3>{build.data.title.split(' - ')[0]}</h3>
                    <span class="tier-card__spec">{build.data.specialization}{build.data.subclass ? ` - ${build.data.subclass}` : ''}</span>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="tier-empty">Nothing here yet. If your build belongs in S-Tier, prove it. <a href="/contact/">Send it in</a>.</div>
          )}
        </div>
      </div>

      <!-- A-TIER -->
      <div class="tier-row">
        <div class="tier-label tier-a">A</div>
        <div class="tier-content">
          {aTier.length > 0 ? (
            <div class="tier-grid">
              {aTier.map(build => (
                <a href={`/builds/${build.id}/`} class="tier-card">
                  <div class="tier-card__img" style={`background-image: url('${build.data.featuredImage || '/images/default-cover.webp'}')`}></div>
                  <div class="tier-card__info">
                    <h3>{build.data.title.split(' - ')[0]}</h3>
                    <span class="tier-card__spec">{build.data.specialization}{build.data.subclass ? ` - ${build.data.subclass}` : ''}</span>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="tier-empty"></div>
          )}
        </div>
      </div>

      <!-- B-TIER -->
      <div class="tier-row">
        <div class="tier-label tier-b">B</div>
        <div class="tier-content">
          {bTier.length > 0 ? (
            <div class="tier-grid">
              {bTier.map(build => (
                <a href={`/builds/${build.id}/`} class="tier-card">
                  <div class="tier-card__img" style={`background-image: url('${build.data.featuredImage || '/images/default-cover.webp'}')`}></div>
                  <div class="tier-card__info">
                    <h3>{build.data.title.split(' - ')[0]}</h3>
                    <span class="tier-card__spec">{build.data.specialization}{build.data.subclass ? ` - ${build.data.subclass}` : ''}</span>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="tier-empty">B-Tier is empty. Which is weird because most of us live here.</div>
          )}
        </div>
      </div>

      <!-- C-TIER -->
      <div class="tier-row">
        <div class="tier-label tier-c">C</div>
        <div class="tier-content">
          {cTier.length > 0 ? (
            <div class="tier-grid">
              {cTier.map(build => (
                <a href={`/builds/${build.id}/`} class="tier-card">
                  <div class="tier-card__img" style={`background-image: url('${build.data.featuredImage || '/images/default-cover.webp'}')`}></div>
                  <div class="tier-card__info">
                    <h3>{build.data.title.split(' - ')[0]}</h3>
                    <span class="tier-card__spec">{build.data.specialization}{build.data.subclass ? ` - ${build.data.subclass}` : ''}</span>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="tier-empty">No C-Tier builds.</div>
          )}
        </div>
      </div>

      <!-- D-TIER -->
      <div class="tier-row">
        <div class="tier-label tier-d">D</div>
        <div class="tier-content">
          {dTier.length > 0 ? (
            <div class="tier-grid">
              {dTier.map(build => (
                <a href={`/builds/${build.id}/`} class="tier-card">
                  <div class="tier-card__img" style={`background-image: url('${build.data.featuredImage || '/images/default-cover.webp'}')`}></div>
                  <div class="tier-card__info">
                    <h3>{build.data.title.split(' - ')[0]}</h3>
                    <span class="tier-card__spec">{build.data.specialization}{build.data.subclass ? ` - ${build.data.subclass}` : ''}</span>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="tier-empty">No D-Tier builds. We have standards. Low ones, but standards.</div>
          )}
        </div>
      </div>

    </div>

    {unrankedBuilds.length > 0 && (
      <section class="unranked-builds" aria-labelledby="unranked-heading">
        <h2 id="unranked-heading">New Season 2 creator builds (not ranked yet)</h2>
        <p>We document these from the creators' own videos, but we haven't run them through our ranking tests, so they don't get a tier. Yet. Each page says exactly whose numbers are whose.</p>
        <div class="tier-grid">
          {unrankedBuilds.map(build => (
            <a href={`/builds/${build.id}/`} class="tier-card">
              <div class="tier-card__img" style={`background-image: url('${build.data.featuredImage || '/images/default-cover.webp'}')`}></div>
              <div class="tier-card__info">
                <h3>{build.data.title.split(' - ')[0]}</h3>
                <span class="tier-card__spec">{build.data.specialization}{build.data.subclass ? ` - ${build.data.subclass}` : ''} · {build.data.patch}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <AdSenseUnit label="Advertisement — tier list 1" />

    <!-- Per-Tier Analysis -->
    <div style="max-width: 800px; margin-top: var(--sp-6);">
      <h2 style="font-family: var(--font-heading); font-size: var(--text-xl); font-weight: 800; color: #fff; margin: 0 0 var(--sp-4) 0;">Tier Breakdown - {lastVerified} Meta</h2>

      <div style="margin-bottom: var(--sp-6);">
        <h3 style="font-family: var(--font-heading); font-size: var(--text-lg); font-weight: 800; color: #ff7b00; margin: 0 0 var(--sp-2) 0;">S-Tier - The Untouchables</h3>
        <p style="color: var(--ink-muted); font-size: var(--text-sm); line-height: 1.75;">
          S-Tier is reserved for builds that break the game in their favor. As of our last ranking, that's Tactical Pharma - RogueMadras put together a setup that pushes 800k+ effective DPS with healing output that keeps the squad alive through damage checks that should be wiping you. It's the kind of build where teammates type "what are you running" in chat after the first boss melts in 8 seconds. If you want to clear Legendary content on autopilot, these are the loadouts that do it.
        </p>
      </div>

      <div style="margin-bottom: var(--sp-6);">
        <h3 style="font-family: var(--font-heading); font-size: var(--text-lg); font-weight: 800; color: #3a7bd5; margin: 0 0 var(--sp-2) 0;">A-Tier - Endgame Ready</h3>
        <p style="color: var(--ink-muted); font-size: var(--text-sm); line-height: 1.75;">
          A-Tier builds are what most experienced players run. The Bulwark Breacher from Saiynergy (334k DPS while holding a shield), PVE Enjoyer's Demolitionist Glass Cannon (333k DPS at 20m range), and AgentHuntzman's Vanguard Recon (team damage multiplier that doesn't show on your own DPS meter but carries the squad). These builds clear all content comfortably and are competitive in Dark Zone PvP. The difference between A-Tier and S-Tier is usually one stat check or one gear piece - if you're running A-Tier, you're doing endgame right.
        </p>
      </div>

      <div style="margin-bottom: var(--sp-6);">
        <h3 style="font-family: var(--font-heading); font-size: var(--text-lg); font-weight: 800; color: #28a745; margin: 0 0 var(--sp-2) 0;">B-Tier - Solid Picks</h3>
        <p style="color: var(--ink-muted); font-size: var(--text-sm); line-height: 1.75;">
          B-Tier builds work. Period. The Milkshake Machine (Strawberry Milkshake LMG with Phalanx Attack) is disgusting sustained DPS that just keeps firing. Tampishach's Tech Aegis (237k DPS shield pulse) is a tanky DPS hybrid with one of the highest skill ceilings in the game. These builds won't top the damage charts against an optimized S-Tier or A-Tier setup, but they'll clear every piece of content in the game and they're often more forgiving to play. If you're still farming for that perfect Fire Cycle T2 roll, B-Tier is where you live - and it's comfortable.
        </p>
      </div>
    </div>

    <!-- Patch Watchlist -->
    <div style="background: rgba(242,104,34,0.06); border: 1px solid rgba(242,104,34,0.2); border-radius: 12px; padding: var(--sp-5) var(--sp-5) var(--sp-5) calc(var(--inset) - 1px); max-width: 800px;">
      <h2 style="font-family: var(--font-heading); font-size: var(--text-base); font-weight: 800; color: var(--accent); margin: 0 0 var(--sp-2) 0;">&#128064; Patch 1.3 Watchlist</h2>
      <p style="color: var(--ink-muted); font-size: var(--text-sm); line-height: 1.7; margin: 0 0 var(--sp-3) 0;">
        Based on community discussion and Ubisoft's balance history, these are the areas we're watching for Patch 1.3 changes:
      </p>
      <ul class="watchlist" style="color: var(--ink-muted); font-size: var(--text-sm); line-height: 1.7; padding-left: var(--inset); margin: 0;">
        <li><strong style="color: var(--ink);">Shockwave Spike MK3:</strong> The ~5-second stun is widely considered too strong for PvP. A cooldown or duration nerf is likely. <em>Result (October 2026): both. Season 2 Phase 1 cut the stun to 2 seconds (Ubisoft lists the old value as 3.5s) and raised the cooldown from 12 to 14 seconds.</em></li>
        <li><strong style="color: var(--ink);">Fire Cycle T2:</strong> The +12% passive Skill Multi-Shot Chance with zero conditions is on the radar. Expect either a nerf or a conditional requirement. <em>Result: no change in any official patch notes through Season 2 Phase 2.</em></li>
        <li><strong style="color: var(--ink);">Toymaker II:</strong> The 20m range requirement may get tightened or the Skill Multi-Shot bonus reduced from +21%. <em>Result: no change in the official notes through Season 2 Phase 2.</em></li>
        <li><strong style="color: var(--ink);">Vanguard Recon:</strong> Smart Cover buffs may see a cap or diminishing returns in group play. <em>Result: no cap. Season 1 Phase 3 fixed Recon passively dealing more damage than intended, and Season 2 Phase 1 improved Recon's Tactical Link auto-aim.</em></li>
        <li><strong style="color: var(--ink);">What we didn't see coming:</strong> the Season 1 Phase 3 Thermobaric Grenades nerf, the June 26 Pummeling Shield stun cooldown and 80% damage reduction cap, the Season 2 Phase 1 nerfs to Steady Reload and the Commando Double Barrel Shotgun loop, and the Recycling rework (slower cooldown, bigger refill).</li>
      </ul>
    </div>

    <AdSenseUnit label="Advertisement — tier list 2" />
  </div>
</BaseLayout>

<style>
  .watchlist li { max-width: var(--measure); } /* about 80 characters a line */
  .tier-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    background: rgba(0,0,0,0.2);
    padding: var(--sp-4);
    border-radius: var(--border-radius);
    border: 1px solid var(--border);
  }

  .tier-row {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border-radius: 8px;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  @media (min-width: 45em) {
    .tier-row {
      flex-direction: row;
    }
  }

  .tier-label {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 800;
    color: #1a1a20;
    min-width: 100px;
    padding: var(--sp-4);
    text-shadow: 0 1px 2px rgba(255,255,255,0.2);
  }

  .tier-s { background: linear-gradient(135deg, #ff7b00, #ff5100); }
  .tier-a { background: linear-gradient(135deg, #00d2ff, #3a7bd5); }
  .tier-b { background: linear-gradient(135deg, #28a745, #20c997); }
  .tier-c { background: linear-gradient(135deg, #6c757d, #adb5bd); }
  .tier-d { background: linear-gradient(135deg, #495057, #343a40); }

  .tier-content {
    flex: 1;
    padding: var(--sp-3);
    background: rgba(0,0,0,0.15);
  }

  .tier-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--sp-2);
  }

  .tier-card {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px;
    text-decoration: none;
    transition: all 0.2s;
    min-height: 62px;
  }

  .tier-card:hover {
    border-color: var(--accent);
    background: rgba(255,255,255,0.05);
    transform: translateY(-2px);
  }

  .tier-card__img {
    width: 48px;
    height: 48px;
    border-radius: 4px;
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
  }

  .tier-card__info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  /* Build names wrap in full (a 2-line clamp cut off the longer ones) */
  .tier-card__info h3 {
    color: var(--ink);
    font-size: var(--step--1);
    margin: 0 0 2px 0;
    line-height: var(--lh-snug);
    font-weight: 600;
  }

  .tier-card__spec {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-muted);
    text-transform: uppercase;
  }

  .tier-empty {
    color: var(--ink-muted);
    font-style: italic;
    padding: var(--sp-2);
    font-size: var(--text-sm);
  }
  .unranked-builds {
    margin: var(--sp-8) 0;
