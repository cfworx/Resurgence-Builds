---
import BaseLayout from '../layouts/BaseLayout.astro';
import postImages from '../data/post-images.json';

// An in-game frame: the Fast Travel prompt from our own recordings.
const IMG = '/images/site/division-resurgence-404-fast-travel-prompt-1200.webp';
const img = (postImages as Record<string, { width: number; height: number; srcset: [number, string][]; small: string }>)[IMG];
const srcset = img.srcset.filter(([w]) => w <= 1200).map(([w, u]) => `${u} ${w}w`).join(', ');
---

<BaseLayout noAds noindex={true}
  title="404: Page Not Found"
  description="The page you are looking for does not exist on Resurgence Builds."
>
  <div class="container section err">
    <img src={img.small} srcset={srcset} sizes="(max-width: 480px) calc(100vw - 32px), 440px" width={img.width} height={img.height}
      alt="The Division Resurgence Fast Travel prompt: Are you sure you want to travel to this position? Cancel or Confirm" class="err__img" />
    <p class="err__code">404</p>
    <h1 class="heading-accent err__title">That Position Isn't on the Map</h1>
    <p class="err__text">
      You hit Confirm and landed nowhere. The page may have moved, or the link has a typo. No enemies, no loot, nothing to see here.
    </p>
    <a href="/" class="btn btn--primary err__home">Fast Travel Home</a>
  </div>
</BaseLayout>

<style>
  /* Same top and bottom spacing as every other page (the standard .section padding), everything centered */
  .err {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .err__img {
    max-width: 440px;
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin-bottom: var(--sp-6);
    box-shadow: 0 10px 30px rgba(255, 109, 16, 0.2);
  }
  /* the big number is decoration for the heading below it, so it isn't the page's h1 */
  .err__code {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 5rem;
    line-height: 1;
    letter-spacing: -2px;
    color: var(--accent);
    margin: 0 0 var(--sp-6);
  }
  .err__title { margin-bottom: var(--sp-3); }
  .err__text {
    color: var(--ink-muted);
    font-size: var(--text-lg);
    max-width: 600px;
    margin: 0 auto var(--sp-8);
  }
  .err__home { font-size: var(--text-lg); padding-inline: var(--sp-8); }
</style>
