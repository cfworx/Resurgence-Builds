---
import BaseLayout from '../../layouts/BaseLayout.astro';
import poisData from '../../data/pois.json';

// Bump this when the map is re-checked against a new patch.
const MAP_REVIEWED = '2026-10-24';
const MAP_REVIEWED_PATCH = 'Season 2 Phase 2';
const reviewedLabel = new Date(MAP_REVIEWED + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

type Cat = (typeof poisData.categories)[number] & { trackable?: boolean; wip?: boolean; approx?: boolean };
type Poi = (typeof poisData.pois)[number] & { code?: string; codeNote?: string; crateNumber?: number };
const categories = poisData.categories as Cat[];
const pois = poisData.pois as Poi[];
const catById = Object.fromEntries(categories.map((c) => [c.id, c]));
const n = (id: string) => catById[id]?.count ?? 0;
const total = pois.length;
const listJoin = (arr: (string | number)[]) =>
  arr.length <= 1 ? arr.join('') : arr.slice(0, -1).join(', ') + ' and ' + arr[arr.length - 1];

const openWorldSafeHouses = pois.filter((p) => p.category === 'safe_house' && !/dark zone/i.test(p.name)).map((p) => p.name);
const dzSafeHouses = pois.filter((p) => p.category === 'safe_house' && /dark zone/i.test(p.name)).length;
const crates = pois.filter((p) => p.category === 'encrypted_crate');
const randomCrates = crates.filter((p) => /random/i.test(p.code || '')).map((p) => p.crateNumber!).sort((a, b) => a - b);
const disputedCrates = crates.filter((p) => !p.code).map((p) => p.crateNumber!).sort((a, b) => a - b);
const trackableTotal = pois.filter((p) => catById[p.category]?.trackable).length;
const wipLabels = categories.filter((c) => c.wip && c.id !== 'encrypted_crate').map((c) => c.label.toLowerCase());
const offMap = poisData.offMap as { type: string; name: string; note: string }[];
const offMapInstances = offMap.filter((o) => /instance/i.test(o.type)).map((o) => o.name);

const groups: Record<string, Cat[]> = {};
for (const cat of categories) (groups[cat.group] ||= []).push(cat);

const title = 'Division Resurgence Interactive Map';
const description = `Free Division Resurgence map of Manhattan with ${total} markers: safe houses, safe codes, ECHOs, artifacts, audio logs and Dark Zone exits.`;
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Interactive Map', url: '/division-resurgence-interactive-map/' }
];

const faqs = [
  {
    question: 'Where are the safe houses in Division Resurgence?',
    answer: `The community map lists ${openWorldSafeHouses.length} open-world safe houses: ${listJoin(openWorldSafeHouses)}. The Dark Zone adds ${dzSafeHouses} numbered safe houses of its own. The NYC Base of Operations and Spring Blossom Settlement are on the map too, with their vendors and crafting stations listed in each popup.`
  },
  {
    question: 'Where are the encrypted crates, and what are the codes?',
    answer: `${crates.length} encrypted crates are pinned on the map, and each popup shows the code where sources agree. Crates ${listJoin(randomCrates)} are randomized per player, so the popup tells you which Code Clue to read instead. Crates ${listJoin(disputedCrates)} are left blank on purpose because community sources disagree on them. The full table is in our Safe Codes Master List.`
  },
  {
    question: 'Does the map show ECHOs, artifacts and audio logs?',
    answer: `Yes: ${n('echo')} ECHOs, ${n('artifact')} artifacts, ${n('audio_log')} audio logs, ${n('shd_crate')} SHD crates and the ${n('encrypted_crate')} encrypted crates, all trackable. Open a marker, hit Mark as found, and the counter in the filter panel ticks up. Progress is saved in your browser only, so clearing site data wipes it. No account, no login, and no judgment about how long that last artifact took you.`
  },
  {
    question: 'Where is the Dark Zone on the map?',
    answer: `The Dark Zone is the eastern section of the map. We plot its ${n('dz_gate')} gates, ${n('dz_extraction')} extraction zones, ${dzSafeHouses} safe houses, ${n('dz_landmark')} landmarks, enemy leaders and extremely contaminated areas. Those markers are converted from a schematic community map, so they can sit slightly off from the in-game icon. Close enough to navigate by, not close enough to stand on.`
  },
  {
    question: 'Why are some missions not on the map?',
    answer: `${listJoin(offMapInstances)} are instanced missions that take place outside the open-world map, so we list them under the map instead of inventing a pin for them. Everything else with a known position is plotted.`
  },
  {
    question: 'Is this an official Ubisoft map?',
    answer: 'No. Resurgence Builds is an independent fan site. Marker positions are adapted from The Division Wiki community maps (CC BY-SA 3.0), fitted onto the in-game map image, and cross-checked against our own guides. If a pin is wrong, tell us through the contact page and we will move it.'
  }
];

const mapLd = {
  '@type': 'Map',
  name: 'Division Resurgence Interactive Map of Manhattan',
  description,
  url: new URL('/division-resurgence-interactive-map/', Astro.site).href,
  mapType: 'https://schema.org/VenueMap',
  dateModified: MAP_REVIEWED,
  license: poisData.attribution.license
};

const dataPayload = JSON.stringify(poisData);
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  jsonLd={mapLd}
  ogImage="/images/map/manhattan-base.jpg"
  keywords={["division resurgence interactive map","division resurgence map","division resurgence manhattan map","division resurgence safe house locations","division resurgence encrypted crate locations","division resurgence echo locations","division resurgence artifact locations","division resurgence audio log locations","division resurgence dark zone map"]}
>

<div class="map-app">
  <section class="map-hero">
    <div class="container map-hero__inner">
      <span class="section-tag">// INTERACTIVE MAP</span>
      <h1 class="map-hero__title">Division Resurgence Interactive Map of Manhattan</h1>
      <p class="map-hero__sub">{total} locations across Midtown and the Dark Zone. Click a marker for details, tick off collectibles as you find them, and share any pin with <strong>Copy link</strong>. Reviewed {reviewedLabel} for {MAP_REVIEWED_PATCH}.</p>
      <ul class="map-stats" aria-label="What is on the map">
        <li><strong>{n('safe_house')}</strong> safe houses</li>
        <li><strong>{n('encrypted_crate')}</strong> encrypted crates</li>
        <li><strong>{n('echo')}</strong> ECHOs</li>
        <li><strong>{n('artifact')}</strong> artifacts</li>
        <li><strong>{n('audio_log')}</strong> audio logs</li>
        <li><strong>{n('dz_extraction')}</strong> DZ extractions</li>
      </ul>
    </div>
  </section>

  <div class="map-toolbar">
    <div class="map-search">
      <label class="sr-only" for="map-search">Search map locations</label>
      <input id="map-search" class="map-search__input" type="search" placeholder={`Search ${total} locations: Kerman Station, ECHO 07, Crate 12...`} autocomplete="off" spellcheck="false" />
      <ul id="map-search-results" class="map-search__results" hidden></ul>
    </div>
    <div class="map-progress">
      <span>Collectibles found</span>
      <strong id="map-progress-total">0 / {trackableTotal}</strong>
      <button type="button" class="map-progress__reset" id="map-reset-progress">Reset</button>
    </div>
  </div>

  <div class="map-layout">
    <aside class="map-filters" id="map-filters" aria-label="Map layers">
      <div class="map-filters__header">
        <span class="map-filters__title">Layers</span>
        <button type="button" class="map-filters__close" id="filters-close" aria-label="Close layers">&times;</button>
      </div>
      <div class="map-filters__body">
        {Object.entries(groups).map(([group, cats]) => (
          <div class="filter-group">
            <div class="filter-group__head">
              <span class="filter-group__label">{group}</span>
              <span class="filter-group__actions">
                <button type="button" data-group-toggle={group} data-mode="all">All</button>
                <button type="button" data-group-toggle={group} data-mode="none">None</button>
              </span>
            </div>
            {cats.map((cat) => (
              <label class="filter-item" data-cat-id={cat.id}>
                <input type="checkbox" class="filter-checkbox" data-category={cat.id} checked={cat.defaultOn} />
                <span class="filter-swatch" style={`background: ${cat.color};`}></span>
                <span class="filter-label">{cat.label}{cat.wip && <span class="filter-flag" title="Partial layer: still being mapped">*</span>}{cat.approx && <span class="filter-flag" title="Approximate positions">≈</span>}</span>
                <span class="filter-count" data-count-for={cat.id}>{cat.trackable ? `0/${cat.count}` : cat.count}</span>
              </label>
            ))}
          </div>
        ))}
        <p class="filter-legend"><span>*</span> partial layer, still being mapped<br /><span>≈</span> approximate positions</p>
      </div>
    </aside>

    <div class="map-canvas-wrap">
      <div id="map-canvas" data-base="/images/map/manhattan-base.webp" role="application" aria-label="Interactive map of Manhattan in The Division Resurgence"></div>
      <div class="map-zoom-hint" id="map-zoom-hint" hidden>Click the map first, then scroll to zoom</div>
      <noscript><p class="map-noscript">The interactive map needs JavaScript. The location lists below still work without it.</p></noscript>
    </div>

    <button type="button" class="map-filters-toggle" id="filters-toggle" aria-label="Show map layers" aria-controls="map-filters">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
      <span>Layers</span>
    </button>
  </div>

  <p class="map-attribution">
    Marker locations adapted from <a href={poisData.attribution.sources[0]} target="_blank" rel="noopener noreferrer">The Division Wiki community maps</a> (Fandom), licensed <a href={poisData.attribution.license} target="_blank" rel="noopener noreferrer">CC BY-SA 3.0</a>, fitted to the in-game map by Resurgence Builds. Dark Zone markers are approximate. <span class="desktop-only">Contributors: Shift+Click copies map coordinates.</span>
  </p>

  <section class="map-seo">
    <h2>Instanced missions (not on the open-world map)</h2>
    <p>These missions launch from a bubble at the edge of the in-game map and play out somewhere else, so there is nothing honest to pin:</p>
    <ul class="offmap-list">
      {offMap.map((o) => (
        <li><strong>{o.name}</strong> <span class="offmap-type">{o.type}</span>. {o.note}</li>
      ))}
    </ul>

    <h2>About this map</h2>
    <p>This is a free interactive map for Tom Clancy's The Division Resurgence, drawn on the in-game map of Midtown Manhattan. It plots {total} locations across {categories.length} layers: hubs and safe houses, main and side missions, open-world activities, every mapped collectible, and the Dark Zone. It works in the browser on phones and PC, with no login.</p>
    <p>How we built it: the positions come from The Division Wiki's community maps, which players have been filling in since launch. We converted them onto our base map with a perspective fit anchored on building outlines, so open-world markers land within a few pixels of the in-game icons. The Dark Zone layer comes from a separate schematic map, which is why those markers carry an "approximate" flag.</p>
    <p>What is still partial: {listJoin(wipLabels)} are flagged as partial layers because the community has not finished mapping them. Encrypted crates are flagged too, because not every crate in the game has been located. The <a href="/guides/division-resurgence-safe-codes/">Safe Codes Master List</a> explains which codes are confirmed, which are randomized per player, and which are disputed.</p>
    <p>Spotted a wrong pin or a missing location? <a href="/contact/">Send it to us</a> with the in-game spot (Shift+Click on desktop copies coordinates) and we will fix it. For gear once you have looted the place clean, see the <a href="/builds/">builds database</a> and the <a href="/guides/division-resurgence-exotic-weapons-list-2026/">exotic weapons list</a>, and check the <a href="/patch-notes/">patch notes</a> for what changed this season.</p>
    <p class="map-disclaimer"><em>Resurgence Builds is an independent fan site. We are not affiliated with, endorsed by, or sponsored by Ubisoft Entertainment SA. Tom Clancy's The Division, The Division Resurgence, and all related characters, logos, and game assets are trademarks and copyrights of Ubisoft Entertainment SA.</em></p>
  </section>

  <section class="map-faq">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-list">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary class="faq-question">{faq.question}</summary>
          <p class="faq-answer">
            {faq.answer.endsWith('Safe Codes Master List.') ? (
              <>{faq.answer.replace(/The full table is in our Safe Codes Master List\.$/, '')}The full table is in our <a href="/guides/division-resurgence-safe-codes/">Safe Codes Master List</a>.</>
            ) : faq.answer.includes('contact page') ? (
              <>{faq.answer.split('contact page')[0]}<a href="/contact/">contact page</a>{faq.answer.split('contact page')[1]}</>
            ) : (
              faq.answer
            )}
          </p>
        </details>
      ))}
    </div>
  </section>
</div>

<link rel="stylesheet" href="/css/leaflet.min.css" />
<script is:inline src="/js/leaflet.min.js"></script>
<script is:inline>
/*! leaflet-rastercoords - MIT - https://github.com/commenthol/leaflet-rastercoords */
(function(f){if(typeof define==="function"&&define.amd){define(["leaflet"],f)}else{f(L)}})(function(L){L.RasterCoords=function(map,imgSize,tileSize){this.map=map;this.width=imgSize[0];this.height=imgSize[1];this.tileSize=tileSize||256;this.zoom=this.zoomLevel()};L.RasterCoords.prototype={zoomLevel:function(){return Math.ceil(Math.log(Math.max(this.width,this.height)/this.tileSize)/Math.log(2))},unproject:function(coords){return this.map.unproject(coords,this.zoom)},project:function(coords){return this.map.project(coords,this.zoom)},getMaxBounds:function(){var southWest=this.unproject([0,this.height]);var northEast=this.unproject([this.width,0]);return new L.LatLngBounds(southWest,northEast)},setMaxBounds:function(){var bounds=this.getMaxBounds();this.map.setMaxBounds(bounds)}}});
</script>
<script type="application/json" id="map-data" is:inline set:html={dataPayload}></script>
<script is:inline src="/js/map-engine.js?v=21"></script>

</BaseLayout>

<style is:global>
/* ============================================================
   INTERACTIVE MAP · Division Resurgence
   ============================================================ */
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0 }

/* --- Hero --- */
.map-hero {
  padding: var(--sp-8) 0 var(--sp-4);
  border-bottom: 1px solid var(--border);
  background: linear-gradient(180deg, rgba(242,104,34,0.03) 0%, transparent 100%);
}
.map-hero__inner { display: flex; flex-direction: column; align-items: center; text-align: center }
.map-hero__title {
  font-size: var(--text-3xl);
  margin-bottom: var(--sp-2);
  background: linear-gradient(135deg, var(--ink) 60%, var(--accent) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.map-hero__sub { color: var(--ink-muted); max-width: 68ch; font-size: var(--text-sm); margin-bottom: var(--sp-3) }
.map-hero__sub strong { color: var(--accent) }
.map-stats { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; padding: 0; margin: 0 }
.map-stats li {
  font-family: var(--font-mono); font-size: 0.8125rem; color: var(--ink-muted);
  padding: 4px 10px; border: 1px solid var(--border); border-radius: 999px; background: var(--surface);
}
.map-stats strong { color: var(--ink-heading) }
@media (min-width: 45em) {
  .map-hero { padding: var(--sp-10) 0 var(--sp-6) }
  .map-hero__title { font-size: var(--text-4xl) }
}

/* --- Toolbar (search + progress) --- */
.map-toolbar {
  max-width: var(--max-width);
  margin: var(--sp-4) auto 0;
  display: flex; gap: var(--sp-3); align-items: center; justify-content: space-between; flex-wrap: wrap;
}
.map-search { position: relative; flex: 1 1 320px; max-width: 560px }
.map-search__input {
  width: 100%; min-height: 44px; padding: 10px 14px; font-size: max(16px, 1rem); color: var(--ink-heading);
  background: var(--surface); border: 1px solid #6E6E76; border-radius: var(--border-radius);
}
.map-search__input:focus { border-color: var(--accent) }
.map-search__input::placeholder { color: var(--ink-muted); opacity: 1 }
.map-search__results {
  position: absolute; z-index: 1200; top: calc(100% + 4px); left: 0; right: 0; margin: 0; padding: 4px; list-style: none;
  background: var(--surface-2); border: 1px solid var(--border); border-radius: 6px; box-shadow: 0 12px 32px rgba(0,0,0,0.5);
  max-height: 340px; overflow-y: auto;
}
.search-hit {
  width: 100%; min-height: 44px; display: flex; align-items: center; gap: 8px; padding: 8px 10px; text-align: left;
  background: none; border: none; border-radius: 4px; color: var(--ink); cursor: pointer; font-size: var(--text-sm);
}
.search-hit:hover, .search-hit:focus-visible { background: rgba(242,104,34,0.12) }
.search-hit:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px }
.search-hit__name { flex: 1; color: var(--ink-heading) }
.search-hit__cat { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--ink-muted); text-transform: uppercase }
.search-empty { padding: 8px 10px; color: var(--ink-muted); font-size: var(--text-sm) }
.map-progress { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.8125rem; color: var(--ink-muted) }
.map-progress strong { color: var(--success) }
.map-progress__reset {
  background: none; border: 1px solid var(--border); color: var(--ink-muted); border-radius: var(--border-radius);
  min-height: 36px; padding: 4px 12px; font-family: var(--font-mono); font-size: 0.8125rem; cursor: pointer;
}
.map-progress__reset:hover { color: var(--accent); border-color: var(--accent) }

/* --- Layout (sidebar + canvas) --- */
.map-layout { max-width: var(--max-width); margin: var(--sp-3) auto 0; display: flex; position: relative }

/* --- Layer sidebar --- */
.map-filters {
  width: 236px; flex-shrink: 0; background: var(--surface);
  border: 1px solid var(--border); border-right: none; border-radius: var(--border-radius) 0 0 var(--border-radius);
  display: flex; flex-direction: column; max-height: 78vh; min-height: min(520px, 85vh); overflow: hidden;
}
.map-filters__header {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--sp-3) var(--sp-4); border-bottom: 1px solid var(--border); flex-shrink: 0;
}
.map-filters__title { font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent) }
.map-filters__close { display: none; width: 44px; height: 44px; margin: -10px -12px -10px 0; background: none; border: none; border-radius: var(--border-radius); color: var(--ink-muted); font-size: 1.75rem; cursor: pointer; padding: 0; line-height: 1 }
.map-filters__close:hover { color: var(--accent) }
.map-filters__body { flex: 1; overflow-y: auto; padding: var(--sp-1) 0 var(--sp-2) }
.map-filters__body::-webkit-scrollbar { width: 4px }
.map-filters__body::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 2px }
.filter-group { padding: var(--sp-1) var(--sp-4) var(--sp-2) }
.filter-group__head {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--sp-2) 0 var(--sp-1); border-bottom: 1px solid rgba(255,255,255,0.05); margin-bottom: var(--sp-1);
}
.filter-group__label { font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-muted) }
.filter-group__actions { display: flex; gap: 8px }
.filter-group__actions button {
  min-height: 28px; background: none; border: none; padding: 2px 4px; cursor: pointer;
  font-family: var(--font-mono); font-size: 0.8125rem; color: var(--ink-muted); text-decoration: underline; text-underline-offset: 2px;
}
.filter-group__actions button:hover { color: var(--accent) }
.filter-item { display: flex; align-items: center; gap: 8px; padding: 5px 0; cursor: pointer; color: var(--ink); user-select: none }
.filter-item:hover { color: #fff }
.filter-checkbox {
  appearance: none; -webkit-appearance: none; width: 16px; height: 16px; margin: 0;
  border: 2px solid rgba(255,255,255,0.22); border-radius: 3px; background: transparent; cursor: pointer; flex-shrink: 0; position: relative;
}
.filter-checkbox:checked { background: var(--accent); border-color: var(--accent) }
.filter-checkbox:checked::after { content: '✓'; position: absolute; top: -2px; left: 2px; font-size: 11px; font-weight: bold; color: #fff }
.filter-checkbox:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px }
.filter-swatch { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0 }
.filter-label { flex: 1; min-width: 0; font-size: 0.875rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis }
.filter-flag { margin-left: 4px; font-family: var(--font-mono); font-size: 0.8125rem; color: #FCD34D }
.filter-legend { margin: var(--sp-2) var(--sp-4) 0; font-family: var(--font-mono); font-size: 0.8125rem; line-height: 1.6; color: var(--ink-muted) }
.filter-legend span { color: #FCD34D; display: inline-block; width: 12px }
.filter-count { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--ink-muted); text-align: right; white-space: nowrap }
.filter-count.is-complete { color: var(--success) }

/* --- Mobile layer toggle --- */
.map-filters-toggle {
  display: none; position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); z-index: 1000;
  min-height: 44px; padding: 10px 20px; background: var(--surface-2); border: 1px solid var(--accent); border-radius: 999px; color: var(--accent);
  font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
  cursor: pointer; align-items: center; gap: 6px; box-shadow: 0 4px 20px rgba(0,0,0,0.5);
}
.map-filters-toggle:hover { background: var(--accent); color: #fff }

/* --- Canvas --- */
.map-canvas-wrap {
  flex: 1; min-width: 0; position: relative;
  border: 1px solid var(--border); border-radius: 0 var(--border-radius) var(--border-radius) 0; overflow: hidden;
  isolation: isolate; /* keeps Leaflet's z-indexes inside the map, so the Layers sheet and its backdrop cover the zoom buttons */
}
#map-canvas { width: 100%; height: 78vh; min-height: min(520px, 85vh); background: #0a0d12; cursor: grab }
#map-canvas.leaflet-drag-target, #map-canvas:active { cursor: grabbing }
.map-zoom-hint {
  position: absolute; z-index: 800; left: 50%; top: 50%; transform: translate(-50%, -50%);
  padding: 8px 14px; border-radius: 999px; pointer-events: none;
  background: rgba(10,13,18,0.85); border: 1px solid var(--border); color: var(--ink-heading); font-size: var(--text-xs); font-family: var(--font-mono);
}
.map-noscript { padding: var(--sp-4); color: var(--ink-muted) }
.map-attribution { max-width: var(--max-width); margin: var(--sp-2) auto 0; font-size: 0.8125rem; color: var(--ink-muted) }
.map-attribution a { color: var(--ink-muted); text-decoration: underline; text-underline-offset: 2px }
.map-attribution a:hover { color: var(--accent) }

/* --- Leaflet chrome --- */
.leaflet-container { font-family: inherit }
