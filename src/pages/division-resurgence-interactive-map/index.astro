---
import BaseLayout from '../../layouts/BaseLayout.astro';
import poisData from '../../data/pois.json';

// Bump this when the map is re-checked against the game.
const MAP_REVIEWED = poisData.checked || '2026-11-20';
const MAP_REVIEWED_PATCH = 'Season 2 Phase 2';
const reviewedLabel = new Date(MAP_REVIEWED + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

type Cat = (typeof poisData.categories)[number] & { trackable?: boolean; wip?: boolean; approx?: boolean };
type Inside = { type: string; name: string; district?: string; gameText?: string };
type Poi = {
  id: string; category: string; name: string; x: number; y: number; description?: string; code?: string; codeNote?: string;
  crateNumber?: number; number?: number; collection?: string; district?: string; gameText?: string; verified?: boolean;
  inside?: Inside[]; note?: string;
};
const categories = poisData.categories as Cat[];
const pois = poisData.pois as unknown as Poi[];
const catById = Object.fromEntries(categories.map((c) => [c.id, c]));
const n = (id: string) => catById[id]?.count ?? 0;
const listJoin = (arr: (string | number)[]) =>
  arr.length <= 1 ? arr.join('') : arr.slice(0, -1).join(', ') + ' and ' + arr[arr.length - 1];
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// Collectibles that live inside instanced missions have no pin of their own. They still count, so the checklist
// lists them under the mission that holds them (the same ids map-engine.js uses).
const missions = pois.filter((p) => p.inside && p.inside.length);
const offMap = poisData.offMap as { type: string; name: string; note: string; distance?: string; about?: string; bubble?: string; inside?: Inside[] }[];
type Row = { id: string; name: string; sub: string; number?: number; collection?: string; pin?: string; district?: string; text?: string; verified?: boolean };
const insideRows = (type: string): Row[] => missions.flatMap((m) =>
  (m.inside || []).filter((i) => i.type === type).map((i) => ({
    id: `inside-${slug(i.name)}`, name: i.name, sub: `Inside ${m.name}`, pin: m.id, district: i.district, text: i.gameText, verified: !!i.district,
  })));
const rowsFor = (cat: string): Row[] => pois.filter((p) => p.category === cat).map((p) => ({
  id: p.id, name: p.name, number: p.number ?? p.crateNumber, collection: p.collection, pin: p.id,
  district: p.district, text: p.gameText,
  sub: p.district || '',
}));
const ECHO_NUM: Record<string, number> = { Triage: 8, Kidnapped: 11, 'Liberty Island': 14 };
const echoRows = [...rowsFor('echo'), ...insideRows('ECHO').map((r) => ({ ...r, number: ECHO_NUM[r.name] }))].sort((a, b) => (a.number ?? 99) - (b.number ?? 99));
const audioRows = [...rowsFor('audio_log'), ...insideRows('Audio log').map((r) => {
  // the collection of an audio log inside a mission comes from the community map's description of it
  const known: Record<string, string> = { 'Simple Pleasures': 'Rikers', 'Bargaining Chips': 'Rikers', Incompetent: 'Freemen', 'Glad To Be Freemen': 'Freemen', 'Rust Bucket': 'Freemen', 'Know-how': 'Freemen', Priorities: 'Cleaners' };
  return { ...r, collection: known[r.name] };
})];
const byNum = (a: Row, b: Row) => (a.number ?? 0) - (b.number ?? 0);
const groupBy = (rows: Row[]) => {
  const g: Record<string, Row[]> = {};
  for (const r of rows) (g[r.collection || 'Other'] ||= []).push(r);
  return Object.entries(g).sort((a, b) => a[0].localeCompare(b[0]));
};
const checklist = [
  { cat: 'echo', label: 'ECHOs', rows: echoRows, numbered: true },
  { cat: 'shd_crate', label: 'SHD Crates', rows: rowsFor('shd_crate').sort(byNum), numbered: true },
  { cat: 'encrypted_crate', label: 'Encrypted Crates', rows: rowsFor('encrypted_crate').sort(byNum), numbered: true },
  { cat: 'artifact', label: 'Artifacts', groups: groupBy(rowsFor('artifact')) },
  { cat: 'audio_log', label: 'Audio Logs', groups: groupBy(audioRows) },
].map((c) => ({ ...c, total: c.rows ? c.rows.length : (c.groups || []).reduce((a, [, r]) => a + r.length, 0), color: catById[c.cat]?.color }));
const trackableTotal = checklist.reduce((a, c) => a + c.total, 0);
const totalOf = (cat: string) => checklist.find((c) => c.cat === cat)?.total ?? 0;

const openWorldSafeHouses = pois.filter((p) => p.category === 'safe_house' && !/dark zone/i.test(p.name)).map((p) => p.name);
const dzSafeHouses = pois.filter((p) => p.category === 'safe_house' && /dark zone/i.test(p.name)).length;
const crates = pois.filter((p) => p.category === 'encrypted_crate');
const randomCrates = crates.filter((p) => /random/i.test(p.code || '')).map((p) => p.crateNumber!).sort((a, b) => a - b);
const disputedCrates = crates.filter((p) => !p.code).map((p) => p.crateNumber!).sort((a, b) => a - b);
const verifiedCount = pois.filter((p) => p.verified).length;
const total = pois.length;

const groups: Record<string, Cat[]> = {};
for (const cat of categories) (groups[cat.group] ||= []).push(cat);
const GROUP_ORDER = ['Collectibles', 'Hubs', 'Missions & Activities', 'Dark Zone'];
const groupEntries = Object.entries(groups).sort((a, b) => GROUP_ORDER.indexOf(a[0]) - GROUP_ORDER.indexOf(b[0]));

const title = 'Division Resurgence Interactive Map';
const description = `Free Division Resurgence map of Manhattan: all ${totalOf('echo')} ECHOs, ${n('shd_crate')} SHD crates, safe codes, artifacts, audio logs, safe houses and Dark Zone exits, with a checklist.`;
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Interactive Map', url: '/division-resurgence-interactive-map/' }
];

const faqs = [
  {
    question: 'Where are all 24 ECHOs in Division Resurgence?',
    answer: `${n('echo')} of the ${totalOf('echo')} ECHOs are in the open world and have a pin on the map. The other three play inside missions: Triage (ECHO 08) in Take The Castle, Kidnapped (ECHO 11) in Precious Cargo and Liberty Island (ECHO 14) in Wall Street Woes. Open the Checklist tab to see them all with the district the game lists for each.`
  },
  {
    question: 'Where are the 13 SHD crates?',
    answer: `All ${n('shd_crate')} SHD crates are pinned. We compared every pin with in-game footage of all 13. Each crate gave a purple skill mod chipset for the agent's specialization, 40 Phoenix Credits and 5,000 credits in that footage. Many sit on rooftops or behind fences, so look for the ladder or the climbable crates nearby.`
  },
  {
    question: 'Where are the safe houses in Division Resurgence?',
    answer: `There are ${openWorldSafeHouses.length} open-world safe houses: ${listJoin(openWorldSafeHouses)}. The Dark Zone adds ${dzSafeHouses} numbered safe houses of its own. The NYC Base of Operations and Spring Blossom Settlement are on the map too, with their vendors and crafting stations listed in each popup.`
  },
  {
    question: 'Where are the encrypted crates, and what are the codes?',
    answer: `${crates.length} encrypted crates are pinned on the map, and each popup shows the code where sources agree. Crates ${listJoin(randomCrates)} are randomized per player, so the popup tells you which Code Clue to read instead. Crates ${listJoin(disputedCrates)} are left blank on purpose because community sources disagree on them. The full table is in our Safe Codes Master List.`
  },
  {
    question: 'How do I track which collectibles I have found?',
    answer: `Open any collectible and tap Mark as found, or tick it in the Checklist tab. The map dims found pins, and Hide found clears them away. Progress is saved in your browser only, so clearing site data wipes it. No account and no login.`
  },
  {
    question: 'Where is the Dark Zone on the map?',
    answer: `The Dark Zone is the purple section on the east side of the map. We plot its ${n('dz_gate')} gates, ${n('dz_extraction')} extraction zones, ${dzSafeHouses} safe houses, ${n('dz_landmark')} landmarks, enemy leaders and extremely contaminated areas. Those markers are converted from a schematic community map, so they can sit slightly off from the in-game icon.`
  },
];

const mapLd = {
  '@type': 'Map',
  name: 'Division Resurgence Interactive Map of Manhattan',
  description,
  url: new URL('/division-resurgence-interactive-map/', Astro.site).href,
  mapType: 'https://schema.org/VenueMap',
  dateModified: MAP_REVIEWED,
  license: poisData.attribution.license
};

const dataPayload = JSON.stringify(poisData);
const offMapNames = offMap.filter((o) => o.type === 'Mission instance');
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  jsonLd={mapLd}
  ogImage="/images/map/manhattan-base.jpg"
  keywords={["division resurgence interactive map","division resurgence map","division resurgence echo locations","division resurgence shd crate locations","division resurgence safe house locations","division resurgence encrypted crate locations","division resurgence artifact locations","division resurgence audio log locations","division resurgence collectibles","division resurgence dark zone map"]}
>
<Fragment slot="head">
  <!-- The base map is the largest paint; Leaflet only asks for it after two scripts run, so start it now (same URL, no crossorigin, so the request is reused). -->
  <link rel="preload" as="image" href="/images/map/manhattan-base.webp" fetchpriority="high" />
</Fragment>

<div class="map-app" id="map-app">
  <header class="map-head">
    <div class="map-head__title">
      <h1>Division Resurgence Interactive Map</h1>
      <p>{total} locations in Midtown Manhattan and the Dark Zone. Checked against the game on {reviewedLabel} ({MAP_REVIEWED_PATCH}).</p>
    </div>
    <div class="map-search">
      <label class="sr-only" for="map-search">Search the map</label>
      <svg class="map-search__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg>
      <input id="map-search" class="map-search__input" type="search" enterkeyhint="search" placeholder="Search: ECHO 07, Chelsea, crate 12" autocomplete="off" spellcheck="false" />
      <ul id="map-search-results" class="map-search__results" hidden></ul>
    </div>
    <div class="map-meter" aria-live="polite">
      <span class="map-meter__label">Collected</span>
      <strong id="map-progress-total">0 / {trackableTotal}</strong>
      <span class="map-meter__bar"><span id="map-progress-bar"></span></span>
    </div>
  </header>

  <div class="map-layout">
    <aside class="map-panel" id="map-panel" aria-label="Map layers and collectible checklist">
      <div class="map-panel__tabs" role="tablist">
        <button type="button" role="tab" id="tab-layers" aria-controls="pane-layers" aria-selected="true" class="map-tab is-active">Layers</button>
        <button type="button" role="tab" id="tab-check" aria-controls="pane-check" aria-selected="false" class="map-tab">Checklist <span class="map-tab__count" id="tab-check-count">0/{trackableTotal}</span></button>
        <button type="button" class="map-panel__close" id="panel-close" aria-label="Close">&times;</button>
      </div>

      <div class="map-pane" id="pane-layers" role="tabpanel" aria-labelledby="tab-layers">
        <label class="map-switch">
          <input type="checkbox" id="hide-found" />
          <span class="map-switch__track" aria-hidden="true"></span>
          <span>Hide found collectibles</span>
        </label>
        {groupEntries.map(([group, cats]) => (
          <div class="filter-group">
            <div class="filter-group__head">
              <h2 class="filter-group__label">{group}</h2>
              <span class="filter-group__actions">
                <button type="button" data-group-toggle={group} data-mode="all">All</button>
                <button type="button" data-group-toggle={group} data-mode="none">None</button>
              </span>
            </div>
            {cats.map((cat) => (
              <label class="filter-item">
                <input type="checkbox" class="filter-checkbox" data-category={cat.id} checked={cat.defaultOn} />
                <span class="filter-chip" style={`--c:${cat.color}`} data-icon={cat.icon}></span>
                <span class="filter-label">{cat.label}{cat.wip && <span class="filter-flag" title="Partial layer: still being mapped">partial</span>}{cat.approx && <span class="filter-flag" title="Approximate positions">≈</span>}</span>
                <span class="filter-count" data-count-for={cat.id}>{cat.trackable ? `0/${totalOf(cat.id) || cat.count}` : cat.count}</span>
              </label>
            ))}
          </div>
        ))}
        <p class="filter-legend">≈ approximate positions. "Partial" layers are still being mapped. Pins marked <span class="vbadge">Checked in game</span> in their popup were compared with the game itself.</p>
        <div class="map-backup">
          <button type="button" class="map-btn map-btn--ghost" id="map-reset-progress">Reset progress</button>
        </div>
      </div>

      <div class="map-pane" id="pane-check" role="tabpanel" aria-labelledby="tab-check" hidden>
        <p class="check-intro">Tick what you have found. Tap a name to fly to it. Items inside missions have no pin: they open the mission instead.</p>
        {checklist.map((c) => (
          <details class="check-cat" open={c.cat === 'echo'} data-check-cat={c.cat}>
            <summary style={`--c:${c.color}`}>
              <span class="check-cat__name">{c.label}</span>
              <span class="check-cat__count" data-check-count={c.cat}>0/{c.total}</span>
              <span class="check-cat__bar"><span data-check-bar={c.cat}></span></span>
            </summary>
            {c.rows && (
              <ul class="check-list">
                {c.rows.map((r) => (
                  <li class="check-row" data-row={r.id}>
                    <input type="checkbox" id={`chk-${r.id}`} data-found-id={r.id} data-cat={c.cat} aria-label={`Found: ${r.name}`} />
                    <button type="button" class="check-row__name" data-goto={r.pin}>
                      {c.numbered && r.number != null && <span class="check-row__num">{String(r.number).padStart(2, '0')}</span>}
                      <span>{c.cat === 'shd_crate' || c.cat === 'encrypted_crate' ? (r.district || r.name) : r.name}</span>
                    </button>
                    <span class="check-row__sub">{c.cat === 'shd_crate' || c.cat === 'encrypted_crate' ? '' : r.sub}</span>
                  </li>
                ))}
              </ul>
            )}
            {c.groups && c.groups.map(([coll, rows]) => (
              <div class="check-coll">
                <div class="check-coll__head"><span>{coll}</span><span data-coll-count={`${c.cat}:${coll}`}>0/{rows.length}</span></div>
                <ul class="check-list">
                  {rows.map((r) => (
                    <li class="check-row" data-row={r.id}>
                      <input type="checkbox" id={`chk-${r.id}`} data-found-id={r.id} data-cat={c.cat} data-coll={coll} aria-label={`Found: ${r.name}`} />
                      <button type="button" class="check-row__name" data-goto={r.pin}><span>{r.name}</span></button>
                      <span class="check-row__sub">{r.sub}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </details>
        ))}
      </div>
    </aside>

    <div class="map-canvas-wrap">
      <a href="#map-after" class="map-skip">Skip the map</a>
      <div id="map-canvas" data-base="/images/map/manhattan-base.webp" role="application" aria-label="Interactive map of Manhattan in The Division Resurgence"></div>
      <div class="map-zoom-hint" id="map-zoom-hint" hidden>Click the map first, then scroll to zoom</div>
      <noscript><p class="map-noscript">The interactive map needs JavaScript. The lists below work without it.</p></noscript>
    </div>
  </div>

  <div class="map-dock" id="map-dock">
    <button type="button" class="map-dock__btn" data-open-pane="layers" aria-controls="map-panel">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3L2 8l10 5 10-5z"/><path d="M2 13l10 5 10-5"/></svg>Layers
    </button>
    <button type="button" class="map-dock__btn" data-open-pane="check" aria-controls="map-panel">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h3M4 12h3M4 18h3M10 6h10M10 12h10M10 18h10"/></svg>Checklist <span id="dock-count">0/{trackableTotal}</span>
    </button>
  </div>

  <section class="map-seo" id="map-after">
    <h2>Missions outside the open-world map</h2>
    <p>These launch from bubbles on the edge of the in-game map, so on our map they sit on the left edge:</p>
    <ul class="offmap-list">
      {offMapNames.map((o) => (
        <li>
          <strong>{o.name}</strong>{o.bubble && <> (the "{o.bubble}" bubble)</>}{o.distance && <>, {o.distance} away on the in-game map</>}.
          {o.about && <> {o.about}</>}
          {o.inside && o.inside.length > 0 && <> Holds {o.inside.map((i) => `the ${i.type === 'ECHO' ? 'ECHO' : 'audio log'} "${i.name}"`).join(', ')}.</>}
        </li>
      ))}
    </ul>

    <h2>Collectible rewards</h2>
    <ul class="offmap-list">
      <li><strong>ECHOs ({totalOf('echo')}):</strong> {poisData.collections.echo.stageReward}</li>
      <li><strong>Mysteries ({poisData.collections.Mysteries.total} artifacts):</strong> {poisData.collections.Mysteries.stageReward}</li>
      <li><strong>SHD crates ({n('shd_crate')}):</strong> {poisData.collections.shd_crate.reward}</li>
    </ul>
    <p>Guides: <a href="/guides/division-resurgence-echo-locations/">all 24 ECHO locations</a>, <a href="/guides/division-resurgence-shd-crate-locations/">all 13 SHD crates</a>, <a href="/guides/division-resurgence-collectibles-guide/">artifacts, audio logs and comms</a> and the <a href="/guides/division-resurgence-safe-codes/">safe codes</a>.</p>

    <h2>How this map was made</h2>
    <p>Pin positions start from The Division Wiki's community maps of <a href={poisData.attribution.sources[0]} target="_blank" rel="noopener noreferrer">New York City</a> and <a href={poisData.attribution.sources[1]} target="_blank" rel="noopener noreferrer">the Dark Zone</a> (Fandom, <a href={poisData.attribution.license} target="_blank" rel="noopener noreferrer">CC BY-SA 3.0</a>). On {reviewedLabel} we lined screenshots of the in-game map up with ours and moved the pins that were off: {verifiedCount} markers are now checked against the game, including every open-world safe house, landmark, mission instance and SHD crate. The ECHO and comm names, districts and descriptions come from the game's own Collectibles screen. Dark Zone markers are still approximate.</p>
    <p>Spotted a wrong pin? <a href="/contact/">Tell us</a> (Shift+Click on desktop copies the coordinates).</p>
  </section>

  <section class="map-faq">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-list">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary class="faq-question">{faq.question}</summary>
          <p class="faq-answer">
            {faq.answer.endsWith('Safe Codes Master List.') ? (
              <>{faq.answer.replace(/The full table is in our Safe Codes Master List\.$/, '')}The full table is in our <a href="/guides/division-resurgence-safe-codes/">Safe Codes Master List</a>.</>
            ) : (
              faq.answer
            )}
          </p>
        </details>
      ))}
    </div>
  </section>
</div>

<link rel="stylesheet" href="/css/leaflet.min.css" />
<script is:inline src="/js/leaflet.min.js"></script>
<script is:inline>
/*! leaflet-rastercoords - MIT - https://github.com/commenthol/leaflet-rastercoords */
(function(f){if(typeof define==="function"&&define.amd){define(["leaflet"],f)}else{f(L)}})(function(L){L.RasterCoords=function(map,imgSize,tileSize){this.map=map;this.width=imgSize[0];this.height=imgSize[1];this.tileSize=tileSize||256;this.zoom=this.zoomLevel()};L.RasterCoords.prototype={zoomLevel:function(){return Math.ceil(Math.log(Math.max(this.width,this.height)/this.tileSize)/Math.log(2))},unproject:function(coords){return this.map.unproject(coords,this.zoom)},project:function(coords){return this.map.project(coords,this.zoom)},getMaxBounds:function(){var southWest=this.unproject([0,this.height]);var northEast=this.unproject([this.width,0]);return new L.LatLngBounds(southWest,northEast)},setMaxBounds:function(){var bounds=this.getMaxBounds();this.map.setMaxBounds(bounds)}}});
</script>
<script type="application/json" id="map-data" is:inline set:html={dataPayload}></script>
<script is:inline src="/js/map-engine.js?v=30"></script>

</BaseLayout>

<style is:global>
/* ============================================================
   INTERACTIVE MAP · Division Resurgence
   The map is the page: a compact head row, then the map filling the screen, with the
   Layers / Checklist panel beside it (a bottom sheet on phones).
   ============================================================ */
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0 }
.map-app { --map-bg: #15171c; --panel-w: 300px; --head-h: 72px }

/* --- Head row --- */
.map-head {
  max-width: 100rem; margin: 0 auto; padding: var(--sp-3) var(--sp-4);
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 420px) auto; gap: var(--sp-4); align-items: center;
}
.map-head__title h1 { font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem); line-height: var(--lh-tight); margin: 0; color: var(--ink-heading) }
.map-head__title p { margin: 2px 0 0; font-size: var(--text-sm); color: var(--ink-muted); max-width: none }
.map-search { position: relative }
.map-search__icon { position: absolute; left: 12px; top: 50%; width: 18px; height: 18px; transform: translateY(-50%); fill: none; stroke: var(--ink-muted); stroke-width: 2; pointer-events: none }
.map-search__input {
  width: 100%; min-height: var(--control); padding: 10px 14px 10px 38px; font-size: max(16px, 1rem); color: var(--ink-heading);
  background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
}
.map-search__input:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px rgba(242,104,34,0.25) }
.map-search__input::placeholder { color: var(--ink-muted); opacity: 1 }
.map-search__results {
  position: absolute; z-index: 1300; top: calc(100% + 4px); left: 0; right: 0; margin: 0; padding: 4px; list-style: none;
  background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-sm); box-shadow: 0 12px 32px rgba(0,0,0,0.5);
  max-height: 360px; overflow-y: auto;
}
.search-hit {
  width: 100%; min-height: 44px; display: flex; align-items: center; gap: 10px; padding: 6px 10px; text-align: left;
  background: none; border: none; border-radius: 6px; color: var(--ink); cursor: pointer; font-size: var(--text-sm);
}
.search-hit:hover, .search-hit:focus-visible { background: rgba(242,104,34,0.12) }
.search-hit:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px }
.search-hit__name { flex: 1; color: var(--ink-heading); min-width: 0 }
.search-hit__name small { display: block; color: var(--ink-muted); font-size: 0.8125rem }
.search-hit__cat { font-size: 0.8125rem; color: var(--ink-muted); white-space: nowrap }
.search-empty { padding: 8px 10px; color: var(--ink-muted); font-size: var(--text-sm) }
.map-meter { display: grid; grid-template-columns: auto auto; gap: 2px 10px; align-items: baseline; justify-items: end; min-width: 150px }
.map-meter__label { font-size: 0.8125rem; color: var(--ink-muted) }
.map-meter strong { font-family: var(--font-mono); font-size: var(--text-base); color: var(--ink-heading) }
.map-meter__bar { grid-column: 1 / -1; width: 100%; height: 4px; border-radius: 2px; background: var(--border); overflow: hidden }
.map-meter__bar span, .check-cat__bar span { display: block; height: 100%; width: 0; background: var(--success); transition: width var(--transition-base) }

/* --- Layout: panel + map --- */
.map-layout {
  max-width: 100rem; margin: 0 auto; padding: 0 var(--sp-4);
  display: grid; grid-template-columns: var(--panel-w) minmax(0, 1fr); gap: 0;
