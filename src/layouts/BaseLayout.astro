---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { GA4_ID, JOURNEY_TAG } from '../data/site-config';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  ogType?: string;
  ogImage?: string;
  article?: {
    publishDate: string;
    modifiedDate?: string;
    author: string;
    tags?: string[];
    wordCount?: number;
  };
  keywords?: string[];
  breadcrumbs?: { name: string; url: string }[];
  jsonLd?: Record<string, unknown>;
  faqs?: { question: string; answer: string }[];
  noAds?: boolean;
  /** Load the ad script with every ad switched off. Only the privacy page: the script adds Mediavine's notice there. */
  adNotice?: boolean;
  noindex?: boolean;
  /** Override robots directive, e.g. "noindex, follow". Implies noindex behavior. */
  robots?: string;
  /** Override the canonical URL (defaults to the page's own URL). */
  canonical?: string;
}

const { title, description, ogType, ogImage, article, keywords, breadcrumbs, jsonLd, faqs, noAds, adNotice, noindex, robots, canonical } = Astro.props;
// Ads (Journey by Mediavine) only run on pages with enough of our own content to carry them. A page kept
// out of Google (noindex), a list of links (tag archives) or a short database card never loads the ad
// script: pass noAds from those templates. scripts/audit-indexation.mjs fails the build when one slips through.
// Journey places the ads itself (settings on its side): in-content ads inside .build-article, a sidebar ad
// at the end of .lom__card on build pages, and a banner fixed to the bottom of the screen.
const suppressAds = noAds || noindex || !!robots;
const loadAdScript = !!JOURNEY_TAG && (!suppressAds || !!adNotice);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="msvalidate.01" content="BE91A714DA465B973961FB903E416D0B" />
  <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, shrink-to-fit=no" />
  {GA4_ID && (
    <>
      {/* Google tag (gtag.js), as Google gives it: high in <head>, gtag() global so consent mode and events can call it. */}
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
      <script is:inline set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${GA4_ID}');`}></script>
    </>
  )}
  <meta name="theme-color" content="#0D0D0F" />
  <meta name="color-scheme" content="dark" />
  <meta name="format-detection" content="telephone=no" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="alternate" type="application/rss+xml" title="Resurgence Builds RSS" href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />


  {/* Self-hosted fonts: DM Sans for all text, JetBrains Mono for labels. The @font-face rules are
      inline (same as public/fonts/fonts.css) so the browser doesn't wait on an extra render-blocking
      stylesheet before it can paint. DM Sans is a variable font: one file covers every weight we
      use; the range stops at 700 so 800 and 900 headings keep the weight they always had. */}
  {/* Preload the fonts used above the fold so they usually arrive before the first paint: when
      a font swaps in late, wrapped text (the mono badges especially) reflows and moves the page. */}
  <link rel="preload" href="/fonts/dm-sans.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jetbrains-mono-400.woff2" as="font" type="font/woff2" crossorigin />
  <style is:inline>@font-face{font-family:'DM Sans';font-style:normal;font-weight:400 700;font-display:swap;src:url('/fonts/dm-sans.woff2') format('woff2')}@font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/jetbrains-mono-400.woff2') format('woff2')}</style>

  <SEO
    title={title}
    description={description}
    ogType={ogType}
    ogImage={ogImage}
    article={article}
    keywords={keywords}
    breadcrumbs={breadcrumbs}
    jsonLd={jsonLd}
    faqs={faqs}
    noindex={noindex}
    robots={robots}
    canonical={canonical}
  />

  <slot name="head" />

  {loadAdScript && <Fragment set:html={JOURNEY_TAG} />}
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <Header />
  <main id="main-content">
    <slot />
    {/* Tier list pages get the email signup here, so the tier list files themselves stay untouched. */}
    {Astro.url.pathname.startsWith('/tier-list') && (
      <div class="container">
        <NewsletterSignup source="tier-list" />
      </div>
    )}
  </main>
  {/* The ad script is on this page for another job (the privacy notice): this tells it to show no ads. */}
  {loadAdScript && suppressAds && <div id="ad-management-config-settings" data-blocklist-all="1" hidden></div>}
<Footer title={title} />
  {loadAdScript && !suppressAds && (
    <script is:inline>
      // The ad script fixes a banner to the bottom of the screen (#fixed_container_bottom > .adhesion_wrapper)
      // and, at times, a small video player just above it (.universalPlayer__bottom). This keeps two CSS
      // variables on <html> current so our own bottom-anchored controls sit clear of them:
      //   --ad-bottom  height of the banner, 0px when there is none
      //   --ad-video   height of the video player while it shows at the bottom, plus a 12px gap, else 0px
      // and the class "ads-on" while a banner is up. Measured, not assumed: the banner was 90px on desktop
      // and 50px on phones on November 15, 2026, and some ad formats are taller.
      (function () {
        if (!('MutationObserver' in window)) return;
        var root = document.documentElement, watched = [], queued = false, last = '', box = null;
        var ro = 'ResizeObserver' in window ? new ResizeObserver(queue) : null;
        function height(el) { return el ? Math.round(el.getBoundingClientRect().height) : 0; }
        function measure() {
          queued = false;
          var ad = document.querySelector('.adhesion_wrapper');
          var vid = document.querySelector('.universalPlayer__bottom');
          [ad, vid].forEach(function (el) { if (el && ro && watched.indexOf(el) < 0) { watched.push(el); ro.observe(el); } });
          var a = height(ad), v = height(vid);
          if (a + ':' + v === last) return;
          last = a + ':' + v;
          root.style.setProperty('--ad-bottom', a + 'px');
          root.style.setProperty('--ad-video', (v > 0 ? v + 12 : 0) + 'px');
          root.classList.toggle('ads-on', a > 0);
        }
        function queue() { if (!queued) { queued = true; requestAnimationFrame(measure); } }
        // The script marks <body> when its ads are in and appends its fixed container to <body>; the banner
        // and the player are that container's children.
        var mo = new MutationObserver(function () {
          var b = document.getElementById('fixed_container_bottom');
          if (b && b !== box) { box = b; mo.observe(b, { childList: true }); }
          queue();
        });
        mo.observe(document.body, { childList: true, attributes: true, attributeFilter: ['class'] });
      })();
    </script>
  )}
  <script>
    // Wrap all prose/content tables in a scrollable box for phones, and fade the edge that has more to scroll to
    document.addEventListener('DOMContentLoaded', () => {
      const boxes: HTMLElement[] = [];
      document.querySelectorAll('.prose table, main table').forEach(table => {
        let wrapper = table.parentElement as HTMLElement | null;
        if (!wrapper?.classList.contains('table-scroll')) {
          wrapper = document.createElement('div');
          wrapper.className = 'table-scroll';
          table.parentNode?.insertBefore(wrapper, table);
          wrapper.appendChild(table);
        }
        boxes.push(wrapper);
      });
      const update = (box: HTMLElement) => {
        const more = box.scrollWidth - box.clientWidth > 2;
        box.classList.toggle('is-scrollable', more);
        box.classList.toggle('is-at-start', box.scrollLeft <= 2);
        box.classList.toggle('is-at-end', box.scrollLeft + box.clientWidth >= box.scrollWidth - 2);
        if (more && !box.hasAttribute('tabindex')) {
          // keyboard users can scroll it too
          box.setAttribute('tabindex', '0');
          box.setAttribute('role', 'region');
          box.setAttribute('aria-label', 'Table, scrolls sideways');
        }
      };
      boxes.forEach(box => { update(box); box.addEventListener('scroll', () => update(box), { passive: true }); });
      let t: number | undefined;
      window.addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(() => boxes.forEach(update), 150); });
    });
  </script>
  <script>
    // Filter buttons only toggle an .is-active class; mirror it to aria-pressed for screen readers
    const syncPressed = (b: Element) => b.setAttribute('aria-pressed', String(b.classList.contains('is-active')));
    document.querySelectorAll('.filter-btn').forEach(syncPressed);
    const pressedObserver = new MutationObserver((ms) => ms.forEach((m) => {
      if (m.target instanceof HTMLElement && m.target.classList.contains('filter-btn')) syncPressed(m.target);
    }));
    document.querySelectorAll('.filter-btn').forEach((b) => b.parentElement && pressedObserver.observe(b.parentElement, { attributes: true, attributeFilter: ['class'], subtree: true }));
  </script>
</body>
</html>
