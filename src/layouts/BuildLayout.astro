---
import { tagHref } from '../utils/tag-href';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionTag from '../components/SectionTag.astro';
import AdSenseUnit from '../components/AdSenseUnit.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import Comments from '../components/Comments.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import BuildLoadout from '../components/BuildLoadout.astro';
import BuildLoadoutMini from '../components/BuildLoadoutMini.astro';
import type { LoadoutData } from '../utils/loadout';
import { getCollection } from 'astro:content';
import { getAuthorUrl } from '../utils/author';
import TierVote from '../components/TierVote.astro';
import TierBadge from '../components/TierBadge.astro';

export interface Props {
  title: string;
  description: string;
  specialization: string;
  playstyle: string;
  patch: string;
  verified?: boolean;
  original?: boolean;
  lastUpdated: Date;
  pve: boolean;
  pvp: boolean;
  tags: string[];
  author: string;
  featuredImage?: string;
  imageAlt?: string;
  shareTitle?: string;
  shareText?: string;
  faqs?: { question: string; answer: string }[];
  sources?: string[];
  plannerHash?: string;
  videoId?: string;
  videoTitle?: string;
  videoChannel?: string;
  videoChannelUrl?: string;
  videoUploadDate?: string;
  videoDuration?: string;
  howTo?: {
    name: string;
    description: string;
    totalTime: string;
    tool: string[];
    steps: { name: string; text: string }[];
  };
  wordCount?: number;
  subclass?: string;
  loadout?: LoadoutData;
}

const { title, description, specialization, playstyle, patch, verified = true, original = false, lastUpdated, pve, pvp, tags, author, featuredImage, imageAlt, shareTitle, shareText, headings = [], faqs = [], sources = [], plannerHash, videoId, videoTitle, videoChannel, videoChannelUrl, videoUploadDate, videoDuration, howTo, wordCount, subclass, loadout } = Astro.props;
// The build's slug (its file name): the key for its player votes
const buildSlug = Astro.url.pathname.split('/').filter(Boolean).pop() ?? '';

const siteUrl = 'https://resurgencebuilds.com';

// Season/Phase labels ("Season 1 · Phase 3") render as-is; numeric versions get a "Patch " prefix.
// A build's `patch` frontmatter only bumps when the build is actually re-verified in-game.
const patchLabel = /^\d/.test(patch) ? `Patch ${patch}` : patch;

// HowTo JSON-LD for structured search results
const howToLd = howTo ? {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  '@id': `${siteUrl}${Astro.url.pathname}#howto`,
  name: howTo.name,
  description: howTo.description,
  totalTime: howTo.totalTime,
  tool: howTo.tool.map(t => ({ '@type': 'HowToTool', name: t })),
  step: howTo.steps.map((s, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    name: s.name,
    text: s.text,
  })),
} : null;

const classSlug = specialization.toLowerCase().replace(/\s+/g, '-');

const tocItems = [...(loadout ? [{ depth: 2, slug: 'loadout', text: 'The Loadout' }] : []), ...headings.filter(h => h.depth <= 3)];
const tagChips = tags.filter(t => t[0] === t[0].toUpperCase() && !t.includes('-'));

const formattedDate = lastUpdated.toLocaleDateString('en-US', { timeZone: 'UTC',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const breadcrumbItems = [
  { name: 'Builds', url: '/builds/' },
  { name: title, url: '#' },
];

// Dynamic Explore More: get other builds, exclude current page
const allBuilds = await getCollection('builds');
const otherBuilds = allBuilds
  .filter(b => b.data.title !== title)
  .sort((a, b) => b.data.lastUpdated.getTime() - a.data.lastUpdated.getTime())
  .slice(0, 3);

const twitterShareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(`Check out the ${title} build guide on Resurgence Builds!`)}&url=${encodeURIComponent(Astro.url.toString())}`;
const redditShareUrl = `https://reddit.com/submit?url=${encodeURIComponent(Astro.url.toString())}&title=${encodeURIComponent(title)}`;
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbItems}
  ogType="article"
  article={{
    publishDate: lastUpdated.toISOString(),
    modifiedDate: lastUpdated.toISOString(),
    author,
    tags,
    ...(wordCount && { wordCount }),
  }}
  ogImage={featuredImage}
  keywords={[specialization, playstyle, ...(pve ? ['PVE'] : []), ...(pvp ? ['PVP'] : []), 'Division Resurgence', 'build guide', ...tags.slice(0, 5)]}
  faqs={faqs}
  jsonLd={howToLd ? howToLd : undefined}
>
  <div class="container section">
    <Breadcrumbs items={breadcrumbItems} />

    <header class="build-head">
      <SectionTag label="Build Guide" />
      <h1 class="heading-accent">{title}</h1>

      <div class="article-meta"><div class="meta-line-wrap"><div class="meta-line">
        <span>By <a href={getAuthorUrl(author)} style="color: var(--accent); text-decoration: none;">{author}</a></span>
        <span>{patchLabel}</span>
        <time datetime={lastUpdated.toISOString()}><strong>Last updated:</strong> {formattedDate}</time>
      </div></div></div>

      <div class="build-badges">
        {verified ? (
          <span class="build-badge build-badge--verified">✓ Verified for {patchLabel}</span>
        ) : original ? (
          <span class="build-badge build-badge--original" title="Our own design, put together from the in-game Build-Making Database">Original build · {patchLabel}</span>
        ) : (
          <span class="build-badge build-badge--creator" title="We documented this creator's build from their videos but haven't re-tested it ourselves">Creator build · {patchLabel}</span>
        )}
        <TierBadge kind="build" id={buildSlug} />
        <span class="build-badges__more">Part of our <a href={`/class/${classSlug}/`}>{specialization} build collection</a></span>
      </div>
    </header>

    {loadout ? (
      <BuildLoadout loadout={loadout} specialization={specialization} subclass={subclass} playstyle={playstyle} pve={pve} pvp={pvp} plannerHash={plannerHash} />
    ) : plannerHash && (
      <p><a href={`/builder/#${plannerHash}`} class="btn btn--accent">Open in Build Planner</a></p>
    )}

    {videoId && (
      <div class="build-media">
        <YouTubeEmbed
          videoId={videoId}
          title={videoTitle || `${title}: Video Guide`}
          description={description}
          channelName={videoChannel}
          channelUrl={videoChannelUrl}
          uploadDate={videoUploadDate}
          duration={videoDuration}
        />
      </div>
    )}

    <div class={`build-main${loadout ? ' build-main--mini' : ''}`}>
      <article class="prose build-article">
        {tocItems.length > 0 && (
          <details class="toc" data-toc style="margin-bottom: var(--sp-6);">
            <summary><span class="toc__title">Contents</span></summary>
            <nav aria-label="Table of contents">
              {tocItems.map(h => (
                <a href={`#${h.slug}`} style={`padding-left:${(h.depth - 2) * 1}rem;`}>
                  {h.text}
                </a>
              ))}
            </nav>
          </details>
        )}

        <slot />

        {tagChips.length > 0 && (
          <div class="build-tags">
            {tagChips.map(tag => <a href={tagHref(tag)} class="tag">{tag}</a>)}
          </div>
        )}

        <NewsletterSignup source="build" />

        <AdSenseUnit slotId="8102223000" label="Advertisement (in-article)" />

        <TierVote kind="build" id={buildSlug} name={title} question="How would you rank this build?" listHref="/tier-list/" listLabel="See the build tier list" beforeComments />

        <Comments />

        {faqs.length > 0 && (
          <section class="build-faq" style="margin-top: var(--sp-8);">
            <h2 id="faq" style="font-size: var(--text-xl); margin-bottom: var(--sp-4);">Frequently Asked Questions</h2>
            <div class="faq-list" style="display: flex; flex-direction: column; gap: var(--sp-2);">
              {faqs.map(faq => (
                <details class="faq-item">
                  <summary class="faq-question">{faq.question}</summary>
                  <p class="faq-answer">{faq.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        {otherBuilds.length > 0 && (
          <>
            <hr style="margin: var(--sp-6) 0; border: none; border-top: 1px solid var(--border);" />
            <nav class="explore-more" aria-label="Related Builds">
              <h2 style="font-size: var(--text-xl); margin-bottom: var(--sp-4);">Related Builds</h2>
              <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--sp-2);">
                {otherBuilds.map(build => (
                  <li><a href={`/builds/${build.id}/`}>{build.data.title}</a></li>
                ))}
              </ul>
            </nav>
          </>
        )}

        <div class="share-box">
          <div>
            <h3 class="share-box__title">{shareTitle || "Share this guide"}</h3>
            <p class="share-box__text">{shareText || "Help other agents drop bodies in the Dark Zone."}</p>
          </div>
          <div class="share-box__actions">
            <a href={twitterShareUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary share-box__x">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865l8.875 11.633Z"/>
              </svg>
              Share on X
            </a>
            <a href={redditShareUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary share-box__reddit">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M15.586 8.26a2.108 2.108 0 0 0-2.1-2.095c-.83 0-1.554.48-1.87 1.178-1.428-.865-3.235-1.405-5.228-1.455l1.096-5.158 4.394 1c.026.832.716 1.498 1.555 1.498a1.55 1.55 0 0 0 0-3.099 1.547 1.547 0 0 0-1.488 1.106l-4.81-1.096a.513.513 0 0 0-.616.4l-1.2 5.645c-2.062.032-3.926.578-5.385 1.464a2.108 2.108 0 0 0-1.89-1.2A2.108 2.108 0 0 0 0 8.261c0 1.05.772 1.93 1.782 2.072A5.3 5.3 0 0 0 1.6 11.2c0 2.535 2.87 4.6 6.4 4.6 3.529 0 6.399-2.065 6.399-4.6 0-.31-.035-.615-.102-.912.986-.159 1.737-1.042 1.737-2.094a2.1 2.1 0 0 0-.448-1.233ZM3.7 10.155a1.442 1.442 0 1 1 0-2.885 1.442 1.442 0 0 1 0 2.885Zm4.872 3.197c-1.579 0-3.003-.541-3.606-1.127a.512.512 0 0 1 .715-.734c.484.471 1.705.867 2.891.867 1.186 0 2.408-.396 2.892-.867a.512.512 0 0 1 .715.734c-.604.586-2.028 1.127-3.607 1.127Zm3.27-2.07a1.442 1.442 0 1 1 0-2.884 1.442 1.442 0 0 1 0 2.884Z"/></svg>
              Reddit
            </a>
          </div>
        </div>

        {sources.length > 0 && (
          <section class="build-sources" style="margin-top: var(--sp-8); background: rgba(0,0,0,0.15); border-radius: var(--border-radius); padding: var(--pad-card);">
            <h2 id="sources" style="font-size: var(--text-xl); margin-bottom: var(--sp-4);">Sources</h2>
            <ul style="color: var(--ink-muted); padding-left: var(--inset); font-size: var(--text-sm);">
              {sources.map(source => (
                <li style="margin-bottom: var(--sp-2);" set:html={source}></li>
              ))}
            </ul>
          </section>
        )}
      </article>

      {loadout && <BuildLoadoutMini loadout={loadout} specialization={specialization} subclass={subclass} plannerHash={plannerHash} />}
    </div>
  </div>

  {loadout && (
    <>
      <button type="button" class="lo-fab" data-lo-fab hidden aria-haspopup="dialog">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        Loadout
      </button>
      <dialog class="lo-dialog" data-lo-dialog aria-label="Loadout">
        <div class="lo-dialog__bar">
          <p class="lo-dialog__title">{title}</p>
          <button type="button" class="lo-dialog__close" data-lo-close aria-label="Close the loadout">
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
        <div class="lo-dialog__body" data-lo-dialog-body></div>
      </dialog>
      <script is:inline>
        (function () {
          var panel = document.querySelector('[data-loadout]');
          var fab = document.querySelector('[data-lo-fab]');
          var dlg = document.querySelector('[data-lo-dialog]');
          if (!panel || !fab || !dlg || typeof dlg.showModal !== 'function') return;
          var wide = window.matchMedia('(min-width: 72em)');
          var past = false;
          function update() { fab.hidden = wide.matches || !past; }
          if ('IntersectionObserver' in window) {
            new IntersectionObserver(function (es) {
              var e = es[0];
              past = !e.isIntersecting && e.boundingClientRect.top < 0;
              update();
            }).observe(panel);
          }
          if (wide.addEventListener) wide.addEventListener('change', update);
          var body = dlg.querySelector('[data-lo-dialog-body]');
          fab.addEventListener('click', function () {
            if (!body.firstChild) {
              var copy = panel.cloneNode(true);
              copy.removeAttribute('id');
              copy.removeAttribute('data-loadout');
              copy.removeAttribute('aria-labelledby');
              copy.querySelectorAll('[id]').forEach(function (el) { el.removeAttribute('id'); });
              copy.querySelectorAll('img[loading="lazy"]').forEach(function (img) { img.loading = 'eager'; });
              body.appendChild(copy);
            }
            dlg.showModal();
          });
          dlg.querySelector('[data-lo-close]').addEventListener('click', function () { dlg.close(); });
          dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
          body.addEventListener('click', function (e) {
            var a = e.target.closest && e.target.closest('a[href^="#"]');
            if (a) dlg.close();
          });
        })();
      </script>
    </>
  )}

{Astro.url.pathname.includes('milkshake-machine') && (
  <div id="strawberry-rain" aria-hidden="true"></div>
  <style>
    #strawberry-rain {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 9999;
      overflow: hidden;
    }
    .strawberry {
      position: absolute;
      top: -60px;
      font-size: 28px;
      animation: strawberry-fall linear forwards;
      filter: drop-shadow(0 0 6px rgba(255, 50, 80, 0.4));
    }
    @keyframes strawberry-fall {
      0% {
        transform: translateY(0) rotate(0deg) scale(1);
        opacity: 1;
      }
      70% {
        opacity: 1;
      }
      100% {
        transform: translateY(110vh) rotate(720deg) scale(0.6);
        opacity: 0;
      }
    }
  </style>
  <script is:inline>
    (function() {
      const container = document.getElementById('strawberry-rain');
      if (!container) return;
      const berries = ['🍓', '🍓', '🔫', '🍓', '🍓', '🍓', '🔫', '🍓', '🍓', '🍓', '🍓', '🔫', '🍓', '🍓', '🍓'];
      berries.forEach(function(emoji, i) {
        const el = document.createElement('span');
        el.className = 'strawberry';
        el.textContent = emoji;
        el.style.left = (Math.random() * 92 + 4) + '%';
        el.style.animationDuration = (2.5 + Math.random() * 2) + 's';
        el.style.animationDelay = (Math.random() * 1.8) + 's';
        el.style.fontSize = (22 + Math.random() * 18) + 'px';
        container.appendChild(el);
      });
      setTimeout(function() { container.remove(); }, 6000);
    })();
  </script>
)}

</BaseLayout>

<style>
  .build-badges { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2); margin-bottom: var(--sp-5); font-size: var(--text-sm); }
  .build-badge {
    display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 4px;
    font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.03em;
  }
  .build-badge--verified { background: rgba(34, 197, 94, 0.12); border: 1px solid rgba(34, 197, 94, 0.3); color: #22c55e; }
  .build-badge--original { background: rgba(147, 197, 253, 0.08); border: 1px solid rgba(147, 197, 253, 0.35); color: #93C5FD; }
  .build-badge--creator { background: rgba(252, 211, 77, 0.08); border: 1px solid rgba(252, 211, 77, 0.3); color: #FCD34D; }
  .build-badges__more { color: var(--ink-muted); }
  .build-badges__more a { color: var(--accent); text-decoration: none; }

  /* The creator's video, as wide as the article. The post's own image isn't repeated on the page (Cory, October 31):
     it's the card and share image. */
  .build-media { max-width: 52rem; margin: 0 0 var(--sp-8); }
  .build-media :global(.yt-embed) { margin: 0; }

  /* Article, with the loadout summary beside it on wide screens */
  .build-main { display: block; }
  .build-article { max-width: 52rem; margin: 0 auto; width: 100%; }
  @media (min-width: 72em) {
    .build-main--mini { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; gap: var(--sp-8); align-items: start; }
    .build-main--mini .build-article { margin: 0; max-width: none; }
  }
  .build-tags { display: flex; flex-wrap: wrap; gap: var(--sp-1); margin-top: var(--sp-8); }

  /* "Loadout" button: brings the build back from anywhere in the post */
  .lo-fab {
    position: fixed; z-index: 60; right: var(--sp-4); bottom: calc(var(--sp-4) + env(safe-area-inset-bottom, 0px));
    display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 var(--sp-5);
    border: 0; border-radius: 999px; background: var(--accent); color: #111; cursor: pointer;
    font-family: var(--font-heading); font-weight: 800; font-size: var(--step--1);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.08);
  }
  .lo-fab[hidden] { display: none; }
  .lo-fab:hover { filter: brightness(1.08); }
  @media (max-width: 44.99em) {
    .lo-fab { left: 50%; right: auto; transform: translateX(-50%); }
  }
  .lo-dialog {
    width: min(72rem, calc(100vw - 2 * var(--sp-4))); max-width: none; max-height: calc(100dvh - 2 * var(--sp-4));
    margin: auto; padding: 0; border: 1px solid var(--border); border-radius: var(--radius-lg);
    background: var(--bg); color: var(--ink); overflow: hidden;
  }
  .lo-dialog[open] { display: flex; flex-direction: column; }
  .lo-dialog::backdrop { background: rgba(0, 0, 0, 0.72); backdrop-filter: blur(3px); }
  .lo-dialog__bar {
    display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-2) var(--sp-2) var(--pad-card); border-bottom: 1px solid var(--border); background: #151518;
  }
  .lo-dialog__title { margin: 0; font-family: var(--font-heading); font-weight: 800; color: var(--ink-heading); font-size: var(--step--1); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lo-dialog__close {
    flex: none; width: 44px; height: 44px; display: grid; place-items: center; border-radius: var(--radius-sm);
    border: 1px solid var(--border); background: transparent; color: var(--ink-heading); cursor: pointer;
  }
  .lo-dialog__close:hover { border-color: var(--accent); color: var(--accent); }
  .lo-dialog__body { overflow-y: auto; overscroll-behavior: contain; padding: var(--sp-3); }
  .lo-dialog__body :global(.lo) { margin: 0; }
  @media (max-width: 44.99em) {
    .lo-dialog { width: 100vw; max-height: 100dvh; height: 100dvh; border-radius: 0; border: 0; }
    .lo-dialog__body { padding: 0; }
    .lo-dialog__body :global(.lo) { border-radius: 0; border-left: 0; border-right: 0; }
  }
</style>
