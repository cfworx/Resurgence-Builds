# =============================================================================
# Global Security Headers (all pages)
# =============================================================================
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://pagead2.googlesyndication.com https://www.googletagservices.com https://adservice.google.com https://static.cloudflareinsights.com https://giscus.app https://cdnjs.buymeacoffee.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' blob:; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.google.com https://*.g.doubleclick.net https://pagead2.googlesyndication.com https://api.web3forms.com https://cloudflareinsights.com https://ep1.adtrafficquality.google https://*.adtrafficquality.google; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://giscus.app https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com;
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), interest-cohort=(), browsing-topics=()
# No Cache-Control here on purpose. Pages then get Cloudflare's default,
# "public, max-age=0, must-revalidate": the browser keeps its copy but checks
# for a newer one on every visit (a quick 304 when nothing changed), so an
# update shows on the next load. The old "stale-while-revalidate=86400" let a
# browser show a day-old page first, and a header set here would also be
# joined onto every rule below (Cloudflare joins repeated headers with commas).

# =============================================================================
# Static Asset Caching — long cache for immutable hashed files
# =============================================================================
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=86400

# =============================================================================
# Image Caching — aggressive cache since images rarely change
# =============================================================================
/images/*
  Cache-Control: public, max-age=2592000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# =============================================================================
# Machine-Readable Files — short cache for freshness
# =============================================================================
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap-index.xml
  Cache-Control: public, max-age=900, s-maxage=3600

/sitemap-0.xml
  Cache-Control: public, max-age=900, s-maxage=3600

/rss.xml
  Cache-Control: public, max-age=900, s-maxage=3600

/llms.txt
  Cache-Control: public, max-age=86400

/llm.txt
  Cache-Control: public, max-age=86400

/ads.txt
  Cache-Control: public, max-age=86400
