# =============================================================================
# Global Security Headers (all pages)
# =============================================================================
# Content-Security-Policy, since the site runs Journey by Mediavine ads (November 15, 2026): the ad
# script loads code, frames, pixels and video from dozens of ad companies, and that list changes on
# their side, so scripts, frames, styles, fonts, media and connections are allowed from any https
# address (plus eval, which some bidders use). A policy that lists hosts, like the one before it,
# silently blocks ads. What it still does: nothing loads over plain http, no plugins (object-src),
# no foreign <base> tag, forms post only to the listed services, and only Mediavine's dashboard may
# show the site in a frame (its script check does that). X-Frame-Options is gone because it can't
# make that one exception; frame-ancestors covers it.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: blob:; style-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self' https: blob: data:; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'self' https://publishers.mediavine.com; base-uri 'self'; form-action 'self' https://api.web3forms.com https://buttondown.com https://app.kit.com;
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), interest-cohort=(), browsing-topics=()
# No Cache-Control here on purpose. Pages then get Cloudflare's default,
# "public, max-age=0, must-revalidate": the browser keeps its copy but checks
# for a newer one on every visit (a quick 304 when nothing changed), so an
# update shows on the next load. The old "stale-while-revalidate=86400" let a
# browser show a day-old page first, and a header set here would also be
# joined onto every rule below (Cloudflare joins repeated headers with commas).

# =============================================================================
# Static Asset Caching: long cache for immutable hashed files
# =============================================================================
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=86400

# =============================================================================
# Image Caching: aggressive cache since images rarely change
# =============================================================================
/images/*
  Cache-Control: public, max-age=2592000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# =============================================================================
# Machine-Readable Files: short cache for freshness
# =============================================================================
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap-index.xml
  Cache-Control: public, max-age=900, s-maxage=3600

/sitemap-0.xml
  Cache-Control: public, max-age=900, s-maxage=3600

/rss.xml
  Cache-Control: public, max-age=900, s-maxage=3600

# llms.txt is for AI tools that fetch it directly; it has no reason to show up as a search result.
/llms.txt
  Cache-Control: public, max-age=86400
  X-Robots-Tag: noindex

/llm.txt
  Cache-Control: public, max-age=86400
  X-Robots-Tag: noindex

/llms-full.txt
  X-Robots-Tag: noindex

# =============================================================================
# Cloudflare hostnames: keep them out of search results
# =============================================================================
# resurgence-builds.pages.dev serves the whole production site, and nothing stopped
# it being indexed as a duplicate of resurgencebuilds.com. Preview deployments
# (<hash>.resurgence-builds.pages.dev) already get noindex from Cloudflare; the second
# rule covers them too. These rules match the pages.dev hosts only, never the custom domain.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
